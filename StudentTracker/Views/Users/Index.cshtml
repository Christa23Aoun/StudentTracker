@model IEnumerable<StudentTracker.Models.UserView>
@{
    ViewData["Title"] = "Users";

    string role = ViewBag.RoleFilter ?? "All";
    string status = ViewBag.StatusFilter ?? "All";
    string search = ViewBag.SearchTerm ?? "";

    string pageTitle =
        role == "Student" ? "All Students" :
        role == "Teacher" ? "All Teachers" :
        role == "Admin" ? "All Admins" :
        "All Users";
}

<style>
    body {
        background: #f2f4fb;
        font-family: 'Segoe UI', sans-serif;
        margin: 0;
        padding: 0;
        color: #1b2b48;
    }

    .users-wrapper {
        width: 90%;
        max-width: 1300px;
        margin: 60px auto 80px auto;
        background: #ffffff;
        border-radius: 20px;
        padding: 32px 36px 40px 36px;
        box-shadow: 0 16px 40px rgba(15, 23, 42, 0.15);
        border: 1px solid rgba(15, 23, 42, 0.06);
    }

    h2 {
        text-align: left;
        font-size: 1.8rem;
        font-weight: 700;
        margin-bottom: 8px;
        color: #0b2540;
    }

    .users-subtitle {
        font-size: 0.95rem;
        color: #64748b;
        margin-bottom: 24px;
    }

    .top-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 16px;
        margin-bottom: 20px;
        flex-wrap: wrap;
    }

    .buttons-row {
        display: flex;
        gap: 12px;
        flex-wrap: wrap;
    }

    .btn {
        padding: 10px 22px;
        border-radius: 999px;
        font-weight: 600;
        text-decoration: none;
        transition: 0.2s ease;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border: none;
        font-size: 0.9rem;
        cursor: pointer;
    }

    .btn-back {
        background: #e2ecff;
        color: #1d3b72;
        border: 1px solid #c4d4ff;
    }

        .btn-back:hover {
            background: #d4e2ff;
        }

    .btn-add {
        background: linear-gradient(135deg, #2155c9, #122f7a);
        color: #ffffff;
        box-shadow: 0 10px 22px rgba(37, 99, 235, 0.4);
    }

        .btn-add:hover {
            background: linear-gradient(135deg, #285ce0, #0f2565);
        }

    .filter-row {
        display: flex;
        justify-content: flex-end;
        align-items: center;
        flex-wrap: wrap;
        gap: 10px;
    }

    select,
    .search-input {
        padding: 8px 12px;
        border-radius: 12px;
        border: 1px solid #d0d7e2;
        background: #f8fafc;
        color: #0b2540;
        font-weight: 500;
        min-width: 160px;
        font-size: 0.9rem;
    }

    .search-input {
        min-width: 230px;
    }

    .filter-row .btn-add {
        padding-inline: 18px;
        box-shadow: none;
        font-size: 0.9rem;
    }

    .table-container {
        margin-top: 22px;
        overflow-x: auto;
        background: #f8fafc;
        border-radius: 16px;
        padding: 18px 20px;
        border: 1px solid #e2e8f0;
    }

    table {
        width: 100%;
        border-collapse: collapse;
        color: #0b2540;
        font-size: 0.9rem;
    }

    th, td {
        padding: 11px 10px;
        text-align: center;
        border-bottom: 1px solid #e2e8f0;
        white-space: nowrap;
    }

    thead {
        background: #e3edff;
    }

    th {
        font-weight: 700;
        color: #1e3a8a;
        font-size: 0.9rem;
    }

    tbody tr:hover {
        background: #edf2ff;
    }

    .badge {
        padding: 5px 12px;
        border-radius: 999px;
        font-weight: 600;
        font-size: 0.8rem;
        display: inline-block;
    }

    .badge-active {
        background: #ecfdf5;
        color: #15803d;
        border: 1px solid #bbf7d0;
    }

    .badge-inactive {
        background: #fef2f2;
        color: #b91c1c;
        border: 1px solid #fecaca;
    }

    .action-btn {
        padding: 6px 12px;
        border-radius: 999px;
        margin: 0 3px;
        font-weight: 600;
        transition: 0.2s ease;
        display: inline-block;
        font-size: 0.8rem;
        border: 1px solid transparent;
        text-decoration: none;
    }

    .edit {
        color: #1d4ed8;
        background: #e0ecff;
        border-color: #bfdbfe;
    }

        .edit:hover {
            background: #c7d7ff;
        }

    .deactivate {
        color: #b91c1c;
        background: #fee2e2;
        border-color: #fecaca;
    }

        .deactivate:hover {
            background: #fecaca;
        }

    .enroll {
        color: #0369a1;
        background: #e0f2fe;
        border-color: #bae6fd;
    }

        .enroll:hover {
            background: #c5e4ff;
        }

    .highlight-row {
        background: #fffbeb !important;
        transition: background-color 0.4s ease;
    }

    .alert-success {
        margin-top: 16px;
        border-radius: 10px;
        border: 1px solid #bbf7d0;
        background: #ecfdf5;
        color: #166534;
        font-size: 0.88rem;
    }

    @@media (max-width: 768px) {
        .users-wrapper

    {
        padding: 24px 18px;
    }

    .top-row {
        align-items: flex-start;
    }

    h2 {
        text-align: center;
    }

    .users-subtitle {
        text-align: center;
    }

    .buttons-row {
        justify-content: center;
    }

    .filter-row {
        justify-content: center;
    }

    }
</style>

<div class="users-wrapper">
    <div class="top-row">
        <div>
            <h2>@pageTitle</h2>
            <div class="users-subtitle">
                Manage user accounts, access levels, and enrollment across the university.
            </div>
        </div>

        <div class="buttons-row">
            <a asp-controller="Admin" asp-action="Dashboard" class="btn btn-back">Back to Dashboard</a>
            <a asp-action="Create" asp-route-roleFilter="@role" class="btn btn-add">Add New User</a>
        </div>
    </div>

    <form method="get" asp-action="Index" class="filter-row">
        <select name="role">
            <option value="All" selected="@(role == "All")">All Roles</option>
            <option value="Admin" selected="@(role == "Admin")">Admins</option>
            <option value="Teacher" selected="@(role == "Teacher")">Teachers</option>
            <option value="Student" selected="@(role == "Student")">Students</option>
        </select>

        <select name="status">
            <option value="All" selected="@(status == "All")">All Statuses</option>
            <option value="Active" selected="@(status == "Active")">Active</option>
            <option value="Inactive" selected="@(status == "Inactive")">Inactive</option>
        </select>

        <input type="text"
               name="search"
               value="@search"
               class="search-input"
               placeholder="Search by ID, name, or email..." />

        <button type="submit" class="btn btn-add">Apply Filter</button>
    </form>

    @if (TempData["Msg"] != null)
    {
        <div class="alert alert-success mt-3">@TempData["Msg"]</div>
    }

    <div class="table-container mt-3">
        <table>
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Full Name</th>
                    <th>Email</th>
                    <th>Role</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var u in Model)
                {
                    string term = search.ToLower();
                    bool highlight =
                    !string.IsNullOrWhiteSpace(term) &&
                    (
                    u.UserID.ToString().Contains(term) ||
                    (u.FullName?.ToLower().Contains(term) ?? false) ||
                    (u.Email?.ToLower().Contains(term) ?? false)
                    );

                    <tr class="@(highlight ? "highlight-row" : "")">
                        <td>@u.UserID</td>
                        <td>@u.FullName</td>
                        <td>@u.Email</td>
                        <td>
                            @(u.RoleID == 1 ? "Admin" :
                                u.RoleID == 2 ? "Teacher" :
                                "Student")
                        </td>
                        <td>
                            <span class="badge @(u.IsActive ? "badge-active" : "badge-inactive")">
                                @(u.IsActive ? "Active" : "Inactive")
                            </span>
                        </td>

                        <td>
                            <a asp-action="Edit"
                               asp-route-id="@u.UserID"
                               asp-route-role="@role"
                               asp-route-status="@status"
                               class="action-btn edit">Edit</a>

                            <a asp-action="Delete"
                               asp-route-id="@u.UserID"
                               asp-route-role="@role"
                               asp-route-status="@status"
                               class="action-btn deactivate">Deactivate</a>

                            @if (u.RoleID == 3)
                            {
                                <a asp-controller="Enrollments"
                                   asp-action="Enroll"
                                   asp-route-studentId="@u.UserID"
                                   asp-route-role="@role"
                                   asp-route-status="@status"
                                   class="action-btn enroll">Enroll</a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<script>
    setTimeout(() => {
        const alerts = document.querySelectorAll('.alert-success');
        alerts.forEach(a => {
            a.style.opacity = '0';
            setTimeout(() => a.remove(), 600);
        });
    }, 3000);
</script>
