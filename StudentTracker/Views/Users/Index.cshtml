@model IEnumerable<StudentTracker.Models.UserView>
@{
    ViewData["Title"] = "Users";

    string role = ViewBag.RoleFilter ?? "All";
    string status = ViewBag.StatusFilter ?? "All";
    string search = ViewBag.SearchTerm ?? "";

    string pageTitle =
        role == "Student" ? "🎓 All Students" :
        role == "Teacher" ? "👨‍🏫 All Teachers" :
        role == "Admin" ? "🧑‍💼 All Admins" :
        "👥 All Users";
}

<style>
    body {
        background: linear-gradient(135deg, #001a33, #003c8f);
        font-family: 'Segoe UI', sans-serif;
        margin: 0;
        padding: 0;
        color: #fff;
    }

    .users-wrapper {
        width: 85%;
        max-width: 1300px;
        margin: 80px auto;
        background: rgba(0, 45, 90, 0.75);
        border-radius: 22px;
        padding: 50px;
        backdrop-filter: blur(30px);
        box-shadow: 0 8px 30px rgba(0, 0, 0, 0.6);
    }

    h2 {
        text-align: center;
        font-size: 2.2rem;
        font-weight: 700;
        margin-bottom: 15px;
        color: #ffffff;
    }

    .buttons-row {
        display: flex;
        justify-content: center;
        gap: 18px;
        margin-bottom: 25px;
        flex-wrap: wrap;
    }

    .btn {
        padding: 12px 28px;
        border-radius: 12px;
        font-weight: 600;
        text-decoration: none;
        transition: 0.3s;
        display: inline-block;
    }

    .btn-back {
        background: rgba(120, 180, 255, 0.25);
        color: #e2eeff;
    }

    .btn-add {
        background: linear-gradient(135deg, #008cff, #005fc4);
        color: #fff;
    }

    .filter-row {
        display: flex;
        justify-content: center;
        flex-wrap: wrap;
        gap: 12px;
        margin-bottom: 25px;
    }

    select,
    .search-input {
        padding: 10px 14px;
        border-radius: 10px;
        border: 1px solid rgba(255, 255, 255, 0.25);
        background: rgba(0, 40, 85, 0.6);
        color: #ffffff;
        font-weight: 600;
        min-width: 180px;
    }

    .table-container {
        overflow-x: auto;
        background: rgba(0, 40, 85, 0.85);
        border-radius: 18px;
        padding: 25px;
        border: 1px solid rgba(255, 255, 255, 0.1);
    }

    table {
        width: 100%;
        border-collapse: collapse;
        color: #fff;
    }

    th, td {
        padding: 14px 16px;
        text-align: center;
        border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    }

    thead {
        background: rgba(0, 90, 170, 0.4);
    }

    .badge {
        padding: 6px 14px;
        border-radius: 10px;
        font-weight: 600;
    }

    .badge-active {
        background: rgba(0, 255, 170, 0.12);
        color: #00e676;
    }

    .badge-inactive {
        background: rgba(255, 100, 100, 0.12);
        color: #ff7b7b;
    }

    .action-btn {
        padding: 6px 14px;
        border-radius: 8px;
        margin: 0 4px;
        font-weight: 600;
        transition: 0.3s;
        display: inline-block;
    }

    .edit {
        color: #4fc3f7;
        background: rgba(79, 195, 247, 0.15);
        border: 1px solid rgba(79, 195, 247, 0.25);
    }

    .delete {
        color: #ef9a9a;
        background: rgba(239, 154, 154, 0.15);
        border: 1px solid rgba(239, 154, 154, 0.25);
    }

    .enroll {
        color: #aee0ff;
        background: rgba(100, 180, 255, 0.15);
        border: 1px solid rgba(100, 180, 255, 0.25);
    }

    .highlight-row {
        background: rgba(255, 255, 0, 0.25) !important;
        transition: background-color 0.4s ease;
    }
</style>

<div class="users-wrapper">
    <h2>@pageTitle</h2>

    <div class="buttons-row">
        <a asp-controller="Admin" asp-action="Dashboard" class="btn btn-back">⬅️ Back to Dashboard</a>
        <a asp-action="Create" asp-route-roleFilter="@role" class="btn btn-add">➕ Add New User</a>
    </div>

    <form method="get" asp-action="Index" class="filter-row">
        <select name="role">
            <option value="All" selected="@(role == "All")">All Roles</option>
            <option value="Admin" selected="@(role == "Admin")">Admins</option>
            <option value="Teacher" selected="@(role == "Teacher")">Teachers</option>
            <option value="Student" selected="@(role == "Student")">Students</option>
        </select>

        <select name="status">
            <option value="All" selected="@(status == "All")">All</option>
            <option value="Active" selected="@(status == "Active")">Active</option>
            <option value="Inactive" selected="@(status == "Inactive")">Inactive</option>
        </select>

        <input type="text" name="search" value="@search" class="search-input" placeholder="Search by ID, name, or email..." />
        <button type="submit" class="btn btn-add">🔍 Apply Filter</button>
    </form>

    @if (TempData["Msg"] != null)
    {
        <div class="alert alert-success">@TempData["Msg"]</div>
    }

    <div class="table-container">
        <table>
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Full Name</th>
                    <th>Email</th>
                    <th>Role</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var u in Model)
                {
                    string term = search.ToLower();
                    bool highlight =
                    !string.IsNullOrWhiteSpace(term) &&
                    (
                    u.UserID.ToString().Contains(term) ||
                    (u.FullName?.ToLower().Contains(term) ?? false) ||
                    (u.Email?.ToLower().Contains(term) ?? false)
                    );

                    <tr class="@(highlight ? "highlight-row" : "")">
                        <td>@u.UserID</td>
                        <td>@u.FullName</td>
                        <td>@u.Email</td>
                        <td>
                            @(u.RoleID == 1 ? "Admin 🧑‍💼" :
                                u.RoleID == 2 ? "Teacher 👨‍🏫" :
                                "Student 🎓")
                        </td>
                        <td>
                            <span class="badge @(u.IsActive ? "badge-active" : "badge-inactive")">
                                @(u.IsActive ? "Active" : "Inactive")
                            </span>
                        </td>

                        <td>
                            <a asp-action="Edit"
                               asp-route-id="@u.UserID"
                               asp-route-role="@role"
                               asp-route-status="@status"
                               class="action-btn edit">✏️ Edit</a>

                            <a asp-action="Delete"
                               asp-route-id="@u.UserID"
                               asp-route-role="@role"
                               asp-route-status="@status"
                               class="action-btn delete">🗑 Delete</a>

                            @if (u.RoleID == 3)
                            {
                                <a asp-controller="Enrollments"
                                   asp-action="Enroll"
                                   asp-route-studentId="@u.UserID"
                                   asp-route-role="@role"
                                   asp-route-status="@status"
                                   class="action-btn enroll">🎓 Enroll</a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<script>
    setTimeout(() => {
        const alerts = document.querySelectorAll('.alert-success');
        alerts.forEach(a => {
            a.style.opacity = '0';
            setTimeout(() => a.remove(), 600);
        });
    }, 3000);
</script>
