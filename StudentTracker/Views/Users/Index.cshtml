@model IEnumerable<StudentTracker.Models.UserView>
@{
    ViewData["Title"] = "Users";
}

<style>
    body {
        background: linear-gradient(135deg, #001a33 0%, #002b66 40%, #003c8f 100%);
        font-family: 'Segoe UI', sans-serif;
        color: #fff;
        margin: 0;
        padding: 0;
    }

    .users-wrapper {
        width: 85%;
        max-width: 1200px;
        margin: 80px auto;
        background: rgba(0, 45, 90, 0.75);
        border-radius: 22px;
        backdrop-filter: blur(30px);
        padding: 50px;
        box-shadow: 0 8px 30px rgba(0, 0, 0, 0.6);
        border: 1px solid rgba(255, 255, 255, 0.05);
    }

    .page-header {
        text-align: center;
        margin-bottom: 40px;
    }

        .page-header h2 {
            font-weight: 700;
            font-size: 2.2rem;
            color: #ffffff;
            text-shadow: 0 0 10px rgba(0, 0, 0, 0.2);
        }

    .buttons-row {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 18px;
        margin-bottom: 20px;
        flex-wrap: wrap;
    }

    .btn {
        display: inline-block;
        padding: 12px 28px;
        border-radius: 12px;
        font-weight: 600;
        border: none;
        text-decoration: none;
        transition: all 0.3s ease;
        font-size: 1rem;
    }

    .btn-back {
        background: rgba(120, 180, 255, 0.25);
        color: #e2eeff;
    }

    .btn-add {
        background: linear-gradient(135deg, #008cff, #005fc4);
        color: #fff;
    }

    .filter-row {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 10px;
        margin-bottom: 25px;
        flex-wrap: wrap;
    }

    select.form-select {
        padding: 10px 36px 10px 14px;
        border-radius: 10px;
        border: 1px solid rgba(255, 255, 255, 0.3);
        background: rgba(0, 40, 85, 0.6);
        color: #ffffff;
        font-weight: 600;
        min-width: 160px;
        appearance: none;
        cursor: pointer;
    }

    .table-container {
        overflow-x: auto;
        background: rgba(0, 40, 85, 0.85);
        border-radius: 18px;
        padding: 25px;
        backdrop-filter: blur(20px);
        border: 1px solid rgba(255, 255, 255, 0.08);
    }

    table {
        width: 100%;
        border-collapse: collapse;
        color: #fff;
    }

    th, td {
        padding: 14px 16px;
        text-align: center;
        border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    }

    thead {
        background: rgba(0, 90, 170, 0.5);
    }

    .badge {
        padding: 6px 14px;
        border-radius: 10px;
        font-weight: 600;
    }

    .bg-success-subtle {
        background: rgba(0, 255, 170, 0.12);
        color: #00e676;
    }

    .bg-danger-subtle {
        background: rgba(255, 100, 100, 0.12);
        color: #ff7b7b;
    }

    .action-btn {
        padding: 6px 14px;
        border-radius: 8px;
        margin: 0 4px;
        font-weight: 600;
        display: inline-block;
        transition: all 0.3s ease;
    }

    .edit {
        color: #4fc3f7;
        background: rgba(79, 195, 247, 0.15);
        border: 1px solid rgba(79, 195, 247, 0.25);
    }

    .delete {
        color: #ef9a9a;
        background: rgba(239, 154, 154, 0.15);
        border: 1px solid rgba(239, 154, 154, 0.25);
    }

    .enroll {
        color: #aee0ff;
        background: rgba(100, 180, 255, 0.15);
        border: 1px solid rgba(100, 180, 255, 0.25);
    }
</style>

<div class="users-wrapper">
    <div class="page-header">
        <h2>
            @(ViewBag.RoleFilter == "Student" ? "🎓 All Students" :
                ViewBag.RoleFilter == "Teacher" ? "👨‍🏫 All Teachers" :
                ViewBag.RoleFilter == "Admin" ? "🧑‍💼 All Admins" :
                "👥 All Users")
        </h2>
    </div>

    <div class="buttons-row">
        <a asp-controller="Admin" asp-action="Dashboard" class="btn btn-back">⬅️ Back to Dashboard</a>
        <a asp-action="Create"
           asp-route-roleFilter="@ViewBag.RoleFilter"
           class="btn btn-add">
            ➕ Add New @(ViewBag.RoleFilter == "Student" ? "Student" :
                        ViewBag.RoleFilter == "Teacher" ? "Teacher" : "User")
        </a>
    </div>

    <form method="get" asp-action="Index" class="filter-row">
        <select name="role" class="form-select w-auto">
            @if (ViewBag.RoleFilter == "All")
            {
                <option value="All" selected>All Roles</option>
            }
            else
            {
                <option value="All">All Roles</option>
            }

            @if (ViewBag.RoleFilter == "Admin")
            {
                <option value="Admin" selected>Admins</option>
            }
            else
            {
                <option value="Admin">Admins</option>
            }

            @if (ViewBag.RoleFilter == "Teacher")
            {
                <option value="Teacher" selected>Teachers</option>
            }
            else
            {
                <option value="Teacher">Teachers</option>
            }

            @if (ViewBag.RoleFilter == "Student")
            {
                <option value="Student" selected>Students</option>
            }
            else
            {
                <option value="Student">Students</option>
            }
        </select>

        <select name="status" class="form-select w-auto">
            @if (ViewBag.StatusFilter == "All")
            {
                <option value="All" selected>All</option>
            }
            else
            {
                <option value="All">All</option>
            }

            @if (ViewBag.StatusFilter == "Active")
            {
                <option value="Active" selected>Active</option>
            }
            else
            {
                <option value="Active">Active</option>
            }

            @if (ViewBag.StatusFilter == "Inactive")
            {
                <option value="Inactive" selected>Inactive</option>
            }
            else
            {
                <option value="Inactive">Inactive</option>
            }
        </select>

        <button type="submit" class="btn btn-add">🔍 Apply Filter</button>
    </form>

    @if (TempData["Msg"] != null)
    {
        <div class="alert alert-success">@TempData["Msg"]</div>
    }

    <div class="table-container">
        <table>
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Full Name</th>
                    <th>Email</th>
                    <th>Role</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var u in Model)
                {
                    <tr>
                        <td>@u.UserID</td>
                        <td>@u.FullName</td>
                        <td>@u.Email</td>
                        <td>
                            @(u.RoleID == 1 ? "Admin 🧑‍💼" :
                                u.RoleID == 2 ? "Teacher 👨‍🏫" :
                                "Student 👩‍🎓")
                        </td>

                        <td>
                            @Html.Raw(u.IsActive
                                     ? "<span class='badge bg-success-subtle'>Active</span>"
                                     : "<span class='badge bg-danger-subtle'>Inactive</span>")
                        </td>

                        <td>
                            <a asp-action="Edit"
                               asp-route-id="@u.UserID"
                               asp-route-role="@ViewBag.RoleFilter"
                               asp-route-status="@ViewBag.StatusFilter"
                               class="action-btn edit">
                                ✏️ Edit
                            </a>

                            <a asp-action="Delete"
                               asp-route-id="@u.UserID"
                               asp-route-role="@ViewBag.RoleFilter"
                               asp-route-status="@ViewBag.StatusFilter"
                               class="action-btn delete">
                                🗑️ Delete
                            </a>

                            @if (u.RoleID == 3)
                            {
                                <a asp-action="Enroll"
                                   asp-route-id="@u.UserID"
                                   asp-route-role="@ViewBag.RoleFilter"
                                   asp-route-status="@ViewBag.StatusFilter"
                                   class="action-btn enroll">
                                    🎓 Enroll
                                </a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<script>
    setTimeout(() => {
        const alertBox = document.querySelector('.alert');
        if (alertBox) {
            alertBox.style.opacity = '0';
            setTimeout(() => alertBox.remove(), 600);
        }
    }, 3000);
</script>
