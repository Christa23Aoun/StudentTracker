@model StudentTracker.Models.UserView
@{
    ViewData["Title"] = "Create New User";
    string roleFilter = ViewBag.RoleFilter ?? "All";
}

<style>
    body {
        background: #f3f6fb;
        font-family: 'Segoe UI', sans-serif;
        color: #0b2540;
        margin: 0;
        padding: 0;
    }

    .create-wrapper {
        max-width: 720px;
        margin: 80px auto;
        padding: 0 16px;
    }

    .create-card {
        background: #ffffff;
        border-radius: 20px;
        padding: 36px 40px;
        box-shadow: 0 18px 40px rgba(15, 23, 42, 0.16);
        border-top: 4px solid #003c8f;
        border-inline: 1px solid rgba(148, 163, 184, 0.35);
        border-bottom: 1px solid rgba(148, 163, 184, 0.35);
    }

    .create-title {
        font-size: 1.6rem;
        font-weight: 700;
        color: #003c8f;
        margin-bottom: 8px;
        text-align: left;
    }

    .create-subtitle {
        font-size: 0.95rem;
        color: #64748b;
        margin-bottom: 24px;
    }

    .form-label {
        font-weight: 600;
        color: #0f172a;
        margin-bottom: 6px;
        font-size: 0.95rem;
    }

    .form-control {
        background: #ffffff;
        border: 1px solid #cbd5e1;
        color: #0f172a;
        border-radius: 10px;
        padding: 10px 12px;
        margin-bottom: 18px;
        transition: all 0.15s ease;
        width: 100%;
        font-size: 0.95rem;
    }

        .form-control:focus {
            border-color: #2563eb;
            box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.25);
            outline: none;
        }

    select.form-control {
        cursor: pointer;
    }

    .form-check {
        margin-bottom: 24px;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .form-check-input {
        width: 18px;
        height: 18px;
        cursor: pointer;
        border-radius: 6px;
        border: 1px solid #94a3b8;
    }

        .form-check-input:checked {
            background-color: #2563eb;
            border-color: #2563eb;
        }

    .form-check-label {
        color: #0f172a;
        font-size: 0.95rem;
        font-weight: 500;
    }

    .btn-row {
        display: flex;
        justify-content: flex-end;
        gap: 12px;
        flex-wrap: wrap;
        margin-top: 8px;
    }

    .btn {
        border-radius: 999px;
        font-weight: 600;
        padding: 10px 26px;
        border: none;
        font-size: 0.95rem;
        cursor: pointer;
        transition: 0.18s ease;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }

    .btn-cancel {
        background: #e2e8f0;
        color: #0f172a;
        border: 1px solid #cbd5e1;
    }

        .btn-cancel:hover {
            background: #cbd5e1;
        }

    .btn-create {
        background: #2563eb;
        color: white;
        border: 1px solid #1d4ed8;
        box-shadow: 0 12px 25px rgba(37, 99, 235, 0.45);
    }

        .btn-create:hover {
            background: #1d4ed8;
        }

    @@media (max-width: 768px) {
        .create-card

    {
        padding: 24px 20px;
    }

    .btn-row {
        justify-content: center;
    }

    }
</style>

<div class="create-wrapper">
    <div class="create-card">
        <h2 class="create-title">Create New User</h2>
        <p class="create-subtitle">Fill in the details below to register a new user into the system.</p>

        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()

            <input type="hidden" name="roleFilter" value="@roleFilter" />

            <label class="form-label">Full Name</label>
            <input asp-for="FullName" class="form-control" />

            <label class="form-label">Email</label>
            <input asp-for="Email" class="form-control" />

            <label class="form-label">Password</label>
            <input asp-for="Password" type="password" class="form-control" />

            <label class="form-label">Select Role</label>
            <select asp-for="RoleID" class="form-control">
@*                 <option value="1">Admin</option>
 *@                <option value="2">Teacher</option>
                <option value="3">Student</option>
            </select>

            <div class="form-check">
                <input asp-for="IsActive" class="form-check-input" />
                <label asp-for="IsActive" class="form-check-label">Active</label>
            </div>

            <div class="btn-row">
                <a asp-action="Index"
                   asp-route-role="@roleFilter"
                   asp-route-status="All"
                   class="btn btn-cancel">
                    Cancel
                </a>

                <button type="submit" class="btn btn-create">
                    Create User
                </button>
            </div>

        </form>
    </div>
</div>
