@model StudentTracker.Models.UserView
@{
    string role = ViewBag.RoleFilter ?? "User";

    string pageTitle =
        role == "Student" ? "➕ Add New Student" :
        role == "Teacher" ? "➕ Add New Teacher" :
                            "➕ Add New User";

    ViewData["Title"] = pageTitle;
}

<style>
    body {
        background: linear-gradient(135deg, #001a33, #003c8f);
        font-family: 'Segoe UI', sans-serif;
        margin: 0;
        padding: 0;
        color: #fff;
    }

    .form-container {
        max-width: 700px;
        margin: 90px auto;
        padding: 45px;
        background: rgba(0, 45, 90, 0.75);
        border-radius: 25px;
        box-shadow: 0 8px 30px rgba(0,0,0,0.6);
        backdrop-filter: blur(25px);
        -webkit-backdrop-filter: blur(25px);
    }

    h2 {
        text-align: center;
        font-weight: 700;
        margin-bottom: 35px;
        color: #aee0ff;
    }

    .form-label {
        font-weight: 600;
        margin-bottom: 6px;
        color: #cfe6ff;
    }

    .form-control {
        background: rgba(255, 255, 255, 0.1);
        border: 1px solid rgba(255, 255, 255, 0.3);
        color: white;
        border-radius: 10px;
        padding: 12px;
        margin-bottom: 18px;
        transition: 0.2s;
        width: 100%;
    }

        .form-control:focus {
            border-color: #2196f3;
            box-shadow: 0 0 10px rgba(33,150,243,0.5);
            outline: none;
        }

        /* 🔥 IMPORTANT FIX — style readonly field */
        .form-control[readonly] {
            background: rgba(255,255,255,0.15) !important;
            color: white !important;
            opacity: 1 !important;
            cursor: not-allowed;
        }

    .form-check-label {
        margin-left: 5px;
        font-weight: 500;
    }

    .btn-row {
        display: flex;
        justify-content: center;
        gap: 20px;
        margin-top: 25px;
    }

    .btn {
        padding: 12px 35px;
        border-radius: 12px;
        font-weight: 600;
        text-decoration: none;
        transition: 0.3s;
        border: none;
        cursor: pointer;
    }

    .btn-success {
        background: linear-gradient(135deg, #00c853, #009624);
        color: white;
    }

        .btn-success:hover {
            background: linear-gradient(135deg, #00e676, #00c853);
            box-shadow: 0 0 12px rgba(0,255,125,0.7);
        }

    .btn-secondary {
        background: rgba(255,255,255,0.15);
        color: #fff;
    }

        .btn-secondary:hover {
            background: rgba(255,255,255,0.3);
        }

    .alert {
        background: rgba(255,80,80,0.2);
        border: 1px solid rgba(255,80,80,0.4);
        color: #ffbaba;
        text-align: center;
        padding: 12px;
        border-radius: 10px;
        margin-bottom: 20px;
    }
</style>

<div class="form-container">
    <h2>@pageTitle</h2>

    @if (ViewBag.Error != null)
    {
        <div class="alert">@ViewBag.Error</div>
    }

   

    @if (ViewBag.Error != null)
    {
        <div class="alert">@ViewBag.Error</div>
    }

    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()

        <input type="hidden" name="roleFilter" value="@role" />

        <label class="form-label">Role</label>
        <input class="form-control" value="@role" readonly />

        <label class="form-label">Full Name</label>
        <input asp-for="FullName" class="form-control" required />
        <span asp-validation-for="FullName" class="text-danger"></span>

        <label class="form-label">Email</label>
        <input asp-for="Email" type="email" class="form-control" required />
        <span asp-validation-for="Email" class="text-danger"></span>

        <label class="form-label">Password</label>
        <input asp-for="Password" type="password" class="form-control" required />
        <span asp-validation-for="Password" class="text-danger"></span>

        @if (role == "Student")
        {
            <input type="hidden" asp-for="RoleID" value="3" />
        }
        else if (role == "Teacher")
        {
            <input type="hidden" asp-for="RoleID" value="2" />
        }
        else if (role == "Admin")
        {
            <input type="hidden" asp-for="RoleID" value="1" />
        }

        <div class="form-check mb-3">
            <input class="form-check-input" asp-for="IsActive" />
            <label class="form-check-label" asp-for="IsActive">Active</label>
        </div>

        <div class="btn-row">
            <button type="submit" class="btn btn-success">💾 Save</button>
            <a asp-action="Index" class="btn btn-secondary">⬅️ Back</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
