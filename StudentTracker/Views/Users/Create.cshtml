@model StudentTracker.Models.UserView
@{
    string role = ViewBag.RoleFilter ?? "User";
    string pageTitle = role == "Student" ? "➕ Add New Student"
                     : role == "Teacher" ? "➕ Add New Teacher"
                     : "➕ Add New User";

    ViewData["Title"] = pageTitle;
}

<style>
    body {
        background: linear-gradient(135deg, #001a33, #003c8f);
        font-family: 'Segoe UI', sans-serif;
        color: #fff;
        margin: 0;
        padding: 0;
    }

    .form-container {
        max-width: 700px;
        margin: 100px auto;
        padding: 50px;
        background: rgba(0, 45, 90, 0.8);
        border-radius: 25px;
        backdrop-filter: blur(25px);
        -webkit-backdrop-filter: blur(25px);
        box-shadow: 0 8px 25px rgba(0, 0, 0, 0.6);
    }

    h2 {
        font-weight: 700;
        text-align: center;
        margin-bottom: 40px;
        color: #ffffff;
    }

    .form-label {
        font-weight: 600;
        color: #cfe6ff;
        margin-bottom: 6px;
    }

    .form-control,
    .form-select {
        background: rgba(255, 255, 255, 0.1);
        border: 1px solid rgba(255, 255, 255, 0.25);
        color: #fff;
        border-radius: 10px;
        padding: 12px;
        margin-bottom: 20px;
        transition: all 0.2s ease;
        width: 100%;
    }

        .form-select option {
            background-color: #00284d;
            color: #fff;
            font-weight: 500;
            padding: 10px;
        }

        .form-control:focus,
        .form-select:focus {
            border-color: #2196f3;
            box-shadow: 0 0 12px rgba(33,150,243,0.6);
            outline: none;
        }

    .alert {
        background: rgba(255, 80, 80, 0.15);
        border: 1px solid rgba(255, 80, 80, 0.3);
        border-radius: 10px;
        color: #ffbaba;
        margin-bottom: 20px;
        text-align: center;
        padding: 10px;
    }

    .btn-row {
        display: flex;
        justify-content: center;
        gap: 20px;
        margin-top: 30px;
    }

    .btn {
        border: none;
        border-radius: 12px;
        font-weight: 600;
        padding: 12px 35px;
        transition: 0.3s;
        cursor: pointer;
    }

    .btn-success {
        background: linear-gradient(135deg, #00c853, #009624);
        color: #fff;
    }

    .btn-secondary {
        background: rgba(255,255,255,0.15);
        color: #ddd;
    }
</style>

<div class="form-container">
    <h2>@pageTitle</h2>

    @if (ViewBag.Error != null)
    {
        <div class="alert">@ViewBag.Error</div>
    }

    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()

        <!-- PASS ROLE FILTER -->
        <input type="hidden" name="roleFilter" value="@role" />

        <!-- SHOW ROLE (NOT EDITABLE) -->
        <label class="form-label">Role</label>
        <input class="form-control"
               value="@role"
               disabled
               style="background:white; color:black;" />

        <label class="form-label">Full Name</label>
        <input asp-for="FullName" class="form-control" required />

        <label class="form-label">Email</label>
        <input asp-for="Email" type="email" class="form-control" required />

        <label class="form-label">Password</label>
        <input asp-for="Password" type="password" class="form-control" required />

        <!-- HIDDEN REAL ROLE -->
        @if (role == "Student")
        {
            <input type="hidden" asp-for="RoleID" value="3" />
        }
        else if (role == "Teacher")
        {
            <input type="hidden" asp-for="RoleID" value="2" />
        }

        <div class="form-check mb-3">
            <input class="form-check-input" asp-for="IsActive" />
            <label class="form-check-label">Active</label>
        </div>

        <div class="btn-row">
            <button type="submit" class="btn btn-success">💾 Save</button>
            <a asp-action="Index" class="btn btn-secondary">⬅️ Back</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
