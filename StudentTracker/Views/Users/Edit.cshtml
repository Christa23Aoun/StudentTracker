@model StudentTracker.Models.UserView

@{
    string roleName =
        Model.RoleID == 1 ? "Admin" :
        Model.RoleID == 2 ? "Teacher" :
        "Student";

    ViewData["Title"] = $"Edit {roleName}";
}

<style>
    body {
        background: linear-gradient(135deg, #001a33, #003c8f);
        font-family: 'Segoe UI', sans-serif;
        color: #fff;
        margin: 0;
        padding: 0;
    }

    .form-container {
        max-width: 700px;
        margin: 100px auto;
        padding: 50px;
        background: rgba(0, 45, 90, 0.8);
        border-radius: 25px;
        backdrop-filter: blur(25px);
        -webkit-backdrop-filter: blur(25px);
        box-shadow: 0 8px 25px rgba(0, 0, 0, 0.6);
    }

    h2 {
        font-weight: 700;
        text-align: center;
        margin-bottom: 40px;
        color: #ffffff;
    }

    .form-label {
        font-weight: 600;
        color: #cfe6ff;
        margin-bottom: 6px;
    }

    .form-control {
        background: rgba(255, 255, 255, 0.1);
        border: 1px solid rgba(255, 255, 255, 0.25);
        color: #fff;
        border-radius: 10px;
        padding: 12px;
        margin-bottom: 20px;
        transition: all 0.2s ease;
        width: 100%;
    }

        .form-control:focus {
            border-color: #2196f3;
            box-shadow: 0 0 12px rgba(33,150,243,0.6);
            outline: none;
        }

    .disabled-field {
        background: rgba(255, 255, 255, 0.1) !important;
        color: #fff !important;
        border: 1px solid rgba(255, 255, 255, 0.25);
        cursor: not-allowed;
    }

    .btn-row {
        display: flex;
        justify-content: center;
        gap: 20px;
        margin-top: 30px;
    }

    .btn {
        border: none;
        border-radius: 12px;
        font-weight: 600;
        padding: 12px 35px;
        transition: all 0.3s ease;
        cursor: pointer;
    }

    .btn-success {
        background: linear-gradient(135deg, #00c853, #009624);
        color: #fff;
    }

        .btn-success:hover {
            background: linear-gradient(135deg, #00e676, #00c853);
            box-shadow: 0 0 15px rgba(0, 255, 120, 0.6);
        }

    .btn-secondary {
        background: rgba(255, 255, 255, 0.15);
        color: #ddd;
    }

        .btn-secondary:hover {
            background: rgba(255, 255, 255, 0.25);
        }
</style>

<div class="form-container">
    <h2>✏️ Edit @roleName</h2>

    <form asp-action="Edit" method="post">

        <input type="hidden" asp-for="UserID" />
        <input type="hidden" asp-for="RoleID" />

        <label class="form-label">Full Name</label>
        <input asp-for="FullName" class="form-control" required />

        <label class="form-label">Email</label>
        <input asp-for="Email" class="form-control" type="email" required />

        <label class="form-label">Role</label>
        <input class="form-control disabled-field" value="@roleName" disabled />

        <div class="form-check mt-3">
            <input class="form-check-input" asp-for="IsActive" />
            <label class="form-check-label" asp-for="IsActive">Active</label>
        </div>

        <div class="btn-row">
            <a asp-action="Index" class="btn btn-secondary">⬅️ Back</a>
            <button type="submit" class="btn btn-success">💾 Save Changes</button>
        </div>

    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
