@model StudentTracker.Models.TeacherDashboardView
@{
    ViewData["Title"] = "Teacher Dashboard";
}

<style>
    body {
        background: #f5f7fa;
        margin: 0;
        padding: 0;
        font-family: 'Inter', sans-serif;
        color: #1a2b4c;
    }

    .dashboard-container {
        width: 92%;
        max-width: 1300px;
        margin: 70px auto;
    }

    .dashboard-header {
        text-align: left;
        margin-bottom: 40px;
        border-left: 5px solid #003c8f;
        padding-left: 18px;
    }

        .dashboard-header h1 {
            font-size: 36px;
            font-weight: 800;
            margin: 0;
            color: #003c8f;
        }

        .dashboard-header p {
            font-size: 16px;
            color: #5b6e80;
            margin-top: 6px;
        }

    .dashboard-cards {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
        gap: 30px;
    }

    .card {
        background: #ffffff;
        border: 1px solid #d9e1ec;
        border-radius: 6px;
        padding: 28px;
        text-decoration: none;
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        transition: 0.25s ease;
        box-shadow: 0px 4px 10px rgba(0, 0, 0, 0.06);
        cursor: pointer;
    }

    .dashboard-cards .card:first-child:hover {
        transform: none;
        box-shadow: none;
        border-color: #d9e1ec;
    }


        .card:hover {
            border-color: #003c8f;
            transform: translateY(-4px);
            box-shadow: 0px 6px 16px rgba(0, 0, 0, 0.10);
        }

    .card-title {
        font-size: 14px;
        text-transform: uppercase;
        font-weight: 600;
        color: #5e6a78;
        letter-spacing: 0.5px;
        margin-bottom: 6px;
    }

    .card-value {
        font-size: 32px;
        font-weight: 800;
        color: #003c8f;
    }

    .card::before {
        content: "";
        display: block;
        height: 4px;
        width: 100%;
        background: #003c8f;
        border-radius: 2px 2px 0 0;
        margin-bottom: 18px;
    }

    .section-title {
        margin-top: 60px;
        font-size: 26px;
        font-weight: 700;
        color: #003c8f;
        border-left: 5px solid #003c8f;
        padding-left: 12px;
        margin-bottom: 25px;
        text-align: left;
    }

    .course-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
        gap: 25px;
        margin-top: 20px;
    }

    .course-card {
        background: white;
        border: 1px solid #d9e1ec;
        border-radius: 6px;
        padding: 22px 20px;
        box-shadow: 0px 4px 10px rgba(0, 0, 0, 0.06);
        transition: 0.25s ease;
        cursor: pointer;
    }

        .course-card:hover {
            border-color: #003c8f;
            transform: translateY(-4px);
            box-shadow: 0px 6px 16px rgba(0, 0, 0, 0.10);
        }

    .course-code {
        font-size: 18px;
        font-weight: 700;
        color: #003c8f;
    }

    .course-name {
        font-size: 16px;
        color: #1a2b4c;
        margin-top: 6px;
    }
</style>

<div class="dashboard-container">

    <div class="dashboard-header">
        <h1>Teacher Dashboard</h1>
        <p>Welcome <strong>@Model.TeacherName</strong>. Manage your classes and students efficiently.</p>
        <small style="color:#5b6e80;">@Model.TeacherEmail</small>
    </div>

    <div class="dashboard-cards">
        <div class="card">
            <div class="card-title">My Courses</div>
            <div class="card-value">@Model.TotalCourses</div>
        </div>
    </div>

    <div class="section-title">My Courses</div>

    @if (Model.Courses != null && Model.Courses.Any())
    {
        <div class="course-grid">
            @foreach (var c in Model.Courses)
            {
                <div class="course-card" onclick="window.location.href='@Url.Action("CourseDetails", "Teacher", new { id = c.CourseID })'">
                    <div class="course-code">@c.CourseCode</div>
                    <div class="course-name">@c.CourseName</div>
                </div>
            }
        </div>
    }
    else
    {
        <p style="color:#5b6e80; margin-top:10px;">No courses found.</p>
    }

</div>
