@model StudentTracker.Models.TeacherDashboardView
@{
    ViewData["Title"] = "Teacher Dashboard";
}

<style>
    body {
        background: linear-gradient(135deg, #001f3f, #003c8f);
        font-family: 'Segoe UI', sans-serif;
        color: #fff;
        margin: 0;
        padding: 0;
    }

    .teacher-dashboard-wrapper {
        padding: 70px 0;
        text-align: center;
    }

    .teacher-dashboard-header {
        margin-bottom: 40px;
    }

        .teacher-dashboard-header h2 {
            font-weight: 700;
            font-size: 2.3rem;
            color: #fff;
        }

        .teacher-dashboard-header p {
            color: #cfd8dc;
            font-size: 1.1rem;
            margin-top: 10px;
        }

    .summary-cards {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
        gap: 25px;
        width: 90%;
        max-width: 1100px;
        margin: 0 auto 40px auto;
    }

    .card {
        background: rgba(255, 255, 255, 0.12);
        backdrop-filter: blur(14px);
        border-radius: 20px;
        padding: 30px 20px;
        border: 1px solid rgba(255, 255, 255, 0.25);
        transition: all 0.3s ease;
        color: #fff;
        box-shadow: 0 8px 25px rgba(0, 0, 0, 0.4);
    }

        .card:hover {
            transform: translateY(-8px);
            box-shadow: 0 12px 35px rgba(0, 0, 0, 0.6), 0 0 25px rgba(0, 191, 255, 0.4);
        }

    .courses {
        border-top: 4px solid #2196f3;
    }

    .course-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
        gap: 25px;
        width: 90%;
        max-width: 1100px;
        margin: 40px auto;
    }

    .course-card {
        background: rgba(255, 255, 255, 0.1);
        border-radius: 16px;
        padding: 35px 25px;
        cursor: pointer;
        transition: 0.3s;
        box-shadow: 0 6px 18px rgba(0, 0, 0, 0.4);
        border: 1px solid rgba(255, 255, 255, 0.2);
    }

        .course-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 12px 25px rgba(0, 0, 0, 0.6);
            background: rgba(255, 255, 255, 0.18);
        }

    .course-code {
        font-size: 1.4rem;
        font-weight: 700;
        color: #90caf9;
    }

    .course-name {
        font-size: 1.1rem;
        color: #fff;
        margin-top: 8px;
    }
</style>

<div class="teacher-dashboard-wrapper">
    <div class="teacher-dashboard-header">
        <h2>👨‍🏫 Teacher Dashboard</h2>
        <p>Welcome back, <strong>@Model.TeacherName</strong> — managing your classes and students efficiently.</p>
        <small class="text-light opacity-75">@Model.TeacherEmail</small>
    </div>

    <div class="summary-cards">
        <div class="card courses">
            <h5>📘 My Courses</h5>
            <h3>@Model.TotalCourses</h3>
        </div>
    </div>

    <h4 style="margin-top:40px;">📚 My Courses</h4>

    @if (Model.Courses != null && Model.Courses.Any())
    {
        <div class="course-grid">
            @foreach (var c in Model.Courses)
            {
                <div class="course-card"
                     onclick="window.location.href='@Url.Action("CourseDetails", "Teacher", new { id = c.CourseID })'">
                    <div class="course-code">@c.CourseCode</div>
                    <div class="course-name">@c.CourseName</div>
                </div>
            }
        </div>
    }
    else
    {
        <p class="text-light opacity-75 text-center mt-4">
            No courses found for this teacher.
        </p>
    }
</div>
