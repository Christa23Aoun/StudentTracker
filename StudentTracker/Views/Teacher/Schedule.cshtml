@model List<StudentTracker.Models.TeacherScheduleItemView>
@using Microsoft.AspNetCore.Mvc.Rendering

@{
    ViewData["Title"] = "My Teaching Schedule";

    int? selectedSemesterId = ViewBag.SelectedSemesterId as int?;
    DateTime weekStart = (DateTime)ViewBag.WeekStart;
    DateTime weekEnd = (DateTime)ViewBag.WeekEnd;

    var semesterOptions = ViewBag.SemesterOptions as List<SelectListItem> ?? new();

    int startHour = 8;
    int endHour = 19;
    int endMinute = 30;

    int slotMinutes = 15;
    int slotHeightPx = 24;

    int startTotalMinutes = startHour * 60;
    int endTotalMinutes = endHour * 60 + endMinute;

    int totalSlots = (endTotalMinutes - startTotalMinutes) / slotMinutes;
    int columnHeightPx = totalSlots * slotHeightPx;

    var weekDates = Enumerable.Range(0, 7)
        .Select(i => weekStart.AddDays(i))
        .ToList();
}

<style>
    body {
        background: #f2f4fb;
        font-family: 'Segoe UI', sans-serif;
    }

    .schedule-wrapper {
        max-width: 1600px;
        margin: 40px auto;
        padding: 20px;
    }

    .schedule-header {
        background: white;
        border-radius: 16px;
        padding: 24px 30px;
        margin-bottom: 24px;
        box-shadow: 0 12px 28px rgba(15,23,42,.12);
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        flex-wrap: wrap;
    }

    .schedule-title h2 {
        margin: 0;
        font-size: 1.7rem;
        color: #0d4b84;
        font-weight: 800;
    }

    .schedule-title span {
        display: block;
        font-size: .9rem;
        color: #475569;
        margin-top: 4px;
    }

    .schedule-filters {
        display: flex;
        gap: 12px;
        align-items: center;
        flex-wrap: wrap;
    }

        .schedule-filters select,
        .schedule-filters input[type="date"] {
            height: 42px;
            border-radius: 10px;
            border: 1px solid #cbd5f5;
            padding: 0 12px;
            font-size: .9rem;
            background: #f8fafc;
        }

        .schedule-filters button {
            height: 42px;
            border-radius: 10px;
            border: none;
            padding: 0 22px;
            background: #0d4b84;
            color: white;
            font-weight: 700;
            cursor: pointer;
        }

    .calendar {
        display: grid;
        grid-template-columns: 90px repeat(7, 1fr);
        background: white;
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 14px 30px rgba(15,23,42,.12);
    }

    .calendar-header {
        background: #0d4b84;
        color: white;
        text-align: center;
        padding: 14px;
        font-weight: 700;
        font-size: .95rem;
    }

        .calendar-header small {
            display: block;
            font-size: .75rem;
            opacity: .85;
            margin-top: 3px;
        }

    .time-col {
        background: #f8fafc;
    }

    .time-slot {
        height: 24px;
        font-size: .72rem;
        color: #475569;
        text-align: right;
        padding-right: 8px;
        border-bottom: 1px solid #e2e8f0;
        display: flex;
        align-items: center;
        justify-content: flex-end;
    }

    .day-col {
        position: relative;
        height: @(columnHeightPx) px;
        border-left: 1px solid #e2e8f0;
        background: repeating-linear-gradient( to bottom, #ffffff, #ffffff 23px, #e2e8f0 24px );
    }

    .event {
        position: absolute;
        left: 6px;
        right: 6px;
        border-radius: 14px;
        padding: 10px 12px;
        color: white;
        font-size: .8rem;
        font-weight: 700;
        background: #2563eb;
        box-shadow: 0 8px 18px rgba(2,6,23,.18);
    }

        .event .code {
            font-size: .75rem;
            opacity: .9;
            margin-top: 2px;
        }

        .event .time {
            font-size: .72rem;
            margin-top: 4px;
            opacity: .95;
        }
</style>

<div class="schedule-wrapper">

    <div class="schedule-header">
        <div class="schedule-title">
            <h2>📅 Teaching Schedule</h2>
            <span>Week of @weekStart.ToString("dd MMM yyyy") – @weekEnd.ToString("dd MMM yyyy")</span>
        </div>

        <form method="get" asp-controller="Teacher" asp-action="Schedule" class="schedule-filters">
            <select name="semesterId" asp-items="semesterOptions"></select>
            <input type="date" name="weekStart" value="@weekStart.ToString("yyyy-MM-dd")" />
            <button type="submit">Show</button>
        </form>
    </div>

    <div class="calendar">
        <div></div>

        @foreach (var d in weekDates)
        {
            <div class="calendar-header">
                @d.ToString("dddd")
                <small>@d.ToString("dd MMM")</small>
            </div>
        }

        <div class="time-col">
            @for (int i = 0; i < totalSlots; i++)
            {
                int t = startTotalMinutes + (i * slotMinutes);
                <div class="time-slot">@($"{t / 60:D2}:{t % 60:D2}")</div>
            }
        </div>

        @foreach (var date in weekDates)
        {
            <div class="day-col">
                @foreach (var s in Model.Where(x => x.SessionDate.Date == date.Date))
                {
                    int startMinutes = (int)s.StartTime.TotalMinutes - startTotalMinutes;
                    int durationMinutes = (int)(s.EndTime - s.StartTime).TotalMinutes;

                    int topPx = (startMinutes / slotMinutes) * slotHeightPx;
                    int heightPx = Math.Max(slotHeightPx, (durationMinutes / slotMinutes) * slotHeightPx);

                    <div class="event" style="top:@(topPx)px; height:@(heightPx)px;">
                        <div>@s.CourseName</div>
                        <div class="code">@s.CourseCode</div>
                        <div class="time">
                            @s.StartTime.ToString(@"hh\:mm") – @s.EndTime.ToString(@"hh\:mm")
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>
