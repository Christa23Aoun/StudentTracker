@model List<StudentTracker.Models.StudentCourseView>

@{
    ViewData["Title"] = "Students in Course";
}

<style>
    body {
        background: #f5f7fa;
        margin: 0;
        padding: 0;
        font-family: 'Inter', sans-serif;
        color: #1a2b4c;
    }

    .wrapper {
        width: 92%;
        max-width: 1100px;
        margin: 70px auto;
    }

    .page-header {
        text-align: left;
        margin-bottom: 35px;
        border-left: 5px solid #003c8f;
        padding-left: 18px;
    }

        .page-header h1 {
            font-size: 32px;
            font-weight: 800;
            margin: 0;
            color: #003c8f;
        }

    table {
        width: 100%;
        background: #ffffff;
        border-collapse: collapse;
        border: 1px solid #d9e1ec;
        border-radius: 6px;
        overflow: hidden;
        box-shadow: 0px 4px 10px rgba(0,0,0,0.06);
    }

    th {
        background: #003c8f;
        color: white;
        padding: 14px;
        font-size: 15px;
        font-weight: 600;
        text-align: center;
    }

    td {
        padding: 14px;
        text-align: center;
        border-bottom: 1px solid #edf2f7;
        color: #1a2b4c;
    }

    tr:hover {
        background: #f0f6ff;
    }

    .back-btn {
        margin-top: 30px;
        display: inline-block;
        background: #5b6e80;
        padding: 12px 20px;
        border-radius: 6px;
        text-decoration: none;
        color: white;
        font-weight: 600;
        transition: 0.25s ease;
    }

        .back-btn:hover {
            background: #445664;
        }
</style>

<div class="wrapper">

    <div class="page-header">
        <h1>Students Enrolled</h1>
    </div>

    <table>
        <thead>
            <tr>
                <th>#</th>
                <th>Student Name</th>
            </tr>
        </thead>

        <tbody>
            @if (Model.Any())
            {
                int i = 1;
                foreach (var s in Model)
                {
                    <tr>
                        <td>@i</td>
                        <td>@s.StudentName</td>
                    </tr>
                    i++;
                }
            }
            else
            {
                <tr>
                    <td colspan="2" style="padding:20px; color:#5b6e80;">
                        No students enrolled in this course.
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <a class="back-btn"
       asp-controller="Teacher"
       asp-action="CourseDetails"
       asp-route-id="@ViewBag.CourseID">
        ⬅ Back to Course
    </a>

</div>
