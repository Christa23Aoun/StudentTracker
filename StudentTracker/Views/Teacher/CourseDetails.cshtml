@model StudentTracker.Models.CourseDetailsView
@{
    ViewData["Title"] = $"{Model.CourseName} Details";
}

<style>
    body {
        background: #f5f7fa;
        margin: 0;
        padding: 0;
        font-family: 'Inter', sans-serif;
        color: #1a2b4c;
    }

    .course-container {
        width: 92%;
        max-width: 1300px;
        margin: 70px auto;
    }

    .course-header {
        text-align: left;
        margin-bottom: 40px;
        border-left: 5px solid #003c8f;
        padding-left: 18px;
    }

        .course-header h1 {
            font-size: 32px;
            font-weight: 800;
            margin: 0;
            color: #003c8f;
        }

        .course-header p {
            font-size: 16px;
            color: #5b6e80;
            margin-top: 6px;
        }

    .info-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
        gap: 30px;
        margin-top: 30px;
    }

    .info-card {
        background: #ffffff;
        border: 1px solid #d9e1ec;
        border-radius: 6px;
        padding: 25px;
        text-align: left;
        box-shadow: 0px 4px 10px rgba(0, 0, 0, 0.06);
        transition: 0.25s ease;
    }

        .info-card:hover {
            border-color: #003c8f;
            transform: translateY(-4px);
            box-shadow: 0px 6px 16px rgba(0, 0, 0, 0.10);
        }

    .info-card-title {
        font-size: 14px;
        text-transform: uppercase;
        font-weight: 600;
        color: #5e6a78;
        margin-bottom: 5px;
        letter-spacing: 0.5px;
    }

    .info-card-value {
        font-size: 28px;
        font-weight: 800;
        color: #003c8f;
        margin-top: 4px;
    }

    .info-link {
        text-decoration: none;
        color: inherit;
    }

    .actions-section {
        margin-top: 60px;
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
        gap: 20px;
    }

    .action-btn {
        background: #003c8f;
        color: white;
        padding: 14px 22px;
        border-radius: 6px;
        text-align: center;
        font-weight: 600;
        display: inline-block;
        transition: 0.25s ease;
        text-decoration: none;
    }

        .action-btn:hover {
            background: #002a6a;
        }

    .back-btn {
        background: #5b6e80;
    }

        .back-btn:hover {
            background: #425060;
        }
</style>

<div class="course-container">

    <div class="course-header">
        <h1>@Model.CourseName (@Model.CourseCode)</h1>
        <p>@Model.DepartmentName — @Model.SemesterName</p>
    </div>

    <div class="info-grid">

        <div class="info-card">
            <div class="info-card-title">Average Grade</div>
            <div class="info-card-value">@Model.AverageGrade.ToString("0.0") %</div>
        </div>

        <div class="info-card">
            <div class="info-card-title">Attendance Rate</div>
            <div class="info-card-value">@Model.AttendanceRate.ToString("0.0") %</div>
        </div>

        <a class="info-link"
           asp-controller="Teacher"
           asp-action="StudentsInCourse"
           asp-route-courseId="@Model.CourseID">
            <div class="info-card">
                <div class="info-card-title">Students Enrolled</div>
                <div class="info-card-value">@Model.StudentCount</div>
            </div>
        </a>

    </div>

    <div class="actions-section">

        <a asp-controller="Attendance"
           asp-action="Index"
           asp-route-courseId="@Model.CourseID"
           class="action-btn">
            View Attendance
        </a>

        <a asp-controller="Tests"
           asp-action="Index"
           asp-route-courseId="@Model.CourseID"
           class="action-btn">
            View Tests
        </a>

        <a asp-controller="TestGrades"
           asp-action="Index"
           asp-route-courseId="@Model.CourseID"
           class="action-btn">
            View Grades
        </a>

        <a asp-controller="Teacher"
           asp-action="Dashboard"
           class="action-btn back-btn">
            ⬅ Back to Dashboard
        </a>

    </div>
</div>
