@model StudentTracker.Models.CourseView
@{
    ViewData["Title"] = $"{Model.CourseName} Details";
}

<style>
    body {
        background: linear-gradient(135deg, #001f3f, #003c8f);
        font-family: 'Segoe UI', sans-serif;
        color: #fff;
        margin: 0;
        padding: 0;
    }

    .course-details-wrapper {
        padding: 60px 5%;
        text-align: center;
    }

    .course-header {
        margin-bottom: 40px;
    }

        .course-header h2 {
            font-size: 2rem;
            font-weight: 700;
            margin-bottom: 10px;
        }

        .course-header p {
            color: #cfd8dc;
            margin: 0;
        }

    .course-info {
        display: flex;
        justify-content: center;
        flex-wrap: wrap;
        gap: 25px;
        margin-bottom: 40px;
    }

    .info-card {
        background: rgba(255, 255, 255, 0.1);
        border-radius: 14px;
        padding: 25px 40px;
        min-width: 200px;
        border: 1px solid rgba(255, 255, 255, 0.2);
        box-shadow: 0 5px 15px rgba(0,0,0,0.4);
    }

        .info-card h4 {
            margin: 0;
            color: #90caf9;
        }

    .students-table {
        width: 90%;
        max-width: 900px;
        margin: 40px auto;
        border-collapse: collapse;
        background: rgba(255, 255, 255, 0.08);
        border-radius: 10px;
        overflow: hidden;
    }

        .students-table th, .students-table td {
            padding: 12px 15px;
            text-align: center;
            color: #f5faff;
        }

        .students-table th {
            background: rgba(255, 255, 255, 0.15);
            color: #bbdefb;
        }

        .students-table tr:hover {
            background: rgba(255, 255, 255, 0.1);
        }

    .actions {
        margin-top: 40px;
        display: flex;
        justify-content: center;
        gap: 15px;
    }

    .btn {
        background: #2196f3;
        color: white;
        padding: 10px 18px;
        border-radius: 8px;
        text-decoration: none;
        transition: 0.3s;
    }

        .btn:hover {
            background: #1769aa;
        }
</style>

<div class="course-details-wrapper">
    <div class="course-header">
        <h2>@Model.CourseName (@Model.CourseCode)</h2>
        <p>@Model.DepartmentName — Semester: @Model.SemesterName</p>
    </div>

    <div class="course-info">
        <div class="info-card">
            <h4>📊 Average Grade</h4>
            <p>@Model.AverageGrade %</p>
        </div>
        <div class="info-card">
            <h4>🕒 Attendance Rate</h4>
            <p>@Model.AttendanceRate %</p>
        </div>
        <div class="info-card">
            <h4>👩‍🎓 Students</h4>
            <p>@Model.StudentCount</p>
        </div>
    </div>

    <h4>👩‍🏫 Students in this course</h4>
    <table class="students-table">
        <thead>
            <tr>
                <th>Student</th>
                <th>Average</th>
                <th>Attendance</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Students != null && Model.Students.Any())
            {
                foreach (var s in Model.Students)
                {
                    <tr>
                        <td>@s.StudentName</td>
                        <td>@(s.AverageGrade > 0 ? $"{s.AverageGrade:0.##}%" : "—")</td>
                        <td>@(s.AttendanceRate > 0 ? $"{s.AttendanceRate:0.##}%" : "—")</td>
                    </tr>
                }
            }
            else
            {
                <tr><td colspan="3">No students enrolled yet.</td></tr>
            }
        </tbody>
    </table>

    <div class="actions">
        <a href="#" class="btn">Mark Attendance</a>
        <a href="#" class="btn">Add Test</a>
        <a href="#" class="btn">View Grades</a>
        <a href="@Url.Action("Dashboard", "Teacher")" class="btn" style="background:#555;">Back</a>
    </div>
</div>
