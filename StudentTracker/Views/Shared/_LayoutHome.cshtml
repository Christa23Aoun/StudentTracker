<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - WTF University</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet" />

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <link rel="stylesheet" href="~/css/styles.css" asp-append-version="true" />
</head>
<body>
    <div class="topbar">
        <div class="container topbar-inner">
            <div class="topbar-left">
                <span><i class="fa-solid fa-phone"></i> +961 70 413 003</span>
                <span><i class="fa-solid fa-envelope"></i> info@wtf.edu.lb</span>
            </div>
        </div>
    </div>

    <header class="site-header">
        <div class="container nav">
            <div class="brand">
                <div class="brand-title">WTF</div>
                <div class="brand-sub">We’re The Future (Inshallah)</div>
            </div>

            <nav class="main-nav">
                <a asp-controller="Home" asp-action="Index">Home</a>
                <a asp-controller="Site" asp-action="About">About</a>
                <a asp-controller="Site" asp-action="Faculties">Faculties</a>
                <a asp-controller="Site" asp-action="Admissions">Admissions</a>
                <a asp-controller="Site" asp-action="Research">Research</a>
                <a asp-controller="Site" asp-action="StudentLife">Student Life</a>
            </nav>

            <div class="nav-actions">

               

                @{
                    var userId = Context.Session.GetInt32("UserID");
                }

                @if (userId != null)
                {
                    if (User.IsInRole("Admin"))
                    {
                        <a class="btn primary me-2" asp-controller="Admin" asp-action="Dashboard">View Dashboard</a>
                    }
                    else if (User.IsInRole("Teacher"))
                    {
                        <a class="btn primary me-2" asp-controller="Teacher" asp-action="Dashboard">View Dashboard</a>
                    }
                    else if (User.IsInRole("Student"))
                    {
                        <a class="btn primary me-2" asp-controller="StudentDashboard" asp-action="Index">View Dashboard</a>
                    }

                    <a asp-controller="Notifications"
                       asp-action="Index"
                       class="me-3"
                       style="color:white; font-size:1.3rem;">
                        <i class="fa-solid fa-bell"></i>
                    </a>

                    <form asp-controller="Auth" asp-action="Logout" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-outline-light">
                            Logout
                        </button>
                    </form>
                }
                else
                {
                    <div class="connect-dropdown">
                        <button class="btn primary" id="connectBtn" type="button">Connect</button>
                        <div class="connect-menu" id="connectMenu">
                            <a href="/Auth/LoginTeacher">👨‍🏫 Teacher</a>
                            <a href="/Auth/LoginStudent">🎓 Student</a>
                        </div>
                    </div>
                }

                <button class="menu-toggle">☰</button>
            </div>
        </div>
    </header>

    <main role="main">
        @RenderBody()
    </main>

    <footer class="uni-footer">
        <div class="container footer-grid">

            <div class="footer-col brand-col">
                <h3 class="footer-logo">WTF</h3>
                <p class="footer-sub">We’re The Future (Inshallah)</p>
                <p class="footer-tagline">Building Tomorrow, Today</p>
            </div>

            <div class="footer-col">
                <h4 class="footer-title">Quick Links</h4>
                <ul class="footer-links">
                    <li><a asp-controller="Home" asp-action="Index">Home</a></li>
                    <li><a asp-controller="Site" asp-action="About">About</a></li>
                    <li><a asp-controller="Site" asp-action="Faculties">Faculties</a></li>
                    <li><a asp-controller="Site" asp-action="Admissions">Admissions</a></li>
                    <li><a asp-controller="Site" asp-action="Research">Research</a></li>
                    <li><a asp-controller="Site" asp-action="StudentLife">Student Life</a></li>
                </ul>
            </div>

            <div class="footer-col">
                <h4 class="footer-title">Contact Us</h4>
                <ul class="footer-contact">
                    <li><i class="fa-solid fa-phone"></i> +961 70 413 000</li>
                    <li><i class="fa-solid fa-envelope"></i> info@wtf.edu.lb</li>
                    <li><i class="fa-solid fa-location-dot"></i> Beirut, Lebanon</li>
                </ul>
                <br /><br />
                <div class="footer-social">
                    <a href="#"><i class="fa-brands fa-facebook-f"></i></a>
                    <a href="#"><i class="fa-brands fa-instagram"></i></a>
                    <a href="#"><i class="fa-brands fa-linkedin-in"></i></a>
                    <a href="https://wa.me/96170413009" target="_blank"><i class="fa-brands fa-whatsapp"></i></a>
                    <a href="#"><i class="fa-brands fa-tiktok"></i></a>
                </div>
            </div>

        </div>

        <div class="footer-bottom">
            © 2025 WTF University – All Rights Reserved.
        </div>
    </footer>


    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/app.js"></script>

    <script>
        document.getElementById('connectBtn')?.addEventListener('click', function (e) {
            const menu = document.getElementById('connectMenu');
            if (!menu) return;
            menu.classList.toggle('show');
            this.setAttribute('aria-expanded', menu.classList.contains('show') ? 'true' : 'false');
            e.stopPropagation();
        });

        window.addEventListener('click', function (e) {
            const menu = document.getElementById('connectMenu');
            const btn = document.getElementById('connectBtn');
            if (menu && btn && !btn.contains(e.target) && !menu.contains(e.target)) {
                menu.classList.remove('show');
                btn.setAttribute('aria-expanded', 'false');
            }
        });

        document.querySelectorAll('#connectMenu a').forEach(a => {
            a.addEventListener('click', () => {
                document.getElementById('connectMenu')?.classList.remove('show');
                document.getElementById('connectBtn')?.setAttribute('aria-expanded', 'false');
            });
        });
    </script>

    <style>
        :root {
            --footerBlueDark: #0a3252;
            --footerBlueMid: #0d3f66;
            --footerBlueLight: #1e6fa8;
            --footerText: #e6f1ff;
            --footerMuted: #b8d4ee;
            --footerBorder: rgba(255,255,255,.16);
            --footerCard: rgba(255,255,255,.08);
            --footerCardBorder: rgba(255,255,255,.14);
        }

        .uni-footer {
            background: linear-gradient(180deg, var(--footerBlueMid), var(--footerBlueDark)) !important;
            padding: 60px 0 22px 0;
            color: var(--footerText) !important;
            font-family: 'Inter', sans-serif;
        }

        .footer-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
            gap: 34px;
            align-items: start;
        }

        /* Make footer columns feel cleaner/modern */
        .footer-col {
            background: transparent;
        }

        /* WTF smaller */
        .footer-logo {
            font-size: 1.65rem;
            font-weight: 850;
            margin: 0 0 10px 0;
            letter-spacing: 0.8px;
            color: #ffffff;
        }

        /* "We're The Future" bigger */
        .footer-sub {
            margin: 0;
            font-size: 1.35rem;
            font-weight: 850;
            line-height: 1.25;
            color: #ffffff;
        }

        .footer-tagline {
            margin-top: 12px;
            font-size: 0.95rem;
            color: var(--footerMuted);
        }

        .footer-title {
            font-size: 1.08rem;
            color: #ffffff;
            margin: 0 0 14px;
            font-weight: 800;
            letter-spacing: -0.2px;
        }

        .footer-links {
            list-style: none;
            padding: 0;
            margin: 0;
        }

            .footer-links li {
                margin-bottom: 10px;
            }

            .footer-links a {
                color: var(--footerMuted);
                text-decoration: none;
                font-weight: 650;
                transition: color .2s ease, transform .2s ease;
                display: inline-flex;
                align-items: center;
                gap: 8px;
            }

                .footer-links a:hover {
                    color: #ffffff;
                    transform: translateX(2px);
                }

        .footer-contact {
            list-style: none;
            padding: 0;
            margin: 0 0 14px 0;
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

            .footer-contact li {
                color: var(--footerMuted);
                font-weight: 650;
                display: flex;
                align-items: center;
                gap: 10px;
            }

            /* Icon pills */
            .footer-contact i {
                width: 34px;
                height: 34px;
                border-radius: 12px;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                background: var(--footerCard);
                border: 1px solid var(--footerCardBorder);
                color: #9ed4ff;
                margin-right: 0;
                font-size: 0.95rem;
                flex: 0 0 auto;
            }

        .footer-social {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
        }

            .footer-social a {
                width: 42px;
                height: 42px;
                border-radius: 14px;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                background: var(--footerCard);
                border: 1px solid var(--footerCardBorder);
                color: #e6f1ff;
                transition: transform .15s ease, background .15s ease, border-color .15s ease;
                text-decoration: none;
            }

                .footer-social a:hover {
                    transform: translateY(-2px);
                    background: rgba(255,255,255,.12);
                    border-color: rgba(255,255,255,.22);
                }

        .footer-bottom {
            text-align: center;
            padding-top: 18px;
            margin-top: 30px;
            border-top: 1px solid var(--footerBorder);
            font-size: 0.92rem;
            color: var(--footerMuted);
            background: transparent !important;
            opacity: 1;
        }

        @@media (max-width: 520px) {
            .uni-footer {
                padding: 46px 0 18px 0;
            }

            .footer-sub {
                font-size: 1.18rem;
            }

            .footer-logo {
                font-size: 1.5rem;
            }
        }
    </style>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
