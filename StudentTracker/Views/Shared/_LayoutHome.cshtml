<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - WTF University</title>

   
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet" />

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <link rel="stylesheet" href="~/css/styles.css" asp-append-version="true" />
</head>
<body>
    <div class="topbar">
        <div class="container topbar-inner">
            <div class="topbar-left">
                <span><i class="fa-solid fa-phone"></i> +961 70 413 003</span>
                <span><i class="fa-solid fa-envelope"></i> info@wtf.edu.lb</span>
            </div>
        </div>
    </div>

    <header class="site-header">
        <div class="container nav">
            <div class="brand">
                <div class="brand-title">WTF</div>
                <div class="brand-sub">We’re The Future (Inshallah)</div>
            </div>

            <nav class="main-nav" aria-label="Primary">
                <a asp-controller="Site" asp-action="About">About</a>
                <a asp-controller="Site" asp-action="Faculties">Faculties</a>
                <a asp-controller="Site" asp-action="Admissions">Admissions</a>
                <a asp-controller="Site" asp-action="Research">Research</a>
                <a asp-controller="Site" asp-action="StudentLife">Student Life</a>
              
            </nav>

            <div class="nav-actions">
                <div class="lang-switch">
                    <button class="lang active">EN</button>
                    <span>|</span>
                    <button class="lang">FR</button>
                </div>

                <div class="connect-dropdown">
                    <button class="btn primary" id="connectBtn" type="button" aria-expanded="false">Connect</button>
                    <div class="connect-menu" id="connectMenu">
                        <a href="/Auth/LoginTeacher">👨‍🏫 Teacher</a>
                        <a href="/Auth/LoginStudent">🎓 Student</a>
                    </div>
                </div>

                <button class="menu-toggle" aria-label="Open menu">☰</button>
            </div>
        </div>
    </header>

    <main role="main">
        @RenderBody()
    </main>

 
    <footer class="footer">
        <div class="container footer-inner">
            <div class="footer-brand">
                <h3>WTF</h3>
                <p class="tagline">We’re The Future (Inshallah)</p>
                <p class="motto">Building Tomorrow, Today</p>
            </div>

            <div class="footer-links">
                <h4>Quick Links</h4>
                <ul>
                    <a asp-controller="Site" asp-action="About">About</a>
                    <a asp-controller="Site" asp-action="Faculties">Faculties</a>
                    <a asp-controller="Site" asp-action="Admissions">Admissions</a>
                    <a asp-controller="Site" asp-action="Research">Research</a>
                    <a asp-controller="Site" asp-action="StudentLife">Student Life</a>

                </ul>
            </div>

            <div class="footer-contact">
                <h4>Contact Us</h4>
                <p><i class="fa-solid fa-phone"></i> +961 70 413 000</p>
                <p><i class="fa-solid fa-envelope"></i> info@wtf.edu.lb</p>
                <p><i class="fa-solid fa-location-dot"></i> Beirut, Lebanon</p>
                <div class="footer-social">
                    <a href="#" aria-label="Facebook"><i class="fa-brands fa-facebook-f"></i></a>
                    <a href="#" aria-label="Instagram"><i class="fa-brands fa-instagram"></i></a>
                    <a href="#" aria-label="LinkedIn"><i class="fa-brands fa-linkedin-in"></i></a>
                    <a href="https://wa.me/96170413009" target="_blank" aria-label="WhatsApp">
                        <i class="fa-brands fa-whatsapp"></i>
                    </a>
                    <a href="#" aria-label="TikTok"><i class="fa-brands fa-tiktok"></i></a>
                </div>
            </div>
        </div>

        <div class="footer-bottom">
            <p>© 2025 WTF University – All Rights Reserved.</p>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/app.js"></script>

    <script>
        document.getElementById('connectBtn')?.addEventListener('click', function (e) {
            const menu = document.getElementById('connectMenu');
            if (!menu) return;
            menu.classList.toggle('show');
            this.setAttribute('aria-expanded', menu.classList.contains('show') ? 'true' : 'false');
            e.stopPropagation();
        });

        window.addEventListener('click', function (e) {
            const menu = document.getElementById('connectMenu');
            const btn = document.getElementById('connectBtn');
            if (menu && btn && !btn.contains(e.target) && !menu.contains(e.target)) {
                menu.classList.remove('show');
                btn.setAttribute('aria-expanded', 'false');
            }
        });

        document.querySelectorAll('#connectMenu a').forEach(a => {
            a.addEventListener('click', () => {
                document.getElementById('connectMenu')?.classList.remove('show');
                document.getElementById('connectBtn')?.setAttribute('aria-expanded', 'false');
            });
        });
    </script>
    <style>
        html, body {
            height: 100%;
            margin: 0;
            display: flex;
            flex-direction: column;
            background: #fff;
        }

        main {
            flex: 1;
        }

        footer.footer {
            margin-top: auto !important;
            position: relative !important;
            bottom: 0 !important;
            width: 100% !important;
            border-top: none !important;
            background: #0a3252 !important; 
            color: #fff;
            box-shadow: none !important;
        }

        .footer-bottom {
            border-top: none !important;
            background: transparent !important;
            box-shadow: none !important;
        }
    </style>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
