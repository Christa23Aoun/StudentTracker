<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - WTF University</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet" />

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <link rel="stylesheet" href="~/css/styles.css" asp-append-version="true" />
</head>
<body>
    <div class="topbar">
        <div class="container topbar-inner">
            <div class="topbar-left">
                <span><i class="fa-solid fa-phone"></i> +961 70 413 003</span>
                <span><i class="fa-solid fa-envelope"></i> info@wtf.edu.lb</span>
            </div>
        </div>
    </div>

    <header class="site-header">
        <div class="container nav">
            <div class="brand">
                <div class="brand-title">WTF</div>
                <div class="brand-sub">We’re The Future (Inshallah)</div>
            </div>

            <nav class="main-nav" aria-label="Primary">
                <a asp-controller="Home" asp-action="Index">Home</a>
                <a asp-controller="Site" asp-action="About">About</a>
                <a asp-controller="Site" asp-action="Faculties">Faculties</a>
                <a asp-controller="Site" asp-action="Admissions">Admissions</a>
                <a asp-controller="Site" asp-action="Research">Research</a>
                <a asp-controller="Site" asp-action="StudentLife">Student Life</a>
            </nav>

            <div class="nav-actions">
                <div class="lang-switch">
                    <button class="lang active">EN</button>
                    <span>|</span>
                    <button class="lang">FR</button>
                </div>

                <div class="connect-dropdown">
                    <button class="btn primary" id="connectBtn" type="button" aria-expanded="false">Connect</button>
                    <div class="connect-menu" id="connectMenu">
                        <a href="/Auth/LoginTeacher">👨‍🏫 Teacher</a>
                        <a href="/Auth/LoginStudent">🎓 Student</a>
                    </div>
                </div>

                <button class="menu-toggle" aria-label="Open menu">☰</button>
            </div>
        </div>
    </header>

    <main role="main">
        @RenderBody()
    </main>
    <footer class="uni-footer">
        <div class="container footer-grid">

            <!-- Brand -->
            <div class="footer-col brand-col">
                <h3 class="footer-logo">WTF</h3>
                <p class="footer-sub">We’re The Future (Inshallah)</p>
                <p class="footer-tagline">Building Tomorrow, Today</p>
            </div>

            <!-- Quick links -->
            <div class="footer-col">
                <h4 class="footer-title">Quick Links</h4>
                <ul class="footer-links">
                    <li><a asp-controller="Home" asp-action="Index">Home</a></li>
                    <li><a asp-controller="Site" asp-action="About">About</a></li>
                    <li><a asp-controller="Site" asp-action="Faculties">Faculties</a></li>
                    <li><a asp-controller="Site" asp-action="Admissions">Admissions</a></li>
                    <li><a asp-controller="Site" asp-action="Research">Research</a></li>
                    <li><a asp-controller="Site" asp-action="StudentLife">Student Life</a></li>
                </ul>
            </div>

            <!-- Contact -->
            <div class="footer-col">
                <h4 class="footer-title">Contact Us</h4>
                <ul class="footer-contact">
                    <li><i class="fa-solid fa-phone"></i> +961 70 413 000</li>
                    <li><i class="fa-solid fa-envelope"></i> info@wtf.edu.lb</li>
                    <li><i class="fa-solid fa-location-dot"></i> Beirut, Lebanon</li>
                </ul>
                </br></br>
                <div class="footer-social">
                    <a href="#"><i class="fa-brands fa-facebook-f"></i></a>
                    <a href="#"><i class="fa-brands fa-instagram"></i></a>
                    <a href="#"><i class="fa-brands fa-linkedin-in"></i></a>
                    <a href="https://wa.me/96170413009" target="_blank"><i class="fa-brands fa-whatsapp"></i></a>
                    <a href="#"><i class="fa-brands fa-tiktok"></i></a>
                </div>
            </div>

        </div>

        <div class="footer-bottom">
            © 2025 WTF University – All Rights Reserved.
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/app.js"></script>

    <script>
        document.getElementById('connectBtn')?.addEventListener('click', function (e) {
            const menu = document.getElementById('connectMenu');
            if (!menu) return;
            menu.classList.toggle('show');
            this.setAttribute('aria-expanded', menu.classList.contains('show') ? 'true' : 'false');
            e.stopPropagation();
        });

        window.addEventListener('click', function (e) {
            const menu = document.getElementById('connectMenu');
            const btn = document.getElementById('connectBtn');
            if (menu && btn && !btn.contains(e.target) && !menu.contains(e.target)) {
                menu.classList.remove('show');
                btn.setAttribute('aria-expanded', 'false');
            }
        });

        document.querySelectorAll('#connectMenu a').forEach(a => {
            a.addEventListener('click', () => {
                document.getElementById('connectMenu')?.classList.remove('show');
                document.getElementById('connectBtn')?.setAttribute('aria-expanded', 'false');
            });
        });
    </script>

    <!-- FINAL FIX: force footer to match header -->
    <style>
        /* ========= NEW FOOTER DESIGN ========= */

        .uni-footer {
            background: #0a3252 !important; /* SAME color as topbar */
            padding: 60px 0 30px 0;
            color: #fff !important;
            font-family: 'Inter', sans-serif;
        }

        .footer-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
            gap: 40px;
        }

        /* Brand column */
        .footer-logo {
            font-size: 2.2rem;
            font-weight: 800;
            margin-bottom: 6px;
        }

        .footer-sub {
            font-size: 0.95rem;
            opacity: 0.85;
        }

        .footer-tagline {
            margin-top: 10px;
            font-size: 0.9rem;
            opacity: 0.65;
        }

        /* Column titles */
        .footer-title {
            font-size: 1.1rem;
            color: #cfe6ff;
            margin-bottom: 12px;
            font-weight: 700;
        }

        /* Links */
        .footer-links {
            list-style: none;
            padding: 0;
            margin: 0;
        }

            .footer-links li {
                margin-bottom: 8px;
            }

            .footer-links a {
                color: #e8f1ff;
                text-decoration: none;
                font-weight: 500;
                transition: 0.25s;
            }

                .footer-links a:hover {
                    color: #00baff;
                    padding-left: 4px;
                }

        /* Contact list */
        .footer-contact {
            list-style: none;
            padding: 0;
            margin: 0 0 10px 0;
        }

            .footer-contact li {
                margin-bottom: 8px;
                opacity: 0.85;
            }

            .footer-contact i {
                margin-right: 6px;
                color: #86c8ff;
            }

        /* Social icons */
        .footer-social a {
            margin-right: 10px;
            font-size: 1.1rem;
            color: #86c8ff;
            transition: 0.3s;
        }

            .footer-social a:hover {
                color: #00baff;
                transform: translateY(-2px);
            }

        /* Bottom bar */
        .footer-bottom {
            text-align: center;
            padding-top: 25px;
            margin-top: 30px;
            border-top: 1px solid rgba(255,255,255,0.15);
            font-size: 0.9rem;
            opacity: 0.75;
            background: #0a3252 !important; /* same color */

        }

        footer.footer {
            margin-top: auto !important;
            position: relative !important;
            bottom: 0 !important;
            width: 100% !important;
            border-top: none !important;
            background: linear-gradient(135deg, #002b66, #003c8f) !important;
            color: #fff;
            box-shadow: none !important;
        }

        .footer-bottom {
            border-top: none !important;
            background: linear-gradient(135deg, #002b66, #003c8f) !important;
            color: #fff;
        }

    </style>


    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
