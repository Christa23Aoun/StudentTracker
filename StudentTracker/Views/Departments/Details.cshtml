@model StudentTracker.Models.DepartmentView
@{
    ViewData["Title"] = "Department Details";
}

<style>
    body {
        background: #eef3ff;
        font-family: 'Segoe UI', sans-serif;
        margin: 0;
        padding: 0;
        color: #0b2540;
    }

    .details-container {
        width: 85%;
        max-width: 1000px;
        margin: 70px auto;
        background: rgba(255, 255, 255, 0.65);
        border-radius: 25px;
        padding: 50px;
        backdrop-filter: blur(25px);
        box-shadow: 0 15px 40px rgba(15, 23, 42, 0.12);
        border: 1px solid rgba(148, 163, 184, 0.3);
    }

    .header-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 40px;
    }

    h1 {
        font-weight: 800;
        margin: 0;
        color: #124f9c;
    }

    .btn-back {
        padding: 10px 22px;
        border-radius: 10px;
        background: linear-gradient(135deg, #0f6ae6, #124f9c);
        color: white;
        text-decoration: none;
        font-weight: 600;
        transition: 0.2s ease;
    }

        .btn-back:hover {
            opacity: 0.9;
            transform: translateY(-2px);
        }

    .info-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
        gap: 18px;
        margin-bottom: 35px;
    }

    .info-card {
        background: rgba(255, 255, 255, 0.65);
        padding: 20px;
        border-radius: 15px;
        border: 1px solid rgba(148, 163, 184, 0.3);
        box-shadow: 0 8px 20px rgba(15, 23, 42, 0.08);
    }

    .label {
        color: #64748b;
        font-weight: 600;
        margin-bottom: 5px;
        display: block;
    }

    .value {
        font-size: 1.05rem;
        font-weight: 700;
        color: #0b2540;
    }

    .badge {
        padding: 6px 12px;
        border-radius: 8px;
        font-weight: 700;
        font-size: 0.85rem;
    }

    .bg-success {
        background: #e7f9ef;
        color: #15803d;
    }

    .bg-danger {
        background: #ffe8e8;
        color: #b91c1c;
    }

    .courses-list {
        background: rgba(255, 255, 255, 0.65);
        border-radius: 15px;
        padding: 25px;
        border: 1px solid rgba(148, 163, 184, 0.3);
        box-shadow: 0 8px 20px rgba(15, 23, 42, 0.08);
    }

        .courses-list h3 {
            color: #124f9c;
            font-weight: 700;
            margin-bottom: 15px;
        }

        .courses-list ul {
            list-style: none;
            padding: 0;
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
            gap: 10px;
        }

        .courses-list li {
            background: #f3f7ff;
            padding: 10px;
            border-radius: 10px;
            text-align: center;
            font-weight: 600;
            color: #124f9c;
        }
</style>

<div class="details-container">

    <div class="header-row">
        <h1>Department Details</h1>
        <a asp-controller="Admin" asp-action="Dashboard" class="btn-back">Back</a>
    </div>

    <div class="info-grid">
        <div class="info-card">
            <span class="label">Department ID</span>
            <span class="value">@Model.DepartmentID</span>
        </div>

        <div class="info-card">
            <span class="label">Department Name</span>
            <span class="value">@Model.DepartmentName</span>
        </div>

        <div class="info-card">
            <span class="label">Status</span>
            @if (Model.IsActive)
            {
                <span class="badge bg-success">Active</span>
            }
            else
            {
                <span class="badge bg-danger">Inactive</span>
            }
        </div>

        <div class="info-card">
            <span class="label">Created At</span>
            <span class="value">@Model.CreatedAt.ToString("yyyy-MM-dd")</span>
        </div>

        <div class="info-card">
            <span class="label">Total Courses</span>
            <span class="value">@Model.CourseCount</span>
        </div>
    </div>

    <div class="courses-list">
        <h3>Courses in this Department</h3>

        @if (!string.IsNullOrWhiteSpace(Model.CourseNames))
        {
            <ul>
                @foreach (var course in Model.CourseNames.Split(',', StringSplitOptions.RemoveEmptyEntries))
                {
                    <li>@course.Trim()</li>
                }
            </ul>
        }
        else
        {
            <p>No courses found.</p>
        }
    </div>

</div>
