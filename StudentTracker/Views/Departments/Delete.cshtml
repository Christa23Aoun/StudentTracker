@model StudentTracker.Models.DepartmentView
@{
    ViewData["Title"] = "Delete Department";
}

<style>
    body {
        background: #eef3ff;
        font-family: 'Segoe UI', sans-serif;
        margin: 0;
        padding: 0;
        color: #0b2540;
    }

    .delete-container {
        max-width: 700px;
        margin: 100px auto;
        padding: 50px;
        background: rgba(255, 255, 255, 0.7);
        border-radius: 25px;
        backdrop-filter: blur(20px);
        border: 1px solid rgba(148, 163, 184, 0.35);
        box-shadow: 0 15px 40px rgba(15, 23, 42, 0.12);
        text-align: center;
    }

    h2 {
        font-weight: 800;
        color: #d84646;
        margin-bottom: 25px;
    }

    .alert-warning {
        background: rgba(255, 235, 200, 0.6);
        border: 1px solid rgba(255, 193, 7, 0.3);
        border-radius: 12px;
        color: #8a6d3b;
        padding: 18px;
        margin-bottom: 30px;
        font-size: 1rem;
        font-weight: 600;
    }

    .btn-row {
        display: flex;
        justify-content: center;
        gap: 20px;
    }

    .btn {
        border: none;
        border-radius: 12px;
        padding: 12px 35px;
        font-weight: 700;
        cursor: pointer;
        transition: 0.2s;
        color: white;
    }

    .btn-secondary {
        background: #8fa7c6;
    }

        .btn-secondary:hover {
            opacity: 0.85;
        }

    .btn-danger {
        background: #d63b3b;
    }

        .btn-danger:hover {
            opacity: 0.85;
        }
</style>

<div class="delete-container">
    <h2>Delete Department</h2>

    <div class="alert-warning">
        Are you sure you want to delete the department:
        <strong>@Model.DepartmentName</strong> ?
    </div>

    <form asp-action="Delete" method="post">
        @Html.AntiForgeryToken()

        <input type="hidden" asp-for="DepartmentID" />

        <div class="btn-row">
            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
            <button type="submit" class="btn btn-danger">Delete</button>
        </div>
    </form>
</div>
