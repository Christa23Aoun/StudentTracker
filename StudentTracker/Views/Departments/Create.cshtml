@model StudentTracker.Models.DepartmentView
@{
    ViewData["Title"] = "Create Department";
}

<style>
    body {
        background: #f5f7fb;
        font-family: 'Segoe UI', sans-serif;
        margin: 0;
        padding: 0;
        color: #0b2540;
    }

    .page-wrapper {
        max-width: 700px;
        margin: 70px auto;
        padding: 0 30px 40px;
    }

    .glass-card {
        background: #ffffff;
        border-radius: 18px;
        padding: 28px 26px 26px;
        box-shadow: 0 14px 45px rgba(15, 23, 42, 0.14);
        border: 1px solid rgba(148, 163, 184, 0.3);
    }

    h2 {
        font-size: 1.8rem;
        font-weight: 800;
        color: #003c8f;
        margin-bottom: 8px;
        text-align: left;
    }

    .subtitle {
        font-size: 0.95rem;
        color: #64748b;
        margin-bottom: 22px;
    }

    label {
        font-weight: 600;
        font-size: 0.9rem;
        margin-bottom: 6px;
        display: block;
        color: #0b2540;
    }

    .form-control {
        width: 100%;
        padding: 10px 13px;
        border-radius: 12px;
        border: 1px solid #cbd5e1;
        font-size: 0.95rem;
        margin-bottom: 6px;
        background: #f9fbff;
    }

    .text-danger {
        font-size: 0.8rem;
    }

    .btn-row {
        display: flex;
        justify-content: flex-end;
        gap: 12px;
        margin-top: 22px;
        flex-wrap: wrap;
    }

    .btn {
        border-radius: 999px;
        padding: 10px 22px;
        font-weight: 600;
        font-size: 0.94rem;
        cursor: pointer;
        text-decoration: none;
        border: 1px solid transparent;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        transition: 0.2s ease;
    }

    .btn-primary {
        background: linear-gradient(135deg, #0f6ae6, #124f9c);
        color: #ffffff;
        box-shadow: 0 12px 32px rgba(15, 118, 210, 0.45);
    }

        .btn-primary:hover {
            background: linear-gradient(135deg, #2563eb, #124f9c);
        }

    .btn-secondary {
        background: #e2e8f0;
        color: #1e293b;
        border-color: #cbd5e1;
    }

        .btn-secondary:hover {
            background: #cbd5e1;
        }
</style>

<div class="page-wrapper">
    <div class="glass-card">
        <h2>Create Department</h2>
        <p class="subtitle">
            Add a new academic department to the university structure.
        </p>

        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()

            <div>
                <label>Department Name</label>
                <input asp-for="DepartmentName"
                       class="form-control"
                       placeholder="e.g. Computer Science, Business Administration" />
                <span asp-validation-for="DepartmentName" class="text-danger"></span>
            </div>

            <div class="btn-row">
                <a asp-action="Index" class="btn btn-secondary">
                    Cancel
                </a>
                <button type="submit" class="btn btn-primary">
                    Create Department
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
