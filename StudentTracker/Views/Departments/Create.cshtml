@model StudentTracker.Models.DepartmentView
@{
    ViewData["Title"] = "Create Department";
}

<style>
    body {
        background: linear-gradient(135deg, #001a33, #003c8f);
        font-family: 'Segoe UI', sans-serif;
        color: #fff;
        margin: 0;
        padding: 0;
    }

    .form-container {
        width: 60%;
        max-width: 600px;
        margin: 80px auto;
        background: rgba(0, 45, 90, 0.8);
        border-radius: 22px;
        padding: 40px;
        backdrop-filter: blur(25px);
        -webkit-backdrop-filter: blur(25px);
        box-shadow: 0 8px 30px rgba(0, 0, 0, 0.6);
    }

    h2 {
        text-align: center;
        font-weight: 700;
        margin-bottom: 30px;
    }

    label {
        font-weight: 600;
        display: block;
        margin-bottom: 6px;
    }

    input.form-control, textarea.form-control {
        width: 100%;
        padding: 10px;
        border-radius: 10px;
        border: none;
        margin-bottom: 20px;
    }

    textarea.form-control {
        height: 100px;
        resize: none;
    }

    .btn-submit {
        background: linear-gradient(135deg, #008cff, #005fc4);
        color: #fff;
        font-weight: 600;
        border: none;
        padding: 12px 25px;
        border-radius: 10px;
        transition: all 0.3s ease;
    }

        .btn-submit:hover {
            background: linear-gradient(135deg, #005fc4, #008cff);
            transform: translateY(-2px);
        }

    .btn-back {
        background: rgba(255, 255, 255, 0.15);
        color: #fff;
        padding: 10px 20px;
        border-radius: 10px;
        text-decoration: none;
        margin-top: 10px;
        display: inline-block;
    }

        .btn-back:hover {
            background: rgba(255, 255, 255, 0.25);
            transform: translateY(-2px);
        }
</style>

<div class="form-container">
    <h2>➕ Add New Department</h2>

    <form asp-action="Create" method="post">
        <label>Department Name</label>
        <input asp-for="DepartmentName" class="form-control" placeholder="Enter department name" />
        <span asp-validation-for="DepartmentName" class="text-danger"></span>

       
       
        <button type="submit" class="btn-submit">Create</button>
        <a asp-action="Index" class="btn-back">⬅ Back</a>
    </form>
</div>
