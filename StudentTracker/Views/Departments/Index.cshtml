@model IEnumerable<StudentTracker.Models.DepartmentView>
@{
    ViewData["Title"] = "Departments";
}

<style>
    body {
        background: linear-gradient(135deg, #001a33, #003c8f);
        font-family: 'Segoe UI', sans-serif;
        color: #fff;
        margin: 0;
        padding: 0;
    }

    .departments-container {
        width: 85%;
        max-width: 1200px;
        margin: 80px auto;
        background: rgba(0, 45, 90, 0.75);
        border-radius: 22px;
        backdrop-filter: blur(25px);
        -webkit-backdrop-filter: blur(25px);
        padding: 50px;
        box-shadow: 0 8px 30px rgba(0, 0, 0, 0.6);
    }

    .header-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 30px;
        flex-wrap: wrap;
        gap: 10px;
    }

    h1 {
        font-weight: 700;
        margin: 0;
    }

    .btn-dashboard {
        display: inline-block;
        padding: 10px 22px;
        border-radius: 10px;
        background: linear-gradient(135deg, #008cff, #005fc4);
        color: #fff;
        font-weight: 600;
        text-decoration: none;
        transition: all 0.3s ease;
    }

        .btn-dashboard:hover {
            background: linear-gradient(135deg, #005fc4, #008cff);
            transform: translateY(-2px);
        }

    table {
        width: 100%;
        border-collapse: collapse;
        color: #fff;
        text-align: center;
    }

    th, td {
        padding: 14px;
        border-bottom: 1px solid rgba(255, 255, 255, 0.15);
    }

    thead {
        background: rgba(0, 90, 170, 0.5);
    }

    tr:hover {
        background: rgba(255, 255, 255, 0.05);
    }

    .badge {
        display: inline-block;
        padding: 6px 12px;
        border-radius: 8px;
        font-weight: 600;
    }

    .bg-success {
        background: rgba(0, 255, 170, 0.15);
        color: #00e676;
    }

    .bg-danger {
        background: rgba(255, 100, 100, 0.15);
        color: #ff7b7b;
    }

    .info-buttons {
        display: flex;
        justify-content: center;
        gap: 10px;
    }

    .btn-info {
        display: inline-block;
        padding: 6px 14px;
        border-radius: 8px;
        background: linear-gradient(135deg, #007bff, #005fc4);
        color: #fff;
        font-weight: 600;
        text-decoration: none;
        transition: all 0.3s ease;
    }

        .btn-info:hover {
            background: linear-gradient(135deg, #005fc4, #007bff);
            transform: translateY(-2px);
        }

    .btn-delete {
        display: inline-block;
        padding: 6px 14px;
        border-radius: 8px;
        background: linear-gradient(135deg, #ff4d4d, #c62828);
        color: #fff;
        font-weight: 600;
        text-decoration: none;
        transition: all 0.3s ease;
    }

        .btn-delete:hover {
            background: linear-gradient(135deg, #c62828, #ff4d4d);
            transform: translateY(-2px);
        }
</style>

<div class="departments-container">
    <div class="header-row">
        <h1>🏛 Departments Overview</h1>
        <div>
            <a asp-controller="Admin" asp-action="Dashboard" class="btn-dashboard">⬅️ Back to Dashboard</a>
            <a asp-action="Create" class="btn-dashboard">➕ Add Department</a>
        </div>
    </div>

    <table>
        <thead>
            <tr>
                <th>ID</th>
                <th>Department Name</th>
                <th>Status</th>
                <th>Course Count</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                foreach (var d in Model)
                {
                    <tr>
                        <td>@d.DepartmentID</td>
                        <td>@d.DepartmentName</td>
                        <td>
                            @if (d.IsActive)
                            {
                                <span class="badge bg-success">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Inactive</span>
                            }
                        </td>
                        <td>@d.CourseCount</td>
                        <td>
                            <div class="info-buttons">
                                <a asp-action="Details" asp-route-id="@d.DepartmentID" class="btn-info">ℹ️ Info</a>
                                <a asp-action="Delete" asp-route-id="@d.DepartmentID" class="btn-delete">🗑️ Delete</a>
                            </div>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="6" class="text-muted py-4">No departments found.</td>
                </tr>
            }
        </tbody>
    </table>
</div>
