@model IEnumerable<StudentTracker.Models.DepartmentView>
@{
    ViewData["Title"] = "Departments";
}

<style>
    body {
        background: #f5f7fb;
        font-family: 'Segoe UI', sans-serif;
        margin: 0;
        padding: 0;
        color: #0b2540;
    }

    .page-wrapper {
        max-width: 1200px;
        margin: 60px auto;
        padding: 0 30px;
    }

    .header-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 30px;
        flex-wrap: wrap;
        gap: 15px;
    }

    h1 {
        font-size: 2rem;
        font-weight: 800;
        color: #003c8f;
        margin: 0;
    }

    .btn-main {
        padding: 11px 26px;
        background: linear-gradient(135deg, #0f6ae6, #124f9c);
        color: #fff;
        border-radius: 12px;
        text-decoration: none;
        font-weight: 600;
        transition: .2s;
        display: inline-block;
        text-align: center;
    }

        .btn-main:hover {
            background: linear-gradient(135deg, #2563eb, #124f9c);
            transform: translateY(-2px);
        }

    .glass-card {
        background: #ffffff;
        border-radius: 16px;
        padding: 25px;
        box-shadow: 0 12px 40px rgba(15, 23, 42, 0.12);
        border: 1px solid rgba(148, 163, 184, 0.25);
    }

    .table-responsive {
        width: 100%;
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
    }

    table {
        width: 100%;
        min-width: 700px;
        border-collapse: collapse;
        margin-top: 10px;
    }

    thead {
        background: #124f9c;
        color: #ffffff;
    }

    th, td {
        padding: 14px 16px;
        text-align: center;
        border-bottom: 1px solid #e2e8f0;
        font-size: .95rem;
    }

    tbody tr:hover {
        background: #eef4ff;
    }

    .badge-active {
        background: #e9fdf1;
        color: #15803d;
        padding: 5px 12px;
        border-radius: 10px;
        font-weight: 600;
        font-size: .85rem;
    }

    .badge-inactive {
        background: #fef2f2;
        color: #b91c1c;
        padding: 5px 12px;
        border-radius: 10px;
        font-weight: 600;
        font-size: .85rem;
    }

    .actions a {
        margin: 0 5px;
        padding: 7px 14px;
        border-radius: 8px;
        font-weight: 600;
        text-decoration: none;
        font-size: .85rem;
        white-space: nowrap;
        display: inline-block;
    }

    .btn-info {
        background: #e0ecff;
        color: #003c8f;
    }

        .btn-info:hover {
            background: #c7dbff;
        }

    .btn-delete {
        background: #fee2e2;
        color: #b91c1c;
    }

        .btn-delete:hover {
            background: #fcbcbc;
        }


   @@media (max-width: 768px) {
        .page-wrapper

    {
        padding: 0 12px;
        margin: 30px auto;
    }

    .glass-card {
        padding: 16px;
        border-radius: 14px;
    }

    .header-row {
        flex-direction: column;
        align-items: stretch;
    }

        .header-row > div {
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

    .btn-main {
        width: 100%;
    }

    th, td {
        font-size: 0.85rem;
        padding: 10px;
    }

    .actions a {
        margin: 4px 0;
    }

    }

    .btn-deactivate {
        background: #fff7ed;
        color: #9a3412;
        border: 1px solid #fed7aa;
        padding: 7px 14px;
        border-radius: 8px;
        font-weight: 600;
        font-size: .85rem;
        cursor: pointer;
        transition: all .2s ease;
    }

        .btn-deactivate:hover {
            background: #ffedd5;
        }

    .btn-reactivate {
        background: #ecfdf5;
        color: #065f46;
        border: 1px solid #6ee7b7;
        padding: 7px 14px;
        border-radius: 8px;
        font-weight: 600;
        font-size: .85rem;
        cursor: pointer;
        transition: all .2s ease;
    }

        .btn-reactivate:hover {
            background: #d1fae5;
        }

    tbody td {
        color: #0b2540; 
    }

    tr.inactive-row td {
        color: #94a3b8;
    }

    tr.active-row td {
        color: #0b2540;
    }

    .btn-reactivate {
        background: #ecfeff;
        color: #0369a1;
        border: 1px solid #bae6fd;
        padding: 7px 14px;
        border-radius: 8px;
        font-weight: 600;
        font-size: .85rem;
        cursor: pointer;
        transition: all .2s ease;
    }

        .btn-reactivate:hover {
            background: #cffafe;
        }
    @@media (max-width: 768px) {
        .actions

    {
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

    }


</style>

<div class="page-wrapper">
    <div class="header-row">
        <h1>Departments</h1>

        <div>
            <a asp-controller="Admin" asp-action="Dashboard" class="btn-main">Back to Dashboard</a>
            <a asp-action="Create" class="btn-main">+ Add Department</a>
        </div>
    </div>

    <div class="glass-card">
        <div class="table-responsive">
            <table>
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Department Name</th>
                        <th>Status</th>
                        <th>Course Count</th>
                        <th>Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var d in Model)
                        {
                            <tr>
                                <td>@d.DepartmentID</td>
                                <td>@d.DepartmentName</td>
                                <td>
                                    @if (d.IsActive)
                                    {
                                        <span class="badge-active">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge-inactive">Inactive</span>
                                    }
                                </td>
                                <td>@d.CourseCount</td>
                                <td class="actions">
                                    <a asp-action="Details"
                                       asp-route-id="@d.DepartmentID"
                                       class="btn-info">
                                        Details
                                    </a>

                                    @if (d.IsActive)
                                    {
                                        <form asp-action="Deactivate"
                                              method="post"
                                              style="display:inline;">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="departmentId" value="@d.DepartmentID" />
                                            <button type="submit" class="btn-deactivate">
                                                Deactivate
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <form asp-action="Reactivate"
                                              method="post"
                                              style="display:inline;">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="departmentId" value="@d.DepartmentID" />
                                            <button type="submit" class="btn-reactivate">
                                                Reactivate
                                            </button>
                                        </form>
                                    }
                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" style="padding: 30px; color: #64748b;">No departments found.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
