@model StudentTracker.Models.DepartmentView
@{
    ViewData["Title"] = "Deactivate Department";
}

<style>
    body {
        background: #f5f7fb;
        font-family: 'Segoe UI', sans-serif;
        color: #0b2540;
    }

    .confirm-box {
        max-width: 520px;
        margin: 120px auto;
        background: #fff;
        padding: 35px;
        border-radius: 18px;
        box-shadow: 0 20px 50px rgba(15,23,42,.15);
        text-align: center;
    }

    h2 {
        color: #b91c1c;
        font-weight: 800;
        margin-bottom: 15px;
    }

    p {
        font-size: 1rem;
        color: #475569;
        margin-bottom: 30px;
    }

    .actions {
        display: flex;
        gap: 15px;
        justify-content: center;
        flex-wrap: wrap;
    }

    .btn-cancel {
        padding: 10px 22px;
        border-radius: 999px;
        background: #e5e7eb;
        color: #111827;
        text-decoration: none;
        font-weight: 600;
    }

    .btn-danger {
        padding: 10px 24px;
        border-radius: 999px;
        background: linear-gradient(135deg,#dc2626,#991b1b);
        color: white;
        border: none;
        font-weight: 700;
    }
</style>

<div class="confirm-box">
    <h2>Deactivate Department</h2>

    <p>
        Are you sure you want to deactivate
        <strong>@Model.DepartmentName</strong>?
        <br />
        This department will no longer be active.
    </p>

    <div class="actions">
        <a asp-action="Index" class="btn-cancel">Cancel</a>

        <form asp-action="DeactivateConfirmed" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="departmentId" value="@Model.DepartmentID" />
            <button type="submit" class="btn-danger">Deactivate</button>
        </form>
    </div>
</div>
