@model IEnumerable<StudentTracker.Models.TestView>
@{
    ViewData["Title"] = "Tests";
}

<style>
    body {
        background: #f5f7fa;
        margin: 0;
        padding: 0;
        font-family: 'Inter', sans-serif;
        color: #1a2b4c;
    }

    .tests-container {
        width: 92%;
        max-width: 1300px;
        margin: 70px auto;
        background: #ffffff;
        border: 1px solid #d9e1ec;
        border-radius: 8px;
        padding: 35px;
        box-shadow: 0px 5px 15px rgba(0,0,0,0.08);
    }

    .page-header {
        text-align: left;
        margin-bottom: 35px;
        border-left: 5px solid #003c8f;
        padding-left: 18px;
    }

        .page-header h1 {
            margin: 0;
            font-size: 30px;
            font-weight: 800;
            color: #003c8f;
        }

    .btn-primary {
        background: #003c8f;
        color: white;
        padding: 12px 22px;
        border-radius: 6px;
        font-weight: 600;
        text-decoration: none;
        transition: 0.25s ease;
        display: inline-block;
    }

        .btn-primary:hover {
            background: #002a6a;
        }

    .btn-secondary {
        background: #5b6e80;
        color: white;
        padding: 12px 22px;
        border-radius: 6px;
        font-weight: 600;
        text-decoration: none;
        transition: 0.25s ease;
        display: inline-block;
    }

        .btn-secondary:hover {
            background: #445664;
        }

    .actions-row {
        display: flex;
        justify-content: space-between;
        margin-bottom: 25px;
        flex-wrap: wrap;
        gap: 10px;
    }

    table {
        width: 100%;
        border-collapse: collapse;
        border: 1px solid #d9e1ec;
        border-radius: 6px;
        overflow: hidden;
        margin-top: 20px;
        box-shadow: 0px 4px 10px rgba(0,0,0,0.06);
    }

    thead {
        background: #003c8f;
        color: white;
    }

    th {
        padding: 14px;
        font-size: 15px;
        font-weight: 600;
        text-align: center;
    }

    td {
        padding: 14px;
        text-align: center;
        border-bottom: 1px solid #edf2f7;
        color: #1a2b4c;
    }

    tr:hover {
        background: #f0f6ff;
    }

    .btn-table {
        padding: 7px 13px;
        border-radius: 6px;
        text-decoration: none;
        font-weight: 600;
        transition: 0.25s ease;
        display: inline-block;
    }

    .btn-blue {
        background: #ffffff;
        border: 1px solid #003c8f;
        color: #003c8f;
    }

        .btn-blue:hover {
            background: #003c8f;
            color: white;
        }

    .btn-green {
        background: #ffffff;
        border: 1px solid #008e2b;
        color: #008e2b;
    }

        .btn-green:hover {
            background: #008e2b;
            color: white;
        }

    .btn-red {
        background: #ffffff;
        border: 1px solid #c62828;
        color: #c62828;
    }

        .btn-red:hover {
            background: #c62828;
            color: white;
        }
</style>

<div class="tests-container">

    <div class="page-header">
        <h1>Tests for @ViewBag.CourseName</h1>
    </div>

    <div class="actions-row">
        <a asp-controller="Teacher"
           asp-action="CourseDetails"
           asp-route-id="@ViewBag.CourseID"
           class="btn-secondary">
            ⬅ Back to Course
        </a>

        <a asp-action="Create"
           asp-route-courseId="@ViewBag.CourseID"
           class="btn-primary">
            ➕ Add Test
        </a>
    </div>

    <table>
        <thead>
            <tr>
                <th>Name</th>
                <th>Date</th>
                <th>Weight (%)</th>
                <th>Max Score</th>
                <th>Average Grade</th>   @* NEW COLUMN *@
                <th>Actions</th>
            </tr>
        </thead>

        <tbody>
            @if (Model.Any())
            {
                foreach (var item in Model)
                {
                    <tr>
                        <td>@item.TestName</td>
                        <td>@item.TestDate.ToShortDateString()</td>
                        <td>@item.Weight</td>
                        <td>@item.MaxScore</td>

                        <!-- NEW AVERAGE COLUMN -->
                        <td style="font-weight:700; color:#003c8f;">
                            @(item.AverageScore == 0 ? "—" : item.AverageScore.ToString("0.00"))
                        </td>

                        <td>
                            <a asp-controller="TestGrades"
                               asp-action="BulkCreate"
                               asp-route-courseId="@item.CourseID"
                               asp-route-testId="@item.TestID"
                               class="btn-table btn-green">
                                ➕ Add Grades
                            </a>

                            <a asp-action="Edit"
                               asp-route-id="@item.TestID"
                               class="btn-table btn-blue">
                                ✏ Edit
                            </a>

                            <a asp-action="Delete"
                               asp-route-id="@item.TestID"
                               class="btn-table btn-red">
                                🗑 Delete
                            </a>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="6" style="padding:20px; color:#5b6e80;">
                        No tests available.
                    </td>
                </tr>
            }
        </tbody>
    </table>

</div>
