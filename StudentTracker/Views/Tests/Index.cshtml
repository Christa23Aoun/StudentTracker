@model IEnumerable<StudentTracker.Models.TestView>
@{
    ViewData["Title"] = "Tests";
}

<style>
    body {
        background: linear-gradient(135deg, #001a33, #003c8f);
        font-family: 'Segoe UI', sans-serif;
        color: #fff;
        margin: 0;
        padding: 0;
    }

    .tests-container {
        max-width: 1200px;
        margin: 80px auto;
        background: rgba(255, 255, 255, 0.08);
        border-radius: 20px;
        padding: 40px;
        box-shadow: 0 8px 25px rgba(0, 0, 0, 0.6);
        backdrop-filter: blur(25px);
        -webkit-backdrop-filter: blur(25px);
    }

    h2 {
        text-align: center;
        font-weight: 700;
        margin-bottom: 30px;
        color: #aee0ff;
    }

    .btn-add {
        display: inline-block;
        background: linear-gradient(135deg, #00bcd4, #1976d2);
        color: white;
        padding: 12px 24px;
        border-radius: 10px;
        font-weight: 600;
        text-decoration: none;
        transition: 0.3s;
        float: right;
        margin-bottom: 20px;
    }

        .btn-add:hover {
            background: linear-gradient(135deg, #1976d2, #00bcd4);
            transform: translateY(-2px);
        }

    table {
        width: 100%;
        border-collapse: collapse;
        color: #fff;
        margin-top: 15px;
    }

    th, td {
        padding: 14px;
        text-align: center;
        border-bottom: 1px solid rgba(255, 255, 255, 0.15);
    }

    thead {
        background: rgba(255, 255, 255, 0.1);
    }

    th {
        color: #aee0ff;
        text-transform: uppercase;
        font-size: 0.9rem;
    }

    tbody tr:hover {
        background: rgba(255, 255, 255, 0.1);
        transition: 0.3s;
    }

    .action-btn {
        text-decoration: none;
        font-weight: 600;
        border-radius: 8px;
        padding: 6px 12px;
        margin: 0 4px;
        transition: 0.3s;
        color: #fff;
    }

    .delete {
        background: rgba(248, 113, 113, 0.2);
        border: 1px solid rgba(248, 113, 113, 0.4);
    }

        .delete:hover {
            background: rgba(248, 113, 113, 0.4);
            transform: translateY(-2px);
        }

    .alert {
        border-radius: 12px;
        padding: 10px 15px;
        margin-bottom: 20px;
        font-weight: 500;
        text-align: center;
        backdrop-filter: blur(8px);
    }

    .alert-success {
        background: rgba(0, 255, 170, 0.2);
        color: #baffda;
    }

    .alert-danger {
        background: rgba(255, 80, 80, 0.2);
        color: #ffb3b3;
    }
</style>

<div class="tests-container">
    <h2>🧪 All Tests</h2>

    <a asp-action="Create" class="btn-add">➕ Add Test</a>

    <div class="clearfix"></div>

    @if (TempData["Msg"] != null)
    {
        var msg = TempData["Msg"].ToString();
        var isDelete = msg.Contains("deleted", StringComparison.OrdinalIgnoreCase);
        <div class="alert @(isDelete ? "alert-danger" : "alert-success")">@msg</div>
    }

    <table>
        <thead>
            <tr>
                <th>ID</th>
                <th>Course</th>
                <th>Name</th>
                <th>Date</th>
                <th>Weight (%)</th>
                <th>Max Score</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                foreach (var item in Model)
                {
                    <tr>
                        <td>@item.TestID</td>
                        <td>@item.CourseID</td>
                        <td>@item.TestName</td>
                        <td>@item.TestDate.ToShortDateString()</td>
                        <td>@item.Weight</td>
                        <td>@item.MaxScore</td>
                        <td>
                            <a asp-action="Delete" asp-route-id="@item.TestID" class="action-btn delete">🗑 Delete</a>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr><td colspan="7" class="text-muted py-3">No tests available.</td></tr>
            }
        </tbody>
    </table>
</div>

<script>
    setTimeout(() => {
        const alertBox = document.querySelector('.alert');
        if (alertBox) {
            alertBox.style.opacity = '0';
            setTimeout(() => alertBox.remove(), 600);
        }
    }, 3000);
</script>
