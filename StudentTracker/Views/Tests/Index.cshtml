@model IEnumerable<StudentTracker.Models.TestView>
@{
    ViewData["Title"] = "Tests";
}

<style>
    body {
        background: linear-gradient(135deg, #001a33, #003c8f);
        font-family: 'Segoe UI', sans-serif;
        color: #fff;
        margin: 0;
        padding: 0;
    }

    .tests-container {
        max-width: 1200px;
        margin: 80px auto;
        background: rgba(255, 255, 255, 0.08);
        border-radius: 20px;
        padding: 40px;
        box-shadow: 0 8px 25px rgba(0, 0, 0, 0.6);
        backdrop-filter: blur(25px);
    }

    h2 {
        text-align: center;
        font-weight: 700;
        margin-bottom: 30px;
        color: #aee0ff;
    }

    .btn-add {
        display: inline-block;
        background: linear-gradient(135deg, #00bcd4, #1976d2);
        color: white;
        padding: 12px 24px;
        border-radius: 10px;
        font-weight: 600;
        text-decoration: none;
        transition: 0.3s;
        float: right;
        margin-bottom: 20px;
    }

        .btn-add:hover {
            background: linear-gradient(135deg, #1976d2, #00bcd4);
            transform: translateY(-2px);
        }

    table {
        width: 100%;
        border-collapse: collapse;
        color: #fff;
    }

    th, td {
        padding: 14px;
        text-align: center;
        border-bottom: 1px solid rgba(255,255,255,0.15);
    }

    thead {
        background: rgba(255, 255, 255, 0.1);
    }

    th {
        color: #aee0ff;
    }

    .delete {
        text-decoration: none;
        font-weight: 600;
        padding: 8px 12px;
        border-radius: 8px;
        background: rgba(255, 77, 77, 0.2);
        border: 1px solid rgba(255, 77, 77, 0.4);
        color: white;
        transition: 0.3s;
        margin-left: 6px;
        display: inline-block;
    }

        .delete:hover {
            background: rgba(255, 77, 77, 0.4);
            transform: translateY(-2px);
        }

    .btn-grades {
        text-decoration: none;
        font-weight: 600;
        padding: 8px 12px;
        border-radius: 8px;
        background: rgba(0, 188, 212, 0.2);
        border: 1px solid rgba(0, 188, 212, 0.5);
        color: #aee0ff;
        transition: 0.3s;
        display: inline-block;
    }

        .btn-grades:hover {
            background: rgba(0, 188, 212, 0.4);
            transform: translateY(-2px);
        }
</style>

<div class="tests-container">
    <h2>🧪 All Tests</h2>

    <div class="text-center mb-4">
        <a asp-controller="Teacher"
           asp-action="CourseDetails"
           asp-route-id="@ViewBag.CourseID"
           class="btn-add"
           style="float:none; background:linear-gradient(135deg, #00bcd4, #1976d2);">
            ⬅ Back to Course
        </a>
    </div>

    <a asp-action="Create" asp-route-courseId="@ViewBag.CourseID" class="btn-add">➕ Add Test</a>

    <div class="clearfix"></div>

    <table>
        <thead>
            <tr>
                <th>ID</th>
                <th>Course</th>
                <th>Name</th>
                <th>Date</th>
                <th>Weight (%)</th>
                <th>Max Score</th>
                <th>Actions</th>
            </tr>
        </thead>

        <tbody>
            @if (Model.Any())
            {
                foreach (var item in Model)
                {
                    <tr>
                        <td>@item.TestID</td>
                        <td>@item.CourseID</td>
                        <td>@item.TestName</td>
                        <td>@item.TestDate.ToShortDateString()</td>
                        <td>@item.Weight</td>
                        <td>@item.MaxScore</td>
                        <td>
                            <a asp-controller="TestGrades"
                               asp-action="BulkCreate"
                               asp-route-testId="@item.TestID"
                               class="btn-grades">
                                ➕ Add Grades
                            </a>
                            <a asp-action="Edit"
                               asp-route-id="@item.TestID"
                               class="btn-grades"
                               style="margin-right: 6px;">
                                ✏ Edit
                            </a>

                            <a asp-action="Delete"
                               asp-route-id="@item.TestID"
                               class="delete">
                                🗑 Delete
                            </a>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="7" class="text-muted py-3">No tests available.</td>
                </tr>
            }
        </tbody>
    </table>
</div>
