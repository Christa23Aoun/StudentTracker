@model StudentTracker.Models.TestView

@{
    ViewData["Title"] = "Delete Test";
}

<style>
    body {
        background: linear-gradient(135deg, #001a33, #003c8f);
        font-family: 'Segoe UI', sans-serif;
        color: #fff;
        margin: 0;
        padding: 0;
    }

    .delete-container {
        max-width: 700px;
        margin: 100px auto;
        background: rgba(255, 255, 255, 0.08);
        border-radius: 20px;
        padding: 40px;
        box-shadow: 0 8px 25px rgba(0, 0, 0, 0.6);
        backdrop-filter: blur(25px);
        text-align: center;
    }

    h2 {
        font-weight: 700;
        margin-bottom: 20px;
        color: #ffb3b3;
    }

    .test-info {
        margin: 20px 0 30px 0;
        text-align: left;
        line-height: 1.7;
    }

        .test-info span {
            color: #aee0ff;
            font-weight: 600;
        }

    .btn-row {
        display: flex;
        justify-content: center;
        gap: 20px;
        margin-top: 10px;
    }

    .btn-cancel,
    .btn-confirm {
        padding: 10px 24px;
        border-radius: 10px;
        font-weight: 600;
        text-decoration: none;
        border: none;
        cursor: pointer;
        transition: 0.3s;
        display: inline-block;
    }

    .btn-cancel {
        background: rgba(255, 255, 255, 0.15);
        color: #aee0ff;
        border: 1px solid rgba(255, 255, 255, 0.3);
    }

        .btn-cancel:hover {
            background: rgba(255, 255, 255, 0.25);
            transform: translateY(-2px);
        }

    .btn-confirm {
        background: rgba(255, 77, 77, 0.3);
        color: #fff;
        border: 1px solid rgba(255, 77, 77, 0.6);
    }

        .btn-confirm:hover {
            background: rgba(255, 77, 77, 0.5);
            transform: translateY(-2px);
        }
</style>

<div class="delete-container">
    <h2>⚠ Delete Test</h2>
    <p>Are you sure you want to delete this test? This action cannot be undone.</p>

    <div class="test-info">
        <p><span>Test ID:</span> @Model.TestID</p>
        <p><span>Test Name:</span> @Model.TestName</p>
        <p><span>Date:</span> @Model.TestDate.ToShortDateString()</p>
        <p><span>Weight:</span> @Model.Weight %</p>
        <p><span>Max Score:</span> @Model.MaxScore</p>
    </div>

    <div class="btn-row">
        <a asp-action="Index"
           asp-route-courseId="@Model.CourseID"
           class="btn-cancel">
            ⬅ Cancel / Back to Tests
        </a>

        <form asp-action="Delete" method="post">
            @Html.AntiForgeryToken()
            <input asp-for="TestID" type="hidden" />
            <input asp-for="CourseID" type="hidden" />
            <button type="submit" class="btn-confirm">🗑 Yes, Delete</button>
        </form>
    </div>
</div>
