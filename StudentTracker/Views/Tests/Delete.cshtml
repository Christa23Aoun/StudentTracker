@model StudentTracker.Models.TestView

@{
    ViewData["Title"] = "Delete Test";
}

<style>
    body {
        background: #f5f7fa;
        margin: 0;
        padding: 0;
        font-family: 'Inter', sans-serif;
        color: #1a2b4c;
    }

    .delete-container {
        width: 92%;
        max-width: 700px;
        margin: 80px auto;
        background: #ffffff;
        border: 1px solid #d9e1ec;
        border-radius: 8px;
        padding: 40px 45px;
        box-shadow: 0px 5px 15px rgba(0,0,0,0.07);
        text-align: center;
    }

    .page-header {
        border-left: 5px solid #c62828;
        padding-left: 14px;
        margin-bottom: 25px;
        text-align: left;
    }

        .page-header h1 {
            margin: 0;
            font-size: 28px;
            font-weight: 800;
            color: #c62828;
        }

    p.warning-text {
        font-size: 15px;
        color: #5b6e80;
        margin-top: 8px;
    }

    .test-info {
        text-align: left;
        line-height: 1.8;
        background: #f7f9fc;
        padding: 20px;
        border-radius: 8px;
        border: 1px solid #e4e9f0;
        margin-top: 20px;
        margin-bottom: 30px;
    }

        .test-info span {
            font-weight: 700;
            color: #003c8f;
        }

    /* BUTTONS */
    .btn-row {
        display: flex;
        justify-content: center;
        gap: 20px;
        margin-top: 5px;
        flex-wrap: wrap;
    }

    .btn-cancel,
    .btn-delete {
        padding: 12px 24px;
        border-radius: 6px;
        font-weight: 700;
        text-decoration: none;
        cursor: pointer;
        transition: 0.25s ease;
        border: none;
        display: inline-block;
    }

    .btn-cancel {
        background: #5b6e80;
        color: white;
    }

        .btn-cancel:hover {
            background: #445664;
        }

    .btn-delete {
        background: #c62828;
        color: white;
    }

        .btn-delete:hover {
            background: #9e1f1f;
        }
</style>

<div class="delete-container">

    <div class="page-header">
        <h1>Delete Test</h1>
        <p class="warning-text">This action cannot be undone. Please confirm your choice.</p>
    </div>

    <div class="test-info">
        <p><span>Test ID:</span> @Model.TestID</p>
        <p><span>Test Name:</span> @Model.TestName</p>
        <p><span>Date:</span> @Model.TestDate.ToShortDateString()</p>
        <p><span>Weight:</span> @Model.Weight %</p>
        <p><span>Max Score:</span> @Model.MaxScore</p>
    </div>

    <div class="btn-row">
        <a asp-action="Index"
           asp-route-courseId="@Model.CourseID"
           class="btn-cancel">
            ⬅ Cancel / Back to Tests
        </a>

        <form asp-action="Delete" method="post">
            @Html.AntiForgeryToken()
            <input asp-for="TestID" type="hidden" />
            <input asp-for="CourseID" type="hidden" />
            <button type="submit" class="btn-delete">🗑 Confirm Delete</button>
        </form>
    </div>
</div>
