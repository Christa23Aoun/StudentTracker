@model StudentTracker.Models.TestView
@{
    ViewData["Title"] = "Create Test";
}

<style>
    body {
        background: linear-gradient(135deg, #001a33, #003c8f);
        font-family: 'Segoe UI', sans-serif;
        color: #fff;
        margin: 0;
        padding: 0;
    }

    .test-form-wrapper {
        max-width: 750px;
        margin: 80px auto;
        background: rgba(255, 255, 255, 0.08);
        border-radius: 20px;
        padding: 45px;
        box-shadow: 0 8px 30px rgba(0, 0, 0, 0.4);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
    }

    h2 {
        text-align: center;
        margin-bottom: 35px;
        font-weight: 700;
        color: #aee0ff;
    }

    label {
        font-weight: 600;
        color: #cfe6ff;
    }

    .form-control {
        background: rgba(255, 255, 255, 0.1);
        border: 1px solid rgba(255, 255, 255, 0.25);
        color: #fff;
        border-radius: 10px;
        padding: 10px;
        margin-bottom: 20px;
    }

    .btn-save {
        background: linear-gradient(135deg, #00c853, #009624);
        color: white;
        border: none;
        border-radius: 10px;
        padding: 12px 25px;
        font-weight: 600;
        width: 150px;
    }

    .btn-cancel {
        background: rgba(255, 255, 255, 0.15);
        color: #fff;
        border-radius: 10px;
        padding: 12px 25px;
        font-weight: 600;
        width: 150px;
        text-align: center;
    }

    .btn-group {
        display: flex;
        justify-content: center;
        gap: 20px;
        margin-top: 25px;
    }

    .course-label {
        color: #bbdefb;
        font-weight: 600;
        margin-bottom: 15px;
        text-align: center;
        font-size: 1.2rem;
    }
</style>

<div class="test-form-wrapper">
    <h2>🧪 Create a New Test</h2>

    <div class="course-label">
        Course: @ViewBag.CourseName (@ViewBag.CourseID)
    </div>

    <form asp-action="Create" method="post">
        <input type="hidden" asp-for="CourseID" />

        <!-- Test Name -->
        <div>
            <label>Test Name</label>
            <input asp-for="TestName" class="form-control" required />
        </div>

        <!-- Today's Date Default -->
        <div>
            <label>Test Date</label>
            <input asp-for="TestDate"
                   type="date"
                   class="form-control"
                   value="@DateTime.Today.ToString("yyyy-MM-dd")"
                   required />
        </div>

        <!-- Weight Dropdown -->
        <div>
            <label>Weight (%)</label>
            <select asp-for="Weight" class="form-control" required>
                <option value="10">10%</option>
                <option value="30">30%</option>
                <option value="50">50%</option>
            </select>
        </div>

        <!-- Max Score Fixed at 100 -->
        <div>
            <label>Max Score</label>
            <input asp-for="MaxScore"
                   type="number"
                   class="form-control"
                   style="background: rgba(255,255,255,0.1); color:white;"
                   value="100"
                   readonly />
        </div>

        <!-- Buttons -->
        <div class="btn-group">
            <button type="submit" class="btn-save">💾 Save</button>

            <a asp-controller="Tests"
               asp-action="Index"
               asp-route-courseId="@ViewBag.CourseID"
               class="btn-cancel">
                ✖ Cancel
            </a>
        </div>
    </form>
</div>
