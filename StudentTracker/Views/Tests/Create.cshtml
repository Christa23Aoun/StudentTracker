@model StudentTracker.Models.TestView
@{
    ViewData["Title"] = "Create Test";
}

<style>
    body {
        background: #f5f7fa;
        margin: 0;
        padding: 0;
        font-family: 'Inter', sans-serif;
        color: #1a2b4c;
    }

    .test-form-wrapper {
        width: 92%;
        max-width: 750px;
        margin: 70px auto;
        background: #ffffff;
        border: 1px solid #d9e1ec;
        border-radius: 8px;
        padding: 45px;
        box-shadow: 0px 5px 15px rgba(0,0,0,0.07);
    }

    .page-header {
        text-align: left;
        margin-bottom: 30px;
        border-left: 5px solid #003c8f;
        padding-left: 16px;
    }

        .page-header h1 {
            margin: 0;
            font-size: 30px;
            font-weight: 800;
            color: #003c8f;
        }

    .course-label {
        color: #5b6e80;
        font-size: 15px;
        margin-bottom: 25px;
        font-weight: 600;
    }

    label {
        font-weight: 600;
        color: #1a2b4c;
        margin-top: 10px;
        display: block;
    }

    .form-control {
        background: #ffffff;
        border: 1px solid #d9e1ec;
        color: #1a2b4c;
        border-radius: 6px;
        padding: 12px;
        margin-bottom: 20px;
        font-size: 15px;
        width: 100%;
    }

    input[readonly] {
        background: #f0f3f6;
        color: #7a8796;
    }

    /* BUTTONS */
    .btn-save {
        background: #003c8f;
        color: white;
        padding: 12px 25px;
        border-radius: 6px;
        border: none;
        font-weight: 700;
        width: 150px;
        cursor: pointer;
        transition: 0.25s ease;
    }

        .btn-save:hover {
            background: #002a6a;
        }

    .btn-cancel {
        background: #5b6e80;
        color: white;
        border-radius: 6px;
        padding: 12px 25px;
        font-weight: 700;
        width: 150px;
        text-align: center;
        text-decoration: none;
        transition: 0.25s ease;
    }

        .btn-cancel:hover {
            background: #445664;
        }

    .btn-group {
        display: flex;
        justify-content: center;
        gap: 20px;
        margin-top: 20px;
    }

    .error-box {
        background: #ffe5e5;
        color: #b30000;
        padding: 12px 15px;
        border-radius: 6px;
        border: 1px solid #ffb3b3;
        margin-bottom: 20px;
        font-weight: 600;
    }
</style>

<div class="test-form-wrapper">

    <div class="page-header">
        <h1>Create Test</h1>
    </div>

    <div class="course-label">
        Course: @ViewBag.CourseName (@ViewBag.CourseID)
    </div>

    @if (ViewBag.Error != null)
    {
        <div class="error-box">@ViewBag.Error</div>
    }

    <form asp-action="Create" method="post">
        <input type="hidden" asp-for="CourseID" />

        <!-- Test Name -->
        <label>Test Name</label>
        <input asp-for="TestName" class="form-control" required />

        <!-- Today's Date Default -->
        <label>Test Date</label>
        <input asp-for="TestDate"
               type="date"
               class="form-control"
               value="@DateTime.Today.ToString("yyyy-MM-dd")"
               required />

        <!-- Weight Dropdown -->
        <label>Weight (%)</label>
        <input asp-for="Weight"
               type="number"
               class="form-control"
               min="1"
               max="100"
               required />

        <!-- Max Score Fixed at 100 -->
        <label>Max Score</label>
        <input asp-for="MaxScore"
               type="number"
               class="form-control"
               value="100"
               readonly />

        <!-- Buttons -->
        <div class="btn-group">
            <button type="submit" class="btn-save">💾 Save</button>

            <a asp-controller="Tests"
               asp-action="Index"
               asp-route-courseId="@ViewBag.CourseID"
               class="btn-cancel">
                ✖ Cancel
            </a>
        </div>

    </form>
</div>
