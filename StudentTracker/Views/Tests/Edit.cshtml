@model StudentTracker.Models.TestView
@{
    ViewData["Title"] = "Edit Test";
}

<style>
    body {
        background: #f5f7fa;
        margin: 0;
        padding: 0;
        font-family: 'Inter', sans-serif;
        color: #1a2b4c;
    }

    .edit-container {
        width: 92%;
        max-width: 700px;
        margin: 70px auto;
        background: #ffffff;
        border: 1px solid #d9e1ec;
        border-radius: 8px;
        padding: 40px 45px;
        box-shadow: 0px 5px 15px rgba(0,0,0,0.07);
    }

    .page-header {
        text-align: left;
        margin-bottom: 25px;
        border-left: 5px solid #003c8f;
        padding-left: 14px;
    }

        .page-header h1 {
            margin: 0;
            font-size: 30px;
            font-weight: 800;
            color: #003c8f;
        }

    label {
        font-weight: 600;
        margin-top: 15px;
        color: #1a2b4c;
        display: block;
    }

    input {
        width: 100%;
        padding: 11px 14px;
        border-radius: 6px;
        border: 1px solid #d9e1ec;
        background: #ffffff;
        color: #1a2b4c;
        margin-top: 6px;
        margin-bottom: 18px;
        font-size: 15px;
    }

        input[readonly] {
            background: #f0f3f6;
            color: #7a8796;
        }

    .btn-save {
        width: 100%;
        padding: 13px 22px;
        background: #003c8f;
        color: white;
        border: none;
        border-radius: 6px;
        font-weight: 700;
        cursor: pointer;
        transition: 0.25s ease;
        margin-top: 10px;
    }

        .btn-save:hover {
            background: #002a6a;
        }

    .btn-cancel {
        display: block;
        text-align: center;
        margin-top: 12px;
        font-weight: 700;
        color: #5b6e80;
        text-decoration: none;
    }

    .error-box {
        background: #ffe5e5;
        color: #b30000;
        padding: 12px 15px;
        border-radius: 6px;
        border: 1px solid #ffb3b3;
        margin-bottom: 20px;
        font-weight: 600;
    }
</style>

<div class="edit-container">

    <div class="page-header">
        <h1>Edit Test</h1>
    </div>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="error-box">
            @Html.ValidationSummary(false)
        </div>
    }

    <form method="post">
        @Html.AntiForgeryToken()

        <input type="hidden" asp-for="TestID" />
        <input type="hidden" asp-for="CourseID" />

        <label>Test Name</label>
        <input asp-for="TestName" />

        <label>Test Date</label>
        <input asp-for="TestDate" type="date" />

        <label>Weight (%)</label>
        <input asp-for="Weight" type="number" min="1" max="100" />

        <label>Max Score</label>
        <input asp-for="MaxScore" type="number" readonly />

        <button class="btn-save" type="submit">💾 Save Changes</button>

        <a asp-controller="Tests"
           asp-action="Index"
           asp-route-courseId="@Model.CourseID"
           class="btn-cancel">
            ✖ Cancel
        </a>
    </form>
</div>
