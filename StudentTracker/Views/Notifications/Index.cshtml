@model IEnumerable<StudentTracker.Models.NotificationView>

@{
    ViewData["Title"] = "Notifications";
}

<style>
    body {
        background: #f5f7fa;
        margin: 0;
        padding: 0;
        font-family: 'Inter', sans-serif;
        color: #1a2b4c;
    }

    .notifications-container {
        width: 92%;
        max-width: 1300px;
        margin: 70px auto;
    }

    .notifications-header {
        text-align: left;
        margin-bottom: 40px;
        border-left: 5px solid #003c8f;
        padding-left: 18px;
    }

        .notifications-header h1 {
            font-size: 36px;
            font-weight: 800;
            margin: 0;
            color: #003c8f;
        }

        .notifications-header p {
            font-size: 16px;
            color: #5b6e80;
            margin-top: 6px;
        }

    .notifications-list {
        display: flex;
        flex-direction: column;
        gap: 16px;
    }

    .notification-card {
        background: #ffffff;
        border: 1px solid #d9e1ec;
        border-radius: 6px;
        padding: 22px 26px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        transition: 0.25s ease;
        box-shadow: 0px 4px 10px rgba(0, 0, 0, 0.06);
        position: relative;
    }

        .notification-card:hover {
            border-color: #003c8f;
            transform: translateY(-2px);
            box-shadow: 0px 6px 16px rgba(0, 0, 0, 0.10);
        }

        .notification-card.unread::before {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            height: 100%;
            width: 4px;
            background: #003c8f;
            border-radius: 6px 0 0 6px;
        }

    .notification-left {
        max-width: 70%;
    }

    .notification-message {
        font-size: 15px;
        line-height: 1.5;
        color: #1a2b4c;
        margin-bottom: 6px;
    }

    .notification-date {
        font-size: 14px;
        color: #5b6e80;
    }

    .notification-actions a {
        background: #003c8f;
        color: white;
        padding: 8px 18px;
        border-radius: 6px;
        text-decoration: none;
        font-weight: 600;
        font-size: 14px;
        transition: 0.2s ease;
    }

        .notification-actions a:hover {
            background: #002a6a;
        }

    .empty {
        background: #ffffff;
        border: 1px solid #d9e1ec;
        border-radius: 6px;
        padding: 30px;
        text-align: center;
        color: #5b6e80;
        font-style: italic;
    }
</style>

<div class="notifications-container">

    <div class="notifications-header">
        <h1>Notifications</h1>
        <p>Latest academic updates and system alerts.</p>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="notifications-list">
            @foreach (var n in Model)
            {
                <div class="notification-card @(n.IsRead ? "" : "unread")">
                    <div class="notification-left">
                        <div class="notification-message">@n.Message</div>
                        <div class="notification-date">
                            @n.CreatedAt.ToLocalTime().ToString("dd MMM yyyy • HH:mm")
                        </div>
                    </div>

                    <div class="notification-actions">
                        <a asp-controller="Notifications"
                           asp-action="View"
                           asp-route-id="@n.NotificationID">
                            View
                        </a>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="empty">
            No notifications available.
        </div>
    }

</div>
