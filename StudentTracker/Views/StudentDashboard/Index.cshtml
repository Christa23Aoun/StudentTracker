@model StudentTracker.Models.ViewModels.StudentDashboardVM
@{
    ViewData["Title"] = "Student Dashboard";
}

<style>
    body {
        background: #f2f4fb;
        font-family: 'Segoe UI', sans-serif;
        color: #0b2540;
        margin: 0;
        padding: 0;
    }

    .dashboard-wrapper {
        max-width: 1200px;
        margin: 80px auto;
        padding: 0 20px 40px 20px;
    }

    .dashboard-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 16px;
        margin-bottom: 28px;
        flex-wrap: wrap;
    }

    .dashboard-title-block h2 {
        font-size: 1.9rem;
        font-weight: 700;
        margin: 0;
        color: #0b2540;
    }

    .dashboard-title-block p {
        margin: 4px 0 0;
        color: #64748b;
        font-size: 0.96rem;
    }

    .profile-pill {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 10px 18px;
        border-radius: 999px;
        background: linear-gradient(135deg, #0d4b84, #2563eb);
        color: #f9fafb;
        text-decoration: none;
        box-shadow: 0 12px 30px rgba(15, 23, 42, 0.25);
        font-size: 0.9rem;
        font-weight: 600;
    }

    .profile-pill-icon {
        width: 32px;
        height: 32px;
        border-radius: 999px;
        background: rgba(15, 23, 42, 0.2);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.1rem;
    }

    .stats-card-container {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
        gap: 20px;
        margin-bottom: 30px;
    }

    .stats-card {
        background: #ffffff;
        border-radius: 20px;
        padding: 22px 24px;
        box-shadow: 0 16px 40px rgba(15, 23, 42, 0.12);
        border: 1px solid rgba(148, 163, 184, 0.3);
        text-align: center;
    }

        .stats-card h3 {
            font-size: 2rem;
            font-weight: 700;
            margin: 0;
            color: #0d4b84;
        }

        .stats-card span {
            color: #64748b;
            font-size: 0.9rem;
        }

    .table-card {
        background: #ffffff;
        border-radius: 20px;
        padding: 24px;
        margin-bottom: 30px;
        box-shadow: 0 16px 40px rgba(15, 23, 42, 0.12);
        border: 1px solid rgba(148, 163, 184, 0.3);
    }

    table {
        width: 100%;
        border-collapse: collapse;
        border-radius: 14px;
        overflow: hidden;
        background: #ffffff;
    }

    thead {
        background: #0d4b84;
        color: #e5f0ff;
    }

    th, td {
        padding: 12px 14px;
        text-align: center;
        font-size: 0.92rem;
        border-bottom: 1px solid #e2e8f0;
        white-space: nowrap;
    }

    tbody tr:nth-child(even) {
        background: #f8fafc;
    }

    tbody tr:hover {
        background: #eef4ff;
    }

    .badge {
        padding: 4px 10px;
        border-radius: 999px;
        font-weight: 600;
        font-size: 0.8rem;
    }

    .bg-success-subtle {
        background: #ecfdf5;
        color: #15803d;
        border: 1px solid #bbf7d0;
    }

    .bg-warning-subtle {
        background: #fff7d6;
        color: #ca8a04;
        border: 1px solid #fde68a;
    }

    .bg-danger-subtle {
        background: #fef2f2;
        color: #b91c1c;
        border: 1px solid #fecaca;
    }

    .btn-action {
        padding: 6px 12px;
        border-radius: 8px;
        background: #0d4b84;
        color: white;
        font-weight: 600;
        text-decoration: none;
        font-size: 0.85rem;
        transition: .2s;
    }

        .btn-action:hover {
            background: #093864;
        }

    .chart-card {
        background: #ffffff;
        border-radius: 20px;
        padding: 24px;
        box-shadow: 0 16px 40px rgba(15, 23, 42, 0.12);
        border: 1px solid rgba(148, 163, 184, 0.3);
    }

        .chart-card h3 {
            color: #0d4b84;
            margin-bottom: 15px;
            font-weight: 700;
        }

    .chart-wrapper {
        width: 100%;
        max-width: 600px;
        height: 260px;
        margin: auto;
    }
</style>

<div class="dashboard-wrapper">
    <div class="dashboard-header">
        <div class="dashboard-title-block">
            <h2>Student Dashboard</h2>
            <p>Welcome, <strong>@Model.StudentName</strong> — @Model.CurrentSemester</p>
        </div>

        <a asp-controller="StudentDashboard"
           asp-action="Profile"
           class="profile-pill">
            <div class="profile-pill-icon">
                <span>👤</span>
            </div>
            <div>
                <div style="font-size:0.8rem; opacity:0.85;">My Profile</div>
                <div style="font-size:0.9rem;">@Model.StudentName</div>
            </div>
        </a>
    </div>

    <div class="stats-card-container">
        <div class="stats-card">
            <h3>@Model.ActiveCourseCount</h3>
            <span>Active Courses</span>
        </div>

        <div class="stats-card">
            <h3>@Model.AttendancePercent.ToString("0.0")%</h3>
            <span>Attendance</span>
        </div>

        <div class="stats-card">
            <h3>@Model.Notifications.Count</h3>
            <span>Notifications</span>
        </div>
    </div>

    <div class="table-card">
        <table>
            <thead>
                <tr>
                    <th>Course</th>
                    <th>Teacher</th>
                    <th>Department</th>
                    <th>Attendance</th>
                    <th>Average</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.MyCourses.Any())
                {
                    foreach (var c in Model.MyCourses)
                    {
                        var badgeClass = c.AttendanceRate < 75
                        ? "bg-danger-subtle"
                        : c.AttendanceRate < 85
                        ? "bg-warning-subtle"
                        : "bg-success-subtle";

                        <tr>
                            <td>@c.CourseName</td>
                            <td>@c.TeacherName</td>
                            <td>@c.Department</td>
                            <td><span class="badge @badgeClass">@c.AttendanceRate.ToString("0.0")%</span></td>
                            <td>
                                @{
                                    var avgText = c.CurrentAverage.HasValue
                                    ? c.CurrentAverage.Value.ToString("0.00")
                                    : "N/A";
                                }
                                @avgText
                            </td>
                            <td>
                                <a asp-controller="StudentDashboard"
                                   asp-action="CourseDetails"
                                   asp-route-courseId="@c.CourseId"
                                   class="btn-action">
                                    📘 Details
                                </a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6">No courses found.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

 @*    <div class="chart-card">
        <h3>📊 Attendance Trend</h3>
        <div class="chart-wrapper">
            <canvas id="attendanceChart"></canvas>
        </div>
    </div> *@
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    const attLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.AttendanceTrend.Select(p => p.WeekLabel)));
    const attData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.AttendanceTrend.Select(p => p.Percent)));

    new Chart(document.getElementById('attendanceChart'), {
        type: 'bar',
        data: {
            labels: attLabels,
            datasets: [{
                label: 'Attendance %',
                backgroundColor: '#0d4b84',
                data: attData
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            scales: {
                y: { beginAtZero: true, max: 100 }
            }
        }
    });
</script>
