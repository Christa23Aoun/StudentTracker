@model IEnumerable<StudentTracker.Models.AdminPendingGradeView>

@{
    ViewData["Title"] = "Pending Grades";
    var courseFilter = ViewBag.CourseFilter as string ?? "";
    var studentFilter = ViewBag.StudentFilter as string ?? "";
    var searchTerm = ViewBag.SearchTerm as string ?? "";
    var courses = ViewBag.Courses as List<string> ?? new List<string>();
    var students = ViewBag.Students as List<string> ?? new List<string>();
}

<style>
    body {
        background: #f5f7fa;
        font-family: 'Inter', sans-serif;
        color: #1a2b4c;
        margin: 0;
        padding: 0;
    }

    .page-wrapper {
        width: 92%;
        max-width: 1300px;
        margin: 70px auto;
    }

    .page-header {
        border-left: 5px solid #003c8f;
        padding-left: 18px;
        margin-bottom: 30px;
    }

        .page-header h1 {
            font-size: 34px;
            font-weight: 800;
            margin: 0;
            color: #003c8f;
        }

        .page-header p {
            color: #5b6e80;
            margin-top: 6px;
            font-size: 15px;
        }

    .filters-row {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        margin-bottom: 25px;
        align-items: center;
    }

        .filters-row select,
        .filters-row input[type="text"] {
            padding: 9px 12px;
            border-radius: 6px;
            border: 1px solid #d9e1ec;
            background: #ffffff;
            font-size: 14px;
            min-width: 190px;
        }

        .filters-row button {
            padding: 9px 22px;
            border-radius: 6px;
            border: none;
            background: #003c8f;
            color: #fff;
            font-weight: 600;
            cursor: pointer;
        }

    .bulk-actions {
        display: flex;
        gap: 12px;
        margin-bottom: 20px;
    }

    .table-container {
        background: #ffffff;
        border: 1px solid #d9e1ec;
        border-radius: 6px;
        overflow-x: auto;
        box-shadow: 0px 4px 10px rgba(0,0,0,0.06);
    }

    table {
        width: 100%;
        border-collapse: collapse;
    }

    thead {
        background: #003c8f;
        color: #ffffff;
    }

    th, td {
        padding: 13px 14px;
        text-align: center;
        border-bottom: 1px solid #e2e8f0;
        font-size: 14px;
    }

    tbody tr:hover {
        background: #f1f5f9;
    }

    .score-cell {
        font-weight: 700;
        color: #003c8f;
    }

    .btn-sm {
        padding: 6px 12px;
        border-radius: 6px;
        border: none;
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
    }

    .btn-validate {
        background: #e8f5e9;
        color: #2e7d32;
        border: 1px solid #c8e6c9;
    }

    .btn-reject {
        background: #fdecea;
        color: #c62828;
        border: 1px solid #f5c6cb;
    }

    .row-actions {
        display: flex;
        justify-content: center;
        gap: 8px;
    }

    .no-data {
        text-align: center;
        padding: 30px;
        color: #64748b;
        font-style: italic;
    }
</style>

<div class="page-wrapper">

    <div class="page-header">
        <h1>Pending Grades</h1>
        <p>Review, validate, or reject grades submitted by teachers.</p>
    </div>

    <form method="get" asp-action="Index" class="filters-row">
        <select name="course">
            <option value="">All courses</option>
            @foreach (var c in courses)
            {
                <option value="@c" selected="@(c == courseFilter)">@c</option>
            }
        </select>

        <select name="student">
            <option value="">All students</option>
            @foreach (var s in students)
            {
                <option value="@s" selected="@(s == studentFilter)">@s</option>
            }
        </select>

        <input type="text" name="search" value="@searchTerm" placeholder="Search test, course or student..." />

        <button type="submit">Filter</button>
    </form>

    @if (Model.Any())
    {
        <div class="bulk-actions">
            <form asp-action="ValidateAll" method="post">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn-sm btn-validate">
                    Validate All
                </button>
            </form>
        </div>
    }

    <div class="table-container">
        @if (!Model.Any())
        {
            <div class="no-data">
                No pending grades found for the selected filters.
            </div>
        }
        else
        {
            <table>
                <thead>
                    <tr>
                        <th>Test</th>
                        <th>Course</th>
                        <th>Student</th>
                        <th>Score</th>
                        <th>Created At</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var g in Model)
                    {
                        <tr>
                            <td>@g.TestName</td>
                            <td>@g.CourseName</td>
                            <td>@g.StudentName</td>
                            <td class="score-cell">@g.Score</td>
                            <td>@g.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                            <td>
                                <div class="row-actions">
                                    <form asp-action="Validate" method="post">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@g.TestGradeID" />
                                        <button type="submit" class="btn-sm btn-validate">Validate</button>
                                    </form>

                                    
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>

</div>
