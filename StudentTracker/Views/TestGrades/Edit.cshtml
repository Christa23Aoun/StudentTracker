@model StudentTracker.Models.TestGradeView
@{
    ViewData["Title"] = "Edit Grade";
}

<style>
    body {
        background: #f5f7fa;
        font-family: 'Inter';
    }

    .box {
        max-width: 600px;
        margin: 60px auto;
        background: white;
        padding: 40px;
        border-radius: 8px;
        border: 1px solid #d9e1ec;
        box-shadow: 0px 5px 15px rgba(0,0,0,0.07);
    }

    label {
        font-weight: 600;
        color: #003c8f;
        margin-top: 15px;
    }

    input {
        width: 100%;
        padding: 12px;
        border-radius: 6px;
        border: 1px solid #d9e1ec;
        background: #f8f9fc;
        margin-top: 5px;
    }

    .btn-save {
        margin-top: 25px;
        background: #003c8f;
        color: white;
        padding: 12px 26px;
        border-radius: 8px;
        border: none;
        font-weight: 700;
        cursor: pointer;
    }
</style>

<div class="box">
    <h2 style="color:#003c8f; font-weight:800;">Edit Grade</h2>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <form asp-action="Edit" method="post">
        @Html.AntiForgeryToken()

        <!-- Hidden required fields -->
        <input type="hidden" asp-for="TestGradeID" />
        <input type="hidden" asp-for="TestID" />
        <input type="hidden" asp-for="StudentID" />
        <input type="hidden" asp-for="CourseID" />

        <label>Student</label>
        <input type="text" value="@Model.StudentName" disabled />

        <label>Test</label>
        <input type="text" value="@Model.TestName" disabled />

        <label>Score</label>
        <input asp-for="Score" type="number" step="0.01" min="0" />

        <button type="submit" class="btn-save">Save Changes</button>
    </form>
</div>
