@model StudentTracker.Models.TestGradeView
@{
    ViewData["Title"] = "Add Test Grade";

    var courseName = ViewBag.CourseName as string ?? "";
    var tests = ViewBag.Tests as List<StudentTracker.Models.TestView>;
    var students = ViewBag.Students as List<StudentTracker.Models.StudentCourseView>;

    tests ??= new List<StudentTracker.Models.TestView>();
    students ??= new List<StudentTracker.Models.StudentCourseView>();

    bool alreadyGraded = ViewBag.AlreadyGraded == true;
    var existingScore = ViewBag.ExistingGrade;
}

<style>
    body {
        background: #f5f7fa;
        font-family: 'Inter', sans-serif;
        color: #1a2b4c;
    }

    .container-card {
        width: 92%;
        max-width: 750px;
        margin: 70px auto;
        background: #ffffff;
        padding: 40px 45px;
        border-radius: 10px;
        border: 1px solid #d9e1ec;
        box-shadow: 0px 4px 15px rgba(0,0,0,0.08);
    }

    .page-header {
        border-left: 6px solid #003c8f;
        padding-left: 18px;
        margin-bottom: 25px;
    }

        .page-header h1 {
            margin: 0;
            font-size: 32px;
            font-weight: 800;
            color: #003c8f;
        }

    .subtitle {
        font-size: 16px;
        margin-bottom: 25px;
    }

    /* Alert */
    .alert-danger-custom {
        background: #ffe4e4;
        padding: 15px 18px;
        color: #a30000;
        font-weight: 600;
        border-left: 5px solid #d60000;
        border-radius: 6px;
        margin-bottom: 25px;
    }

    label {
        font-weight: 600;
        color: #003c8f;
        margin-bottom: 6px;
        display: block;
        margin-top: 15px;
    }

    select, input[type=number], .disabled-input {
        width: 100%;
        background: #f7f9fc;
        border: 1px solid #d9e1ec;
        border-radius: 6px;
        padding: 12px;
        color: #1a2b4c;
        font-size: 15px;
    }

        select:disabled, .disabled-input {
            background: #eef1f5;
            color: #6c7a89;
            cursor: not-allowed;
        }

    .btn-row {
        margin-top: 35px;
        display: flex;
        justify-content: center;
        gap: 22px;
    }

    .btn-save {
        background: #003c8f;
        color: white;
        padding: 12px 26px;
        border-radius: 8px;
        border: none;
        font-weight: 700;
        min-width: 150px;
        transition: 0.25s ease;
    }

        .btn-save:hover:not([disabled]) {
            background: #002c6a;
        }

        .btn-save[disabled] {
            background: #8ba3c0;
            cursor: not-allowed;
        }

    .btn-cancel {
        background: #6c7a89;
        color: white;
        padding: 12px 26px;
        border-radius: 8px;
        font-weight: 700;
        text-decoration: none;
    }

        .btn-cancel:hover {
            background: #55616e;
        }
</style>

<div class="container-card">

    <div class="page-header">
        <h1>Add Grade</h1>
    </div>

    <div class="subtitle">
        Course: <strong>@courseName</strong> (ID: @Model.CourseID)
    </div>

    <!-- Alerts -->
    @if (alreadyGraded)
    {
        <div class="alert-danger-custom">
            This student already has a grade for this test.<br />
            Existing Grade: <strong>@existingScore</strong>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert-danger-custom">@TempData["Error"]</div>
    }

    @if (ViewBag.Error != null)
    {
        <div class="alert-danger-custom">@ViewBag.Error</div>
    }

    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="CourseID" />

        <!-- TEST -->
        <label>Select Test</label>
        @if (!alreadyGraded)
        {
            <select asp-for="TestID">
                <option value="">-- Choose a test --</option>
                @foreach (var t in tests)
                {
                    <option value="@t.TestID">@t.TestName (@t.TestDate.ToShortDateString()) – @t.Weight% (Max @t.MaxScore)</option>
                }
            </select>
            <span asp-validation-for="TestID" class="text-danger"></span>
        }
        else
        {
            <select disabled class="disabled-input">
                <option>Test already selected</option>
            </select>
        }

        <!-- STUDENT -->
        <label>Select Student</label>
        @if (!alreadyGraded)
        {
            <select asp-for="StudentID">
                <option value="">-- Choose a student --</option>
                @foreach (var s in students)
                {
                    <option value="@s.StudentID">@s.StudentName (ID: @s.StudentID)</option>
                }
            </select>
            <span asp-validation-for="StudentID" class="text-danger"></span>
        }
        else
        {
            <select disabled class="disabled-input">
                <option>Student already graded</option>
            </select>
        }

        <!-- SCORE -->
        <label>Score</label>
        @if (alreadyGraded)
        {
            <input type="number" class="disabled-input" value="@existingScore" disabled />
            <input type="hidden" asp-for="Score" />

            <script>
                document.addEventListener("DOMContentLoaded", function () {
                    document.querySelector(".btn-save").disabled = true;
                });
            </script>
        }
        else
        {
            <input asp-for="Score" type="number" min="0" step="0.01" />
            <span asp-validation-for="Score" class="text-danger"></span>
        }

        <!-- BUTTONS -->
        <div class="btn-row">
            <button type="submit" class="btn-save">Save</button>
            <a asp-controller="Teacher" asp-action="CourseDetails" asp-route-id="@Model.CourseID" class="btn-cancel">Cancel</a>
        </div>

    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
