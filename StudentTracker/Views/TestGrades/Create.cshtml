@model StudentTracker.Models.TestGradeView

@{
    ViewData["Title"] = "Add Test Grade";
}

<div class="container mt-5" style="max-width:700px;">
    <h2 class="text-center text-primary mb-4">➕ Add Test Grade</h2>

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger text-center">@ViewBag.Error</div>
    }

    <form asp-action="Create" method="post" class="shadow-sm p-4 rounded bg-light">
        <div class="mb-3">
            <label class="form-label">Test ID</label>
            <input asp-for="TestID" class="form-control" placeholder="Enter Test ID" required />
            <span asp-validation-for="TestID" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label class="form-label">Student ID</label>
            <input asp-for="StudentID" class="form-control" placeholder="Enter Student ID" required />
            <span asp-validation-for="StudentID" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label class="form-label">Score</label>
            <input asp-for="Score" type="number" step="0.01" class="form-control" placeholder="Enter score" required />
            <span asp-validation-for="Score" class="text-danger"></span>
        </div>

        <div class="form-check mb-3">
            <input asp-for="IsValidated" class="form-check-input" type="checkbox" />
            <label class="form-check-label">Validated</label>
        </div>

        <div class="d-flex justify-content-center gap-3">
            <button type="submit" class="btn btn-success px-4">Save</button>
            <a asp-action="Index" class="btn btn-secondary px-4">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
