@model StudentTracker.Models.TestGradeView
@{
    ViewData["Title"] = "Add Test Grade";

    var courseName = ViewBag.CourseName as string ?? "";
    var tests = ViewBag.Tests as List<StudentTracker.Models.TestView>;
    var students = ViewBag.Students as List<StudentTracker.Models.StudentCourseView>;
}

<style>
    body {
        background: #f5f7fa;
        margin: 0;
        padding: 0;
        font-family: 'Inter', sans-serif;
        color: #1a2b4c;
    }

    .grade-container {
        width: 92%;
        max-width: 750px;
        margin: 70px auto;
        background: #ffffff;
        padding: 40px 45px;
        border-radius: 8px;
        border: 1px solid #d9e1ec;
        box-shadow: 0px 5px 15px rgba(0,0,0,0.07);
    }

    .page-header {
        border-left: 5px solid #003c8f;
        padding-left: 16px;
        margin-bottom: 25px;
    }

        .page-header h1 {
            margin: 0;
            font-size: 30px;
            font-weight: 800;
            color: #003c8f;
        }

    .subtitle {
        font-size: 15px;
        color: #5b6e80;
        margin-bottom: 25px;
    }

    label {
        font-weight: 600;
        color: #003c8f;
        margin-bottom: 6px;
        display: block;
    }

    select, input {
        width: 100%;
        background: #f7f9fc;
        border: 1px solid #d9e1ec;
        border-radius: 6px;
        padding: 12px;
        color: #1a2b4c;
        margin-bottom: 18px;
    }

        select:focus, input:focus {
            outline: none;
            border-color: #003c8f;
        }

    .alert-danger {
        background: #ffe6e6;
        color: #b30000;
        border: 1px solid #ffcccc;
        padding: 10px;
        border-radius: 6px;
        margin-bottom: 18px;
    }

    .btn-save, .btn-cancel {
        padding: 12px 26px;
        border-radius: 8px;
        font-weight: 700;
        text-decoration: none;
        border: none;
        transition: 0.25s ease;
        display: inline-block;
        min-width: 150px;
        text-align: center;
    }

    .btn-save {
        background: #003c8f;
        color: white;
    }

        .btn-save:hover {
            background: #002c6a;
        }

    .btn-cancel {
        background: #5b6e80;
        color: white;
    }

        .btn-cancel:hover {
            background: #445664;
        }

    .btn-row {
        display: flex;
        justify-content: center;
        gap: 20px;
        margin-top: 25px;
    }
</style>

<div class="grade-container">

    <div class="page-header">
        <h1>Add Grade</h1>
    </div>

    <div class="subtitle">
        Course: <strong>@courseName</strong> (ID: @Model.CourseID)
    </div>

    <!-- SERVER ERRORS -->
    @if (TempData["Error"] != null)
    {
        <div class="alert-danger">@TempData["Error"]</div>
    }

    @if (ViewBag.Error != null)
    {
        <div class="alert-danger">@ViewBag.Error</div>
    }

    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()

        <input type="hidden" asp-for="CourseID" />

        <!-- Test -->
        <label>Select Test</label>
        <select asp-for="TestID">
            <option value="">-- Choose a test --</option>

            @foreach (var t in tests)
            {
                <option value="@t.TestID">
                    @t.TestName (@t.TestDate.ToShortDateString()) – @t.Weight% (Max @t.MaxScore)
                </option>
            }
        </select>
        <span asp-validation-for="TestID" class="text-danger"></span>

        <!-- Student -->
        <label>Select Student</label>
        <select asp-for="StudentID">
            <option value="">-- Choose a student --</option>

            @foreach (var s in students)
            {
                <option value="@s.StudentID">@s.StudentName (ID: @s.StudentID)</option>
            }
        </select>
        <span asp-validation-for="StudentID" class="text-danger"></span>

        <!-- Score -->
        <label>Score</label>
        <input asp-for="Score" type="number" min="0" step="0.01" />
        <span asp-validation-for="Score" class="text-danger"></span>

        <!-- Buttons -->
        <div class="btn-row">
            <button type="submit" class="btn-save">Save</button>

            <a asp-controller="Teacher"
               asp-action="CourseDetails"
               asp-route-id="@Model.CourseID"
               class="btn-cancel">
                Cancel
            </a>
        </div>

    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
