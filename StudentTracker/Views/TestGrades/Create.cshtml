@model StudentTracker.Models.TestGradeView
@{
    ViewData["Title"] = "Add Test Grade";

    var courseName = ViewBag.CourseName as string ?? "";
    var tests = ViewBag.Tests as List<StudentTracker.Models.TestView>;
    var students = ViewBag.Students as List<StudentTracker.Models.StudentCourseView>;
}

<style>
    body {
        background: linear-gradient(135deg, #001a33, #003c8f);
        font-family: 'Segoe UI', sans-serif;
        color: white;
        margin: 0;
        padding: 0;
    }

    .grade-container {
        max-width: 750px;
        margin: 70px auto;
        background: rgba(255, 255, 255, 0.08);
        padding: 40px;
        border-radius: 20px;
        box-shadow: 0 8px 25px rgba(0, 0, 0, 0.6);
        backdrop-filter: blur(18px);
    }

    h2 {
        text-align: center;
        margin-bottom: 15px;
        color: #aee0ff;
        font-weight: 700;
        font-size: 2rem;
    }

    .subtitle {
        text-align: center;
        color: #cfe6ff;
        margin-bottom: 25px;
        font-size: 1.05rem;
    }

    label {
        font-weight: 600;
        color: #cfe6ff;
        margin-bottom: 6px;
    }

    .form-control, .form-select {
        background: rgba(255,255,255,0.1);
        border: 1px solid rgba(255,255,255,0.25);
        color: white;
        border-radius: 10px;
        padding: 10px;
        margin-bottom: 18px;
    }

    .btn-save {
        background: linear-gradient(135deg, #00c853, #009624);
        color: white;
        border: none;
        padding: 12px 30px;
        font-weight: 600;
        border-radius: 10px;
        min-width: 150px;
    }

    .btn-cancel {
        background: rgba(255,255,255,0.15);
        color: white;
        border-radius: 10px;
        padding: 12px 30px;
        min-width: 150px;
        text-decoration: none;
        border: 1px solid rgba(255,255,255,0.3);
        font-weight: 600;
    }

    .btn-row {
        display: flex;
        justify-content: center;
        gap: 20px;
        margin-top: 25px;
        /* Force dark dropdown (matches textbox) */
        .form-select

    {
        background: rgba(255,255,255,0.1) !important;
        color: #fff !important;
        border: 1px solid rgba(255,255,255,0.25) !important;
        appearance: none;
    }

    /* Make dropdown popup dark */
    select {
        color-scheme: dark;
    }

    /* Make option background match textbox */
    .form-select option {
        background: rgba(255,255,255,0.1) !important;
        color: #fff !important;
    }

        /* REMOVE hover + selected highlight */
        .form-select option:hover,
        .form-select option:checked,
        .form-select option:active,
        .form-select option:focus {
            background: rgba(255,255,255,0.1) !important;
            color: #fff !important;
        }



</style>

<div class="grade-container">
    <h2>➕ Add Grade</h2>
    <div class="subtitle">
        Course: <strong>@courseName</strong> (ID: @Model.CourseID)
    </div>

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger text-center">@ViewBag.Error</div>
    }

    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()

        <input type="hidden" asp-for="CourseID" />

        <!-- Select Test -->
        <label>Select Test</label>
        <select asp-for="TestID" class="form-select">
            <option value="">-- Choose a test --</option>

            @foreach (var t in tests)
            {
                <option value="@t.TestID">
                    @t.TestName (@t.TestDate.ToShortDateString()) – @t.Weight% (Max @t.MaxScore)
                </option>
            }
        </select>
        <span asp-validation-for="TestID" class="text-danger"></span>

        <!-- Select Student -->
        <label>Select Student</label>
        <select asp-for="StudentID" class="form-select">
            <option value="">-- Choose a student --</option>

            @foreach (var s in students)
            {
                <option value="@s.StudentID">@s.StudentName (ID: @s.StudentID)</option>
            }
        </select>
        <span asp-validation-for="StudentID" class="text-danger"></span>

        <!-- Score -->
        <label>Score</label>
        <input asp-for="Score" type="number" class="form-control" min="0" step="0.01" />
        <span asp-validation-for="Score" class="text-danger"></span>

        <!-- Submit -->
        <div class="btn-row">
            <button type="submit" class="btn-save">Save Grade</button>

            <a asp-controller="Teacher"
               asp-action="CourseDetails"
               asp-route-id="@Model.CourseID"
               class="btn-cancel">
                Cancel
            </a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
