@model StudentTracker.Models.TestGradeView

@{
    ViewData["Title"] = "Delete Test Grade";
    var courseId = ViewBag.CourseID;
}

<style>
    body {
        background: linear-gradient(135deg, #001a33, #003c8f);
        font-family: 'Segoe UI', sans-serif;
        color: #fff;
    }

    .delete-wrapper {
        max-width: 600px;
        margin: 100px auto;
        padding: 35px;
        border-radius: 20px;
        backdrop-filter: blur(20px);
        background: rgba(0, 45, 90, 0.75);
        box-shadow: 0 8px 25px rgba(0,0,0,0.6);
        text-align: center;
    }

    h2 {
        font-size: 2rem;
        font-weight: 700;
        margin-bottom: 10px;
        color: #ffcccc;
    }

    p.info {
        color: #e0e0e0;
        font-size: 1.1rem;
        margin-bottom: 25px;
    }

    .details-box {
        background: rgba(255,255,255,0.12);
        padding: 20px;
        border-radius: 15px;
        text-align: left;
        margin-bottom: 30px;
        border: 1px solid rgba(255,255,255,0.2);
    }

        .details-box p {
            margin: 6px 0;
            font-size: 1rem;
        }

    .btn-danger {
        background: linear-gradient(135deg, #ff3d3d, #c62828);
        padding: 12px 25px;
        border-radius: 10px;
        color: #fff;
        font-weight: 700;
        text-decoration: none;
        border: none;
        transition: 0.3s;
    }

        .btn-danger:hover {
            background: linear-gradient(135deg, #c62828, #ff3d3d);
            transform: translateY(-2px);
            box-shadow: 0 0 10px rgba(255,80,80,0.5);
        }

    .btn-back {
        background: #666;
        padding: 12px 25px;
        border-radius: 10px;
        color: #fff;
        text-decoration: none;
        margin-right: 10px;
        font-weight: 600;
        transition: 0.3s;
    }

        .btn-back:hover {
            background: #888;
            transform: translateY(-2px);
        }
</style>

<div class="delete-wrapper">
    <h2>🗑 Confirm Delete</h2>
    <p class="info">Are you sure you want to delete this grade?</p>

    <div class="details-box">
        <p><strong>Grade ID:</strong> @Model.GradeID</p>
        <p><strong>Test ID:</strong> @Model.TestID</p>
        <p><strong>Student ID:</strong> @Model.StudentID</p>
        <p><strong>Score:</strong> @Model.Score</p>
        <p><strong>Validated:</strong> @(Model.IsValidated ? "Yes" : "No")</p>
    </div>

    <form asp-action="Delete" method="post">
        <input type="hidden" name="id" value="@Model.GradeID" />
        <input type="hidden" name="courseId" value="@courseId" />

        <a asp-controller="TestGrades"
           asp-action="Index"
           asp-route-courseId="@courseId"
           class="btn-back">⬅ Cancel</a>

        <button type="submit" class="btn-danger">Delete</button>
    </form>
</div>
