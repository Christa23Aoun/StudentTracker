@model StudentTracker.Models.TestGradeView

@{
    ViewData["Title"] = "Delete Grade";

    var courseId = ViewBag.CourseID;
    var testId = ViewBag.TestID;
    var testName = ViewBag.TestName;
    var courseName = ViewBag.CourseName;
}

<style>
    body {
        background: #f5f7fa;
        font-family: 'Inter', sans-serif;
        margin: 0;
        padding: 0;
        color: #1a2b4c;
    }

    .delete-wrapper {
        width: 92%;
        max-width: 650px;
        margin: 80px auto;
        background: white;
        padding: 40px;
        border-radius: 10px;
        box-shadow: 0px 6px 15px rgba(0,0,0,0.07);
    }

    .page-header {
        border-left: 5px solid #c62828;
        padding-left: 14px;
        margin-bottom: 20px;
    }

        .page-header h1 {
            margin: 0;
            font-size: 28px;
            font-weight: 800;
            color: #c62828;
        }

    .details-box {
        background: #f7f9fc;
        border: 1px solid #e4e9f0;
        padding: 22px;
        border-radius: 8px;
        margin-bottom: 30px;
    }

    .label {
        font-weight: 800;
        color: #003c8f;
    }

    .badge {
        padding: 5px 10px;
        border-radius: 6px;
        font-weight: 700;
        font-size: 14px;
    }

    .badge-green {
        background: #c8f7d4;
        color: #0f7b2d;
    }

    .badge-red {
        background: #ffd4d4;
        color: #9a1a1a;
    }

    .btn-danger, .btn-back {
        padding: 12px 24px;
        border-radius: 6px;
        font-weight: 700;
        text-decoration: none;
    }

    .btn-back {
        background: #5b6e80;
        color: white;
    }

    .btn-danger {
        background: #c62828;
        color: white;
        border: none;
    }
</style>


<div class="delete-wrapper">

    <div class="page-header">
        <h1>Delete Grade</h1>
    </div>

    <p>Are you sure you want to delete this grade?</p>

    <div class="details-box">

        <p><span class="label">Student:</span> @Model.StudentName</p>

        <p><span class="label">Course:</span> @courseName</p>

        <p><span class="label">Test:</span> @testName</p>

        <p><span class="label">Score:</span> @Model.Score</p>

        <p>
            <span class="label">Status:</span>
            @if (Model.IsValidated)
            {
                <span class="badge badge-green">Validated</span>
            }
            else
            {
                <span class="badge badge-red">Pending</span>
            }
        </p>

    </div>
    <form asp-controller="TestGrades" asp-action="DeleteConfirmed" method="post">
        @Html.AntiForgeryToken()

        <input type="hidden" name="id" value="@Model.TestGradeID" />
        <input type="hidden" name="courseId" value="@courseId" />
        <input type="hidden" name="testId" value="@testId" />

        <a asp-controller="TestGrades"
           asp-action="Index"
           asp-route-courseId="@courseId"
           asp-route-testId="@testId"
           class="btn-back">⬅ Cancel</a>

        @if (!Model.IsValidated)
        {
            <button type="submit" class="btn-danger">🗑 Delete</button>
        }
        else
        {
            <span style="color:#c62828; font-weight:700;">
                (Cannot delete validated grade)
            </span>
        }
    </form>

</div>
