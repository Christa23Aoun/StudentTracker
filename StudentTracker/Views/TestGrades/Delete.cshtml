@model StudentTracker.Models.TestGradeView

@{
    ViewData["Title"] = "Delete Test Grade";
    var courseId = ViewBag.CourseID;
}

<style>
    body {
        background: #f5f7fa;
        margin: 0;
        padding: 0;
        font-family: 'Inter', sans-serif;
        color: #1a2b4c;
    }

    .delete-wrapper {
        width: 92%;
        max-width: 650px;
        margin: 80px auto;
        background: #ffffff;
        padding: 40px 45px;
        border-radius: 8px;
        border: 1px solid #d9e1ec;
        box-shadow: 0px 5px 15px rgba(0,0,0,0.07);
        text-align: center;
    }

    .page-header {
        border-left: 5px solid #c62828;
        padding-left: 14px;
        text-align: left;
        margin-bottom: 20px;
    }

        .page-header h1 {
            margin: 0;
            font-size: 28px;
            font-weight: 800;
            color: #c62828;
        }

    .info-text {
        font-size: 15px;
        color: #5b6e80;
        margin-bottom: 20px;
    }

    /* DETAILS BOX */
    .details-box {
        background: #f7f9fc;
        border: 1px solid #e4e9f0;
        padding: 20px 25px;
        border-radius: 8px;
        margin-bottom: 30px;
        text-align: left;
        font-size: 15px;
        color: #1a2b4c;
        line-height: 1.7;
    }

        .details-box strong {
            color: #003c8f;
            font-weight: 700;
        }

    /* BUTTONS */
    .btn-back, .btn-danger {
        padding: 12px 24px;
        border-radius: 6px;
        font-weight: 700;
        text-decoration: none;
        transition: 0.25s ease;
        display: inline-block;
        margin: 5px;
    }

    .btn-back {
        background: #5b6e80;
        color: white;
    }

        .btn-back:hover {
            background: #445664;
        }

    .btn-danger {
        background: #c62828;
        color: white;
        border: none;
    }

        .btn-danger:hover {
            background: #9e1f1f;
        }
</style>

<div class="delete-wrapper">

    <div class="page-header">
        <h1>Delete Grade</h1>
    </div>

    <p class="info-text">Are you sure you want to delete this grade? This action cannot be undone.</p>

    <div class="details-box">
        <p><strong>Grade ID:</strong> @Model.GradeID</p>
        <p><strong>Test ID:</strong> @Model.TestID</p>
        <p><strong>Student ID:</strong> @Model.StudentID</p>
        <p><strong>Score:</strong> @Model.Score</p>
        <p><strong>Validated:</strong> @(Model.IsValidated ? "Yes" : "No")</p>
    </div>

    <form asp-action="Delete" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" name="id" value="@Model.GradeID" />
        <input type="hidden" name="courseId" value="@courseId" />

        <a asp-controller="TestGrades"
           asp-action="Index"
           asp-route-courseId="@courseId"
           class="btn-back">
            ⬅ Cancel
        </a>

        <button type="submit" class="btn-danger">🗑 Delete</button>
    </form>
</div>
