@model StudentTracker.Models.BulkTestGradesView
@{
    ViewData["Title"] = "Add Grades";

    var testName = ViewBag.TestName ?? "Selected Test";
    var courseName = ViewBag.CourseName ?? $"Course {Model.CourseID}";
}

<style>
    body {
        background: #f5f7fa;
        margin: 0;
        padding: 0;
        font-family: 'Inter', sans-serif;
        color: #1a2b4c;
    }

    .bulk-wrapper {
        width: 92%;
        max-width: 1050px;
        margin: 60px auto;
        background: #ffffff;
        padding: 40px 45px;
        border-radius: 8px;
        border: 1px solid #d9e1ec;
        box-shadow: 0px 5px 15px rgba(0,0,0,0.07);
    }

    .page-header {
        border-left: 5px solid #003c8f;
        padding-left: 16px;
        margin-bottom: 25px;
    }

        .page-header h1 {
            margin: 0;
            font-size: 30px;
            font-weight: 800;
            color: #003c8f;
        }

    .subtitle {
        font-size: 15px;
        color: #5b6e80;
        margin-bottom: 25px;
    }

    /* TABLE */
    table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 15px;
    }

    th {
        background: #f1f4f9;
        text-transform: uppercase;
        font-size: 13px;
        font-weight: 700;
        color: #003c8f;
        padding: 12px;
        border-bottom: 1px solid #dce3ed;
    }

    td {
        padding: 12px;
        border-bottom: 1px solid #e8edf4;
        font-size: 14px;
        color: #1a2b4c;
        background: #ffffff;
    }

    tr:nth-child(even) td {
        background: #f9fbfd;
    }

    input[type="number"] {
        width: 100%;
        padding: 10px;
        border: 1px solid #d9e1ec;
        border-radius: 6px;
        background: #f7f9fc;
        color: #1a2b4c;
    }

        input[type="number"]:focus {
            outline: none;
            border-color: #003c8f;
        }

    .alert-danger {
        background: #ffe6e6;
        color: #b30000;
        border: 1px solid #ffcccc;
        padding: 10px;
        border-radius: 6px;
        margin-bottom: 18px;
    }

    /* BUTTONS */
    .btn-save, .btn-cancel {
        padding: 12px 26px;
        border-radius: 8px;
        font-weight: 700;
        text-decoration: none;
        border: none;
        transition: 0.25s ease;
        display: inline-block;
        min-width: 150px;
        text-align: center;
        cursor: pointer;
    }

    .btn-save {
        background: #003c8f;
        color: white;
    }

        .btn-save:hover {
            background: #002c6a;
        }

    .btn-cancel {
        background: #5b6e80;
        color: white;
    }

        .btn-cancel:hover {
            background: #445664;
        }

    .actions-row {
        margin-top: 35px;
        display: flex;
        justify-content: center;
        gap: 22px;
    }
</style>

<div class="bulk-wrapper">

    <div class="page-header">
        <h1>Add Grades</h1>
    </div>

    <div class="subtitle">
        Test: <strong>@testName</strong> — Course: <strong>@courseName</strong>
    </div>

    <form asp-action="BulkCreate" method="post">
        <input type="hidden" asp-for="CourseID" />
        <input type="hidden" asp-for="SelectedTestID" />

        @if (TempData["Error"] != null)
        {
            <div class="alert-danger">@TempData["Error"]</div>
        }

        @if (Model.Students.Any())
        {
            <table>
                <thead>
                    <tr>
                        <th>Student</th>
                        <th>ID</th>
                        <th>Score</th>
                        <th>Status</th>
                    </tr>
                </thead>

                <tbody>
                    @for (int i = 0; i < Model.Students.Count; i++)
                    {
                        <tr>
                            <td>
                                @Model.Students[i].StudentName
                                <input type="hidden" asp-for="Students[i].StudentName" />
                            </td>

                            <td>
                                @Model.Students[i].StudentID
                                <input type="hidden" asp-for="Students[i].StudentID" />
                            </td>

                            <td>
                                <input asp-for="Students[i].Score" type="number" step="0.01" min="0" />
                            </td>

                            <td>
                                <input type="hidden" asp-for="Students[i].IsValidated" value="false" />
                                <span style="color:#5b6e80; font-weight:600;">Pending</span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }

        <div class="actions-row">
            <button type="submit" class="btn-save">Save Grades</button>

            <a asp-controller="Teacher"
               asp-action="CourseDetails"
               asp-route-id="@Model.CourseID"
               class="btn-cancel">
                Cancel
            </a>
        </div>

    </form>
</div>
