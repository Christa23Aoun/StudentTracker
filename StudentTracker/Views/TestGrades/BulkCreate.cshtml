@model StudentTracker.Models.BulkTestGradesView
@{
    ViewData["Title"] = "Add Grades";

    var testName = ViewBag.TestName ?? "Selected Test";
    var courseName = ViewBag.CourseName ?? $"Course {Model.CourseID}";
}

<style>
    body {
        background: linear-gradient(135deg, #001a33, #003c8f);
        font-family: 'Segoe UI', sans-serif;
        color: #fff;
        margin: 0;
    }

    .bulk-wrapper {
        max-width: 1000px;
        margin: 60px auto;
        background: rgba(255, 255, 255, 0.08);
        border-radius: 20px;
        padding: 35px 40px;
        box-shadow: 0 8px 30px rgba(0, 0, 0, 0.5);
        backdrop-filter: blur(20px);
    }

    h2 {
        text-align: center;
        margin-bottom: 25px;
        font-weight: 700;
        color: #aee0ff;
        font-size: 2rem;
    }

    table {
        width: 100%;
        margin-top: 25px;
        border-collapse: collapse;
    }

    th, td {
        padding: 10px 8px;
        border-bottom: 1px solid rgba(255, 255, 255, 0.15);
    }

    th {
        color: #b3e5fc;
        text-transform: uppercase;
        font-size: 0.9rem;
    }

    .form-control {
        background: rgba(255,255,255,0.1);
        border: 1px solid rgba(255,255,255,0.2);
        color: white;
        border-radius: 10px;
        padding: 8px;
    }

    .btn-save {
        background: linear-gradient(135deg, #00c853, #009624);
        color: white;
        border-radius: 10px;
        padding: 10px 30px;
        min-width: 150px;
        font-weight: 600;
    }

    .btn-cancel {
        background: rgba(255, 255, 255, 0.15);
        color: white;
        border-radius: 10px;
        padding: 10px 30px;
        min-width: 150px;
        font-weight: 600;
    }

    .actions-row {
        margin-top: 30px;
        display: flex;
        justify-content: center;
        gap: 20px;
    }
</style>

<div class="bulk-wrapper">

    <!-- ⭐ FIXED TITLE ⭐ -->
    <h2>
        ➕ Add Grades for <span style="color:#fff;">@testName</span> —
        <span style="color:#bfe9ff;">@courseName</span>
    </h2>

    <form asp-action="BulkCreate" method="post">
        <input type="hidden" asp-for="CourseID" />
        <input type="hidden" asp-for="SelectedTestID" />
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger" style="margin-bottom:15px;">
                @TempData["Error"]
            </div>
        }

        <!-- ⭐ Removed ugly Test white input box ⭐ -->
        @if (Model.Students.Any())
        {
            <table>
                <thead>
                    <tr>
                        <th>Student</th>
                        <th>ID</th>
                        <th>Score</th>
                        <th>Validated</th>
                    </tr>
                </thead>

                <tbody>
                    @for (int i = 0; i < Model.Students.Count; i++)
                    {
                        <tr>
                            <td>
                                @Model.Students[i].StudentName
                                <input type="hidden" asp-for="Students[i].StudentName" />
                            </td>

                            <td>
                                @Model.Students[i].StudentID
                                <input type="hidden" asp-for="Students[i].StudentID" />
                            </td>

                            <td>
                                <input asp-for="Students[i].Score" class="form-control" />
                            </td>

                            <td>
                                <input type="hidden" asp-for="Students[i].IsValidated" value="false" />
                                <span style="color:#ccc;">Pending</span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }

        <div class="actions-row">
            <button type="submit" class="btn-save">Save Grades</button>
            <a asp-controller="Teacher"
               asp-action="CourseDetails"
               asp-route-id="@Model.CourseID"
               class="btn-cancel">Cancel</a>
        </div>
    </form>
</div>
