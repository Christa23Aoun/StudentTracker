@model IEnumerable<StudentTracker.Models.TestGradeView>

@{
    ViewData["Title"] = "Test Grades";
    var courseId = ViewBag.CourseID;
    var courseName = ViewBag.CourseName ?? "Course";
    var tests = ViewBag.Tests as List<StudentTracker.Models.TestView> ?? new();
    var selectedTestId = ViewBag.SelectedTestID ?? 0;
    var selectedTestName = ViewBag.TestName as string ?? "";
}

<style>
    body {
        background: #f5f7fa;
        margin: 0;
        padding: 0;
        font-family: 'Inter', sans-serif;
        color: #1a2b4c;
    }

    .wrapper {
        width: 92%;
        max-width: 1300px;
        margin: 60px auto;
    }

    .page-header {
        border-left: 5px solid #003c8f;
        padding-left: 14px;
        margin-bottom: 25px;
    }

        .page-header h1 {
            font-size: 30px;
            font-weight: 800;
            margin: 0;
            color: #003c8f;
        }

    .subtext {
        font-size: 15px;
        color: #5b6e80;
        margin-bottom: 30px;
    }

    /* TEST GRID */
    .tests-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
        gap: 20px;
        margin-bottom: 35px;
    }

    .test-card {
        background: #ffffff;
        border: 1px solid #d9e1ec;
        border-radius: 6px;
        padding: 20px;
        cursor: pointer;
        box-shadow: 0px 4px 10px rgba(0,0,0,0.05);
        transition: 0.25s ease;
        text-align: center;
    }

        .test-card:hover {
            border-color: #003c8f;
            transform: translateY(-4px);
        }

        .test-card.selected {
            border: 2px solid #003c8f;
            background: #f0f6ff;
        }

    .test-title {
        font-size: 17px;
        font-weight: 700;
        color: #003c8f;
    }

    .test-info {
        margin-top: 8px;
        font-size: 14px;
        color: #5b6e80;
        line-height: 1.5;
    }

    /* BUTTONS */
    .button-row {
        display: flex;
        justify-content: center;
        gap: 15px;
        margin-bottom: 40px;
        flex-wrap: wrap;
    }

    .btn-secondary, .btn-primary {
        padding: 12px 22px;
        border-radius: 6px;
        text-decoration: none;
        font-weight: 700;
        transition: 0.25s ease;
        display: inline-block;
    }

    .btn-secondary {
        background: #5b6e80;
        color: white;
    }

        .btn-secondary:hover {
            background: #445664;
        }

    .btn-primary {
        background: #003c8f;
        color: white;
    }

        .btn-primary:hover {
            background: #002a6a;
        }

    /* TABLE */
    .table-container {
        background: #ffffff;
        border: 1px solid #d9e1ec;
        border-radius: 6px;
        box-shadow: 0px 5px 15px rgba(0,0,0,0.06);
        padding: 25px;
    }

    table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 10px;
    }

    thead {
        background: #003c8f;
        color: white;
    }

    th {
        padding: 14px;
        text-align: center;
        font-size: 14px;
        font-weight: 600;
    }

    td {
        padding: 14px;
        text-align: center;
        color: #1a2b4c;
        border-bottom: 1px solid #edf2f7;
    }

    tr:hover {
        background: #f6f9ff;
    }

    /* DELETE BUTTON */
    .btn-danger {
        background: #c62828;
        color: white;
        padding: 7px 14px;
        border-radius: 6px;
        text-decoration: none;
        font-weight: 700;
        transition: 0.25s ease;
        display: inline-block;
    }

        .btn-danger:hover {
            background: #9e1f1f;
        }

</style>

<div class="wrapper">

    <div class="page-header">
        <h1>Grades – @courseName</h1>
    </div>

    <div class="subtext">
        Select a test to view or manage its grades.
    </div>

    <!-- TEST CARDS -->
    <div class="tests-grid">
        @if (tests.Any())
        {
            foreach (var t in tests)
            {
                <div class="test-card @(selectedTestId == t.TestID ? "selected" : "")"
                     onclick="location.href='@Url.Action("Index", new { courseId, testId = t.TestID })'">
                    <div class="test-title">@t.TestName</div>
                    <div class="test-info">
                        @t.TestDate.ToShortDateString()<br />
                        Weight: @t.Weight%<br />
                        Max: @t.MaxScore
                    </div>
                </div>
            }
        }
        else
        {
            <div style="grid-column: 1 / -1; padding:20px; text-align:center; color:#5b6e80;">
                No tests available for this course.
            </div>
        }
    </div>

    <!-- ACTION BUTTONS -->
    <div class="button-row">
        <a asp-controller="Teacher"
           asp-action="CourseDetails"
           asp-route-id="@courseId"
           class="btn-secondary">⬅ Back to Course</a>

        <a asp-action="Create"
           asp-route-courseId="@courseId"
           class="btn-primary">➕ Add Grade</a>
    </div>

    <!-- GRADES TABLE -->
    @if (selectedTestId > 0)
    {
        <h1 style="font-size:24px; font-weight:800; margin-bottom:18px; color:#003c8f;">
            Grades for: @selectedTestName
        </h1>

        <div class="table-container">
            <table>
                <thead>
                    <tr>
                        <th>Student ID</th>
                        <th>Score</th>
                        <th>Validated</th>
                        <th>Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model.Any())
                    {
                        foreach (var g in Model)
                        {
                            <tr>
                                <td>@g.StudentID</td>
                                <td>@g.Score</td>
                                <td>@(g.IsValidated ? "Yes" : "No")</td>
                                <td>
                                    <a asp-action="Delete"
                                       asp-route-id="@g.GradeID"
                                       asp-route-courseId="@courseId"
                                       asp-route-testId="@selectedTestId"
                                       class="btn-danger">
                                        🗑 Delete
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" style="padding:22px; color:#5b6e80;">
                                No grades available for this test.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
