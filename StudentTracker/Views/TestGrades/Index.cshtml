@model IEnumerable<StudentTracker.Models.TestGradeView>

@{
    ViewData["Title"] = "Test Grades";
    var courseId = ViewBag.CourseID;
    var courseName = ViewBag.CourseName ?? "Course";
    var tests = ViewBag.Tests as List<StudentTracker.Models.TestView> ?? new();
    var selectedTestId = ViewBag.SelectedTestID ?? 0;
    var selectedTestName = ViewBag.TestName as string ?? "";
}

<style>
    body {
        background: linear-gradient(135deg, #001f3f, #003c8f);
        font-family: 'Segoe UI', sans-serif;
        color: #fff;
    }

    .wrapper {
        width: 90%;
        max-width: 1200px;
        margin: 70px auto;
    }

    .btn-back, .btn-add {
        background: linear-gradient(135deg, #00bcd4, #1976d2);
        color: white;
        padding: 10px 20px;
        border-radius: 10px;
        font-weight: 600;
        text-decoration: none;
        margin-right: 10px;
        transition: 0.3s;
        text-align: center;
    }

        .btn-back:hover, .btn-add:hover {
            background: linear-gradient(135deg, #1976d2, #00bcd4);
            transform: translateY(-2px);
        }

    h2 {
        font-weight: 700;
        font-size: 2.4rem;
        text-align: center;
        margin-bottom: 10px;
        color: #aee0ff;
    }

    .select-text {
        text-align: center;
        font-size: 1.1rem;
        margin: 20px 0;
        color: #cfd8dc;
    }

    /* TEST CARDS */
    .tests-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap: 20px;
        margin-bottom: 35px;
    }

    .test-card {
        background: rgba(255, 255, 255, 0.12);
        padding: 20px;
        border-radius: 20px;
        text-align: center;
        cursor: pointer;
        transition: 0.3s;
        border: 1px solid rgba(255,255,255,0.15);
    }

        .test-card:hover {
            transform: translateY(-4px);
            background: rgba(255, 255, 255, 0.18);
        }

        .test-card.selected {
            border: 2px solid #00e5ff;
            background: rgba(0, 229, 255, 0.2);
        }

    .test-title {
        font-size: 1.2rem;
        font-weight: 600;
    }

    .test-info {
        font-size: 0.9rem;
        opacity: 0.85;
    }

    .button-center {
        width: 100%;
        display: flex;
        justify-content: center;
        gap: 20px;
        margin-bottom: 30px;
    }

    /* TABLE */
    .table-container {
        background: rgba(255, 255, 255, 0.12);
        backdrop-filter: blur(14px);
        padding: 25px;
        border-radius: 20px;
    }

    table {
        width: 100%;
        color: white;
        border-collapse: collapse;
    }

    th {
        background: rgba(255, 255, 255, 0.1);
        padding: 14px;
        text-transform: uppercase;
    }

    td {
        padding: 14px;
        border-bottom: 1px solid rgba(255,255,255,0.15);
        text-align: center;
    }

    .action-btn {
        background: rgba(255, 90, 90, 0.25);
        color: #fff;
        padding: 6px 12px;
        border-radius: 8px;
        font-weight: 600;
        text-decoration: none;
    }

        .action-btn:hover {
            background: rgba(255, 50, 50, 0.45);
            transform: translateY(-2px);
        }
</style>

<div class="wrapper">


    <!-- TITLE -->
    <h2>🧾 Grades for @courseName</h2>

    <!-- SELECT TEST MESSAGE -->
    <div class="select-text">
        Select a test to display its grades
    </div>

    <!-- TEST CARDS -->
    <div class="tests-grid">
        @if (tests.Any())
        {
            foreach (var t in tests)
            {
                <div class="test-card @(selectedTestId == t.TestID ? "selected" : "")"
                     onclick="location.href='@Url.Action("Index", new { courseId, testId = t.TestID })'">

                    <div class="test-title">@t.TestName</div>
                    <div class="test-info">
                        @t.TestDate.ToShortDateString()<br />
                        Weight: @t.Weight%<br />
                        Max: @t.MaxScore
                    </div>
                </div>
            }
        }
        else
        {
            <div style="grid-column: 1 / -1; text-align:center; color:#ccc; padding:20px;">
                No tests yet for this course.
            </div>
        }
    </div>

    <div class="button-center">
        <a asp-controller="Teacher"
           asp-action="CourseDetails"
           asp-route-id="@courseId"
           class="btn-back">⬅ Back to Course</a>

        <a asp-action="Create"
           asp-route-courseId="@courseId"
           class="btn-add">➕ Add Grade</a>
    </div>

    <!-- SHOW GRADES ONLY IF A TEST IS SELECTED -->
    @if (selectedTestId > 0)
    {
        <h2 style="margin-top:20px;">
            Grades for <strong>@selectedTestName</strong>
        </h2>

        <div class="table-container">
            <table>
                <thead>
                    <tr>
                        
                        <th>Student ID</th>
                        <th>Score</th>
                        <th>Validated</th>
                        <th>Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model.Any())
                    {
                        foreach (var g in Model)
                        {
                            <tr>
                      
                                <td>@g.StudentID</td>
                                <td>@g.Score</td>
                                <td>@(g.IsValidated ? "Yes" : "No")</td>
                                <td>
                                    <a asp-action="Delete"
                                       asp-route-id="@g.GradeID"
                                       asp-route-courseId="@courseId"
                                       asp-route-testId="@selectedTestId"
                                       class="action-btn">🗑 Delete</a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" style="padding:22px; color:#aaa;">
                                No grades available for this test.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
