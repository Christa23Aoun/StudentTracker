@model StudentTracker.Models.LoginView

@{
    ViewData["Title"] = ViewData["Title"] ?? "Login";
}

<style>
    html, body {
        height: 100%;
        background: linear-gradient(135deg, #001a33, #003c8f);
        font-family: 'Segoe UI', sans-serif;
        color: #fff;
        margin: 0;
        padding: 0;
        overflow-x: hidden;
    }

    .login-box {
        max-width: 420px;
        margin: 100px auto;
        background: rgba(0, 45, 90, 0.85);
        border-radius: 25px;
        padding: 45px;
        box-shadow: 0 8px 25px rgba(0,0,0,0.6);
        text-align: center;
        backdrop-filter: blur(25px);
        -webkit-backdrop-filter: blur(25px);
    }

    h3 {
        font-weight: 700;
        margin-bottom: 20px;
        color: #fff;
    }

    .login-role-label {
        background: rgba(0,150,255,0.18);
        border: 1px solid rgba(0,150,255,0.35);
        color: #cfeaff;
        padding: 12px 18px;
        border-radius: 12px;
        text-align: center;
        margin-bottom: 20px;
        font-weight: 600;
        backdrop-filter: blur(6px);
        -webkit-backdrop-filter: blur(6px);
        animation: fadeIn 0.4s ease-out;
    }

    label {
        font-weight: 600;
        color: #cfe6ff;
        margin-bottom: 6px;
    }

    .form-control {
        background: rgba(255, 255, 255, 0.1);
        border: 1px solid rgba(255, 255, 255, 0.25);
        color: #fff;
        border-radius: 10px;
        padding: 12px;
        margin-bottom: 20px;
        transition: all 0.2s ease;
    }

        .form-control:focus {
            border-color: #2196f3;
            box-shadow: 0 0 12px rgba(33,150,243,0.6);
            outline: none;
        }

    .btn-primary {
        width: 100%;
        background: linear-gradient(135deg, #006aff, #0048b3);
        border: none;
        border-radius: 10px;
        padding: 12px;
        color: #fff;
        font-weight: 600;
        transition: 0.3s ease;
    }

        .btn-primary:hover {
            background: linear-gradient(135deg, #007bff, #003f91);
            box-shadow: 0 0 15px rgba(0,150,255,0.6);
            transform: translateY(-2px);
        }

    .alert {
        border-radius: 10px;
        padding: 10px;
        margin-top: 15px;
        background: rgba(255,80,80,0.2);
        color: #ffb3b3;
    }

    @@keyframes fadeIn {
        from

    {
        opacity: 0;
        transform: translateY(-4px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }

    }
</style>

<div class="login-box">

    <h3>🔐 Login</h3>

    @if (ViewBag.Role != null && ViewBag.Role.ToString() != "")
    {
        <div class="login-role-label">
            You are logging in as: <strong>@ViewBag.Role</strong>
        </div>
    }

    <form asp-controller="Auth" asp-action="Login" method="post">
        @Html.AntiForgeryToken()

        <input type="hidden" name="Role" value="@ViewBag.Role" />

        <div class="mb-3 text-start">
            <label class="form-label">Email</label>
            <input asp-for="Email" type="email" class="form-control" placeholder="Enter your email" required />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>

        <div class="mb-3 text-start">
            <label class="form-label">Password</label>
            <input asp-for="Password" type="password" class="form-control" placeholder="Enter your password" required />
            <span asp-validation-for="Password" class="text-danger"></span>
        </div>

        <button type="submit" class="btn-primary">Login</button>

        @if (ViewBag.Error != null)
        {
            <div class="alert">@ViewBag.Error</div>
        }
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
