@model StudentTracker.Models.LoginView

@{
    ViewData["Title"] = ViewData["Title"] ?? "Login";
}

<style>
    html, body {
        height: 100%;
        background: #f5f7fa;
        margin: 0;
        padding: 0;
        font-family: 'Inter', sans-serif;
        color: #1a2b4c;
    }

    .login-box {
        width: 92%;
        max-width: 420px;
        margin: 100px auto;
        background: #ffffff;
        border-radius: 8px;
        padding: 45px;
        border: 1px solid #d9e1ec;
        box-shadow: 0px 5px 15px rgba(0,0,0,0.07);
    }

    .page-header {
        border-left: 5px solid #003c8f;
        padding-left: 14px;
        margin-bottom: 25px;
        text-align: left;
    }

        .page-header h1 {
            margin: 0;
            font-size: 28px;
            font-weight: 800;
            color: #003c8f;
        }

    /* Role Label */
    .login-role-label {
        background: #f1f4f9;
        border: 1px solid #dde4ee;
        color: #003c8f;
        padding: 12px 14px;
        border-radius: 6px;
        font-weight: 600;
        margin-bottom: 20px;
        text-align: center;
    }

    label {
        font-weight: 600;
        color: #003c8f;
        margin-bottom: 6px;
        display: inline-block;
    }

    .form-control {
        background: #f7f9fc;
        border: 1px solid #d9e1ec;
        border-radius: 6px;
        padding: 12px;
        color: #1a2b4c;
        width: 100%;
        margin-bottom: 18px;
        transition: 0.25s ease;
    }

        .form-control:focus {
            border-color: #003c8f;
            outline: none;
        }

    .btn-primary {
        width: 100%;
        background: #003c8f;
        border: none;
        border-radius: 6px;
        padding: 12px;
        color: white;
        font-weight: 700;
        transition: 0.25s ease;
        margin-top: 10px;
    }

        .btn-primary:hover {
            background: #002c6a;
        }

    /* Error Message */
    .alert {
        border-radius: 6px;
        padding: 10px 12px;
        margin-top: 15px;
        background: #ffe6e6;
        border: 1px solid #ffcccc;
        color: #b30000;
        font-size: 14px;
    }
</style>

<div class="login-box">

    <div class="page-header">
        <h1>Login</h1>
    </div>

    @if (ViewBag.Role != null && ViewBag.Role.ToString() != "")
    {
        <div class="login-role-label">
            You are logging in as <strong>@ViewBag.Role</strong>
        </div>
    }

    <form asp-controller="Auth" asp-action="Login" method="post">
        @Html.AntiForgeryToken()

        <input type="hidden" name="Role" value="@ViewBag.Role" />

        <!-- Email -->
        <label>Email</label>
        <input asp-for="Email" type="email" class="form-control" placeholder="Enter your email" required />
        <span asp-validation-for="Email" class="text-danger"></span>

        <!-- Password -->
        <label>Password</label>
        <input asp-for="Password" type="password" class="form-control" placeholder="Enter your password" required />
        <span asp-validation-for="Password" class="text-danger"></span>

        <!-- Submit -->
        <button type="submit" class="btn-primary">Login</button>

        <!-- Error message -->
        @if (ViewBag.Error != null)
        {
            <div class="alert">@ViewBag.Error</div>
        }
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
