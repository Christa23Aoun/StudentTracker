@model StudentTracker.Models.RegisterView

@{
    ViewData["Title"] = "Register";
}

<style>
    body {
        background: linear-gradient(135deg, #001a33, #003c8f);
        font-family: 'Segoe UI', sans-serif;
        color: #fff;
        margin: 0;
        padding: 0;
    }

    .register-box {
        max-width: 450px;
        margin: 100px auto;
        background: rgba(0, 45, 90, 0.85);
        border-radius: 25px;
        padding: 45px;
        box-shadow: 0 8px 25px rgba(0, 0, 0, 0.6);
        backdrop-filter: blur(25px);
        -webkit-backdrop-filter: blur(25px);
    }

    h3 {
        text-align: center;
        font-weight: 700;
        margin-bottom: 30px;
        color: #ffffff;
    }

    label {
        font-weight: 600;
        color: #cfe6ff;
        margin-bottom: 6px;
    }

    .form-control,
    .form-select {
        background: rgba(255, 255, 255, 0.1);
        border: 1px solid rgba(255, 255, 255, 0.25);
        color: #fff;
        border-radius: 10px;
        padding: 12px;
        margin-bottom: 20px;
        transition: all 0.2s ease;
    }

        .form-control:focus,
        .form-select:focus {
            border-color: #2196f3;
            box-shadow: 0 0 12px rgba(33, 150, 243, 0.6);
            outline: none;
        }

        .form-select option {
            background-color: #00284d;
            color: #fff;
        }

    .btn-primary {
        width: 100%;
        background: linear-gradient(135deg, #006aff, #0048b3);
        border: none;
        border-radius: 10px;
        padding: 12px;
        color: #fff;
        font-weight: 600;
        transition: all 0.3s ease;
    }

        .btn-primary:hover {
            background: linear-gradient(135deg, #007bff, #003f91);
            box-shadow: 0 0 15px rgba(0, 150, 255, 0.6);
            transform: translateY(-2px);
        }

    .alert {
        border-radius: 10px;
        padding: 10px;
        margin-top: 15px;
        background: rgba(255, 80, 80, 0.2);
        color: #ffb3b3;
        text-align: center;
    }

    a {
        color: #aee0ff;
        text-decoration: none;
    }

        a:hover {
            text-decoration: underline;
        }

    .text-center {
        text-align: center;
    }
</style>

<div class="register-box">
    <h3>📝 Create Account</h3>

    <form asp-action="Register" method="post">
        @Html.AntiForgeryToken()

        <div class="mb-3 text-start">
            <label class="form-label">Full Name</label>
            <input asp-for="FullName" class="form-control" placeholder="Enter your full name" required />
            <span asp-validation-for="FullName" class="text-danger"></span>
        </div>

        <div class="mb-3 text-start">
            <label class="form-label">Email</label>
            <input asp-for="Email" type="email" class="form-control" placeholder="Enter your email" required />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>

        <div class="mb-3 text-start">
            <label class="form-label">Password</label>
            <input asp-for="Password" type="password" class="form-control" placeholder="Create a password" required />
            <span asp-validation-for="Password" class="text-danger"></span>
        </div>

        <div class="mb-3 text-start">
            <label class="form-label">Role</label>
            <select asp-for="RoleID" class="form-select" required>
                <option value="">-- Select Role --</option>
                <option value="1">Admin</option>
                <option value="2">Teacher</option>
                <option value="3">Student</option>
            </select>
            <span asp-validation-for="RoleID" class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-primary">Register</button>

        <div class="text-center mt-3">
            <a asp-action="Login" class="text-decoration-none">Already have an account? Login</a>
        </div>

        @if (ViewBag.Error != null)
        {
            <div class="alert mt-3">@ViewBag.Error</div>
        }
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
