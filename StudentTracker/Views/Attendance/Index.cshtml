<div class="attendance-page">
    <div class="attendance-container">

        <div class="page-header">
            <h1>Attendance</h1>
        </div>

        <div class="top-actions">
            <a class="btn-primary"
               asp-action="Create"
               asp-route-courseId="@courseId">
                Add Attendance
            </a>

            <a class="btn-secondary"
               asp-controller="Teacher"
               asp-action="CourseDetails"
               asp-route-id="@courseId">
                ⬅ Back to Course
            </a>
        </div>

        <div class="layout">

            <div class="sessions">
                <div class="sessions-header">Sessions</div>

                @if (!sessions.Any())
                {
                    <div class="hint">No sessions found for this course.</div>
                }
                else
                {
                    foreach (var s in sessions.OrderByDescending(x => x.SessionDate))
                    {
                        <a asp-action="Index"
                           asp-route-courseId="@courseId"
                           asp-route-sessionId="@s.SessionID"
                           class="@(selectedSessionId == s.SessionID ? "active" : "")">
                            @s.SessionDate.ToString("dd/MM/yyyy")
                            (@s.StartTime.ToString(@"hh\:mm") - @s.EndTime.ToString(@"hh\:mm"))
                        </a>
                    }
                }
            </div>

            <div class="panel">
                <div class="panel-header">
                    <div>
                        Attendance List
                        <div class="panel-sub">
                            @(selectedSessionId == null ? "Select a session to view attendance." : $"Session ID: {selectedSessionId}")
                        </div>
                    </div>
                </div>

                @if (selectedSessionId == null)
                {
                    <div class="hint">Click a session on the left to display students attendance.</div>
                }
                else if (!Model.Any())
                {
                    <div class="hint">No attendance recorded for this session.</div>
                }
                else
                {
                    <table>
                        <thead>
                            <tr>
                                <th>Student</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>@item.StudentName</td>
                                    <td class="@(item.IsPresent ? "present" : "absent")">
                                        @(item.IsPresent ? "Present ✔" : "Absent ✘")
                                    </td>
                                    <td>
                                        <a class="btn-danger"
                                           asp-action="Delete"
                                           asp-route-id="@item.AttendanceID"
                                           asp-route-courseId="@courseId"
                                           asp-route-sessionId="@selectedSessionId"
                                           onclick="return confirm('Delete this attendance record?');">
                                            Delete
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }

            </div>

        </div>

    </div>
</div>
 *@
@model List<StudentTracker.Models.AttendanceView>
@{
    ViewData["Title"] = "Attendance";

    int courseId = (int)(ViewBag.CourseID ?? 0);
    int? selectedSessionId = ViewBag.SelectedSessionId as int?;
    var sessions = ViewBag.Sessions as List<StudentTracker.Models.CourseSessionView> ?? new();

    var courseName = (string?)ViewBag.CourseName;
    if (string.IsNullOrWhiteSpace(courseName))
    {
        courseName = "";
    }
}
<style>
    .attendance-page {
        background: #f5f7fa;
        font-family: 'Inter', sans-serif;
        color: #1a2b4c;
        padding: 70px 0;
        min-height: calc(100vh - 200px);
    }

    .attendance-container {
        width: 92%;
        max-width: 1300px;
        margin: 0 auto;
        background: #ffffff;
        border: 1px solid #d9e1ec;
        border-radius: 8px;
        padding: 35px;
        box-shadow: 0px 4px 12px rgba(0,0,0,0.06);
    }

    .page-header {
        text-align: left;
        margin-bottom: 25px;
        border-left: 5px solid #003c8f;
        padding-left: 18px;
    }

        .page-header h1 {
            font-size: 30px;
            font-weight: 800;
            margin: 0;
            color: #003c8f;
            line-height: 1.2;
        }

        .page-header .sub {
            margin-top: 6px;
            color: #5b6e80;
            font-weight: 600;
            font-size: 14px;
        }

    .top-actions {
        display: flex;
        justify-content: space-between;
        margin-bottom: 22px;
        flex-wrap: wrap;
        gap: 10px;
    }

    .btn-primary {
        background: #003c8f;
        color: white;
        padding: 12px 22px;
        border-radius: 6px;
        font-weight: 700;
        text-decoration: none;
        transition: 0.25s ease;
        display: inline-block;
    }

        .btn-primary:hover {
            background: #002a6a;
        }

    .btn-secondary {
        background: #5b6e80;
        color: white;
        padding: 12px 22px;
        border-radius: 6px;
        font-weight: 700;
        text-decoration: none;
        transition: 0.25s ease;
        display: inline-block;
    }

        .btn-secondary:hover {
            background: #445664;
        }

    .layout {
        display: grid;
        grid-template-columns: 330px 1fr;
        gap: 22px;
        margin-top: 10px;
    }

    .sessions {
        border: 1px solid #d9e1ec;
        border-radius: 8px;
        overflow: hidden;
        background: #ffffff;
        box-shadow: 0px 4px 10px rgba(0,0,0,0.06);
        height: fit-content;
    }

    .sessions-header {
        background: #003c8f;
        color: #ffffff;
        padding: 14px;
        font-weight: 800;
        text-align: left;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .sessions-count {
        font-weight: 700;
        opacity: .9;
        font-size: 13px;
    }

    .sessions a {
        display: block;
        padding: 14px;
        border-bottom: 1px solid #edf2f7;
        text-decoration: none;
        color: #1a2b4c;
        font-weight: 650;
        transition: 0.2s ease;
    }

        .sessions a:hover {
            background: #f0f6ff;
        }

        .sessions a.active {
            background: #e6f0ff;
            color: #003c8f;
            border-left: 4px solid #003c8f;
            padding-left: 10px;
        }

    .panel {
        background: #ffffff;
        border: 1px solid #d9e1ec;
        border-radius: 8px;
        overflow: hidden;
        box-shadow: 0px 4px 10px rgba(0,0,0,0.06);
        min-height: 240px;
    }

    .panel-empty {
        padding: 28px;
        color: #5b6e80;
        font-weight: 650;
    }

    table {
        width: 100%;
        border-collapse: collapse;
    }

    thead {
        background: #003c8f;
        color: white;
    }

    th {
        padding: 14px;
        font-size: 15px;
        font-weight: 800;
        text-align: center;
    }

    td {
        padding: 14px;
        text-align: center;
        border-bottom: 1px solid #edf2f7;
        color: #1a2b4c;
        font-weight: 600;
    }

    tr:hover {
        background: #f0f6ff;
    }

    .present {
        font-weight: 800;
        color: #0a7d2c;
    }

    .absent {
        font-weight: 800;
        color: #b30000;
    }

    .btn-danger {
        background: #c62828;
        padding: 7px 16px;
        border-radius: 6px;
        font-weight: 800;
        color: white;
        text-decoration: none;
        transition: 0.25s ease;
        display: inline-block;
    }

        .btn-danger:hover {
            background: #a71f1f;
        }

    .hint {
        padding: 18px;
        color: #5b6e80;
        font-weight: 650;
    }
</style>

<div class="attendance-page">
    <div class="attendance-container">

        <div class="page-header">
            @if (!string.IsNullOrWhiteSpace(courseName))
            {
                <h1>Attendance for @courseName</h1>
            }
            else
            {
                <h1>Attendance</h1>
            }
            <div class="sub">Choose a session to view recorded attendance.</div>
        </div>

        <div class="top-actions">
            <a class="btn-primary"
               asp-action="Create"
               asp-route-courseId="@courseId">
                Add Attendance
            </a>

            <a class="btn-secondary"
               asp-controller="Teacher"
               asp-action="CourseDetails"
               asp-route-id="@courseId">
                ⬅ Back to Course
            </a>
        </div>

        <div class="layout">

            <div class="sessions">
                <div class="sessions-header">
                    <span>Sessions</span>
                    <span class="sessions-count">@sessions.Count</span>
                </div>

                @if (!sessions.Any())
                {
                    <div class="hint">No sessions with recorded attendance yet.</div>
                }
                else
                {
                    foreach (var s in sessions.OrderByDescending(x => x.SessionDate).ThenByDescending(x => x.StartTime))
                    {
                        <a asp-action="Index"
                           asp-route-courseId="@courseId"
                           asp-route-sessionId="@s.SessionID"
                           class="@(selectedSessionId == s.SessionID ? "active" : "")">
                            @s.SessionDate.ToString("dd/MM/yyyy")
                            (@s.StartTime.ToString(@"hh\:mm") - @s.EndTime.ToString(@"hh\:mm"))
                        </a>
                    }
                }
            </div>

            <div class="panel">
                @if (selectedSessionId == null)
                {
                    <div class="panel-empty">Select a session </div>
                }
                else if (!Model.Any())
                {
                    <div class="panel-empty">No attendance found for the selected session.</div>
                }
                else
                {
                    <table>
                        <thead>
                            <tr>
                                <th>Student</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>@item.StudentName</td>
                                    <td class="@(item.IsPresent ? "present" : "absent")">
                                        @(item.IsPresent ? "Present" : "Absent")
                                    </td>
                                    <td>
                                        <a class="btn-danger"
                                           asp-action="Delete"
                                           asp-route-id="@item.AttendanceID"
                                           asp-route-courseId="@courseId"
                                           asp-route-sessionId="@selectedSessionId"
                                           onclick="return confirm('Delete this attendance record?');">
                                            Delete
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>

        </div>

    </div>
</div>
