@model List<StudentTracker.Models.AttendanceView>

@{
    ViewData["Title"] = "Attendance Records";
    var courseId = ViewBag.CourseID;
}

<style>
    body {
        background: #f5f7fa;
        margin: 0;
        padding: 0;
        font-family: 'Inter', sans-serif;
        color: #1a2b4c;
    }

    .attendance-container {
        width: 92%;
        max-width: 1300px;
        margin: 70px auto;
        background: #ffffff;
        border: 1px solid #d9e1ec;
        border-radius: 8px;
        padding: 35px;
        box-shadow: 0px 4px 12px rgba(0,0,0,0.06);
    }

    .page-header {
        text-align: left;
        margin-bottom: 35px;
        border-left: 5px solid #003c8f;
        padding-left: 18px;
    }

        .page-header h1 {
            font-size: 32px;
            font-weight: 800;
            margin: 0;
            color: #003c8f;
        }

    /* ACTION BUTTONS */
    .top-actions {
        display: flex;
        justify-content: space-between;
        margin-bottom: 25px;
        flex-wrap: wrap;
        gap: 10px;
    }

    .btn-primary {
        background: #003c8f;
        color: white;
        padding: 12px 22px;
        border-radius: 6px;
        font-weight: 600;
        text-decoration: none;
        transition: 0.25s ease;
    }

        .btn-primary:hover {
            background: #002a6a;
        }

    .btn-secondary {
        background: #5b6e80;
        color: white;
        padding: 12px 22px;
        border-radius: 6px;
        font-weight: 600;
        text-decoration: none;
        transition: 0.25s ease;
    }

        .btn-secondary:hover {
            background: #445664;
        }

    /* FILTERS */
    .filters {
        display: flex;
        gap: 15px;
        margin-bottom: 20px;
        flex-wrap: wrap;
    }

        .filters input {
            padding: 9px 12px;
            border-radius: 6px;
            border: 1px solid #d9e1ec;
            background: #ffffff;
            color: #1a2b4c;
            width: 200px;
        }

    /* TABLE */
    table {
        width: 100%;
        border-collapse: collapse;
        border: 1px solid #d9e1ec;
        border-radius: 6px;
        overflow: hidden;
        box-shadow: 0px 4px 10px rgba(0,0,0,0.06);
    }

    thead {
        background: #003c8f;
        color: white;
    }

    th {
        padding: 14px;
        font-size: 15px;
        font-weight: 600;
        text-align: center;
    }

    td {
        padding: 14px;
        text-align: center;
        border-bottom: 1px solid #edf2f7;
        color: #1a2b4c;
    }

    tr:hover {
        background: #f0f6ff;
    }

    /* DELETE BUTTON */
    .btn-danger {
        background: #c62828;
        padding: 7px 16px;
        border-radius: 6px;
        font-weight: 600;
        color: white;
        text-decoration: none;
        transition: 0.25s ease;
    }

        .btn-danger:hover {
            background: #a71f1f;
        }
</style>

<div class="attendance-container">

    <div class="page-header">
        <h1>Attendance Records</h1>
    </div>

    <div class="top-actions">
        <a class="btn-primary"
           asp-action="Create"
           asp-route-courseId="@courseId">
            Mark Attendance
        </a>

        <a class="btn-secondary"
           asp-controller="Teacher"
           asp-action="CourseDetails"
           asp-route-id="@courseId">
            ⬅ Back to Course
        </a>
    </div>

    <!-- FILTERS -->
    <div class="filters">
        <input type="date" id="filterDate" />
        <input type="text" id="filterName" placeholder="Search student name..." />
    </div>

    <table id="attendanceTable">
        <thead>
            <tr>
                <th>Student</th>
                <th>Course</th>
                <th>Date & Time</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>

        <tbody>
            @if (Model.Any())
            {
                foreach (var item in Model)
                {
                    <tr>
                        <td class="student-name">@item.StudentName</td>
                        <td>@item.CourseName</td>
                        <td class="date-cell">@item.AttendanceDate.ToString("yyyy-MM-dd HH:mm")</td>

                        <td style="font-weight:600; color:@(item.IsPresent ? "#0a7d2c" : "#b30000")">
                            @(item.IsPresent ? "Present ✔" : "Absent ✘")
                        </td>

                        <td>
                            <a class="btn-danger"
                               href="/Attendance/Delete?id=@item.AttendanceID&courseId=@courseId">
                                Delete
                            </a>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr><td colspan="6" style="padding:20px; color:#5b6e80;">No attendance records found.</td></tr>
            }
        </tbody>
    </table>
</div>

<script>
    const filterDate = document.getElementById("filterDate");
    const filterName = document.getElementById("filterName");
    const rows = document.querySelectorAll("#attendanceTable tbody tr");

    function applyFilters() {
        const dateValue = filterDate.value;
        const nameValue = filterName.value.toLowerCase();

        rows.forEach(row => {
            const dateText = row.querySelector(".date-cell").textContent.substring(0,10);
            const studentName = row.querySelector(".student-name").textContent.toLowerCase();

            let matchDate = !dateValue || dateText === dateValue;
            let matchName = !nameValue || studentName.includes(nameValue);

            row.style.display = (matchDate && matchName) ? "" : "none";
        });
    }

    filterDate.addEventListener("change", applyFilters);
    filterName.addEventListener("keyup", applyFilters);
</script>
