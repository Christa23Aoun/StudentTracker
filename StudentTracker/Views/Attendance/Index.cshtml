@model List<StudentTracker.Models.AttendanceView>

@{
    ViewData["Title"] = "Attendance Records";
    var courseId = ViewBag.CourseID;
}

<style>
    body {
        background: linear-gradient(135deg, #001a33, #003c8f);
        font-family: 'Segoe UI', sans-serif;
        color: #fff;
        margin: 0;
        padding: 0;
    }

    .container {
        max-width: 1100px;
        margin: 80px auto;
        background: rgba(0, 45, 90, 0.75);
        border-radius: 20px;
        backdrop-filter: blur(25px);
        padding: 40px 50px;
        box-shadow: 0 8px 25px rgba(0, 0, 0, 0.6);
    }

    h2 {
        text-align: center;
        font-weight: 700;
        margin-bottom: 30px;
        color: #fff;
    }

    .top-actions {
        display: flex;
        justify-content: space-between;
        margin-bottom: 25px;
    }

    .btn-primary, .btn-secondary {
        background: linear-gradient(135deg, #006aff, #0048b3);
        border: none;
        border-radius: 10px;
        padding: 12px 22px;
        color: #fff;
        font-weight: 600;
        text-decoration: none;
        transition: 0.3s;
    }

    .btn-secondary {
        background: #666;
    }

    .btn-primary:hover {
        background: linear-gradient(135deg, #0056d2, #007bff);
        transform: translateY(-2px);
        box-shadow: 0 0 10px rgba(0,150,255,0.6);
    }

    .filters {
        display: flex;
        gap: 15px;
        margin-bottom: 20px;
    }

        .filters input {
            padding: 8px 12px;
            border-radius: 8px;
            border: 1px solid rgba(255,255,255,0.3);
            background: rgba(255,255,255,0.1);
            color: #fff;
        }

    table {
        width: 100%;
        border-collapse: collapse;
        color: #fff;
        margin-top: 20px;
    }

    thead {
        background: rgba(0, 90, 180, 0.6);
    }

    th, td {
        padding: 14px;
        text-align: center;
        border-bottom: 1px solid rgba(255,255,255,0.1);
    }

    tbody tr:hover {
        background: rgba(255,255,255,0.1);
        transition: 0.3s;
    }

    .btn-danger {
        background: linear-gradient(135deg, #ff3d3d, #c62828);
        border: none;
        border-radius: 8px;
        padding: 6px 14px;
        color: #fff;
        font-weight: 600;
        transition: 0.3s;
    }
</style>

<div class="container">

    <h2>🗓️ Attendance Records</h2>

    <div class="top-actions">
        <a class="btn-primary"
           asp-action="Create"
           asp-route-courseId="@courseId">
            📋 Mark Attendance
        </a>

        <a class="btn-secondary"
           asp-controller="Teacher"
           asp-action="CourseDetails"
           asp-route-id="@courseId">
            ⬅ Back to Course
        </a>
    </div>

    <!-- FILTERS -->
    <div class="filters">
        <input type="date" id="filterDate" />
        <input type="text" id="filterName" placeholder="Search by student name..." />
    </div>

    <table id="attendanceTable">
        <thead>
            <tr>
                
                <th>Student</th>
                <th>Course</th>
                <th>Date & Time</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>

        <tbody>
            @if (Model.Any())
            {
                foreach (var item in Model)
                {
                    <tr>
                     
                        <td class="student-name">@item.StudentName</td>
                        <td>@item.CourseName</td>

                        <td class="date-cell">@item.AttendanceDate.ToString("yyyy-MM-dd HH:mm")</td>

                        <td class="@(item.IsPresent ? "status-yes" : "status-no")">
                            @(item.IsPresent ? "Present ✅" : "Absent ❌")
                        </td>

                        <td>
                            <a class="btn-danger"
                               asp-action="Delete"
                               asp-route-id="@item.AttendanceID"
                               asp-route-courseId="@courseId">
                                🗑️ Delete
                            </a>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr><td colspan="6" class="text-center py-4">No attendance records found.</td></tr>
            }
        </tbody>
    </table>
</div>

<script>
    const filterDate = document.getElementById("filterDate");
    const filterName = document.getElementById("filterName");
    const rows = document.querySelectorAll("#attendanceTable tbody tr");

    function applyFilters() {
        const dateValue = filterDate.value;
        const nameValue = filterName.value.toLowerCase();

        rows.forEach(row => {
            const dateText = row.querySelector(".date-cell").textContent.substring(0,10);
            const studentName = row.querySelector(".student-name").textContent.toLowerCase();

            let matchDate = !dateValue || dateText === dateValue;
            let matchName = !nameValue || studentName.includes(nameValue);

            row.style.display = (matchDate && matchName) ? "" : "none";
        });
    }

    filterDate.addEventListener("change", applyFilters);
    filterName.addEventListener("keyup", applyFilters);
</script>
