@model List<StudentTracker.Models.AttendanceView>

@using StudentTracker.Controllers

@{
    ViewData["Title"] = "Attendance";

    int courseId = (int)(ViewBag.CourseID ?? 0);
    int? selectedSessionId = ViewBag.SelectedSessionId as int?;

    var sessions = ViewBag.Sessions as List<StudentTracker.Models.CourseSessionView>
                   ?? new List<StudentTracker.Models.CourseSessionView>();

    var semesters = ViewBag.Semesters as List<AttendanceController.SemesterOptionView>
                    ?? new List<AttendanceController.SemesterOptionView>();

    int selectedSemesterId = ViewBag.SelectedSemesterId != null
        ? (int)ViewBag.SelectedSemesterId
        : (semesters.Any() ? semesters.First().SemesterID : 0);

    var courseName = ViewBag.CourseName as string ?? "";
}

<style>
    .attendance-page {
        background: #f5f7fa;
        padding: 70px 0;
        min-height: calc(100vh - 200px);
        font-family: 'Inter', sans-serif;
    }

    .attendance-container {
        width: 92%;
        max-width: 1350px;
        margin: auto;
        background: #fff;
        border-radius: 14px;
        padding: 40px;
        box-shadow: 0 10px 30px rgba(0,0,0,.08);
    }

    .header {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        flex-wrap: wrap;
        gap: 20px;
        margin-bottom: 30px;
    }

    .header-left h2 {
        margin: 0;
        font-size: 32px;
        font-weight: 900;
        color: #003c8f;
    }

    .header-left p {
        margin-top: 6px;
        color: #5b6e80;
        font-weight: 600;
    }

    .header-right {
        display: flex;
        gap: 12px;
        flex-wrap: wrap;
        align-items: center;
    }

    select {
        padding: 12px 14px;
        border-radius: 8px;
        border: 1px solid #d0d7e2;
        font-weight: 700;
        background: #fff;
    }

    .btn-primary {
        background: #003c8f;
        color: #fff;
        padding: 12px 22px;
        border-radius: 8px;
        font-weight: 800;
        text-decoration: none;
        transition: .2s;
    }

        .btn-primary:hover {
            background: #002a6a;
            color: #fff;
        }

    .btn-secondary {
        background: #5b6e80;
        color: #fff;
        padding: 12px 22px;
        border-radius: 8px;
        font-weight: 800;
        text-decoration: none;
        transition: .2s;
    }

        .btn-secondary:hover {
            background: #445664;
            color: #fff;
        }

    .layout {
        display: grid;
        grid-template-columns: 320px 1fr;
        gap: 24px;
        margin-top: 20px;
    }

    .sessions {
        border: 1px solid #e1e6ef;
        border-radius: 12px;
        overflow: hidden;
        background: #fff;
    }

    .sessions-header {
        background: #003c8f;
        color: #fff;
        padding: 16px;
        font-weight: 900;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .session-item {
        display: block;
        padding: 15px 16px;
        border-bottom: 1px solid #edf1f6;
        text-decoration: none;
        color: #003c8f;
        font-weight: 700;
        transition: .15s;
    }

        .session-item:hover {
            background: #f0f6ff;
        }

        .session-item.active {
            background: #e6f0ff;
            border-left: 5px solid #003c8f;
        }

    .panel {
        border: 1px solid #e1e6ef;
        border-radius: 12px;
        padding: 28px;
        background: #fff;
        min-height: 240px;
    }

    .empty-state {
        text-align: center;
        color: #5b6e80;
        font-weight: 700;
        font-size: 16px;
        padding-top: 40px;
    }

    table {
        width: 100%;
        border-collapse: collapse;
    }

    thead {
        background: #003c8f;
        color: #fff;
    }

    th, td {
        padding: 14px;
        text-align: left;
        font-weight: 700;
    }

    tbody tr {
        border-bottom: 1px solid #edf1f6;
    }

        tbody tr:hover {
            background: #f7fbff;
        }
</style>

<div class="attendance-page">
    <div class="attendance-container">

        <div class="header">
            <div class="header-left">
                <h2>Attendance : @courseName</h2>
                <p>Select a semester and session to view attendance</p>
            </div>

            <div class="header-right">
                <form method="get" asp-action="Index">
                    <input type="hidden" name="courseId" value="@courseId" />
                    <select name="semesterId" onchange="this.form.submit()">
                        @foreach (var sem in semesters)
                        {
                            if (sem.SemesterID == selectedSemesterId)
                            {
                                <option value="@sem.SemesterID" selected>@sem.Name</option>
                            }
                            else
                            {
                                <option value="@sem.SemesterID">@sem.Name</option>
                            }
                        }
                    </select>
                </form>

                <a class="btn-primary"
                   asp-action="Create"
                   asp-route-courseId="@courseId"
                   asp-route-semesterId="@selectedSemesterId">
                    Add Attendance
                </a>

                <a class="btn-secondary"
                   asp-controller="Teacher"
                   asp-action="CourseDetails"
                   asp-route-id="@courseId">
                    ← Back
                </a>
            </div>
        </div>

        <div class="layout">

            <div class="sessions">
                <div class="sessions-header">
                    <span>Sessions</span>
                    <span>@sessions.Count</span>
                </div>

                @if (!sessions.Any())
                {
                    <div class="empty-state">No sessions with attendance</div>
                }
                else
                {
                    @foreach (var s in sessions)
                    {
                        <a class="session-item @(selectedSessionId == s.SessionID ? "active" : "")"
                           asp-action="Index"
                           asp-route-courseId="@courseId"
                           asp-route-semesterId="@selectedSemesterId"
                           asp-route-sessionId="@s.SessionID">
                            @s.SessionDate.ToString("dd/MM/yyyy")
                            (@s.StartTime - @s.EndTime)
                        </a>
                    }
                }
            </div>

            <div class="panel">
                @if (selectedSessionId == null)
                {
                    <div class="empty-state">Select a session to view attendance</div>
                }
                else if (!Model.Any())
                {
                    <div class="empty-state">No attendance recorded for this session</div>
                }
                else
                {
                    <table>
                        <thead>
                            <tr>
                                <th>Student</th>
                                <th>Status</th>
                                <th>Actions</th>

                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var a in Model)
                            {
                                <tr>
                                    <td>@a.StudentName</td>
                                    <td style="color:@(a.IsPresent ? "#1b8f3c" : "#c62828"); font-weight:900;">
                                        @(a.IsPresent ? "Present" : "Absent")
                                    </td>
                                    <td>
                                        <a asp-action="Edit"
                                           asp-route-id="@a.AttendanceID"
                                           asp-route-courseId="@courseId"
                                           asp-route-sessionId="@selectedSessionId"
                                           asp-route-semesterId="@selectedSemesterId"
                                           style="margin-right:10px; color:#003c8f; font-weight:800;">
                                            Edit
                                        </a>

                                        <form asp-action="Delete"
                                              method="post"
                                              style="display:inline;">
                                            <input type="hidden" name="id" value="@a.AttendanceID" />
                                            <input type="hidden" name="courseId" value="@courseId" />
                                            <input type="hidden" name="sessionId" value="@selectedSessionId" />
                                            <input type="hidden" name="semesterId" value="@selectedSemesterId" />
                                            <button type="submit"
                                                    style="background:none;border:none;color:#c62828;font-weight:800;cursor:pointer;">
                                                Delete
                                            </button>
                                        </form>
                                    </td>

                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>

        </div>
    </div>
</div>
