@model List<StudentTracker.Models.AttendanceView>

@{
    ViewData["Title"] = "Attendance Records";
}

<style>
    body {
        background: linear-gradient(135deg, #001a33, #003c8f);
        font-family: 'Segoe UI', sans-serif;
        color: #fff;
        margin: 0;
        padding: 0;
    }

    .container {
        max-width: 1100px;
        margin: 80px auto;
        background: rgba(0, 45, 90, 0.75);
        border-radius: 20px;
        backdrop-filter: blur(25px);
        -webkit-backdrop-filter: blur(25px);
        padding: 40px 50px;
        box-shadow: 0 8px 25px rgba(0, 0, 0, 0.6);
    }

    h2 {
        text-align: center;
        font-weight: 700;
        margin-bottom: 30px;
        color: #fff;
    }

    .btn-primary {
        background: linear-gradient(135deg, #006aff, #0048b3);
        border: none;
        border-radius: 10px;
        padding: 12px 25px;
        color: #fff;
        font-weight: 600;
        transition: all 0.3s ease;
        text-decoration: none;
    }

        .btn-primary:hover {
            background: linear-gradient(135deg, #0056d2, #007bff);
            box-shadow: 0 0 12px rgba(0, 150, 255, 0.6);
            transform: translateY(-2px);
        }

    table {
        width: 100%;
        margin-top: 25px;
        border-collapse: collapse;
        color: #fff;
        border-radius: 10px;
        overflow: hidden;
    }

    thead {
        background: rgba(0, 90, 180, 0.6);
    }

    th, td {
        padding: 14px;
        text-align: center;
        border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    }

    tbody tr:hover {
        background: rgba(255, 255, 255, 0.1);
        transition: 0.3s;
    }

    .btn-danger {
        background: linear-gradient(135deg, #ff3d3d, #c62828);
        border: none;
        border-radius: 8px;
        padding: 6px 14px;
        color: #fff;
        font-weight: 600;
        font-size: 0.9rem;
        text-decoration: none;
        transition: all 0.3s ease;
    }

        .btn-danger:hover {
            background: linear-gradient(135deg, #ff6b6b, #e53935);
            box-shadow: 0 0 12px rgba(255, 90, 90, 0.6);
            transform: translateY(-2px);
        }

    .status-yes {
        color: #00e676;
        font-weight: 600;
    }

    .status-no {
        color: #ff7b7b;
        font-weight: 600;
    }
</style>

<div class="container">
    <h2>🗓️ Attendance Records</h2>

    <div class="text-center mb-3">
        <a class="btn-primary" href="/Attendance/Create">📋 Mark Attendance</a>
    </div>

    <table>
        <thead>
            <tr>
                <th>ID</th>
                <th>Student</th>
                <th>Course</th>
                <th>Date</th>
                <th>Status</th>
                <th>Validated</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                foreach (var item in Model)
                {
                    <tr>
                        <td>@item.AttendanceID</td>
                        <td>@item.StudentName</td>
                        <td>@item.CourseName</td>
                        <td>@item.AttendanceDate.ToShortDateString()</td>
                        <td class="@(item.IsPresent ? "status-yes" : "status-no")">
                            @(item.IsPresent ? "Present ✅" : "Absent ❌")
                        </td>
                        <td class="@(item.IsValidated ? "status-yes" : "status-no")">
                            @(item.IsValidated ? "Yes ✅" : "No ❌")
                        </td>
                        <td>
                            <a class="btn-danger btn-sm" href="/Attendance/Delete/@item.AttendanceID">🗑️ Delete</a>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="7" class="text-center text-muted py-4">No attendance records found.</td>
                </tr>
            }
        </tbody>
    </table>
</div>
