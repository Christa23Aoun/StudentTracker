@model List<StudentTracker.Models.AttendanceView>

@{
    ViewData["Title"] = "Mark Attendance";
    var courseId = ViewBag.CourseID;
    var courseName = Model.FirstOrDefault()?.CourseName ?? "Unknown Course";
}

<style>
    body {
        background: #f5f7fa;
        margin: 0;
        padding: 0;
        font-family: 'Inter', sans-serif;
        color: #1a2b4c;
    }

    .attendance-container {
        width: 92%;
        max-width: 1000px;
        margin: 70px auto;
        background: #ffffff;
        border: 1px solid #d9e1ec;
        border-radius: 8px;
        padding: 40px 45px;
        box-shadow: 0px 5px 15px rgba(0,0,0,0.07);
    }

    /* PAGE HEADER */
    .page-header {
        text-align: left;
        margin-bottom: 25px;
        border-left: 5px solid #003c8f;
        padding-left: 14px;
    }

        .page-header h1 {
            margin: 0;
            font-size: 32px;
            font-weight: 800;
            color: #003c8f;
        }

    .course-title {
        font-size: 16px;
        color: #5b6e80;
        margin-top: 4px;
    }

    /* DATE + TIME INPUTS */
    .session-inputs {
        display: flex;
        gap: 20px;
        flex-wrap: wrap;
        margin: 30px 0 25px 0;
    }

        .session-inputs label {
            font-weight: 600;
            color: #1a2b4c;
        }

        .session-inputs input {
            padding: 9px 12px;
            border-radius: 6px;
            border: 1px solid #d9e1ec;
            background: #ffffff;
            color: #1a2b4c;
            width: 210px;
        }

    /* TABLE */
    table {
        width: 100%;
        border-collapse: collapse;
        border: 1px solid #d9e1ec;
        border-radius: 6px;
        overflow: hidden;
        margin-top: 10px;
        box-shadow: 0px 4px 10px rgba(0,0,0,0.06);
    }

    thead {
        background: #003c8f;
        color: white;
    }

    th {
        padding: 14px;
        font-size: 15px;
        font-weight: 600;
        text-align: center;
    }

    td {
        padding: 14px;
        text-align: center;
        border-bottom: 1px solid #edf2f7;
        color: #1a2b4c;
    }

    tr:hover {
        background: #f0f6ff;
    }

    select {
        padding: 9px 12px;
        border-radius: 6px;
        border: 1px solid #d9e1ec;
        background: #ffffff;
        color: #1a2b4c;
        cursor: pointer;
        width: 130px;
    }

    /* BUTTONS */
    .btn-save {
        background: #003c8f;
        border: none;
        padding: 12px 25px;
        color: white;
        font-weight: 700;
        border-radius: 6px;
        display: block;
        margin: 35px auto 10px auto;
        cursor: pointer;
        transition: 0.25s ease;
        width: 220px;
        text-align: center;
    }

        .btn-save:hover {
            background: #002a6a;
        }

    .btn-cancel {
        background: #5b6e80;
        color: white;
        padding: 12px 25px;
        border-radius: 6px;
        display: block;
        width: 220px;
        margin: 10px auto;
        text-align: center;
        font-weight: 600;
        text-decoration: none;
        transition: 0.25s ease;
    }

        .btn-cancel:hover {
            background: #445664;
        }
</style>

<div class="attendance-container">

    <div class="page-header">
        <h1>Mark Attendance</h1>
        <p class="course-title">@courseName</p>
    </div>

    <form asp-action="Create" method="post">
        <input type="hidden" name="courseId" value="@courseId" />

        <div class="session-inputs">
            <div>
                <label>Date:</label><br />
                <input type="date" name="AttendanceDate" required />
            </div>

            <div>
                <label>Time:</label><br />
                <input type="time" name="SessionTime" required />
            </div>
        </div>

        <table>
            <thead>
                <tr>
                    <th>Student</th>
                    <th>Status</th>
                </tr>
            </thead>

            <tbody>
                @for (int i = 0; i < Model.Count; i++)
                {
                    <tr>
                        <td>
                            @Model[i].StudentName

                            <input type="hidden" name="attendanceList[@i].StudentID" value="@Model[i].StudentID" />
                            <input type="hidden" name="attendanceList[@i].CourseID" value="@Model[i].CourseID" />
                            <input type="hidden" name="attendanceList[@i].StudentName" value="@Model[i].StudentName" />
                            <input type="hidden" name="attendanceList[@i].CourseName" value="@Model[i].CourseName" />
                        </td>

                        <td>
                            <select name="attendanceList[@i].Status">
                                <option value="Present">Present</option>
                                <option value="Absent">Absent</option>
                            </select>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <button type="submit" class="btn-save">💾 Save Attendance</button>

        <a asp-action="Index" asp-route-courseId="@courseId" class="btn-cancel">
            ✖ Cancel
        </a>
    </form>

</div>
