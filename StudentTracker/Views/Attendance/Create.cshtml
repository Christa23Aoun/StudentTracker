@model StudentTracker.Models.AttendanceView

@{
    ViewData["Title"] = "Add Attendance";
}

<style>
    body {
        background: linear-gradient(135deg, #001a33, #003c8f);
        font-family: 'Segoe UI', sans-serif;
        color: #fff;
        margin: 0;
        padding: 0;
    }

    .form-container {
        max-width: 700px;
        margin: 80px auto;
        padding: 40px;
        background: rgba(0, 45, 90, 0.8);
        border-radius: 25px;
        box-shadow: 0 8px 25px rgba(0, 0, 0, 0.6);
    }

    h2 {
        text-align: center;
        margin-bottom: 30px;
        font-weight: 700;
        color: #fff;
    }

    label {
        font-weight: 600;
        color: #cfe6ff;
    }

    .form-control {
        background: rgba(255, 255, 255, 0.1);
        border: 1px solid rgba(255, 255, 255, 0.25);
        color: #fff;
        border-radius: 10px;
        padding: 10px;
        margin-bottom: 20px;
        transition: 0.3s;
    }

    .form-control:focus {
        border-color: #2196f3;
        box-shadow: 0 0 10px rgba(33, 150, 243, 0.6);
        outline: none;
    }

    .form-check-label {
        margin-left: 5px;
        font-weight: 500;
    }

    .btn-success {
        background: linear-gradient(135deg, #00c853, #009624);
        color: #fff;
        border: none;
        border-radius: 10px;
        padding: 12px 25px;
        font-weight: 600;
        transition: all 0.3s ease;
        display: block;
        margin: 0 auto;
    }

        .btn-success:hover {
            background: linear-gradient(135deg, #00e676, #00c853);
            box-shadow: 0 0 15px rgba(0, 255, 120, 0.6);
        }
</style>

<div class="form-container">
    <h2>📝 Add Attendance</h2>

    <form asp-action="Create" method="post">
        <div class="form-group">
            <label>Student ID</label>
            <input asp-for="StudentID" class="form-control" placeholder="Enter student ID" />
        </div>

        <div class="form-group">
            <label>Course ID</label>
            <input asp-for="CourseID" class="form-control" placeholder="Enter course ID" />
        </div>

        <div class="form-group">
            <label>Attendance Date</label>
            <input asp-for="AttendanceDate" type="date" class="form-control" />
        </div>

        <div class="form-check mb-2">
            <input asp-for="IsPresent" class="form-check-input" type="checkbox" />
            <label class="form-check-label" asp-for="IsPresent">Present</label>
        </div>

        <div class="form-check mb-4">
            <input asp-for="IsValidated" class="form-check-input" type="checkbox" />
            <label class="form-check-label" asp-for="IsValidated">Validated</label>
        </div>

        <button type="submit" class="btn btn-success">💾 Save</button>
    </form>
</div>
