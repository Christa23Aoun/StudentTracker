@model List<StudentTracker.Models.AttendanceView>

@{
    ViewData["Title"] = "Mark Attendance";
    var courseId = ViewBag.CourseID;
    var courseName = Model.FirstOrDefault()?.CourseName ?? "Unknown Course";
}

<style>
    body {
        background: linear-gradient(135deg, #001a33, #003c8f);
        font-family: 'Segoe UI', sans-serif;
        color: #fff;
    }

    .attendance-container {
        width: 90%;
        max-width: 900px;
        margin: 50px auto;
        background: rgba(255,255,255,0.08);
        border-radius: 20px;
        padding: 40px;
        box-shadow: 0 8px 25px rgba(0,0,0,0.5);
    }

    h2 {
        text-align: center;
        color: #fff;
        margin-bottom: 10px;
    }

    .course-title {
        text-align: center;
        color: #90caf9;
        font-weight: 600;
        margin-bottom: 25px;
    }

    .session-inputs {
        display: flex;
        justify-content: center;
        gap: 20px;
        margin-bottom: 25px;
    }

    table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 10px;
    }

    th, td {
        padding: 12px;
        text-align: center;
        border-bottom: 1px solid rgba(255,255,255,0.1);
    }

    th {
        background: rgba(255,255,255,0.15);
        color: #bbdefb;
    }

    select {
        background: rgba(255,255,255,0.1);
        color: white;
        border: 1px solid rgba(255,255,255,0.3);
        border-radius: 8px;
        padding: 6px 10px;
    }

    .btn-save {
        background: #00c853;
        color: white;
        border: none;
        padding: 12px 25px;
        border-radius: 10px;
        font-weight: 600;
        margin-top: 30px;
        display: block;
        margin-left: auto;
        margin-right: auto;
    }

    .btn-cancel {
        background: rgba(255,255,255,0.2);
        color: #fff;
        border-radius: 10px;
        padding: 12px 25px;
        display: block;
        width: 200px;
        margin: 15px auto 0 auto;
        text-align: center;
        font-weight: 600;
    }
</style>

<div class="attendance-container">
    <h2>🧾 Mark Attendance</h2>
    <p class="course-title">@courseName</p>

    <form asp-action="Create" method="post">

        <input type="hidden" name="courseId" value="@courseId" />

        <div class="session-inputs">
            <div>
                <label>Date:</label>
                <input type="date" name="AttendanceDate" class="form-control" required />
            </div>
            <div>
                <label>Time:</label>
                <input type="time" name="SessionTime" class="form-control" required />
            </div>
        </div>

        <table>
            <thead>
                <tr><th>Student</th><th>Status</th></tr>
            </thead>
            <tbody>
                @for (int i = 0; i < Model.Count; i++)
                {
                    <tr>
                        <td>
                            @Model[i].StudentName

                            <!-- Hidden required fields -->
                            <input type="hidden" name="attendanceList[@i].StudentID" value="@Model[i].StudentID" />
                            <input type="hidden" name="attendanceList[@i].CourseID" value="@Model[i].CourseID" />
                            <input type="hidden" name="attendanceList[@i].StudentName" value="@Model[i].StudentName" />
                            <input type="hidden" name="attendanceList[@i].CourseName" value="@Model[i].CourseName" />
                        </td>

                        <td>
                            <select name="attendanceList[@i].Status">
                                <option value="Present">Present</option>
                                <option value="Absent">Absent</option>
                                <option value="Late">Late</option>
                            </select>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <button type="submit" class="btn-save">💾 Save Attendance</button>

        <a asp-controller="Teacher" asp-action="CourseDetails"
           asp-route-id="@courseId"
           class="btn-cancel">✖ Cancel</a>

    </form>
</div>
