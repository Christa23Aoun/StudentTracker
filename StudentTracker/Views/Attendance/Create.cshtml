@model List<StudentTracker.Models.AttendanceView>

@{
    ViewData["Title"] = "Add Attendance";

    int courseId = (int)(ViewBag.CourseID ?? 0);
    int? selectedSessionId = ViewBag.SelectedSessionId as int?;
    int selectedSemesterId = ViewBag.SelectedSemesterId != null ? (int)ViewBag.SelectedSemesterId : 0;

    var sessions = ViewBag.Sessions as List<StudentTracker.Models.CourseSessionView> ?? new();
    var courseName = ViewBag.CourseName as string ?? "";
}

<style>
    .att-page {
        background: #f5f7fa;
        padding: 70px 0;
        color: #1a2b4c;
        font-family: 'Inter',sans-serif;
        min-height: calc(100vh - 200px);
    }

    .att-container {
        width: 92%;
        max-width: 1100px;
        margin: 0 auto;
        background: #fff;
        border: 1px solid #d9e1ec;
        border-radius: 10px;
        padding: 35px;
        box-shadow: 0 8px 24px rgba(0,0,0,0.08);
    }

    .page-header {
        text-align: left;
        margin-bottom: 18px;
        border-left: 5px solid #003c8f;
        padding-left: 18px;
    }

        .page-header h1 {
            font-size: 30px;
            font-weight: 900;
            margin: 0;
            color: #003c8f;
            line-height: 1.2;
        }

    .top-actions {
        display: flex;
        justify-content: space-between;
        margin-bottom: 18px;
        flex-wrap: wrap;
        gap: 10px;
        align-items: center;
    }

    .btn-secondary {
        background: #5b6e80;
        color: #fff;
        padding: 11px 18px;
        border-radius: 8px;
        font-weight: 750;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

    .card {
        border: 1px solid #d9e1ec;
        border-radius: 10px;
        background: #fff;
        box-shadow: 0 6px 16px rgba(0,0,0,0.06);
        padding: 16px;
        margin-top: 10px;
    }

    label {
        font-weight: 800;
        color: #1a2b4c;
    }

    select {
        padding: 11px 12px;
        border-radius: 8px;
        border: 1px solid #d9e1ec;
        background: #fff;
        color: #1a2b4c;
        min-width: 320px;
    }

    .btn-primaryy {
        background: #003c8f;
        border: none;
        padding: 11px 18px;
        color: #fff;
        font-weight: 900;
        border-radius: 8px;
        cursor: pointer;
        white-space: nowrap;
    }

    table {
        width: 100%;
        border-collapse: collapse;
        border: 1px solid #d9e1ec;
        border-radius: 10px;
        overflow: hidden;
        background: #fff;
    }

    thead {
        background: #003c8f;
        color: #fff;
    }

    th, td {
        padding: 14px;
        text-align: left;
    }
</style>

<div class="att-page">
    <div class="att-container">

        <div class="page-header">
            <h1>
                Add Attendance to course:
                <span style="font-weight:600;color:#003c8f;">@courseName</span>
            </h1>
        </div>

        <div class="top-actions">
            <a class="btn-secondary"
               asp-controller="Teacher"
               asp-action="CourseDetails"
               asp-route-id="@courseId">⬅ Back to Course</a>
        </div>

        @if (!sessions.Any())
        {
            <div>No sessions found for this course in the selected semester.</div>
        }
        else
        {
            <div class="card">
                <form asp-action="Create" method="get">
                    <input type="hidden" name="courseId" value="@courseId" />
                    <input type="hidden" name="semesterId" value="@selectedSemesterId" />

                    <label>Session</label><br />
                    <select name="sessionId" required>
                        <option value="">Select session</option>

                        @foreach (var s in sessions.OrderByDescending(x => x.SessionDate).ThenByDescending(x => x.StartTime))
                        {
                            if (selectedSessionId == s.SessionID)
                            {
                                <option value="@s.SessionID" selected>
                                    @s.SessionDate.ToString("dd/MM/yyyy") (@s.StartTime.ToString(@"hh\:mm") - @s.EndTime.ToString(@"hh\:mm"))
                                </option>
                            }
                            else
                            {
                                <option value="@s.SessionID">
                                    @s.SessionDate.ToString("dd/MM/yyyy") (@s.StartTime.ToString(@"hh\:mm") - @s.EndTime.ToString(@"hh\:mm"))
                                </option>
                            }
                        }
                    </select>

                    <div style="margin-top:12px;">
                        <button type="submit" class="btn-primaryy">📋 Load Students</button>
                    </div>
                </form>
            </div>

            @if (selectedSessionId.HasValue && Model.Any())
            {
                <div class="card">
                    <form asp-action="Create" method="post">
                        @Html.AntiForgeryToken()

                        <input type="hidden" name="courseId" value="@courseId" />
                        <input type="hidden" name="sessionId" value="@selectedSessionId.Value" />
                        <input type="hidden" name="semesterId" value="@selectedSemesterId" />

                        <div style="margin-bottom:12px;text-align:right;">
                            <button type="submit" class="btn-primaryy">💾 Save Attendance</button>
                        </div>

                        <table>
                            <thead>
                                <tr>
                                    <th>Student</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @for (int i = 0; i < Model.Count; i++)
                                {
                                    <tr>
                                        <td>
                                            @Model[i].StudentName
                                            <input type="hidden" name="attendanceList[@i].StudentID" value="@Model[i].StudentID" />
                                            <input type="hidden" name="attendanceList[@i].StudentName" value="@Model[i].StudentName" />
                                        </td>
                                        <td>
                                            <select name="attendanceList[@i].Status">
                                                @if (Model[i].Status == "Absent")
                                                {
                                                    <option value="Present">Present</option>
                                                    <option value="Absent" selected>Absent</option>
                                                }
                                                else
                                                {
                                                    <option value="Present" selected>Present</option>
                                                    <option value="Absent">Absent</option>
                                                }
                                            </select>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </form>
                </div>
            }
        }
    </div>
</div>
