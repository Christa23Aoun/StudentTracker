@model List<StudentTracker.Models.CourseSessionView>

@{
    ViewData["Title"] = "Select Session";
    var courseId = ViewBag.CourseID;
}

<style>
    body {
        background: #f5f7fa;
        font-family: 'Inter', sans-serif;
        color: #1a2b4c;
    }

    .container {
        max-width: 900px;
        margin: 80px auto;
        background: #ffffff;
        border-radius: 8px;
        padding: 35px;
        box-shadow: 0px 6px 18px rgba(0,0,0,0.08);
    }

    h1 {
        font-size: 30px;
        font-weight: 800;
        margin-bottom: 20px;
        color: #003c8f;
    }

    table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 20px;
    }

    th {
        background: #003c8f;
        color: white;
        padding: 12px;
        text-align: center;
        font-weight: 600;
    }

    td {
        padding: 12px;
        text-align: center;
        border-bottom: 1px solid #e5e7eb;
    }

    .btn {
        background: #003c8f;
        color: white;
        padding: 8px 16px;
        border-radius: 6px;
        text-decoration: none;
        font-weight: 600;
        transition: 0.25s ease;
    }

    .btn:hover {
        background: #002a6a;
    }

    .btn-back {
        display: inline-block;
        margin-top: 25px;
        background: #5b6e80;
        padding: 10px 20px;
        color: white;
        border-radius: 6px;
        text-decoration: none;
        font-weight: 600;
    }

    .btn-back:hover {
        background: #445664;
    }
</style>

<div class="container">

    <h1>Select Session</h1>

    @if (!Model.Any())
    {
        <p>No sessions found for this course.</p>
    }
    else
    {
        <table>
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Time</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var s in Model.OrderBy(x => x.SessionDate))
                {
                    <tr>
                        <td>@s.SessionDate.ToString("dddd dd/MM/yyyy")</td>
                        <td>@s.StartTime.ToString(@"hh\:mm") - @s.EndTime.ToString(@"hh\:mm")</td>
                        <td>
                            <a asp-action="Create"
                               asp-route-sessionId="@s.SessionID"
                               class="btn">
                                Mark Attendance
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }

    <a asp-controller="Attendance"
       asp-action="Index"
       asp-route-courseId="@courseId"
       class="btn-back">
        ⬅ Back to Attendance
    </a>

</div>
