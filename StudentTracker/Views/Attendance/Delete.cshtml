@model StudentTracker.Models.AttendanceView

@{
    ViewData["Title"] = "Delete Attendance";
    int courseId = (int)(ViewBag.CourseID ?? Model.CourseID);
    int sessionId = (int)(ViewBag.SessionID ?? Model.SessionID);
}

<style>
    body {
        background: #f5f7fa;
        margin: 0;
        padding: 0;
        font-family: 'Inter', sans-serif;
        color: #1a2b4c;
    }

    .delete-container {
        width: 92%;
        max-width: 650px;
        margin: 80px auto;
        background: #ffffff;
        border: 1px solid #d9e1ec;
        border-radius: 8px;
        padding: 35px;
        box-shadow: 0px 5px 15px rgba(0,0,0,0.07);
        text-align: center;
    }

    .delete-header {
        border-left: 5px solid #c62828;
        padding-left: 14px;
        margin-bottom: 25px;
        text-align: left;
    }

        .delete-header h1 {
            margin: 0;
            font-size: 28px;
            font-weight: 800;
            color: #c62828;
        }

    .delete-details {
        margin: 20px 0;
        font-size: 16px;
        color: #5b6e80;
        line-height: 1.6;
    }

        .delete-details strong {
            color: #003c8f;
        }

    .btn-danger {
        background: #c62828;
        border: none;
        padding: 12px 22px;
        color: white;
        font-weight: 800;
        border-radius: 6px;
        cursor: pointer;
        transition: 0.25s ease;
        width: 160px;
    }

        .btn-danger:hover {
            background: #a71f1f;
        }

    .btn-secondary {
        background: #5b6e80;
        color: white;
        padding: 12px 22px;
        border-radius: 6px;
        font-weight: 800;
        text-decoration: none;
        transition: 0.25s ease;
        width: 160px;
        display: inline-block;
    }

        .btn-secondary:hover {
            background: #445664;
        }

    .btn-row {
        margin-top: 35px;
        display: flex;
        justify-content: center;
        gap: 20px;
        flex-wrap: wrap;
    }
</style>

<div class="delete-container">
    <div class="delete-header">
        <h1>Delete Attendance</h1>
    </div>

    <p class="delete-details">
        Are you sure you want to delete this attendance entry?<br /><br />
        <strong>Student:</strong> @Model.StudentName <br />
        <strong>Status:</strong> @(Model.IsPresent ? "Present" : "Absent")
    </p>

    <div class="btn-row">
        <form asp-action="Delete" method="get">
            <input type="hidden" name="id" value="@Model.AttendanceID" />
            <input type="hidden" name="courseId" value="@courseId" />
            <input type="hidden" name="sessionId" value="@sessionId" />
            <button type="submit" class="btn-danger">Delete</button>
        </form>

        <a class="btn-secondary"
           asp-action="Index"
           asp-route-courseId="@courseId"
           asp-route-sessionId="@sessionId">
            Cancel
        </a>
    </div>
</div>
