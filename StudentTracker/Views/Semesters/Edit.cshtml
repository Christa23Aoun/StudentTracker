@model StudentTracker.Models.SemesterView

@{
    ViewData["Title"] = "Edit Semester";
}

<style>
    body {
        background: linear-gradient(135deg, #001a33, #003c8f);
        font-family: 'Segoe UI', sans-serif;
        color: #fff;
        margin: 0;
        padding: 0;
    }

    .form-container {
        max-width: 700px;
        margin: 100px auto;
        padding: 50px;
        background: rgba(0, 45, 90, 0.8);
        border-radius: 25px;
        backdrop-filter: blur(25px);
        -webkit-backdrop-filter: blur(25px);
        box-shadow: 0 8px 25px rgba(0, 0, 0, 0.6);
    }

    h2 {
        font-weight: 700;
        text-align: center;
        margin-bottom: 40px;
        color: #ffffff;
    }

    .form-label {
        font-weight: 600;
        color: #cfe6ff;
        margin-bottom: 6px;
    }

    .form-control,
    .form-select {
        background: rgba(255, 255, 255, 0.1);
        border: 1px solid rgba(255, 255, 255, 0.25);
        color: #fff;
        border-radius: 10px;
        padding: 12px;
        margin-bottom: 20px;
        transition: all 0.2s ease;
    }

        .form-select option {
            background-color: #00284d;
            color: #fff;
        }

        .form-control:focus,
        .form-select:focus {
            border-color: #2196f3;
            box-shadow: 0 0 12px rgba(33, 150, 243, 0.6);
            outline: none;
        }

    .btn-row {
        display: flex;
        justify-content: center;
        gap: 20px;
        margin-top: 30px;
    }

    .btn {
        border: none;
        border-radius: 12px;
        font-weight: 600;
        padding: 12px 35px;
        transition: all 0.3s ease;
        cursor: pointer;
    }

    .btn-primary {
        background: linear-gradient(135deg, #00bcd4, #1976d2);
        color: #fff;
    }

        .btn-primary:hover {
            background: linear-gradient(135deg, #1976d2, #00bcd4);
            box-shadow: 0 0 15px rgba(33, 150, 243, 0.6);
        }

    .btn-secondary {
        background: rgba(255, 255, 255, 0.15);
        color: #ddd;
    }

        .btn-secondary:hover {
            background: rgba(255, 255, 255, 0.25);
        }
</style>

<div class="form-container">
    <h2>✏️ Edit Semester</h2>

    <form asp-action="Edit" method="post">
        <input type="hidden" asp-for="SemesterID" />

        <div class="mb-3">
            <label class="form-label">Academic Year</label>
            <select asp-for="AcademicYearID" class="form-select"
                    asp-items="@(new SelectList(Model.AcademicYears, nameof(StudentTracker.Models.AcademicYearOption.AcademicYearID), nameof(StudentTracker.Models.AcademicYearOption.Name), Model.AcademicYearID))">
            </select>
            <span asp-validation-for="AcademicYearID" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label class="form-label">Name</label>
            <input asp-for="Name" class="form-control" placeholder="Enter semester name" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label class="form-label">Semester Number</label>
            <input asp-for="SemesterNb" type="number" class="form-control" placeholder="e.g., 1 or 2" />
            <span asp-validation-for="SemesterNb" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label class="form-label">Start Date</label>
            <input asp-for="StartDate" type="date" class="form-control" />
        </div>

        <div class="mb-3">
            <label class="form-label">End Date</label>
            <input asp-for="EndDate" type="date" class="form-control" />
        </div>

        <div class="btn-row">
            <button class="btn btn-primary" type="submit">💾 Save Changes</button>
            <a asp-action="Index" class="btn btn-secondary">⬅️ Back</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
