@{
    ViewData["Title"] = "Research";
}

<section class="research-hero text-white text-center">
    <div class="research-hero-overlay"></div>
    <img src="~/images/unnamed.jpg" class="research-hero-bg" />

    <div class="container position-relative hero-content">
        
        <h1 class="fw-bold" style="font-size: 48px;">Research at WTF University</h1>
        <p style="max-width: 850px; margin: 15px auto; font-size: 18px;">
            At WTF University, research is at the heart of innovation. Our mission is to empower students and faculty
            to explore cutting-edge ideas, develop impactful solutions, and contribute to the scientific, technological,
            and social progress of our community and region.
        </p>
    </div>
</section>

<style>
    .research-hero {
        position: relative;
        height: 60vh;
        min-height: 350px;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
    }

    .research-hero-bg {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        filter: brightness(55%);
    }

    .research-hero-overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(135deg, rgba(0,30,70,0.6), rgba(0,55,120,0.85));
    }

    .hero-content {
        position: relative;
        z-index: 2;
        max-width: 900px;
    }
</style>

<!-- ===== ORIGINAL CONTENT (UNCHANGED) ===== -->

<section 
   
</section>

<div class="container my-5">

    <div class="mb-5">
        <h2 class="fw-bold" style="color:#003c8f;">Our Research Vision</h2>
        <p style="color:#5b7083; font-size: 16px;">
            WTF University is committed to creating a vibrant research culture grounded in creativity,
            interdisciplinary collaboration, and real-world impact. Our research initiatives span areas
            such as computer science, cybersecurity, education, artificial intelligence, engineering
            technologies, environmental science, and digital transformation.
        </p>
        <p style="color:#5b7083; font-size: 16px;">
            Students and faculty work closely in laboratories, innovation hubs, and collaborative research
            groups to turn innovative ideas into tangible projects, tools, and solutions.
        </p>
    </div>

    <h3 class="fw-bold mb-4" style="color:#003c8f;">Key Research Areas</h3>

    <div class="row g-4">

        <div class="col-md-4 d-flex">
            <div class="card shadow-lg w-100" style="border-radius:18px; height:100%;">
                <div class="card-body text-center p-4">
                    <i class="fas fa-brain fa-3x mb-3" style="color:#003c8f;"></i>
                    <h5 class="fw-bold">Artificial Intelligence</h5>
                    <p class="text-muted">
                        Machine learning, neural networks, intelligent systems, and predictive analytics
                        developed for education, healthcare, finance, and smart cities.
                    </p>
                </div>
            </div>
        </div>

        <div class="col-md-4 d-flex">
            <div class="card shadow-lg w-100" style="border-radius:18px; height:100%;">
                <div class="card-body text-center p-4">
                    <i class="fas fa-shield-alt fa-3x mb-3" style="color:#003c8f;"></i>
                    <h5 class="fw-bold">Cybersecurity & Digital Safety</h5>
                    <p class="text-muted">
                        Research on threat detection, secure authentication, encryption, IoT security,
                        and building resilient digital infrastructure.
                    </p>
                </div>
            </div>
        </div>

        <div class="col-md-4 d-flex">
            <div class="card shadow-lg w-100" style="border-radius:18px; height:100%;">
                <div class="card-body text-center p-4">
                    <i class="fas fa-database fa-3x mb-3" style="color:#003c8f;"></i>
                    <h5 class="fw-bold">Data Science & Analytics</h5>
                    <p class="text-muted">
                        Big data, visualization, decision-making models, and analytical techniques
                        applied to modern industries.
                    </p>
                </div>
            </div>
        </div>

        <div class="col-md-4 d-flex">
            <div class="card shadow-lg w-100" style="border-radius:18px; height:100%;">
                <div class="card-body text-center p-4">
                    <i class="fas fa-cogs fa-3x mb-3" style="color:#003c8f;"></i>
                    <h5 class="fw-bold">Engineering & Technology</h5>
                    <p class="text-muted">
                        Research on automation, embedded systems, renewable energy, and modern
                        engineering technologies.
                    </p>
                </div>
            </div>
        </div>

        <div class="col-md-4 d-flex">
            <div class="card shadow-lg w-100" style="border-radius:18px; height:100%;">
                <div class="card-body text-center p-4">
                    <i class="fas fa-graduation-cap fa-3x mb-3" style="color:#003c8f;"></i>
                    <h5 class="fw-bold">Educational Research</h5>
                    <p class="text-muted">
                        Innovation in teaching and learning, digital classrooms, student performance
                        tracking, curriculum development, and assessment tools.
                    </p>
                </div>
            </div>
        </div>

        <div class="col-md-4 d-flex">
            <div class="card shadow-lg w-100" style="border-radius:18px; height:100%;">
                <div class="card-body text-center p-4">
                    <i class="fas fa-leaf fa-3x mb-3" style="color:#003c8f;"></i>
                    <h5 class="fw-bold">Environment & Sustainability</h5>
                    <p class="text-muted">
                        Research on environmental protection, green technologies, climate change,
                        and sustainable development strategies.
                    </p>
                </div>
            </div>
        </div>

    </div>

    <div class="text-center mt-5">
        <h3 class="fw-bold" style="color:#003c8f;">Want to Join Our Research Community?</h3>
        <p class="text-muted">Students and faculty are welcome to participate in ongoing projects and research labs.</p>
        <a asp-controller="Auth" asp-action="Login" class="btn btn-primary px-4 py-2 fw-semibold" style="border-radius:12px;">
            Join a Research Group
        </a>
    </div>

</div>
