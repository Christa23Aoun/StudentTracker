@{
    Layout = "_LayoutHome";
    ViewData["Title"] = "Research – WTF University";
}

<!-- ========================= -->
<!-- ADMIN-STYLE BLUE HEADER -->
<!-- ========================= -->
<section class="research-header">
    <div class="container header-content">
        <h1>Research at WTF University</h1>
        <p>
            At WTF University, research drives innovation. We empower students and faculty to explore
            cutting-edge ideas, create meaningful solutions, and contribute to scientific, technological,
            and social progress.
        </p>
    </div>
</section>

<!-- ========================= -->
<!-- RESEARCH CONTENT -->
<!-- ========================= -->
<div class="container research-content">

    <!-- Vision -->
    <div class="vision-block">
        <h2>Our Research Vision</h2>
        <p>
            WTF University is committed to building a dynamic research ecosystem rooted in creativity,
            interdisciplinary collaboration, and real-world impact.
        </p>
        <p>
            Our initiatives span areas such as AI, cybersecurity, digital transformation, engineering,
            environmental sustainability, and education—powered by labs, innovation hubs, and project-based learning.
        </p>
    </div>

    <!-- Research Areas -->
    <h3 class="section-title">Key Research Areas</h3>

    <div class="auto-slider">

        <div class="auto-track">

            <div class="auto-slide">
                <i class="fas fa-brain icon"></i>
                <h5>Artificial Intelligence</h5>
                <p>Machine learning, neural networks, intelligent systems.</p>
            </div>

            <div class="auto-slide">
                <i class="fas fa-shield-alt icon"></i>
                <h5>Cybersecurity</h5>
                <p>Threat detection, encryption, IoT and network security.</p>
            </div>

            <div class="auto-slide">
                <i class="fas fa-database icon"></i>
                <h5>Data Science</h5>
                <p>Big data, analytics, prediction & visualization models.</p>
            </div>

            <div class="auto-slide">
                <i class="fas fa-cogs icon"></i>
                <h5>Engineering</h5>
                <p>Automation, renewable energy, robotics & embedded systems.</p>
            </div>

            <div class="auto-slide">
                <i class="fas fa-graduation-cap icon"></i>
                <h5>Educational Research</h5>
                <p>Digital learning, performance tracking, curriculum design.</p>
            </div>

            <div class="auto-slide">
                <i class="fas fa-leaf icon"></i>
                <h5>Environment & Sustainability</h5>
                <p>Green innovation, climate studies and sustainable development.</p>
            </div>

        </div>

        <!-- dots auto-generated by JS -->
        <div class="auto-dots"></div>

    </div>



    <!-- CTA -->
    <div class="text-center join-block">
        <h3>Want to Join Our Research Community?</h3>
        <p class="text-muted">
            Students and professors are welcome to participate in active research labs and innovation projects.
        </p> </br> </br>
        <a asp-controller="Auth" asp-action="Login" class="join-btn">Join a Research Group</a>
    </div>

</div>

<!-- ========================= -->
<!-- PAGE STYLES -->
<!-- ========================= -->
<style>

    /* ===== HEADER ===== */
    .research-header {
        background: linear-gradient(135deg, #003c8f, #001e44);
        padding: 70px 0 65px;
        text-align: center;
        color: white;
        margin-bottom: 50px;
    }

    .header-content h1 {
        font-size: 48px;
        font-weight: 800;
        margin-bottom: 12px;
    }

    .header-content p {
        max-width: 900px;
        font-size: 18px;
        opacity: 0.9;
        margin: 0 auto;
        line-height: 1.7;
    }

    /* ===== CONTENT BLOCKS ===== */
    .research-content {
        padding-bottom: 120px;
    }

    .vision-block h2 {
        font-size: 34px;
        font-weight: 800;
        color: #003c8f;
        margin-bottom: 15px;
    }

    .vision-block p {
        color: #4a5d73;
        font-size: 16px;
        line-height: 1.75;
        margin-bottom: 15px;
    }

    .section-title {
        font-size: 30px;
        font-weight: 800;
        color: #003c8f;
        margin: 40px 0 25px;
    }

    /* ===== CARD STYLE ===== */
    .research-card {
        background: white;
        padding: 28px;
        border-radius: 18px;
        text-align: center;
        box-shadow: 0 6px 20px rgba(0,0,0,0.08);
        border: 1px solid #dce7f9;
        transition: 0.3s ease;
        width: 100%;
    }

        .research-card:hover {
            transform: translateY(-6px);
            box-shadow: 0 12px 30px rgba(0,0,0,0.15);
        }

        .research-card h5 {
            font-size: 20px;
            color: #003c8f;
            font-weight: 700;
            margin-bottom: 12px;
        }

        .research-card p {
            color: #5b7083;
            line-height: 1.6;
        }

        .research-card .icon {
            font-size: 36px;
            margin-bottom: 12px;
            color: #003c8f;
        }

    /* ===== CTA BLOCK ===== */
    .join-block {
        margin-top: 65px;
    }

        .join-block h3 {
            color: #003c8f;
            font-size: 28px;
            font-weight: 800;
            margin-bottom: 10px;
        }

    .join-btn {
        background: linear-gradient(135deg, #0066cc, #004c99);
        padding: 12px 32px;
        border-radius: 12px;
        color: white;
        font-weight: 600;
        text-decoration: none;
        transition: 0.3s;
    }

        .join-btn:hover {
            background: linear-gradient(135deg, #0080ff, #005bb5);
            transform: translateY(-3px);
        }

    .auto-slider {
        width: 100%;
        overflow: hidden;
        position: relative;
        margin-top: 30px;
    }

    .auto-track {
        display: flex;
        gap: 25px;
        transition: transform 0.7s ease-in-out;
    }

    .auto-slide {
        flex: 0 0 calc(33.333% - 20px);
        background: white;
        padding: 28px;
        border-radius: 18px;
        text-align: center;
        border: 1px solid #dce7f9;
        box-shadow: 0 6px 20px rgba(0,0,0,0.08);
        transition: 0.3s ease;
    }

        .auto-slide:hover {
            transform: translateY(-6px);
            box-shadow: 0 12px 30px rgba(0,0,0,0.15);
        }

        .auto-slide .icon {
            font-size: 38px;
            margin-bottom: 12px;
            color: #003c8f;
        }

    .auto-dots {
        text-align: center;
        margin-top: 22px;
    }

    .auto-dot {
        display: inline-block;
        width: 12px;
        height: 12px;
        background: #bcd7f4;
        border-radius: 50%;
        margin: 0 5px;
        cursor: pointer;
        transition: 0.3s;
    }

        .auto-dot.active {
            background: #003c8f;
            transform: scale(1.2);
        }

</style>
<script>
    const track = document.querySelector(".auto-track");
    const slides = document.querySelectorAll(".auto-slide");
    const dotsContainer = document.querySelector(".auto-dots");

    let currentIndex = 0;
    const total = slides.length;
    const visible = 3;
    const maxIndex = total - visible;

    // Create dots
    for (let i = 0; i < total; i++) {
        const dot = document.createElement("span");
        dot.classList.add("auto-dot");
        if (i === 0) dot.classList.add("active");
        dot.dataset.index = i;
        dotsContainer.appendChild(dot);

        dot.addEventListener("click", () => {
            currentIndex = i <= maxIndex ? i : maxIndex;
            updateSlider();
            restartAutoSlide();
        });
    }

    const dots = document.querySelectorAll(".auto-dot");

    function updateSlider() {
        const offset = currentIndex * -33.333;
        track.style.transform = `translateX(${offset}%)`;

        dots.forEach(d => d.classList.remove("active"));
        dots[currentIndex].classList.add("active");
    }

    // Auto-slide
    let autoSlide = setInterval(() => {
        currentIndex = currentIndex < maxIndex ? currentIndex + 1 : 0;
        updateSlider();
    }, 8000);

    function restartAutoSlide() {
        clearInterval(autoSlide);
        autoSlide = setInterval(() => {
            currentIndex = currentIndex < maxIndex ? currentIndex + 1 : 0;
            updateSlider();
        }, 8000);
    }
</script>

