@{
    Layout = "_LayoutHome";
    ViewData["Title"] = "Research – WTF University";
}

<section class="research-hero">
    <div class="research-hero-bg"></div>
    <div class="container research-hero-content">
        <div class="research-badge">Research</div>
        <h1>Research at WTF University</h1>
        <p>
            At WTF University, research drives innovation. We empower students and faculty to explore
            cutting-edge ideas, create meaningful solutions, and contribute to scientific, technological,
            and social progress.
        </p>
    </div>
</section>

<div class="container research-wrap">

    <div class="research-vision">
        <div class="research-kicker">Our Research Vision</div>
        <h2>Building a research ecosystem with real-world impact.</h2>
        <p>
            WTF University is committed to building a dynamic research ecosystem rooted in creativity,
            interdisciplinary collaboration, and real-world impact.
        </p>
        <p>
            Our initiatives span areas such as AI, cybersecurity, digital transformation, engineering,
            environmental sustainability, and education—powered by labs, innovation hubs, and project-based learning.
        </p>
    </div>

    <div class="research-areas-head">
        <div class="research-kicker">Key Research Areas</div>
        <h3 class="section-title">Explore our focus domains</h3>
        <p class="section-sub">
            Discover the labs and initiatives where students and faculty collaborate on meaningful projects.
        </p>
    </div>

    <div class="auto-slider" aria-label="Research areas slider">
        <div class="auto-track">

            <div class="auto-slide">
                <div class="area-icon"><i class="fas fa-brain"></i></div>
                <h5>Artificial Intelligence</h5>
                <p>Machine learning, neural networks, intelligent systems.</p>
            </div>

            <div class="auto-slide">
                <div class="area-icon"><i class="fas fa-shield-alt"></i></div>
                <h5>Cybersecurity</h5>
                <p>Threat detection, encryption, IoT and network security.</p>
            </div>

            <div class="auto-slide">
                <div class="area-icon"><i class="fas fa-database"></i></div>
                <h5>Data Science</h5>
                <p>Big data, analytics, prediction &amp; visualization models.</p>
            </div>

            <div class="auto-slide">
                <div class="area-icon"><i class="fas fa-cogs"></i></div>
                <h5>Engineering</h5>
                <p>Automation, renewable energy, robotics &amp; embedded systems.</p>
            </div>

            <div class="auto-slide">
                <div class="area-icon"><i class="fas fa-graduation-cap"></i></div>
                <h5>Educational Research</h5>
                <p>Digital learning, performance tracking, curriculum design.</p>
            </div>

            <div class="auto-slide">
                <div class="area-icon"><i class="fas fa-leaf"></i></div>
                <h5>Environment &amp; Sustainability</h5>
                <p>Green innovation, climate studies and sustainable development.</p>
            </div>

        </div>

        <div class="auto-dots" aria-label="Slider navigation"></div>
    </div>

    <div class="join-block">
        <div class="join-card">
            <div class="join-kicker">Get Involved</div>
            <h3>Want to Join Our Research Community?</h3>
            <p>
                Students and professors are welcome to participate in active research labs and innovation projects.
            </p>

            <div class="join-actions">
                <a asp-controller="Auth" asp-action="Login" class="join-btn">Join a Research Group</a>
            </div>
        </div>
    </div>

</div>

<style>
    :root {
        --navy: #0b1b3a;
        --navy2: #0a2a55;
        --blue: #2563eb;
        --text: #0f172a;
        --muted: #475569;
        --muted2: #64748b;
        --border: #e5e7eb;
        --surface: #f8fafc;
        --shadowSoft: 0 10px 22px rgba(15, 23, 42, .06);
    }

    .research-hero {
        position: relative;
        min-height: 44vh;
        display: grid;
        place-items: center;
        overflow: hidden;
        background: linear-gradient(135deg, var(--navy), var(--navy2));
        color: #fff;
        text-align: left;
        margin-bottom: 34px;
        padding: 0 16px;
    }

    .research-hero-bg {
        position: absolute;
        inset: 0;
        background: radial-gradient(900px 520px at 18% 20%, rgba(37, 99, 235, .22), transparent 60%), radial-gradient(780px 520px at 84% 26%, rgba(110, 231, 255, .14), transparent 55%), linear-gradient(180deg, rgba(7, 11, 20, .12), rgba(7, 11, 20, .48));
        backdrop-filter: blur(1px);
    }

    .research-hero-content {
        position: relative;
        z-index: 1;
        padding: 68px 0;
        max-width: 980px;
    }

    .research-badge {
        display: inline-flex;
        align-items: center;
        padding: 10px 14px;
        border-radius: 999px;
        background: rgba(255,255,255,.10);
        border: 1px solid rgba(255,255,255,.18);
        color: rgba(255,255,255,.92);
        font-weight: 750;
        letter-spacing: .2px;
        margin-bottom: 14px;
    }

    .research-hero-content h1 {
        margin: 0 0 12px;
        font-size: clamp(34px, 4.5vw, 56px);
        font-weight: 950;
        letter-spacing: -0.7px;
        line-height: 1.06;
    }

    .research-hero-content p {
        margin: 0;
        max-width: 92ch;
        color: rgba(255,255,255,.82);
        font-size: 17px;
        line-height: 1.7;
    }

    .research-wrap {
        padding: 52px 0 92px;
    }

    .research-vision {
        background: #ffffff;
        border: 1px solid var(--border);
        border-radius: 18px;
        padding: 26px;
        box-shadow: 0 6px 18px rgba(15, 23, 42, .05);
    }

    .research-kicker {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        font-weight: 900;
        color: var(--blue);
        letter-spacing: .2px;
        margin-bottom: 10px;
    }

        .research-kicker::before {
            content: "";
            width: 10px;
            height: 10px;
            border-radius: 999px;
            background: var(--blue);
            box-shadow: 0 0 0 6px rgba(37, 99, 235, .12);
        }

    .research-vision h2 {
        margin: 0 0 10px;
        font-size: 30px;
        font-weight: 950;
        color: var(--text);
        letter-spacing: -0.5px;
        line-height: 1.16;
    }

    .research-vision p {
        margin: 0 0 12px;
        color: var(--muted);
        font-size: 16.5px;
        line-height: 1.75;
    }

        .research-vision p:last-child {
            margin-bottom: 0;
        }

    .research-areas-head {
        margin-top: 28px;
        text-align: left;
        padding: 0 6px;
    }

    .section-title {
        margin: 8px 0 6px;
        font-size: 26px;
        font-weight: 950;
        color: var(--text);
        letter-spacing: -0.4px;
        line-height: 1.16;
    }

    .section-sub {
        margin: 0;
        color: var(--muted);
        font-weight: 650;
        line-height: 1.65;
        max-width: 82ch;
    }

    /* ✅ Slider fixed: JS will translate by exact pixels (not %) so gaps won't break it */
    .auto-slider {
        width: 100%;
        overflow: hidden;
        position: relative;
        margin-top: 18px;
    }

    .auto-track {
        display: flex;
        gap: 16px;
        transition: transform 0.7s ease-in-out;
        will-change: transform;
    }

    .auto-slide {
        background: #ffffff;
        border: 1px solid var(--border);
        border-radius: 20px;
        padding: 20px;
        box-shadow: 0 6px 18px rgba(15, 23, 42, .05);
        transition: transform .15s ease, box-shadow .15s ease, border-color .15s ease;
        position: relative;
        overflow: hidden;
        text-align: left;
        flex: 0 0 calc((100% - (16px * 2)) / 3);
        min-height: 180px;
    }

        .auto-slide::before {
            content: "";
            position: absolute;
            inset: 0;
            background: radial-gradient(520px 220px at 18% 10%, rgba(37, 99, 235, .12), transparent 55%);
            opacity: .9;
            pointer-events: none;
        }

        .auto-slide:hover {
            transform: translateY(-3px);
            box-shadow: var(--shadowSoft);
            border-color: rgba(37, 99, 235, .22);
        }

    .area-icon {
        position: relative;
        z-index: 1;
        width: 56px;
        height: 56px;
        border-radius: 18px;
        display: grid;
        place-items: center;
        background: rgba(37, 99, 235, .10);
        border: 1px solid rgba(37, 99, 235, .18);
        color: var(--blue);
        font-size: 22px;
        margin-bottom: 14px;
    }

    .auto-slide h5 {
        position: relative;
        z-index: 1;
        font-size: 17px;
        color: var(--text);
        font-weight: 950;
        margin: 0 0 8px;
        letter-spacing: -0.2px;
    }

    .auto-slide p {
        position: relative;
        z-index: 1;
        margin: 0;
        color: var(--muted2);
        line-height: 1.65;
        font-weight: 650;
        font-size: 14.6px;
    }

    .auto-dots {
        text-align: center;
        margin-top: 18px;
    }

    .auto-dot {
        display: inline-block;
        width: 10px;
        height: 10px;
        background: rgba(37, 99, 235, .18);
        border-radius: 50%;
        margin: 0 5px;
        cursor: pointer;
        transition: 0.2s ease;
        border: 1px solid rgba(37, 99, 235, .25);
    }

        .auto-dot.active {
            background: rgba(37, 99, 235, .90);
            transform: scale(1.25);
        }

    /* ✅ CTA fixed */
    .join-block {
        margin-top: 38px;
        padding: 0 6px;
    }

    .join-card {
        background: linear-gradient(135deg, rgba(11, 27, 58, .06), rgba(37, 99, 235, .06));
        border: 1px solid rgba(37, 99, 235, .18);
        border-radius: 22px;
        padding: 22px;
        text-align: center;
    }

    .join-kicker {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        font-weight: 900;
        color: var(--blue);
        letter-spacing: .2px;
        margin-bottom: 10px;
    }

        .join-kicker::before {
            content: "";
            width: 10px;
            height: 10px;
            border-radius: 999px;
            background: var(--blue);
            box-shadow: 0 0 0 6px rgba(37, 99, 235, .12);
        }

    .join-card h3 {
        margin: 0 0 10px;
        font-size: 24px;
        font-weight: 950;
        color: var(--text);
        letter-spacing: -0.3px;
    }

    .join-card p {
        margin: 0 auto 16px;
        max-width: 80ch;
        color: var(--muted2);
        font-weight: 650;
        line-height: 1.7;
    }

    .join-actions {
        display: flex;
        justify-content: center;
    }

    .join-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 12px 22px;
        border-radius: 14px;
        background: linear-gradient(135deg, #2563eb, #1d4ed8);
        color: #fff;
        text-decoration: none;
        font-weight: 900;
        box-shadow: 0 12px 26px rgba(37, 99, 235, .22);
        transition: transform .15s ease, filter .15s ease;
        border: 0;
        white-space: nowrap;
    }

        .join-btn:hover {
            transform: translateY(-2px);
            filter: brightness(1.05);
            color: #fff;
            text-decoration: none;
        }

    @@media (max-width: 900px) {
        .research-hero-content {
            padding: 58px 0;
        }

        .auto-slide {
            flex: 0 0 calc((100% - (16px * 1)) / 2);
        }
    }

    @@media (max-width: 520px) {
        .auto-slide {
            flex: 0 0 100%;
        }
    }
</style>

<script>
    (() => {
        const slider = document.querySelector(".auto-slider");
        const track = document.querySelector(".auto-track");
        const slides = Array.from(document.querySelectorAll(".auto-slide"));
        const dotsContainer = document.querySelector(".auto-dots");

        if (!slider || !track || slides.length === 0 || !dotsContainer) return;

        let currentIndex = 0;
        let autoTimer = null;

        const getVisibleCount = () => {
            const w = window.innerWidth;
            if (w <= 520) return 1;
            if (w <= 900) return 2;
            return 3;
        };

        const clampIndex = (i) => {
            const visible = getVisibleCount();
            const maxIndex = Math.max(0, slides.length - visible);
            return Math.min(Math.max(i, 0), maxIndex);
        };

        const buildDots = () => {
            dotsContainer.innerHTML = "";
            const visible = getVisibleCount();
            const maxIndex = Math.max(0, slides.length - visible);

            for (let i = 0; i <= maxIndex; i++) {
                const dot = document.createElement("span");
                dot.className = "auto-dot" + (i === currentIndex ? " active" : "");
                dot.dataset.index = i;
                dot.addEventListener("click", () => {
                    currentIndex = i;
                    updateSlider(true);
                });
                dotsContainer.appendChild(dot);
            }
        };

        const updateDots = () => {
            const dots = dotsContainer.querySelectorAll(".auto-dot");
            dots.forEach((d, idx) => d.classList.toggle("active", idx === currentIndex));
        };

        const updateSlider = (restart = false) => {
            currentIndex = clampIndex(currentIndex);

            const firstSlide = slides[0];
            const slideWidth = firstSlide.getBoundingClientRect().width;
            const styles = window.getComputedStyle(track);
            const gap = parseFloat(styles.columnGap || styles.gap || "0") || 0;

            const offsetPx = currentIndex * (slideWidth + gap);
            track.style.transform = `translateX(-${offsetPx}px)`;

            buildDots();
            updateDots();

            if (restart) restartAuto();
        };

        const startAuto = () => {
            clearInterval(autoTimer);
            autoTimer = setInterval(() => {
                const visible = getVisibleCount();
                const maxIndex = Math.max(0, slides.length - visible);
                currentIndex = currentIndex < maxIndex ? currentIndex + 1 : 0;
                updateSlider(false);
            }, 6500);
        };

        const restartAuto = () => startAuto();

        window.addEventListener("resize", () => {
            updateSlider(false);
        });

        currentIndex = 0;
        updateSlider(false);
        startAuto();
    })();
</script>
