@{
    Layout = "_LayoutHome";
    ViewData["Title"] = "About – WTF University";
}

<!-- ===== Hero Section ===== -->
<section class="about-hero d-flex align-items-center justify-content-center text-center text-white">
    <div class="overlay"></div>
    <div class="container position-relative">
        <h1 class="fw-bold display-5 mb-3">About WTF University</h1>
        <p class="lead opacity-90">We’re The Future (Inshallah) — Shaping minds that shape tomorrow.</p>
    </div>
</section>

<!-- ===== Mission / Vision ===== -->
<section class="container my-5 py-5">
    <div class="row align-items-center g-5">
        <div class="col-lg-6">
            <div class="about-card shadow-sm p-4 rounded-4 bg-white">
                <h2 class="text-primary fw-bold mb-3">Our Mission</h2>
                <p class="text-muted mb-4">
                    To empower students with the knowledge, skills, and values to create positive change
                    in their communities and beyond. We believe in education that inspires curiosity,
                    critical thinking, and compassion.
                </p>

                <h2 class="text-primary fw-bold mb-3">Our Vision</h2>
                <p class="text-muted">
                    To be a pioneer in innovative, inclusive, and future-driven learning across Lebanon and the region.
                </p>
            </div>
        </div>

        <div class="col-lg-6 text-center">
            <img src="~/images/uniHome.jpg"
                 alt="Campus image"
                 class="img-fluid rounded-4 shadow-lg about-img" />
        </div>
    </div>
</section>

<!-- ===== Values Section ===== -->
<section class="values-band text-white py-5">
    <div class="container text-center">
        <h2 class="fw-bold mb-5">Our Core Values</h2>
        <div class="row g-4">
            <div class="col-md-3">
                <div class="value-card p-4 rounded-4">
                    <h4>Integrity</h4>
                    <p>Honesty in learning and leadership.</p>
                </div>
            </div>
            <div class="col-md-3">
                <div class="value-card p-4 rounded-4">
                    <h4>Innovation</h4>
                    <p>Creative solutions for real problems.</p>
                </div>
            </div>
            <div class="col-md-3">
                <div class="value-card p-4 rounded-4">
                    <h4>Inclusion</h4>
                    <p>Diversity as a strength and a mission.</p>
                </div>
            </div>
            <div class="col-md-3">
                <div class="value-card p-4 rounded-4">
                    <h4>Impact</h4>
                    <p>Education that transforms society.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<style>
    /* ===== Hero Section ===== */
    /* ===== Hero Section Typography & Overlay ===== */
    .about-hero {
        position: relative;
        height: 70vh;
        min-height: 480px;
        background: url('/images/unnamed.jpg') center/cover no-repeat;
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
        color: #fff;
    }

        .about-hero .overlay {
            position: absolute;
            inset: 0;
            background: rgba(0, 0, 0, 0.45); /* lighter overlay for more image visibility */
            z-index: 1;
        }

        .about-hero .container {
            position: relative;
            z-index: 2;
            color: #fff;
        }

        .about-hero h1 {
            color: #ffffff;
            text-shadow: 0 0 12px rgba(255, 255, 255, 0.6);
            font-weight: 800;
            letter-spacing: 1px;
        }

        .about-hero p {
            color: #f2f6ff;
            font-size: 1.2rem;
            font-weight: 400;
            max-width: 800px;
            margin: 0 auto;
            text-shadow: 0 0 8px rgba(255, 255, 255, 0.5);
        }

    /* ===== Mission / Vision ===== */
    .about-card {
        border-left: 5px solid var(--brand-blue);
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

        .about-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 6px 16px rgba(0, 0, 0, 0.15);
        }

    .about-img {
        max-height: 400px;
        object-fit: cover;
        border: 6px solid #fff;
    }

    /* ===== Values Section ===== */
    /* ===== Values Section ===== */
    .values-band {
        background: linear-gradient(90deg, #0d4b84 0%, #0a3862 100%);
        color: #fff;
    }

        .values-band h2 {
            font-weight: 700;
            color: #ffffff;
        }

    .value-card {
        background: rgba(255, 255, 255, 0.15);
        backdrop-filter: blur(12px);
        border: 1px solid rgba(255, 255, 255, 0.25);
        transition: transform 0.3s ease, background 0.3s ease, border-color 0.3s ease;
        color: #ffffff;
    }

        .value-card:hover {
            transform: translateY(-6px);
            background: rgba(255, 255, 255, 0.25);
            border-color: rgba(255, 255, 255, 0.4);
        }

        .value-card h4 {
            font-weight: 800;
            font-size: 20px;
            margin-bottom: 6px;
            color: #ffffff;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .value-card p {
            font-size: 15px;
            color: #f8f9fa;
            opacity: 0.95;
        }



</style>
