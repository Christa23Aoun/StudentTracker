@{
    Layout = "_LayoutHome";
    ViewData["Title"] = "About – WTF University";
}

<!-- ========================= -->
<!--      HERO SECTION         -->
<!-- ========================= -->
<section class="about-hero">
    <div class="about-hero-content container">
        <h1>About WTF University</h1>
        <p>Building leaders. Inspiring innovation. Shaping the future of education.</p>
    </div>
</section>

<style>
    .about-hero {
        position: relative;
        height: 55vh;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, #003c8f, #001a44);
        color: white;
        text-align: center;
        padding: 0 20px;
    }

    .about-hero-content h1 {
        font-size: 50px;
        font-weight: 800;
        margin-bottom: 12px;
    }

    .about-hero-content p {
        font-size: 20px;
        opacity: 0.9;
        max-width: 700px;
        margin: 0 auto;
    }
</style>



<!-- ========================= -->
<!--     WHO WE ARE SECTION    -->
<!-- ========================= -->
<section class="who-we-are">
    <div class="container who-container">

        <div class="who-text">
            <h2>Who We Are</h2>
            <p>
                WTF University is a leading academic institution dedicated to excellence,
                innovation, and the empowerment of future leaders. Our programs combine cutting-edge
                research with real-world experience, preparing students to succeed in an evolving world.
            </p>
            <p>
                With a mission rooted in integrity and impact, WTF University fosters intellectual growth,
                creativity, and global citizenship in a dynamic learning environment.
            </p>
        </div>


        <div class="section-img">
            <img src="~/images/uniHome.jpg" alt="Campus Image" class="img-round" />
       
        </div>

    </div>
</section>

<style>
    .who-we-are {
        padding: 80px 0;
        background: #f5f8ff;
    }

    .who-container {
        display: flex;
        gap: 50px;
        align-items: center;
        padding: 0 20px;
    }

    .section-img {
        flex: 1;
    }

    .img-round {
        width: 100%;
        border-radius: 14px;
        box-shadow: 0px 10px 20px rgba(0,0,0,0.15);
    }

    .who-text {
        flex: 1;
    }

        .who-text h2 {
            font-size: 34px;
            color: #003c8f;
            margin-bottom: 20px;
            font-weight: 800;
        }

        .who-text p {
            font-size: 18px;
            line-height: 1.7;
            color: #333;
            margin-bottom: 18px;
        }

    @@media(max - width: 900px)

    {
        .who-container

    {
        flex-direction: column;
        text-align: center;
    }

    .who-placeholder {
        width: 100%;
    }

    }
</style>



<!-- ========================= -->
<!--      MISSION SECTION      -->
<!-- ========================= -->
<section class="mission-blue">
    <div class="container mission-content">
        <h2>Our Mission</h2>
        <p>
            To educate, inspire, and empower the next generation through research, innovation,
            and a steadfast commitment to academic excellence.
        </p>
    </div>
</section>

<style>
    .mission-blue {
        padding: 70px 0;
        background: linear-gradient(135deg, #003c8f, #001a44);
        color: white;
        text-align: center;
    }

        .mission-blue h2 {
            font-size: 36px;
            font-weight: 800;
            margin-bottom: 18px;
        }

        .mission-blue p {
            font-size: 19px;
            max-width: 900px;
            margin: 0 auto;
            opacity: 0.95;
        }
</style>



<!-- ========================= -->
<!--      VALUES SECTION       -->
<!-- ========================= -->
<section class="values-grid">
    <div class="container">

        <h2 class="values-header">Our Core Values</h2>

        <div class="values-boxes">

            <div class="value-box">
                <h3>Integrity</h3>
                <p>We uphold truth, transparency, and ethical leadership in everything we do.</p>
            </div>

            <div class="value-box">
                <h3>Innovation</h3>
                <p>We pursue bold ideas and creative solutions that shape the future.</p>
            </div>

            <div class="value-box">
                <h3>Inclusion</h3>
                <p>We embrace diversity and create opportunities for every learner.</p>
            </div>

            <div class="value-box">
                <h3>Impact</h3>
                <p>We drive positive change through research, education, and engagement.</p>
            </div>

        </div>

    </div>
</section>

<style>
    .values-grid {
        padding: 80px 0;
        background: #eef4ff;
    }

    .values-header {
        text-align: center;
        font-size: 34px;
        font-weight: 800;
        color: #003c8f;
        margin-bottom: 45px;
    }

    .values-boxes {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
        gap: 30px;
    }

    .value-box {
        background: white;
        padding: 28px;
        border-radius: 14px;
        box-shadow: 0 4px 18px rgba(0,0,0,0.08);
        transition: 0.25s ease;
    }

        .value-box:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 25px rgba(0,0,0,0.12);
        }

        .value-box h3 {
            font-size: 22px;
            color: #003c8f;
            font-weight: 700;
            margin-bottom: 10px;
        }

        .value-box p {
            color: #555;
            line-height: 1.6;
            font-size: 16px;
        }
</style>



<!-- ========================= -->
<!--      WHY CHOOSE US        -->
<!-- ========================= -->
<section class="why-wtf-section">
    <div class="container">

        <h2>Why Choose WTF University?</h2>

        <div class="why-cards">

            <div class="why-card">
                <h3>Top Faculty</h3>
                <p>Renowned professors and researchers leading each academic field.</p>
            </div>

            <div class="why-card">
                <h3>Modern Campus</h3>
                <p>State-of-the-art labs, classrooms, and collaborative spaces.</p>
            </div>

            <div class="why-card">
                <h3>Global Opportunities</h3>
                <p>Exchange programs and cross-border academic partnerships.</p>
            </div>

            <div class="why-card">
                <h3>Career Success</h3>
                <p>Industry-driven programs with strong career placement support.</p>
            </div>

        </div>

    </div>
</section>

<style>
    .why-wtf-section {
        background: #f4f7fc; /* clean light admin color */
        padding: 80px 0;
        color: #003c8f;
    }

    .why-container h2 {
        text-align: center;
        font-size: 34px;
        font-weight: 800;
        margin-bottom: 50px;
        color: #003c8f; /* deep blue title */
    }

    /* Cards */
    .why-cards {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 30px;
    }

    .why-card {
        background: white;
        padding: 25px 20px;
        border-radius: 14px;
        transition: 0.3s;
        text-align: center;
        box-shadow: 0 4px 14px rgba(0,0,0,0.08);
        border: 1px solid #e5eaf3;
    }

        .why-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 6px 18px rgba(0,0,0,0.12);
        }

        .why-card h3 {
            font-size: 22px;
            font-weight: 700;
            margin-bottom: 8px;
            color: #002b66;
        }

        .why-card p {
            font-size: 16px;
            line-height: 1.6;
            color: #444;
        }

</style>
