@{
    ViewData["Title"] = "Learn More";
}

<section class="learn-hero">
    <div class="learn-hero-bg"></div>
    <div class="container learn-hero-content">
        <div class="learn-badge">Learn More</div>
        <h1>Learn More</h1>
        <p>
            Discover the vision, mission, and development story behind the
            Student Attendance and Performance Tracker (SAPT) — a full academic management platform
            designed and built by WTF University’s software development team.
        </p>
    </div>
</section>

<div class="container learn-wrap">

    <section class="learn-section">
        <div class="learn-section-head">
            <div class="learn-kicker">About the Project</div>
            <h2>What SAPT is and why it exists.</h2>
            <p>
                The <strong>Student Attendance and Performance Tracker (SAPT)</strong> is a full-stack
                academic management platform built using ASP.NET Core MVC, a Web API layer, SQL Server,
                and a structured five-layer architecture (MVC, API, BLL, DAL, COMMON).
                It automates attendance tracking, grade management, course assignment, student dashboards,
                teacher dashboards, and admin operations — ensuring smooth and accurate academic monitoring
                across the university.
            </p>
            <p>
                The system includes role-based authentication for Admins, Teachers, and Students,
                and uses secure API communication, Dapper, stored procedures, sessions, and real-time
                data retrieval through HttpClient.
                The project aims to improve transparency, academic organization, and operational efficiency
                while offering a modern, responsive UI inspired by professional university platforms.
            </p>
        </div>
    </section>

    <section class="learn-section">
        <div class="learn-section-head center">
            <div class="learn-kicker">Development Team</div>
            <h2>Meet the people who built SAPT</h2>
            <p>Each developer owns key modules to keep the platform scalable and maintainable.</p>
        </div>

        <div class="row g-4 mt-3">
            <div class="col-md-4">
                <div class="team-card">
                    <div class="team-icon"><i class="fas fa-user-graduate"></i></div>
                    <div class="team-name">Christa-Maria Aoun</div>
                    <div class="team-role">Developer — Teacher Dashboard &amp; Academic Structure</div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="team-card">
                    <div class="team-icon"><i class="fas fa-user-graduate"></i></div>
                    <div class="team-name">Lynn El Haly</div>
                    <div class="team-role">Developer —  Student Dashboard &amp;User &amp; Access Management</div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="team-card">
                    <div class="team-icon"><i class="fas fa-user-graduate"></i></div>
                    <div class="team-name">Roy Chahoud</div>
                    <div class="team-role">Developer — Admin Dashboard, Reports &amp; Analytics</div>
                </div>
            </div>
        </div>
    </section>

    <div class="text-center learn-cta">
        <a asp-controller="Home" asp-action="Index" class="learn-btn">
            Back to Home
        </a>
    </div>

</div>

<style>
    :root {
        --navy: #0b1b3a;
        --navy2: #0a2a55;
        --blue: #2563eb;
        --text: #0f172a;
        --muted: #475569;
        --muted2: #64748b;
        --border: #e5e7eb;
        --surface: #f8fafc;
        --shadowSoft: 0 10px 22px rgba(15, 23, 42, .06);
        --shadow: 0 14px 40px rgba(15, 23, 42, .08);
    }

    .learn-hero {
        position: relative;
        min-height: 44vh;
        display: grid;
        place-items: center;
        overflow: hidden;
        background: linear-gradient(135deg, var(--navy), var(--navy2));
        color: #fff;
        text-align: left;
        padding: 0 16px;
    }

    .learn-hero-bg {
        position: absolute;
        inset: 0;
        background: radial-gradient(900px 520px at 18% 20%, rgba(37, 99, 235, .22), transparent 60%), radial-gradient(780px 520px at 84% 26%, rgba(110, 231, 255, .14), transparent 55%), linear-gradient(180deg, rgba(7, 11, 20, .12), rgba(7, 11, 20, .48));
        backdrop-filter: blur(1px);
    }

    .learn-hero-content {
        position: relative;
        z-index: 1;
        padding: 68px 0;
        max-width: 980px;
    }

    .learn-badge {
        display: inline-flex;
        align-items: center;
        padding: 10px 14px;
        border-radius: 999px;
        background: rgba(255,255,255,.10);
        border: 1px solid rgba(255,255,255,.18);
        color: rgba(255,255,255,.92);
        font-weight: 750;
        letter-spacing: .2px;
        margin-bottom: 14px;
    }

    .learn-hero-content h1 {
        margin: 0 0 12px;
        font-size: clamp(34px, 4.5vw, 56px);
        font-weight: 950;
        letter-spacing: -0.7px;
        line-height: 1.06;
    }

    .learn-hero-content p {
        margin: 0;
        max-width: 88ch;
        color: rgba(255,255,255,.82);
        font-size: 17px;
        line-height: 1.7;
    }

    .learn-wrap {
        padding: 52px 0 92px;
    }

    .learn-section {
        margin-bottom: 46px;
    }

    .learn-section-head {
        background: #ffffff;
        border: 1px solid var(--border);
        border-radius: 18px;
        padding: 26px;
        box-shadow: 0 6px 18px rgba(15, 23, 42, .05);
    }

        .learn-section-head.center {
            text-align: center;
        }

    .learn-kicker {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        font-weight: 900;
        color: var(--blue);
        letter-spacing: .2px;
        margin-bottom: 10px;
    }

        .learn-kicker::before {
            content: "";
            width: 10px;
            height: 10px;
            border-radius: 999px;
            background: var(--blue);
            box-shadow: 0 0 0 6px rgba(37, 99, 235, .12);
        }

    .learn-section-head h2 {
        margin: 0 0 12px;
        font-size: 28px;
        font-weight: 950;
        color: var(--text);
        letter-spacing: -0.5px;
        line-height: 1.18;
    }

    .learn-section-head p {
        margin: 0 0 12px;
        color: var(--muted);
        font-size: 16.5px;
        line-height: 1.75;
    }

        .learn-section-head p:last-child {
            margin-bottom: 0;
        }

    /* Team cards: slightly different style (not Bootstrap card) */
    .team-card {
        height: 100%;
        background: linear-gradient(180deg, #ffffff, #fbfdff);
        border: 1px solid var(--border);
        border-radius: 18px;
        padding: 22px;
        box-shadow: 0 6px 18px rgba(15, 23, 42, .05);
        transition: transform .15s ease, box-shadow .15s ease, border-color .15s ease;
        position: relative;
        overflow: hidden;
        text-align: center;
    }

        .team-card::before {
            content: "";
            position: absolute;
            inset: 0;
            background: radial-gradient(520px 220px at 20% 10%, rgba(37, 99, 235, .12), transparent 55%);
            opacity: .9;
            pointer-events: none;
        }

        .team-card:hover {
            transform: translateY(-3px);
            box-shadow: var(--shadowSoft);
            border-color: rgba(37, 99, 235, .22);
        }

    .team-icon {
        position: relative;
        z-index: 1;
        width: 56px;
        height: 56px;
        border-radius: 16px;
        margin: 0 auto 14px;
        display: grid;
        place-items: center;
        background: rgba(37, 99, 235, .10);
        border: 1px solid rgba(37, 99, 235, .18);
        color: var(--blue);
        font-size: 22px;
    }

    .team-name {
        position: relative;
        z-index: 1;
        font-weight: 950;
        color: var(--text);
        letter-spacing: -0.2px;
        font-size: 17px;
        margin-bottom: 6px;
    }

    .team-role {
        position: relative;
        z-index: 1;
        color: var(--muted2);
        font-weight: 700;
        font-size: 13.8px;
        line-height: 1.6;
        max-width: 40ch;
        margin: 0 auto;
    }

    .learn-cta {
        margin-top: 28px;
    }

    .learn-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 12px 22px;
        border-radius: 14px;
        background: linear-gradient(135deg, #2563eb, #1d4ed8);
        color: #fff;
        text-decoration: none;
        font-weight: 850;
        box-shadow: 0 12px 26px rgba(37, 99, 235, .22);
        transition: transform .15s ease, filter .15s ease;
    }

        .learn-btn:hover {
            transform: translateY(-2px);
            filter: brightness(1.05);
            color: #fff;
            text-decoration: none;
        }

    @@media (max-width: 900px) {
        .learn-hero-content {
            padding: 58px 0;
        }
    }

    @@media (max-width: 520px) {
        .learn-wrap {
            padding: 44px 0 78px;
        }

        .learn-section-head {
            padding: 20px;
        }

            .learn-section-head h2 {
                font-size: 25px;
            }
    }
</style>
