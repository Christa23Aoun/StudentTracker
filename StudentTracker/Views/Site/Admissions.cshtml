@{
    Layout = "_LayoutHome";
    ViewData["Title"] = "Admissions – WTF University";
}

<section class="admission-hero">
    <div class="admission-hero-bg"></div>
    <div class="admission-hero-content container">
        <div class="admission-badge">Admissions</div>
        <h1>Admissions at WTF University</h1>
        <p>Join a community of innovators, dreamers, and future leaders.</p>
    </div>
</section>

<section class="admission-section container">
    <div class="row g-5 align-items-center">
        <div class="col-lg-7">

            <div class="admission-head">
                <div class="admission-kicker">How to Apply</div>
                <h2 class="admission-title">A simple, supportive process—step by step.</h2>
                <p class="admission-text">
                    Our admissions process is designed to be simple, supportive, and transparent.
                    Submit your online application, provide the required documents, and our admissions
                    advisors will guide you every step of the way.
                </p>
            </div>

            <div class="admission-steps">
                <div class="step-card">
                    <div class="step-pill">Step 1</div>
                    <div class="step-title">Online Application Form</div>
                    <div class="step-desc">Complete the form with your personal and academic details.</div>
                </div>

                <div class="step-card">
                    <div class="step-pill">Step 2</div>
                    <div class="step-title">Transcripts &amp; Certificates</div>
                    <div class="step-desc">Upload your latest transcripts and relevant certificates.</div>
                </div>

                <div class="step-card">
                    <div class="step-pill">Step 3</div>
                    <div class="step-title">Motivation Letter</div>
                    <div class="step-desc">Tell us your goals and why you want to join WTF University.</div>
                </div>

                <div class="step-card">
                    <div class="step-pill">Step 4</div>
                    <div class="step-title">Interview (if shortlisted)</div>
                    <div class="step-desc">A short conversation to understand your interests and fit.</div>
                </div>
            </div>

            <div class="admission-cta">
                <a href="#" class="admission-btn">Start Your Application</a>
                <span class="admission-note">It only takes a few minutes to begin.</span>
            </div>

        </div>
    </div>
</section>

<style>
    :root {
        --navy: #0b1b3a;
        --navy2: #0a2a55;
        --blue: #2563eb;
        --text: #0f172a;
        --muted: #475569;
        --muted2: #64748b;
        --border: #e5e7eb;
        --surface: #f8fafc;
        --surface2: #eef4ff;
        --shadowSoft: 0 10px 22px rgba(15, 23, 42, .06);
        --shadow: 0 14px 40px rgba(15, 23, 42, .08);
    }

    .admission-hero {
        position: relative;
        min-height: 44vh;
        display: grid;
        place-items: center;
        overflow: hidden;
        background: linear-gradient(135deg, var(--navy), var(--navy2));
        color: #fff;
        text-align: left;
        margin-bottom: 34px;
    }

    .admission-hero-bg {
        position: absolute;
        inset: 0;
        background: radial-gradient(900px 520px at 18% 20%, rgba(37, 99, 235, .22), transparent 60%), radial-gradient(780px 520px at 84% 26%, rgba(110, 231, 255, .14), transparent 55%), linear-gradient(180deg, rgba(7, 11, 20, .12), rgba(7, 11, 20, .46));
        backdrop-filter: blur(1px);
    }

    .admission-hero-content {
        position: relative;
        z-index: 1;
        padding: 66px 0;
        max-width: 980px;
    }

    .admission-badge {
        display: inline-flex;
        align-items: center;
        padding: 10px 14px;
        border-radius: 999px;
        background: rgba(255,255,255,.10);
        border: 1px solid rgba(255,255,255,.18);
        color: rgba(255,255,255,.92);
        font-weight: 750;
        letter-spacing: .2px;
        margin-bottom: 14px;
    }

    .admission-hero-content h1 {
        margin: 0 0 10px;
        font-size: clamp(30px, 4.2vw, 52px);
        font-weight: 900;
        letter-spacing: -0.6px;
        line-height: 1.08;
    }

    .admission-hero-content p {
        margin: 0;
        font-size: 17px;
        line-height: 1.65;
        color: rgba(255,255,255,.82);
        max-width: 72ch;
    }

    .admission-section {
        padding-bottom: 110px;
    }

    .admission-head {
        margin-bottom: 18px;
    }

    .admission-kicker {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        font-weight: 850;
        color: var(--blue);
        letter-spacing: .2px;
        margin-bottom: 10px;
    }

        .admission-kicker::before {
            content: "";
            width: 10px;
            height: 10px;
            border-radius: 999px;
            background: var(--blue);
            box-shadow: 0 0 0 6px rgba(37, 99, 235, .12);
        }

    .admission-title {
        font-size: 32px;
        font-weight: 900;
        color: var(--text);
        margin: 0 0 10px;
        letter-spacing: -0.4px;
        line-height: 1.15;
    }

    .admission-text {
        font-size: 17px;
        color: var(--muted);
        line-height: 1.75;
        margin: 0;
        max-width: 78ch;
    }

    .admission-steps {
        display: grid;
        grid-template-columns: repeat(12, 1fr);
        gap: 14px;
        margin-top: 22px;
    }

    .step-card {
        grid-column: span 6;
        background: #ffffff;
        border: 1px solid var(--border);
        border-radius: 18px;
        padding: 18px;
        box-shadow: 0 6px 18px rgba(15, 23, 42, .05);
        transition: transform .15s ease, box-shadow .15s ease, border-color .15s ease;
        position: relative;
        overflow: hidden;
    }

        .step-card::before {
            content: "";
            position: absolute;
            inset: 0;
            background: linear-gradient(90deg, rgba(37, 99, 235, .10), transparent 42%);
            opacity: .55;
            pointer-events: none;
        }

        .step-card:hover {
            transform: translateY(-3px);
            box-shadow: var(--shadowSoft);
            border-color: rgba(37, 99, 235, .22);
        }

    .step-pill {
        position: relative;
        z-index: 1;
        display: inline-flex;
        align-items: center;
        padding: 8px 12px;
        border-radius: 999px;
        background: rgba(37, 99, 235, .10);
        border: 1px solid rgba(37, 99, 235, .18);
        color: var(--blue);
        font-weight: 800;
        font-size: 13px;
        margin-bottom: 10px;
    }

    .step-title {
        position: relative;
        z-index: 1;
        font-size: 16.5px;
        font-weight: 900;
        color: var(--text);
        margin-bottom: 6px;
        letter-spacing: -0.2px;
    }

    .step-desc {
        position: relative;
        z-index: 1;
        color: var(--muted2);
        font-size: 14.5px;
        line-height: 1.65;
    }

    .admission-cta {
        margin-top: 22px;
        display: flex;
        gap: 14px;
        align-items: center;
        flex-wrap: wrap;
    }

    .admission-btn {
        background: linear-gradient(135deg, #2563eb, #1d4ed8);
        padding: 12px 22px;
        color: #fff;
        font-weight: 750;
        border-radius: 14px;
        text-decoration: none;
        transition: transform .15s ease, filter .15s ease;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 12px 26px rgba(37, 99, 235, .22);
    }

        .admission-btn:hover {
            transform: translateY(-2px);
            filter: brightness(1.05);
        }

    .admission-note {
        color: var(--muted2);
        font-weight: 650;
        font-size: 14px;
    }

    @@media (max-width: 900px) {
        .step-card {
            grid-column: span 12;
        }

        .admission-hero-content {
            padding: 58px 0;
        }
    }

    @@media (max-width: 520px) {
        .admission-section {
            padding-bottom: 90px;
        }

        .admission-title {
            font-size: 28px;
        }
    }
</style>
