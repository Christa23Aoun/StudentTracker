@{
    Layout = "_LayoutHome";
    ViewData["Title"] = "Admissions – WTF University";
}

<!-- ===================== -->
<!-- ADMIN-STYLE HEADER -->
<!-- ===================== -->
<section class="admission-header">
    <div class="admission-header-content container">
        <h1>Admissions at WTF University</h1>
        <p>Join a community of innovators, dreamers, and future leaders.</p>
    </div>
</section>

<!-- ===================== -->
<!-- ADMISSIONS STEPS -->
<!-- ===================== -->
<section class="admission-section container">

    <div class="row g-5 align-items-center">

        <div class="col-lg-6">
            <h2 class="admission-title">How to Apply</h2>

            <p class="admission-text">
                Our admissions process is designed to be simple, supportive, and transparent.
                Submit your online application, provide the required documents, and our admissions
                advisors will guide you every step of the way.
            </p>

            <div class="admission-steps">
                <div class="step-box">Online Application Form</div>
                <div class="step-box">Transcripts & Certificates</div>
                <div class="step-box">Motivation Letter</div>
                <div class="step-box">Interview (if shortlisted)</div>
            </div></br></br/>

            <a href="#" class="admission-btn">Start Your Application</a>
        </div>

    </div>

</section>

<!-- ===================== -->
<!-- STYLING -->
<!-- ===================== -->
<style>

    /* ===== HEADER (ADMIN STYLE) ===== */
    .admission-header {
        background: linear-gradient(135deg, #003c8f, #001e44);
        padding: 70px 0 65px 0;
        color: white;
        text-align: center;
        margin-bottom: 40px;
    }

    .admission-header-content h1 {
        font-size: 46px;
        font-weight: 800;
        margin-bottom: 10px;
    }

    .admission-header-content p {
        font-size: 18px;
        opacity: 0.9;
    }

    /* ===== CONTENT SECTION ===== */
    .admission-section {
        padding-bottom: 120px;
    }

    .admission-title {
        font-size: 32px;
        font-weight: 800;
        color: #003c8f;
        margin-bottom: 18px;
    }

    .admission-text {
        font-size: 17px;
        color: #333;
        line-height: 1.7;
        margin-bottom: 25px;
    }

    /* ===== STEPS ===== */
    .admission-steps {
        display: grid;
        gap: 14px;
    }

    .step-box {
        background: #eef4ff;
        border-left: 5px solid #003c8f;
        padding: 12px 16px;
        border-radius: 10px;
        font-weight: 600;
        color: #003c8f;
        font-size: 15px;
        transition: 0.3s ease;
    }

        .step-box:hover {
            background: #dce8ff;
            transform: translateX(4px);
        }

    /* ===== BUTTON ===== */
    .admission-btn {
        background: linear-gradient(135deg, #0066cc, #004c99);
        padding: 12px 28px;
        color: white;
        font-weight: 600;
        border-radius: 12px;
        text-decoration: none;
        transition: 0.3s ease;
        display: inline-block;
    }

        .admission-btn:hover {
            background: linear-gradient(135deg, #0080ff, #005bb5);
            transform: translateY(-3px);
        }

</style>
