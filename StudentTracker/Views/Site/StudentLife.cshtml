@{
    ViewData["Title"] = "Student Life";
}

<!-- ================== HERO WITH IMAGE ================== -->
<section class="studentlife-hero">
    <div class="studentlife-hero-overlay"></div>
    <img src="~/images/uniHome.jpg" class="studentlife-hero-bg" />

    <div class="hero-content">
        <h1 class="fw-bold" style="font-size: 48px;">Student Life at WTF University</h1>
        <p style="max-width: 900px; margin: 20px auto; font-size: 18px;">
            Student life at WTF University is vibrant, diverse, and full of opportunities. From academic excellence
            to leadership, clubs, competitions, and campus activities — students grow personally, socially,
            and professionally.
        </p>
    </div>
</section>

<!-- ================== MAIN CONTENT ================== -->
<div class="container my-5">

    <div class="text-center mb-5">
        <h2 class="fw-bold" style="color:#003c8f;">Life Beyond the Classroom</h2>
        <p style="max-width:700px; margin:auto; color:#5b7083;">
            Our campus experience is designed to help students build friendships, explore passions,
            and develop leadership skills while maintaining academic success.
        </p>
    </div>

    <div class="row g-4">

        <div class="col-md-4 d-flex">
            <div class="card shadow-lg card-fixed" style="border-radius:18px; width:100%;">
                <div class="card-body text-center p-4">
                    <i class="fas fa-users fa-3x mb-3" style="color:#003c8f;"></i>
                    <h5 class="fw-bold">Student Clubs & Societies</h5>
                    <p class="text-muted">
                        Technology club, robotics team, business society, arts & design club, volunteer groups
                        and cultural associations.
                    </p>
                </div>
            </div>
        </div>

        <div class="col-md-4 d-flex">
            <div class="card shadow-lg card-fixed" style="border-radius:18px; width:100%;">
                <div class="card-body text-center p-4">
                    <i class="fas fa-lightbulb fa-3x mb-3" style="color:#003c8f;"></i>
                    <h5 class="fw-bold">Leadership Development</h5>
                    <p class="text-muted">
                        Workshops, mentorships, public speaking sessions, leadership camps,
                        and student council initiatives.
                    </p>
                </div>
            </div>
        </div>

        <div class="col-md-4 d-flex">
            <div class="card shadow-lg card-fixed" style="border-radius:18px; width:100%;">
                <div class="card-body text-center p-4">
                    <i class="fas fa-calendar-alt fa-3x mb-3" style="color:#003c8f;"></i>
                    <h5 class="fw-bold">Campus Events & Activities</h5>
                    <p class="text-muted">
                        Hackathons, competitions, cultural nights, charity events, open days,
                        and academic exhibitions.
                    </p>
                </div>
            </div>
        </div>

        <div class="col-md-4 d-flex">
            <div class="card shadow-lg card-fixed" style="border-radius:18px; width:100%;">
                <div class="card-body text-center p-4">
                    <i class="fas fa-volleyball-ball fa-3x mb-3" style="color:#003c8f;"></i>
                    <h5 class="fw-bold">Sports & Fitness</h5>
                    <p class="text-muted">
                        Basketball, volleyball, football, fitness club, yoga sessions, and inter-faculty tournaments.
                    </p>
                </div>
            </div>
        </div>

        <div class="col-md-4 d-flex">
            <div class="card shadow-lg card-fixed" style="border-radius:18px; width:100%;">
                <div class="card-body text-center p-4">
                    <i class="fas fa-hand-holding-heart fa-3x mb-3" style="color:#003c8f;"></i>
                    <h5 class="fw-bold">Student Support Services</h5>
                    <p class="text-muted">
                        Academic advising, psychological support, tutoring, mentoring,
                        and career development guidance.
                    </p>
                </div>
            </div>
        </div>

        <div class="col-md-4 d-flex">
            <div class="card shadow-lg card-fixed" style="border-radius:18px; width:100%;">
                <div class="card-body text-center p-4">
                    <i class="fas fa-globe fa-3x mb-3" style="color:#003c8f;"></i>
                    <h5 class="fw-bold">Campus Community</h5>
                    <p class="text-muted">
                        A welcoming and collaborative environment where students feel
                        supported, connected, and inspired.
                    </p>
                </div>
            </div>
        </div>

    </div>

    <div class="text-center mt-5">
        <h3 class="fw-bold" style="color:#003c8f;">Become Part of Our Community</h3>
        <p class="text-muted">Your journey starts here. Explore a campus full of creativity, innovation, and opportunity.</p>
        <a asp-controller="Auth" asp-action="Login" class="btn btn-success px-4 py-2 fw-semibold" style="border-radius:12px;">
            Join WTF University
        </a>
    </div>

</div>

<!-- ================== FIX HERO AGAINST LAYOUT ================== -->
<style>
    .studentlife-hero {
        position: relative !important;
        height: 60vh !important;
        min-height: 350px !important;
        display: flex !important;
        align-items: center !important;
        justify-content: center !important;
        overflow: hidden !important;
        text-align: center !important;
        width: 100% !important;
    }

    .studentlife-hero-bg {
        position: absolute !important;
        inset: 0 !important;
        width: 100% !important;
        height: 100% !important;
        object-fit: cover !important;
        filter: brightness(55%) !important;
    }

    .studentlife-hero-overlay {
        position: absolute !important;
        inset: 0 !important;
        background: linear-gradient(135deg, rgba(0,30,70,0.6), rgba(0,55,120,0.85)) !important;
    }

    .hero-content {
        position: relative !important;
        z-index: 2 !important;
        max-width: 900px !important;
        padding: 0 20px !important;
        color:white !important;
    }

    /* CARDS SAME HEIGHT */
    .card-fixed {
        height: 100% !important;
        display: flex !important;
        flex-direction: column !important;
        justify-content: center !important;
    }
</style>
