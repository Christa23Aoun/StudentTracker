@{
    Layout = "_LayoutHome";
    ViewData["Title"] = "Student Life – WTF University";
}

<!-- ================== HERO SECTION (KEPT SIMPLE) ================== -->
<section class="simple-hero">
    <div class="simple-hero-content">
        <h1>Student Life at WTF University</h1>
        <p>
            A vibrant community where students grow academically, socially, and professionally.
        </p>
    </div>
</section>

<style>
    .simple-hero {
        padding: 80px 20px;
        text-align: center;
        background: linear-gradient(135deg, #003c8f, #001f3f);
        color: white;
    }

        .simple-hero h1 {
            font-size: 42px;
            font-weight: 800;
            margin-bottom: 10px;
        }

        .simple-hero p {
            font-size: 18px;
            opacity: 0.9;
        }
</style>

<!-- ================== STUDENT LIFE SLIDER ================== -->
<section class="studentlife-slider-wrapper container">
    <h2 class="slider-title">Life Beyond the Classroom</h2>
    <p class="slider-sub">
        Explore activities, leadership, and community initiatives shaping the WTF University experience.
    </p>

    <div class="slider-container">
        <div class="slider-track">

            <!-- CARD 1 -->
            <div class="slide-card">
                <i class="fas fa-users fa-3x card-icon"></i>
                <h3>Student Clubs</h3>
                <p>Technology, arts, robotics, cultural groups, volunteering & more.</p>
            </div>

            <!-- CARD 2 -->
            <div class="slide-card">
                <i class="fas fa-lightbulb fa-3x card-icon"></i>
                <h3>Leadership Development</h3>
                <p>Workshops, mentorships, public speaking, student councils.</p>
            </div>

            <!-- CARD 3 -->
            <div class="slide-card">
                <i class="fas fa-calendar-alt fa-3x card-icon"></i>
                <h3>Campus Events</h3>
                <p>Hackathons, cultural nights, charity events, exhibitions.</p>
            </div>

            <!-- CARD 4 -->
            <div class="slide-card">
                <i class="fas fa-volleyball-ball fa-3x card-icon"></i>
                <h3>Sports & Fitness</h3>
                <p>Basketball, volleyball, yoga, fitness club, tournaments.</p>
            </div>

            <!-- CARD 5 -->
            <div class="slide-card">
                <i class="fas fa-hand-holding-heart fa-3x card-icon"></i>
                <h3>Support Services</h3>
                <p>Academic advising, psychological support, mentoring.</p>
            </div>

            <!-- CARD 6 -->
            <div class="slide-card">
                <i class="fas fa-globe fa-3x card-icon"></i>
                <h3>Campus Community</h3>
                <p>A welcoming environment where everyone feels connected.</p>
            </div>

        </div>
    </div>

    <!-- DOTS -->
    <div class="slider-dots"></div>

    <div class="join-block">
        <h3>Become Part of Our Community</h3>
        <p>Your journey starts here. Explore a campus full of creativity and opportunity.</p>
        <a asp-controller="Home" asp-action="Index" class="btn btn-success px-4 py-2 fw-semibold" style="border-radius:12px;">
            Join WTF University
        </a>
    </div>

</section>

<!-- ================== SLIDER STYLES ================== -->
<style>
    .studentlife-slider-wrapper {
        margin-top: 80px;
        margin-bottom: 100px;
        text-align: center;
    }

    .slider-title {
        font-size: 34px;
        font-weight: 800;
        color: #003c8f;
        margin-bottom: 12px;
    }

    .slider-sub {
        max-width: 700px;
        margin: auto;
        color: #5b7083;
        margin-bottom: 40px;
    }

    /* SLIDER WRAPPER */
    .slider-container {
        overflow: hidden;
        width: 100%;
        position: relative;
    }

    /* TRACK: 6 cards → sliding left */
    .slider-track {
        display: flex;
        transition: transform 0.8s ease;
        will-change: transform;
    }

    /* CARD */
    .slide-card {
        flex: 0 0 calc(33.333% - 20px);
        background: rgba(255,255,255,0.12);
        backdrop-filter: blur(12px);
        border: 1px solid rgba(255,255,255,0.25);
        margin: 0 10px;
        padding: 30px 25px;
        border-radius: 20px;
        box-shadow: 0 8px 20px rgba(0,0,0,0.15);
        transition: 0.3s ease;
    }

        .slide-card:hover {
            transform: translateY(-6px);
            background: rgba(255,255,255,0.18);
        }

    .card-icon {
        color: #003c8f;
        margin-bottom: 15px;
    }

    /* DOTS */
    .slider-dots {
        margin-top: 25px;
        display: flex;
        justify-content: center;
        gap: 10px;
    }

    .slider-dot {
        width: 12px;
        height: 12px;
        background: #c3d4e1;
        border-radius: 50%;
        cursor: pointer;
        transition: 0.3s;
    }

        .slider-dot.active {
            background: #003c8f;
            transform: scale(1.25);
        }

    /* MOBILE */
    @@media (max-width: 900px) {
        .slide-card

    {
        flex: 0 0 calc(50% - 20px);
    }

    }

    @@media (max-width: 600px) {
        .slide-card

    {
        flex: 0 0 100%;
    }

    }

    .join-block {
        margin-top: 60px;
    }
</style>

<!-- ================== SLIDER SCRIPT ================== -->
<script>
    const track = document.querySelector('.slider-track');
    const dotsContainer = document.querySelector('.slider-dots');

    const totalCards = 6;
    const visibleCount = 3;
    const totalSlides = Math.ceil(totalCards / visibleCount);

    let currentSlide = 0;

    // ========== Create Dots ==========
    for (let i = 0; i < totalSlides; i++) {
        const dot = document.createElement('div');
        dot.classList.add('slider-dot');
        if (i === 0) dot.classList.add('active');
        dot.dataset.index = i;
        dot.onclick = () => goToSlide(i);
        dotsContainer.appendChild(dot);
    }

    const dots = document.querySelectorAll('.slider-dot');

    // ========== Go To Slide ==========
    function goToSlide(slideIndex) {
        currentSlide = slideIndex;
        const offset = -(slideIndex * 100);
        track.style.transform = `translateX(${offset}%)`;

        dots.forEach(dot => dot.classList.remove('active'));
        dots[slideIndex].classList.add('active');
    }

    // ========== Auto Slide ==========
    setInterval(() => {
        currentSlide = (currentSlide + 1) % totalSlides;
        goToSlide(currentSlide);
    }, 8000);
</script>
