@model List<StudentTracker.Models.DepartmentView>

@{
    ViewData["Title"] = "Faculties - WTF University";
}

<div class="container mt-5">
    <h2 class="text-center text-primary mb-4">🏛️ Faculties & Departments</h2>

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger text-center">@ViewBag.Error</div>
    }

    @if (Model == null || !Model.Any())
    {
        <p class="text-center text-muted">No departments found.</p>
    }
    else
    {
        <div class="row justify-content-center">
            @foreach (var dept in Model)
            {
                <div class="col-md-4 mb-4">
                    <div class="card shadow-sm border-0 h-100">
                        <div class="card-body text-center">
                            <h5 class="card-title text-primary">@dept.DepartmentName</h5>
                            <p class="text-muted">
                                @(string.IsNullOrWhiteSpace(dept.Description)
                                                        ? "Description not available."
                                                        : dept.Description)
                    </p>
                    <span class="badge @(dept.IsActive ? "bg-success" : "bg-secondary")">
                        @(dept.IsActive ? "Active" : "Inactive")
                    </span>
                </div>
            </div>
        </div>
                }
        </div>
    }
</div>
