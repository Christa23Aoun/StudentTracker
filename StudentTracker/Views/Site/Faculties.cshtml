@using System.Collections.Generic
@model List<StudentTracker.Models.DepartmentView>

@{
    Layout = "_LayoutHome";
    ViewData["Title"] = "Faculties – WTF University";
}

<!-- ===================== -->
<!-- ADMIN-STYLE HEADER -->
<!-- ===================== -->
<section class="faculty-header">
    <div class="faculty-header-content container">
        <h1>Faculties & Departments</h1>
        <p>Explore the academic divisions that shape the leaders of tomorrow.</p>
    </div>
</section>

<!-- ===================== -->
<!-- FACULTIES LIST -->
<!-- ===================== -->
<section class="faculty-section container">

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger text-center mt-4">@ViewBag.Error</div>
    }

    @if (Model == null || !Model.Any())
    {
        <p class="text-center text-muted mt-5">No departments found.</p>
    }
    else
    {
        <div class="faculty-grid">
            @foreach (var dept in Model)
            {
                <div class="faculty-card">
                    <div class="faculty-card-header">
                        <h3>@dept.DepartmentName</h3>

                        <span class="status @(dept.IsActive ? "status-active" : "status-inactive")">
                            @(dept.IsActive ? "Active" : "Inactive")
                        </span>
                    </div>

                    <p class="faculty-description">
                        Preparing students with quality education, research, and real-world experience.
                    </p>

                    <div class="faculty-meta">
                        <span>Courses:</span>
                        <strong>@dept.CourseCount</strong>
                    </div>
                </div>
            }
        </div>
    }
</section>

<!-- ===================== -->
<!-- CSS STYLING -->
<!-- ===================== -->
<style>

    /* ===== HEADER (ADMIN STYLE) ===== */
    .faculty-header {
        background: linear-gradient(135deg, #003c8f, #001e44);
        padding: 70px 0;
        text-align: center;
        color: white;
        margin-bottom: 40px;
    }

    .faculty-header-content h1 {
        font-size: 46px;
        font-weight: 800;
        margin-bottom: 10px;
    }

    .faculty-header-content p {
        font-size: 18px;
        opacity: 0.9;
    }

    /* ===== SECTION SPACING ===== */
    .faculty-section {
        padding-bottom: 120px;
    }

    /* ===== GRID ===== */
    .faculty-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 35px;
        margin-top: 30px;
    }

    /* ===== CARD (ADMIN STYLE) ===== */
    .faculty-card {
        background: white;
        border-radius: 18px;
        padding: 28px;
        border: 1px solid #d6e4fa;
        box-shadow: 0 6px 18px rgba(0,0,0,0.09);
        transition: 0.3s ease;
    }

        .faculty-card:hover {
            transform: translateY(-6px);
            box-shadow: 0 14px 32px rgba(0,0,0,0.15);
        }

    .faculty-card-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

        .faculty-card-header h3 {
            font-size: 20px;
            font-weight: 700;
            color: #003c8f;
            margin: 0;
        }

    /* ===== STATUS BADGES ===== */
    .status {
        padding: 6px 12px;
        border-radius: 30px;
        font-size: 12px;
        font-weight: 600;
    }

    .status-active {
        background: #d4f6df;
        color: #157a31;
    }

    .status-inactive {
        background: #f0f0f0;
        color: #666;
    }

    /* ===== DESCRIPTION ===== */
    .faculty-description {
        margin: 18px 0;
        color: #444;
        font-size: 15px;
        line-height: 1.7;
    }

    .faculty-meta {
        display: flex;
        gap: 6px;
        font-size: 15px;
        color: #003c8f;
        margin-top: 10px;
    }

</style>
