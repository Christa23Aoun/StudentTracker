@using System.Collections.Generic
@model List<StudentTracker.Models.DepartmentView>

@{
    Layout = "_LayoutHome";
    ViewData["Title"] = "Faculties – WTF University";
}

<section class="faculty-hero">
    <div class="faculty-hero-overlay"></div>
    <img src="~/images/uniHome.jpg" class="faculty-hero-bg" />

    <div class="faculty-hero-content container">
        <h1>Faculties & Departments</h1>
        <p>Explore the academic divisions that shape the leaders of tomorrow.</p>
    </div>
</section>

<section class="faculty-section container">
    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger text-center mt-4">@ViewBag.Error</div>
    }

    @if (Model == null || !Model.Any())
    {
        <p class="text-center text-muted mt-5">No departments found.</p>
    }
    else
    {
        <div class="faculty-grid">
            @foreach (var dept in Model)
            {
                <div class="faculty-card">
                    <div class="faculty-card-header">
                        <h3>@dept.DepartmentName</h3>
                        <span class="status @(dept.IsActive ? "status-active" : "status-inactive")">
                            @(dept.IsActive ? "Active" : "Inactive")
                        </span>
                    </div>

                    <p class="faculty-description">
                        Preparing students with quality education, research, and real-world experience.
                    </p>

                    <div class="faculty-meta">
                        <span>Courses:</span>
                        <strong>@dept.CourseCount</strong>
                    </div>
                </div>
            }
        </div>
    }
</section>

<style>
    .faculty-hero {
        position: relative;
        height: 58vh;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        overflow: hidden;
    }

    .faculty-hero-bg {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        filter: brightness(60%);
    }

    .faculty-hero-overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(135deg, rgba(0,40,90,0.55), rgba(0,60,130,0.75));
    }

    .faculty-hero-content {
        position: relative;
        text-align: center;
        z-index: 2;
        max-width: 900px;
    }

        .faculty-hero-content h1 {
            font-size: 44px;
            font-weight: 800;
            margin-bottom: 10px;
        }

        .faculty-hero-content p {
            font-size: 18px;
            opacity: 0.95;
        }

    .faculty-section {
        padding-top: 40px;
        padding-bottom: 140px; 
    }

    .faculty-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 35px;
        margin-top: 30px;
    }

    .faculty-card {
        background: white;
        border-radius: 20px;
        padding: 28px;
        border: 1px solid #dce7f9;
        box-shadow: 0 4px 14px rgba(0,0,0,0.08);
        transition: 0.3s ease;
    }

        .faculty-card:hover {
            transform: translateY(-6px);
            box-shadow: 0 10px 28px rgba(0,0,0,0.15);
        }

    .faculty-card-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

        .faculty-card-header h3 {
            font-size: 20px;
            font-weight: 700;
            color: #003c8f;
            margin: 0;
        }

    .status {
        padding: 7px 12px;
        border-radius: 30px;
        font-size: 12px;
        font-weight: 600;
    }

    .status-active {
        background: #d4f6df;
        color: #1b7d3a;
    }

    .status-inactive {
        background: #eee;
        color: #666;
    }

    .faculty-description {
        margin: 18px 0;
        color: #444;
        font-size: 15px;
        line-height: 1.7;
    }

    .faculty-meta {
        display: flex;
        gap: 6px;
        font-size: 15px;
        color: #003c8f;
        margin-top: 10px;
    }
</style>
