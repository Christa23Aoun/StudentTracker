@{
    Layout = "_LayoutHome";
    ViewData["Title"] = "Home Page";
}

<!-- ===== HERO SECTION ===== -->
<section class="hero home-section">
    <div class="hero-overlay"></div>

    <img src="~/images/unnamed.jpg"
         alt="WTF University campus"
         class="hero-bg" />

    <div class="container hero-content">
        <h1 class="batata">
            Welcome to <span>WTF University</span><br />
            <small>Empowering the Future of Education</small>
        </h1>

        <div class="hero-actions">
            <a class="btn primary"
               asp-controller="Site"
               asp-action="Programs">
                Discover Our Programs
            </a>

            <a class="btn ghost"
               asp-controller="Site"
               asp-action="LearnMore">
                Learn More
            </a>
        </div>
    </div>
</section>

<!-- ===== LATEST NEWS & EVENTS ===== -->
<section class="news-block home-section container" aria-label="Latest News & Events">
    <div class="news-header">
        <h2>Latest News &amp; Events</h2>


    </div>

    <div class="news-track" id="newsTrack">
        <article class="news-card">
            <div class="news-card-body">
                <h3>150 Years of Academic Excellence</h3>
                <p>Celebrating a legacy of innovation, research, and education since 1875.</p>
                <a class="news-link" href="#">Read more →</a>
            </div>
        </article>

        <article class="news-card">
            <div class="news-card-body">
                <h3>Admissions Open 2025–2026</h3>
                <p>Join our diverse community of scholars, innovators, and changemakers.</p>
                <a class="news-link" href="#">Read more →</a>
            </div>
        </article>

        <article class="news-card">
            <div class="news-card-body">
                <h3>Join Our Research Teams</br></br></h3>
                <p>Take part in groundbreaking projects across engineering, sciences, and humanities.</p>
                <a class="news-link" href="#">Read more →</a>
            </div>
        </article>

        <article class="news-card">
            <div class="news-card-body">
                <h3>Student Life &amp; Campus Experience</h3>
                <p>Clubs, events, and activities that make learning a full life experience.</p>
                <a class="news-link" href="#">Read more →</a>
            </div>
        </article>
    </div>
</section>

<!-- ===== STATS SECTION ===== -->
<section class="stats-band home-section">
    <div class="container stats-container">
        <div class="stat">
            <h3>100</h3>
            <p>Students</p>
        </div>
        <div class="stat">
            <h3>20</h3>
            <p>Teachers</p>
        </div>
        <div class="stat">
            <h3>20</h3>
            <p>Researchers</p>
        </div>
        <div class="stat">
            <h3>13</h3>
            <p>Faculties</p>
        </div>
    </div>
</section>