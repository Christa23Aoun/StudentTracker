@model StudentTracker.Models.CourseScheduleView

@{
    ViewData["Title"] = "Edit Schedule";
    var courseId = Model.CourseID;
}

<style>
    body {
        background: #f2f4fb;
        font-family: 'Segoe UI', sans-serif;
        color: #0b2540;
        margin: 0;
        padding: 0;
    }

    .page-wrapper {
        max-width: 650px;
        margin: 80px auto;
        padding: 0 20px 40px 20px;
    }

    .form-card {
        background: #ffffff;
        border-radius: 20px;
        padding: 30px;
        box-shadow: 0 16px 40px rgba(15, 23, 42, 0.12);
        border: 1px solid rgba(148, 163, 184, 0.3);
    }

    h2 {
        margin-bottom: 8px;
        font-size: 1.8rem;
        font-weight: 700;
    }

    .subtitle {
        color: #64748b;
        font-size: 0.95rem;
        margin-bottom: 22px;
    }

    label {
        font-weight: 600;
        color: #0b2540;
        margin-bottom: 6px;
        display: block;
    }

    .form-control {
        width: 100%;
        padding: 10px 14px;
        border-radius: 12px;
        border: 1px solid #cbd5e1;
        font-size: 0.95rem;
        margin-bottom: 18px;
    }

    .btn {
        border-radius: 999px;
        font-weight: 600;
        padding: 10px 22px;
        cursor: pointer;
        border: 1px solid transparent;
        font-size: 0.94rem;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
    }

    .btn-primary {
        background: linear-gradient(135deg, #0f6ae6, #1d4ed8);
        color: #ffffff;
        box-shadow: 0 10px 25px rgba(37, 99, 235, 0.35);
    }

    .btn-secondary {
        background: #e0ecff;
        color: #1d3b72;
        border-color: #c4d4ff;
    }

    .actions {
        display: flex;
        justify-content: flex-end;
        gap: 12px;
        margin-top: 25px;
    }

    .modal-overlay {
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.35);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 9999;
    }

    .modal-box {
        background: #ffffff;
        padding: 28px 30px;
        border-radius: 18px;
        max-width: 360px;
        width: 90%;
        text-align: center;
        box-shadow: 0 12px 30px rgba(0,0,0,0.2);
        border: 1px solid #e2e8f0;
    }

        .modal-box h3 {
            margin-bottom: 12px;
            font-size: 1.3rem;
            font-weight: 700;
            color: #b91c1c;
        }

        .modal-box p {
            margin-bottom: 22px;
            color: #374151;
            font-size: 0.95rem;
        }

    .modal-btn {
        background: #0f6ae6;
        color: white;
        padding: 10px 22px;
        border: none;
        border-radius: 999px;
        font-weight: 600;
        cursor: pointer;
        font-size: 0.95rem;
        box-shadow: 0 8px 20px rgba(15, 106, 230, 0.3);
    }

        .modal-btn:hover {
            background: #1d4ed8;
        }
</style>

<div class="page-wrapper">
    <div class="form-card">

        <h2>Edit Schedule</h2>
        <p class="subtitle">Modify this weekly time slot.</p>

        <form asp-action="EditSchedule" asp-route-courseId="@courseId" method="post">

            <input type="hidden" asp-for="ScheduleID" />
            <input type="hidden" asp-for="CourseID" />

            <label>Day of Week</label>
            <select asp-for="DayOfWeek" class="form-control">
                <option value="1">Monday</option>
                <option value="2">Tuesday</option>
                <option value="3">Wednesday</option>
                <option value="4">Thursday</option>
                <option value="5">Friday</option>
            </select>

            <label>Start Time</label>
            <input asp-for="StartTime"
                   type="time"
                   class="form-control"
                   min="08:00"
                   max="19:15"
                   required />

            <p style="color:#64748b; font-size:0.85rem; margin-top:-12px; margin-bottom:15px;">
                Allowed time range: <strong>08:00 AM</strong> to <strong>07:15 PM</strong>.
            </p>

            <div class="actions">
                <a asp-action="Schedule"
                   asp-route-courseId="@courseId"
                   class="btn btn-secondary">
                    Cancel
                </a>

                <button type="submit" class="btn btn-primary">
                    Save Changes
                </button>
            </div>

        </form>

        <div id="timeModal" class="modal-overlay" style="display:none;">
            <div class="modal-box">
                <h3>Invalid Start Time</h3>
                <p>The latest allowed start time is <strong>18:00</strong> so the session ends at 19:15.</p>
                <button id="closeModal" class="modal-btn">OK</button>
            </div>
        </div>

        <script>
            const startInput = document.querySelector('input[name="StartTime"]');
            const modal = document.getElementById('timeModal');
            const closeModal = document.getElementById('closeModal');

            if (startInput) {
                startInput.addEventListener('input', () => {
                    const value = startInput.value;
                    if (!value) return;
                    const [h, m] = value.split(':').map(Number);
                    const start = h * 60 + m;
                    const end = start + 75;
                    const latestEnd = 19 * 60 + 15;
                    if (end > latestEnd) {
                        startInput.value = "18:00";
                        modal.style.display = "flex";
                    }
                });
            }
            closeModal.addEventListener('click', () => {
                modal.style.display = "none";
            });
        </script>

    </div>
</div>
