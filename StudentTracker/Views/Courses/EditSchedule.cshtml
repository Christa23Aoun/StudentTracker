@model StudentTracker.Models.CourseScheduleView

@{
    ViewData["Title"] = "Edit Schedule";
}

<style>
    body {
        background: #f3f4fd;
        font-family: 'Segoe UI', sans-serif;
        color: #0b2540;
        margin: 0;
        padding: 0;
    }

    .schedule-form-page {
        max-width: 960px;
        margin: 70px auto 80px auto;
        padding: 0 20px;
    }

    .schedule-form-card {
        background: #ffffff;
        border-radius: 28px;
        padding: 40px 40px 32px 40px;
        box-shadow: 0 18px 55px rgba(15, 23, 42, 0.16);
        border: 1px solid rgba(148, 163, 184, 0.3);
    }

    .schedule-title {
        font-size: 2rem;
        font-weight: 700;
        text-align: center;
        margin-bottom: 24px;
        color: #0b2540;
    }

    .alert-error {
        background: #fee2e2;
        border: 1px solid #fecaca;
        color: #b91c1c;
        padding: 14px 16px;
        border-radius: 14px;
        font-size: 0.95rem;
        font-weight: 600;
        text-align: center;
        margin-bottom: 22px;
    }

    .form-group {
        margin-bottom: 20px;
    }

    .form-label {
        display: block;
        font-weight: 600;
        margin-bottom: 6px;
        color: #0f172a;
        font-size: 0.96rem;
    }

    .form-select,
    .form-control {
        width: 100%;
        border-radius: 14px;
        border: 1px solid #cbd5f5;
        padding: 11px 14px;
        font-size: 0.96rem;
        background: #f8fbff;
        color: #0b2540;
        outline: none;
        transition: border-color 0.15s ease, box-shadow 0.15s ease, background 0.15s ease;
        box-sizing: border-box;
    }

        .form-select:focus,
        .form-control:focus {
            border-color: #2563eb;
            box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.25);
            background: #ffffff;
        }

    .btn-row {
        display: flex;
        justify-content: flex-start;
        gap: 16px;
        margin-top: 26px;
        flex-wrap: wrap;
    }

    .btn {
        border-radius: 999px;
        font-weight: 600;
        padding: 10px 26px;
        cursor: pointer;
        border: 1px solid transparent;
        font-size: 0.95rem;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        transition: background 0.2s ease, box-shadow 0.2s ease, transform 0.1s ease;
    }

    .btn-primary {
        background: linear-gradient(135deg, #0f6ae6, #1d4ed8);
        color: #ffffff;
        box-shadow: 0 12px 28px rgba(37, 99, 235, 0.4);
    }

        .btn-primary:hover {
            background: linear-gradient(135deg, #2563eb, #1d4ed8);
            transform: translateY(-1px);
        }

    .btn-secondary {
        background: #e0ecff;
        color: #1d3b72;
        border-color: #c4d4ff;
    }

        .btn-secondary:hover {
            background: #d4e2ff;
        }

    @@media (max-width: 768px) {
        .schedule-form-card

    {
        padding: 28px 20px 24px 20px;
    }

    .schedule-title {
        font-size: 1.6rem;
    }

    .btn-row {
        justify-content: center;
    }

    }
</style>

<div class="schedule-form-page">
    <div class="schedule-form-card">
        <h1 class="schedule-title">Edit Schedule</h1>

        @if (TempData["ScheduleError"] != null)
        {
            <div class="alert-error">
                @TempData["ScheduleError"]
            </div>
        }

        <form method="post" asp-action="EditSchedule">
            <input type="hidden" asp-for="ScheduleID" />
            <input type="hidden" asp-for="CourseID" />

            <div class="form-group">
                <label class="form-label">Day of Week</label>
                <select asp-for="DayOfWeek" class="form-select">
                    <option value="1">Monday</option>
                    <option value="2">Tuesday</option>
                    <option value="3">Wednesday</option>
                    <option value="4">Thursday</option>
                    <option value="5">Friday</option>
                    <option value="6">Saturday</option>
                    <option value="7">Sunday</option>
                </select>
            </div>

            <div class="form-group">
                <label class="form-label">Start Time</label>
                <input asp-for="StartTime" type="time" step="60" class="form-control" />
            </div>

            <div class="btn-row">
                <button type="submit" class="btn btn-primary">
                    Save Changes
                </button>

                <a asp-action="Schedule"
                   asp-route-courseId="@Model.CourseID"
                   class="btn btn-secondary">
                    Back to Schedule
                </a>

                <a asp-controller="Courses"
                   asp-action="Index"
                   class="btn btn-secondary">
                    Dashboard
                </a>
            </div>
        </form>
    </div>
</div>
