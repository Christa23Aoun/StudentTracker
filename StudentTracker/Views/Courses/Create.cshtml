@model StudentTracker.Models.CourseView
@{
    ViewData["Title"] = "Add Course";
}

<style>
    body {
        background: #f2f4fb;
        font-family: 'Segoe UI', sans-serif;
        color: #0b2540;
        margin: 0;
        padding: 0;
    }

    .course-form-shell {
        max-width: 720px;
        margin: 80px auto;
        padding: 0 20px 40px 20px;
    }

    .course-form-card {
        background: #ffffff;
        border-radius: 22px;
        padding: 32px 30px 28px 30px;
        box-shadow: 0 18px 40px rgba(15, 23, 42, 0.16);
        border: 1px solid rgba(148, 163, 184, 0.35);
    }

    .course-form-header {
        text-align: center;
        margin-bottom: 26px;
    }

        .course-form-header h2 {
            margin: 0 0 8px;
            font-weight: 700;
            font-size: 1.8rem;
            color: #0b2540;
        }

        .course-form-header p {
            margin: 0;
            color: #64748b;
            font-size: 0.95rem;
        }

    .form-label {
        font-weight: 600;
        color: #0b2540;
        margin-bottom: 4px;
        font-size: 0.9rem;
    }

    .form-control,
    .form-select {
        background: #f9fafb;
        border-radius: 10px;
        border: 1px solid #cbd5e1;
        padding: 10px 12px;
        font-size: 0.95rem;
        margin-bottom: 16px;
        color: #0b2540;
    }

        .form-control:focus,
        .form-select:focus {
            outline: none;
            border-color: #2563eb;
            box-shadow: 0 0 0 1px #2563eb33;
        }

    .btn-row {
        display: flex;
        justify-content: center;
        gap: 14px;
        margin-top: 10px;
    }

    .btn {
        border-radius: 999px;
        font-weight: 600;
        padding: 10px 26px;
        cursor: pointer;
        transition: 0.2s ease;
        border: 1px solid transparent;
        font-size: 0.95rem;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }

    .btn-primary {
        background: linear-gradient(135deg, #0f6ae6, #1d4ed8);
        color: #ffffff;
        border-color: transparent;
        box-shadow: 0 10px 25px rgba(37, 99, 235, 0.35);
    }

        .btn-primary:hover {
            background: linear-gradient(135deg, #2563eb, #1d4ed8);
        }

    .btn-secondary {
        background: #e2e8f0;
        color: #0f172a;
        border-color: #cbd5e1;
    }

        .btn-secondary:hover {
            background: #cbd5e1;
        }

    .text-danger {
        font-size: 0.85rem;
    }
</style>

<div class="course-form-shell">
    <div class="course-form-card">
        <div class="course-form-header">
            <h2>Add Course</h2>
            <p>Create a new course and assign it to the proper department and semester.</p>
        </div>

        <form asp-action="Create" method="post">

            <label class="form-label">Course Code</label>
            <input asp-for="CourseCode" class="form-control" />

            <label class="form-label">Course Name</label>
            <input asp-for="CourseName" class="form-control" />
            <span asp-validation-for="CourseName" class="text-danger"></span>

            <label class="form-label">Credit Hours</label>
            <input asp-for="CreditHours" type="number" class="form-control" />
            <span asp-validation-for="CreditHours" class="text-danger"></span>

            <label class="form-label">Department</label>
            <select asp-for="DepartmentID"
                    class="form-select"
                    asp-items="@(new SelectList(Model.Departments, "Id", "Name", Model.DepartmentID))">
                <option value="">-- Select Department --</option>
            </select>

            <label class="form-label">Semester</label>
            <select asp-for="SemesterID"
                    class="form-select"
                    asp-items="@(new SelectList(Model.Semesters, "Id", "Name", Model.SemesterID))">
                <option value="">-- Select Semester --</option>
            </select>

            <label class="form-label">Teacher</label>
            <select asp-for="TeacherID"
                    class="form-select"
                    asp-items="@(new SelectList(Model.Teachers, "Id", "Name", Model.TeacherID))">
                <option value="">-- Select Teacher --</option>
            </select>

            <div class="form-check">
                <input class="form-check-input" asp-for="IsActive" />
                <label class="form-check-label" asp-for="IsActive">Active</label>
            </div>

            <div class="btn-row">
                <button class="btn btn-primary" type="submit">Save</button>
                <a asp-action="Index" class="btn btn-secondary">Back</a>
            </div>

        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
