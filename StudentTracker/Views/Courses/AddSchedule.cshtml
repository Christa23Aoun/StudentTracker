@model StudentTracker.Models.CourseScheduleView

@{
    ViewData["Title"] = "Add Schedule";
    var courseId = Model.CourseID;
}

<style>
    body {
        background: #f2f4fb;
        font-family: 'Segoe UI', sans-serif;
        color: #0b2540;
        margin: 0;
        padding: 0;
    }

    .page-wrapper {
        max-width: 650px;
        margin: 80px auto;
        padding: 0 20px 40px 20px;
    }

    .form-card {
        background: #ffffff;
        border-radius: 20px;
        padding: 30px;
        box-shadow: 0 16px 40px rgba(15, 23, 42, 0.12);
        border: 1px solid rgba(148, 163, 184, 0.3);
    }

    h2 {
        margin-bottom: 8px;
        font-size: 1.8rem;
        font-weight: 700;
    }

    .subtitle {
        color: #64748b;
        font-size: 0.95rem;
        margin-bottom: 22px;
    }

    label {
        font-weight: 600;
        color: #0b2540;
        margin-bottom: 6px;
        display: block;
    }

    .form-control {
        width: 100%;
        padding: 10px 14px;
        border-radius: 12px;
        border: 1px solid #cbd5e1;
        font-size: 0.95rem;
        margin-bottom: 18px;
    }

    .btn {
        border-radius: 999px;
        font-weight: 600;
        padding: 10px 22px;
        cursor: pointer;
        border: 1px solid transparent;
        font-size: 0.94rem;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
    }

    .btn-primary {
        background: linear-gradient(135deg, #0f6ae6, #1d4ed8);
        color: #ffffff;
        box-shadow: 0 10px 25px rgba(37, 99, 235, 0.35);
    }

    .btn-secondary {
        background: #e0ecff;
        color: #1d3b72;
        border-color: #c4d4ff;
    }

    .actions {
        display: flex;
        justify-content: flex-end;
        gap: 12px;
        margin-top: 25px;
    }
</style>

<div class="page-wrapper">
    <div class="form-card">

        <h2>Add Schedule</h2>
        <p class="subtitle">Create a weekly time slot for this course.</p>

        <form asp-action="AddSchedule" asp-route-courseId="@courseId" method="post">

            <input type="hidden" asp-for="CourseID" />

            <label>Day of Week</label>
            <select asp-for="DayOfWeek" class="form-control">
                <option value="1">Monday</option>
                <option value="2">Tuesday</option>
                <option value="3">Wednesday</option>
                <option value="4">Thursday</option>
                <option value="5">Friday</option>
                <option value="6">Saturday</option>
                <option value="7">Sunday</option>
            </select>

            <label>Start Time</label>
            <input asp-for="StartTime" type="time" class="form-control" />

            <div class="actions">
                <a asp-action="Schedule"
                   asp-route-courseId="@courseId"
                   class="btn btn-secondary">
                    Cancel
                </a>

                <button type="submit" class="btn btn-primary">
                    Save Schedule
                </button>
            </div>

        </form>

    </div>
</div>
