@model StudentTracker.Models.CourseScheduleView

@{
    ViewData["Title"] = "Add Schedule";
}

<style>
    body {
        background: linear-gradient(135deg, #001a33, #003c8f);
        font-family: 'Segoe UI', sans-serif;
        color: #fff;
        margin: 0;
        padding: 0;
    }

    .form-wrapper {
        width: 75%;
        max-width: 700px;
        margin: 80px auto;
        background: rgba(0, 45, 90, 0.75);
        padding: 35px;
        border-radius: 20px;
        backdrop-filter: blur(20px);
    }

    h2 {
        text-align: center;
        font-weight: 700;
        margin-bottom: 20px;
    }

    label {
        font-weight: 600;
        margin-top: 12px;
        display: block;
    }

    select, input {
        width: 100%;
        padding: 10px;
        border-radius: 10px;
        border: none;
        margin-top: 5px;
    }

    .btn-row {
        display: flex;
        justify-content: center;
        gap: 20px;
        margin-top: 25px;
    }

    .btn {
        padding: 10px 25px;
        border-radius: 10px;
        cursor: pointer;
        font-weight: 600;
        border: none;
        transition: 0.3s;
    }

    .btn-primary {
        background: linear-gradient(135deg, #009dff, #0066cc);
        color: white;
    }

        .btn-primary:hover {
            background: linear-gradient(135deg, #00b7ff, #004c99);
        }

    .btn-secondary {
        background: rgba(255,255,255,0.25);
        color: #eee;
    }

        .btn-secondary:hover {
            background: rgba(255,255,255,0.4);
        }
</style>

<div class="form-wrapper">

    <h2>➕ Add Schedule</h2>

    <form method="post" asp-action="AddSchedule">

        <input type="hidden" asp-for="CourseID" />

        <label>Day of Week</label>
        <select asp-for="DayOfWeek">
            <option value="1">Monday</option>
            <option value="2">Tuesday</option>
            <option value="3">Wednesday</option>
            <option value="4">Thursday</option>
            <option value="5">Friday</option>
            <option value="6">Saturday</option>
            <option value="7">Sunday</option>
        </select>

        <label>Start Time</label>
        <input asp-for="StartTime" type="time" step="1" />

        <div class="btn-row">
            <button type="submit" class="btn-primary btn">Save Schedule</button>

            <a asp-action="Schedule" asp-route-courseId="@Model.CourseID" class="btn btn-secondary">
                ⬅ Back to Course Schedule
            </a>

            <a asp-controller="Admin" asp-action="Dashboard" class="btn btn-secondary">
                🏠 Dashboard
            </a>
        </div>

    </form>
</div>
