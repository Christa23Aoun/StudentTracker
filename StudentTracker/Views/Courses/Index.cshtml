@model IEnumerable<StudentTracker.Models.CourseView>
@{
    ViewData["Title"] = "Course Management";
}

<style>
    body {
        background: linear-gradient(135deg, #001a33, #003c8f);
        font-family: 'Segoe UI', sans-serif;
        color: #fff;
        margin: 0;
        padding: 0;
        overflow-x: hidden;
    }

    .page-wrapper {
        width: 90%;
        max-width: 1200px;
        margin: 100px auto 80px auto;
        background: rgba(0, 45, 90, 0.75);
        border-radius: 25px;
        padding: 40px;
        box-shadow: 0 8px 25px rgba(0, 0, 0, 0.6);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
    }

    h2 {
        font-weight: 700;
        text-align: center;
        margin-bottom: 25px;
        color: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
    }

    .btn-row {
        display: flex;
        justify-content: center;
        gap: 20px;
        margin-bottom: 30px;
    }

    .btn {
        border: none;
        border-radius: 12px;
        font-weight: 600;
        padding: 12px 28px;
        cursor: pointer;
        transition: all 0.3s ease;
    }

    .btn-primary {
        background: linear-gradient(135deg, #007bff, #0056b3);
        color: #fff;
    }

        .btn-primary:hover {
            background: linear-gradient(135deg, #0095ff, #0048a5);
            box-shadow: 0 0 15px rgba(0, 150, 255, 0.6);
        }

    .btn-secondary {
        background: rgba(255, 255, 255, 0.15);
        color: #ddd;
    }

        .btn-secondary:hover {
            background: rgba(255, 255, 255, 0.3);
        }

    table {
        width: 100%;
        border-collapse: collapse;
        background: rgba(255, 255, 255, 0.05);
        border-radius: 12px;
        overflow: hidden;
    }

    th, td {
        padding: 14px 16px;
        text-align: center;
    }

    th {
        background: rgba(0, 60, 130, 0.9);
        font-weight: 600;
        color: #cde5ff;
    }

    tr:nth-child(even) {
        background: rgba(255, 255, 255, 0.05);
    }

    tr:hover {
        background: rgba(0, 90, 180, 0.25);
    }

    .status-active {
        background: #00c853;
        color: #fff;
        padding: 5px 12px;
        border-radius: 12px;
        font-weight: 500;
    }

    .actions {
        display: flex;
        justify-content: center;
        gap: 10px;
    }

        .actions a, .actions button {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 35px;
            height: 35px;
            border-radius: 10px;
            border: none;
            transition: all 0.3s ease;
        }

    .btn-edit {
        background: rgba(0, 150, 255, 0.25);
        color: #fff;
    }

    .btn-delete {
        background: rgba(255, 80, 80, 0.25);
        color: #fff;
    }

    .btn-edit:hover {
        background: rgba(0, 150, 255, 0.5);
    }

    .btn-delete:hover {
        background: rgba(255, 80, 80, 0.5);
    }
</style>

<div class="page-wrapper">
    <h2>📘 Course Management</h2>

    <div class="btn-row">
        <a asp-action="Dashboard" asp-controller="Admin" class="btn btn-secondary">⬅️ Back to Dashboard</a>
        <a asp-action="Create" class="btn btn-primary">➕ Add Course</a>
    </div>

    <table>
        <thead>
            <tr>
                <th>ID</th>
                <th>Code</th>
                <th>Name</th>
                <th>CH</th>
                <th>Department ID</th>
                <th>Teacher ID</th>
                <th>Semester ID</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var course in Model)
            {
                <tr>
                    <td>@course.CourseID</td>
                    <td>@course.CourseCode</td>
                    <td>@course.CourseName</td>
                    <td>@course.CreditHours</td>
                    <td>@course.DepartmentID</td>
                    <td>@course.TeacherID</td>
                    <td>@course.SemesterID</td>
                    <td>
                        @if (course.IsActive)
                        {
                            <span class="status-active">Active</span>
                        }
                        else
                        {
                            <span class="status-inactive">Inactive</span>
                        }
                    </td>
                    <td class="actions">
                        <a asp-action="Edit" asp-route-id="@course.CourseID" class="btn-edit">
                            ✏️
                        </a>
                        <form asp-action="Delete" asp-route-id="@course.CourseID" method="post" style="display:inline;">
                            <button type="submit" class="btn-delete">🗑️</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
