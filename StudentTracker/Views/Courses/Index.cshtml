@model IEnumerable<StudentTracker.Models.CourseView>

@{
    ViewData["Title"] = "Courses";
}

<style>
    /* ===== Background (matches admin dashboard) ===== */
    body {
        background: linear-gradient(135deg, #001a33 0%, #002b66 40%, #003c8f 100%);
        font-family: 'Segoe UI', sans-serif;
        color: #fff;
        margin: 0;
        padding: 0;
    }

    /* ===== Wrapper ===== */
    .courses-wrapper {
        width: 90%;
        max-width: 1300px;
        margin: 80px auto;
        background: rgba(0, 45, 90, 0.75);
        border-radius: 22px;
        backdrop-filter: blur(30px);
        -webkit-backdrop-filter: blur(30px);
        padding: 50px;
        box-shadow: 0 8px 30px rgba(0, 0, 0, 0.6);
        border: 1px solid rgba(255, 255, 255, 0.05);
    }

    /* ===== Header ===== */
    .page-header {
        text-align: center;
        margin-bottom: 40px;
    }

        .page-header h2 {
            font-weight: 700;
            font-size: 2.2rem;
            color: #ffffff;
            text-shadow: 0 0 10px rgba(0, 0, 0, 0.2);
        }

    /* ===== Buttons Row ===== */
    .buttons-row {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 18px;
        margin-bottom: 35px;
        flex-wrap: wrap;
    }

    .btn {
        display: inline-block;
        padding: 12px 28px;
        border-radius: 12px;
        font-weight: 600;
        border: none;
        text-decoration: none;
        transition: all 0.3s ease;
        font-size: 1rem;
    }

    .btn-back {
        background: rgba(120, 180, 255, 0.25);
        color: #e2eeff;
    }

        .btn-back:hover {
            background: rgba(120, 180, 255, 0.4);
            transform: translateY(-2px);
        }

    .btn-add {
        background: linear-gradient(135deg, #008cff, #005fc4);
        color: #fff;
        box-shadow: 0 0 10px rgba(0, 140, 255, 0.3);
    }

        .btn-add:hover {
            background: linear-gradient(135deg, #005fc4, #008cff);
            transform: translateY(-2px);
            box-shadow: 0 0 20px rgba(0, 140, 255, 0.5);
        }

    /* ===== Table Container: full width, no scroll ===== */
    .table-container {
        width: 100%;
        margin: 0 auto;
        background: rgba(0, 40, 85, 0.85);
        border-radius: 18px;
        padding: 25px;
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.5);
        border: 1px solid rgba(255, 255, 255, 0.08);
        overflow-x: visible;
    }

  table {
    width: 100%;
    border-collapse: collapse;
    color: #fff;
    table-layout: auto; /* ✅ allow flexible width */
}

th, td {
    padding: 10px 12px;
    text-align: center;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    white-space: nowrap; /* ✅ prevents stacking */
    overflow: hidden;
    text-overflow: ellipsis; /* ✅ shortens long text neatly */
}

thead {
    background: rgba(0, 90, 170, 0.5);
}

th {
    text-transform: uppercase;
    font-size: 0.9rem;
    color: #cfe6ff;
    letter-spacing: 0.5px;
}

/* ✅ optional fine-tuned column widths for balance */
th:nth-child(1) { width: 5%; }   /* ID */
th:nth-child(2) { width: 10%; }  /* Code */
th:nth-child(3) { width: 20%; }  /* Name */
th:nth-child(4) { width: 6%; }   /* CH */
th:nth-child(5) { width: 12%; }  /* Department ID */
th:nth-child(6) { width: 12%; }  /* Teacher ID */
th:nth-child(7) { width: 10%; }  /* Semester ID */
th:nth-child(8) { width: 10%; }  /* Status */
th:nth-child(9) { width: 15%; }  /* Actions */

    tbody tr:hover {
        background: rgba(0, 90, 160, 0.25);
        transition: 0.3s;
    }

    /* ===== Status Badges ===== */
    .badge {
        display: inline-block;
        padding: 6px 14px;
        border-radius: 10px;
        font-weight: 600;
        font-size: 0.9rem;
    }

    .bg-success-subtle {
        background: rgba(0, 255, 170, 0.12);
        color: #00e676;
    }

    .bg-danger-subtle {
        background: rgba(255, 100, 100, 0.12);
        color: #ff7b7b;
    }

    /* ===== Action Buttons (side by side, smaller gap) ===== */
    .actions {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 6px;
    }

    .action-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 45px;
        height: 40px;
        border-radius: 10px;
        padding: 6px;
        font-size: 1.1rem;
        transition: all 0.3s ease;
        border: none;
        cursor: pointer;
        text-decoration: none; 
        color: inherit; 
    }

    .edit {
        background: rgba(79, 195, 247, 0.2);
        color: #4fc3f7;
        border: 1px solid rgba(79, 195, 247, 0.3);
    }

        .edit:hover {
            background: rgba(79, 195, 247, 0.3);
            transform: translateY(-2px);
        }

    .delete {
        background: rgba(255, 50, 50, 0.2);
        color: #ff4c4c;
        border: 1px solid rgba(255, 80, 80, 0.3);
        box-shadow: 0 0 6px rgba(255, 60, 60, 0.2);
    }

        .delete:hover {
            background: rgba(255, 60, 60, 0.35);
            color: #fff;
            box-shadow: 0 0 15px rgba(255, 50, 50, 0.6);
            transform: translateY(-2px);
        }

    /* ===== Alerts ===== */
    .alert {
        border-radius: 12px;
        padding: 10px 15px;
        margin: 10px 0 20px 0;
        font-weight: 500;
        text-align: center;
        backdrop-filter: blur(10px);
    }

    .alert-success {
        background: rgba(0, 255, 170, 0.15);
        color: #baffda;
    }

    .alert-danger {
        background: rgba(255, 80, 80, 0.15);
        color: #ffb3b3;
    }

    .alert-info {
        background: rgba(0, 190, 255, 0.15);
        color: #aee0ff;
    }

    /* ===== Responsive ===== */
    @@media (max-width: 768px) {
        .buttons-row

    {
        flex-direction: column;
        gap: 10px;
    }

    .btn {
        width: 100%;
        text-align: center;
    }

    }
</style>

<div class="courses-wrapper">
    <div class="page-header">
        <h2>📚 Course Management</h2>
    </div>

    <div class="buttons-row">
        <a asp-controller="Admin" asp-action="Dashboard" class="btn btn-back">⬅️ Back to Dashboard</a>
        <a asp-action="Create" class="btn btn-add">➕ Add Course</a>
    </div>

    @if (TempData["Msg"] != null)
    {
        var msg = TempData["Msg"].ToString();
        var isDelete = msg.Contains("delete", StringComparison.OrdinalIgnoreCase);
        <div class="alert @(isDelete ? "alert-danger" : "alert-success")">@msg</div>
    }

    <div class="table-container">
        <table>
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Code</th>
                    <th>Name</th>
                    <th>CH</th>
                    <th>Department ID</th>
                    <th>Teacher ID</th>
                    <th>Semester ID</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var c in Model)
                    {
                        <tr>
                            <td>@c.CourseID</td>
                            <td>@c.CourseCode</td>
                            <td>@c.CourseName</td>
                            <td>@c.CreditHours</td>
                            <td>@c.DepartmentID</td>
                            <td>@c.TeacherID</td>
                            <td>@c.SemesterID</td>
                            <td>
                                @if (c.IsActive)
                                {
                                    <span class="badge bg-success-subtle">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger-subtle">Inactive</span>
                                }
                            </td>
                            <td class="actions">
                                <a asp-action="Edit" asp-route-id="@c.CourseID" class="action-btn edit">✏️</a>
                                <a asp-action="Delete" asp-route-id="@c.CourseID" class="action-btn delete">🗑️</a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="9" class="text-center text-muted py-4">No courses found.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<script>
    // ✅ Fade alerts after 3 seconds
    setTimeout(() => {
        const alertBox = document.querySelector('.alert');
        if (alertBox) {
            alertBox.style.opacity = '0';
            setTimeout(() => alertBox.remove(), 600);
        }
    }, 3000);
</script>
