@model IEnumerable<StudentTracker.Models.CourseView>

@{
    ViewData["Title"] = "Course Management";
}

<style>
    body {
        background: #f2f4fb;
        font-family: 'Segoe UI', sans-serif;
        color: #0b2540;
        margin: 0;
        padding: 0;
    }

    .courses-page-wrapper {
        max-width: 1200px;
        margin: 80px auto;
        padding: 0 20px 40px 20px;
    }

    .courses-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        gap: 16px;
        margin-bottom: 24px;
        flex-wrap: wrap;
    }

    .courses-title-block h2 {
        font-size: 1.9rem;
        font-weight: 700;
        margin: 0;
        color: #0b2540;
    }

    .courses-title-block p {
        margin: 4px 0 0;
        color: #64748b;
        font-size: 0.95rem;
    }

    .courses-actions {
        display: flex;
        gap: 12px;
        flex-wrap: wrap;
    }

    .btn {
        border-radius: 999px;
        font-weight: 600;
        padding: 10px 22px;
        cursor: pointer;
        transition: 0.2s ease;
        border: 1px solid transparent;
        font-size: 0.94rem;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
    }

    .btn-primary {
        background: linear-gradient(135deg, #0f6ae6, #1d4ed8);
        color: #ffffff;
        border-color: transparent;
        box-shadow: 0 10px 25px rgba(37, 99, 235, 0.35);
    }

        .btn-primary:hover {
            background: linear-gradient(135deg, #2563eb, #1d4ed8);
        }

    .btn-secondary {
        background: #e0ecff;
        color: #1d3b72;
        border-color: #c4d4ff;
    }

        .btn-secondary:hover {
            background: #d4e2ff;
        }

    .courses-card {
        background: #ffffff;
        border-radius: 20px;
        padding: 24px 22px 10px 22px;
        box-shadow: 0 16px 40px rgba(15, 23, 42, 0.12);
        border: 1px solid rgba(148, 163, 184, 0.3);
    }

    .courses-table-wrapper {
        width: 100%;
        overflow-x: auto;
    }

    table {
        width: 100%;
        border-collapse: collapse;
        border-radius: 14px;
        overflow: hidden;
        background: #ffffff;
    }

    thead {
        background: #0d4b84;
        color: #e5f0ff;
    }

    th,
    td {
        padding: 12px 14px;
        text-align: center;
        font-size: 0.92rem;
        border-bottom: 1px solid #e2e8f0;
        white-space: nowrap;
    }

    th {
        font-weight: 600;
    }

    tbody tr:nth-child(even) {
        background: #f8fafc;
    }

    tbody tr:hover {
        background: #eef4ff;
    }

    .status-pill {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 4px 10px;
        border-radius: 999px;
        font-size: 0.8rem;
        font-weight: 600;
    }

    .status-active {
        background: #ecfdf5;
        color: #15803d;
        border: 1px solid #bbf7d0;
    }

    .status-inactive {
        background: #fef2f2;
        color: #b91c1c;
        border: 1px solid #fecaca;
    }

    .actions {
        display: flex;
        justify-content: center;
        gap: 8px;
    }

    .action-icon {
        width: 32px;
        height: 32px;
        border-radius: 999px;
        border: none;
        cursor: pointer;
        font-size: 1.1rem;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        transition: 0.2s ease;
        text-decoration: none;
    }

    .icon-schedule {
        background: #e0f2fe;
        color: #0369a1;
        border: 1px solid #bae6fd;
    }

        .icon-schedule:hover {
            background: #bae6fd;
        }

    .icon-edit {
        background: #e0ecff;
        color: #1d4ed8;
        border: 1px solid #bfdbfe;
    }

        .icon-edit:hover {
            background: #bfdbfe;
        }

    .icon-delete {
        background: #fef2f2;
        color: #b91c1c;
        border: 1px solid #fecaca;
    }

        .icon-delete:hover {
            background: #fee2e2;
        }
</style>

<div class="courses-page-wrapper">
    <div class="courses-header">
        <div class="courses-title-block">
            <h2>Course Management</h2>
            <p>Manage courses, assignments, and academic structure for the university.</p>
        </div>

        <div class="courses-actions">
            <a asp-action="Dashboard" asp-controller="Admin" class="btn btn-secondary">
                Back to Dashboard
            </a>
            <a asp-action="Create" class="btn btn-primary">
                Add Course
            </a>
        </div>
    </div>

    <div class="courses-card">
        <div class="courses-table-wrapper">
            <div class="table-responsive">
            <table>
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Code</th>
                        <th>Name</th>
                        <th>CH</th>
                        <th>Department</th>
                        <th>Teacher</th>
                        <th>Semester</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var course in Model)
                    {
                        <tr>
                            <td>@course.CourseID</td>
                            <td>@course.CourseCode</td>
                            <td>@course.CourseName</td>
                            <td>@course.CreditHours</td>
                            <td>@course.DepartmentName</td>
                            <td>@course.TeacherName</td>
                            <td>@course.SemesterName</td>
                            <td>
                                @if (course.IsActive)
                                {
                                    <span class="status-pill status-active">Active</span>
                                }
                                else
                                {
                                    <span class="status-pill status-inactive">Inactive</span>
                                }
                            </td>
                            <td>
                                <div class="actions">

                                   
                                    <a asp-action="Sessions"
                                       asp-route-courseId="@course.CourseID"
                                       class="action-icon icon-schedule">📅</a>

                                    <a asp-action="Edit"
                                       asp-route-id="@course.CourseID"
                                       class="action-icon icon-edit">✏️</a>

                                    <a asp-action="DeactivateCourseConfirmation"
                                       asp-route-id="@course.CourseID"
                                       class="action-icon icon-delete">🚫</a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        </div>
    </div>
</div>
