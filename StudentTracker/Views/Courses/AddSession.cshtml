@model StudentTracker.Models.CourseSessionView
@{
    ViewData["Title"] = "Add Session";
}

<style>
    body {
        background: #f2f4fb;
        font-family: 'Segoe UI', sans-serif;
        margin: 0;
        padding: 0;
    }

    .page-wrapper {
        max-width: 900px;
        margin: 70px auto;
        padding: 0 20px;
    }

    .card {
        background: #ffffff;
        padding: 35px;
        border-radius: 22px;
        box-shadow: 0 18px 42px rgba(14, 30, 56, 0.18);
        border: 1px solid rgba(148,163,184,0.35);
        backdrop-filter: blur(6px);
        margin-bottom: 30px;
    }

    h2 {
        font-size: 2rem;
        font-weight: 800;
        color: #0b2540;
        margin-bottom: 6px;
    }

    .subtitle {
        color: #64748b;
        font-size: 0.95rem;
        margin-bottom: 30px;
    }

    label {
        display: block;
        font-weight: 700;
        color: #0b2540;
        margin-bottom: 6px;
        margin-top: 14px;
    }

    .form-control {
        width: 100%;
        padding: 12px 16px;
        border-radius: 14px;
        border: 1px solid #cbd5e1;
        background: #f8fafc;
        font-size: 0.95rem;
        transition: 0.2s;
    }

        .form-control:focus {
            border-color: #124f9c;
            outline: none;
            background: #ffffff;
            box-shadow: 0 0 0 4px rgba(18,79,156,0.15);
        }

    .btn-primary {
        margin-top: 25px;
        background: linear-gradient(135deg, #0f6ae6, #124f9c);
        color: #ffffff;
        padding: 12px 26px;
        font-weight: 700;
        border-radius: 999px;
        border: none;
        font-size: 0.95rem;
        cursor: pointer;
        transition: 0.2s ease;
    }

        .btn-primary:hover {
            background: linear-gradient(135deg, #2563eb, #124f9c);
        }

    .btn-back {
        display: inline-block;
        margin-top: 25px;
        font-size: 0.9rem;
        color: #124f9c;
        text-decoration: none;
        font-weight: 600;
    }

        .btn-back:hover {
            text-decoration: underline;
        }
</style>

<div class="page-wrapper">
    <div class="card">
        <h2>Add Session</h2>
        <p class="subtitle">Choose the date and time for the new session.</p>

        <form asp-action="AddSession" method="post">

            <input type="hidden" name="CourseID" value="@Model.CourseID" />

            <label>Date</label>
            <input type="date" name="SessionDate" class="form-control"
                   value="@Model.SessionDate.ToString("yyyy-MM-dd")" required />

            <label>Start Time</label>
            <input type="time" name="StartTime" class="form-control" required />

            <label>End Time</label>
            <input type="time" name="EndTime" class="form-control" required />

            <button class="btn-primary" type="submit">Save Session</button>

            <br />
            <a asp-action="Sessions" asp-route-courseId="@Model.CourseID" class="btn-back">← Back to Sessions</a>
        </form>
    </div>
</div>
