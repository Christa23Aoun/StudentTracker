@model StudentTracker.Models.CourseView
@{
    ViewData["Title"] = "Delete Course";
}

<style>
    body {
        background: #f2f4fb;
        font-family: 'Segoe UI', sans-serif;
        color: #0b2540;
        margin: 0;
        padding: 0;
    }

    .course-delete-shell {
        max-width: 600px;
        margin: 90px auto;
        padding: 0 20px 40px 20px;
    }

    .course-delete-card {
        background: #ffffff;
        border-radius: 22px;
        padding: 30px 28px 26px 28px;
        box-shadow: 0 18px 40px rgba(15, 23, 42, 0.16);
        border: 1px solid rgba(248, 113, 113, 0.35);
    }

        .course-delete-card h2 {
            color: #b91c1c;
            font-weight: 700;
            font-size: 1.7rem;
            margin-bottom: 10px;
            text-align: center;
        }

        .course-delete-card p {
            color: #64748b;
            font-size: 0.95rem;
            text-align: center;
            margin-bottom: 24px;
        }

    .course-summary {
        background: #fef2f2;
        border-radius: 16px;
        padding: 16px 16px 10px 16px;
        border: 1px solid #fecaca;
        margin-bottom: 22px;
    }

    .course-summary-row {
        display: flex;
        justify-content: space-between;
        margin-bottom: 6px;
        font-size: 0.9rem;
    }

    .course-summary-label {
        color: #9f1239;
        font-weight: 500;
    }

    .course-summary-value {
        font-weight: 600;
        color: #7f1d1d;
    }

    .btn-row {
        display: flex;
        justify-content: center;
        gap: 12px;
        margin-top: 10px;
    }

    .btn {
        border-radius: 999px;
        font-weight: 600;
        padding: 9px 24px;
        cursor: pointer;
        transition: 0.2s ease;
        border: 1px solid transparent;
        font-size: 0.9rem;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }

    .btn-danger {
        background: #b91c1c;
        color: #ffffff;
        border-color: #7f1d1d;
        box-shadow: 0 12px 28px rgba(185, 28, 28, 0.45);
    }

        .btn-danger:hover {
            background: #991b1b;
        }

    .btn-secondary {
        background: #e2e8f0;
        color: #0f172a;
        border-color: #cbd5e1;
    }

        .btn-secondary:hover {
            background: #cbd5e1;
        }
</style>

<div class="course-delete-shell">
    <div class="course-delete-card">
        <h2>Delete Course</h2>
        <p>Are you sure you want to permanently remove this course from the system?</p>

        <div class="course-summary">
            <div class="course-summary-row">
                <span class="course-summary-label">Course ID</span>
                <span class="course-summary-value">@Model.CourseID</span>
            </div>
            <div class="course-summary-row">
                <span class="course-summary-label">Code</span>
                <span class="course-summary-value">@Model.CourseCode</span>
            </div>
            <div class="course-summary-row">
                <span class="course-summary-label">Name</span>
                <span class="course-summary-value">@Model.CourseName</span>
            </div>
            <div class="course-summary-row">
                <span class="course-summary-label">Credit Hours</span>
                <span class="course-summary-value">@Model.CreditHours</span>
            </div>
        </div>

        <form asp-action="Delete" method="post">
            <input type="hidden" asp-for="CourseID" />
            <div class="btn-row">
                <button type="submit" class="btn btn-danger">Yes, Delete</button>
                <a asp-action="Index" class="btn btn-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>
