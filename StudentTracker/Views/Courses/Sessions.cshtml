@model StudentTracker.Models.GenerateSessionsPageView

@{
    ViewData["Title"] = "Manage Sessions";

    var semesterStart = Model.SemesterStartDate.Date;

    int GetSemesterWeek(DateTime date)
    {
        return 1 + (int)((date.Date - semesterStart).TotalDays / 7);
    }

    var sessionsWithWeek = (Model.Sessions ?? new List<StudentTracker.Models.CourseSessionView>())
        .Select(s => new
        {
            Session = s,
            SemesterWeek = GetSemesterWeek(s.SessionDate)
        })
        .ToList();

    var semesterWeeks = sessionsWithWeek
        .Select(x => x.SemesterWeek)
        .Distinct()
        .OrderBy(x => x)
        .ToList();
    var distinctDays = sessionsWithWeek
        .Select(x => x.Session.SessionDate.DayOfWeek)
        .Distinct()
        .OrderBy(d => d == DayOfWeek.Sunday ? 7 : (int)d)
        .Select(d => d.ToString())
        .ToList();

}

<style>
    body {
        background: #f3f5fb;
        font-family: 'Segoe UI', sans-serif;
        color: #0b2540;
    }

    .page-wrapper {
        max-width: 1100px;
        margin: 50px auto;
        padding: 0 20px 40px;
    }

    .glass-card {
        background: #fff;
        border-radius: 20px;
        padding: 26px;
        margin-bottom: 30px;
        box-shadow: 0 18px 40px rgba(15,23,42,.12);
        border: 1px solid rgba(148,163,184,.35);
    }

    h2 {
        font-size: 2rem;
        font-weight: 800;
        margin-bottom: 6px;
    }

    h3 {
        font-size: 1.25rem;
        font-weight: 700;
        margin-bottom: 14px;
    }

    .subtitle {
        font-size: .95rem;
        color: #64748b;
    }

    label {
        font-weight: 600;
        font-size: .9rem;
        margin-bottom: 6px;
        display: block;
    }

    .form-control {
        width: 100%;
        padding: 10px 14px;
        border-radius: 12px;
        border: 1px solid #cbd5e1;
        background: #f9fbff;
        margin-bottom: 14px;
    }

    .btn-primary {
        background: linear-gradient(135deg,#0f6ae6,#124f9c);
        color: #fff;
        border-radius: 999px;
        padding: 10px 28px;
        font-weight: 600;
        border: none;
    }

    .btn-back {
        background: #e5e7eb;
        color: #111827;
        border-radius: 999px;
        padding: 10px 22px;
        font-weight: 700;
        border: 1px solid #d1d5db;
        text-decoration: none;
        display: inline-block;
        margin-bottom: 18px;
    }

    .session-table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 20px;
        background: #fff;
        border-radius: 14px;
        overflow: hidden;
    }

        .session-table th {
            background: #124f9c;
            color: #fff;
            padding: 12px;
            font-size: .9rem;
        }

        .session-table td {
            padding: 12px;
            text-align: center;
            border-bottom: 1px solid #e2e8f0;
            font-size: .9rem;
        }

    .status-pill {
        padding: 4px 12px;
        border-radius: 999px;
        font-size: .78rem;
        font-weight: 600;
        background: #ecfdf5;
        color: #15803d;
        border: 1px solid #bbf7d0;
    }

    .btn-danger {
        background: #fee2e2;
        color: #b91c1c;
        border-radius: 999px;
        padding: 6px 16px;
        border: 1px solid #fecaca;
    }
</style>

<div class="page-wrapper">

    <!-- BACK BUTTON (FIXED PLACEMENT) -->
    <a asp-action="Index" asp-controller="Courses" class="btn-back">← Back to Courses</a>

    <!-- HEADER -->
    <div class="glass-card">
        <h2>Sessions for @Model.CourseName</h2>
        <p class="subtitle">
            Semester:
            <strong>@Model.SemesterStartDate.ToString("dd MMM yyyy")</strong> →
            <strong>@Model.SemesterEndDate.ToString("dd MMM yyyy")</strong>
        </p>
    </div>

    <!-- ADD SESSIONS -->
    <div class="glass-card">
        <h3>Add Sessions</h3>

        <form asp-action="GenerateSessions" method="post">
            @Html.AntiForgeryToken()

            <input type="hidden" name="CourseID" value="@Model.CourseID" />

            <label>Start Date</label>
            <input type="date" name="StartDate" class="form-control" required />

            <label>End Date</label>
            <input type="date" name="EndDate" class="form-control" required />

            <label>Start Time</label>
            <input type="time" id="startTime" name="StartTime" class="form-control" required />

            <label>End Time</label>
            <input type="time" id="endTime" name="EndTime" class="form-control" required />

            <label>Repeat</label>
            <label><input type="radio" name="RepeatType" value="None" checked /> One Time</label>
            <label><input type="radio" name="RepeatType" value="Daily" /> Daily</label>
            <label><input type="radio" name="RepeatType" value="Weekly" /> Weekly</label>

            <br /><br />
            <button type="submit" class="btn-primary">Generate Sessions</button>
        </form>
    </div>

    <!-- EXISTING SESSIONS -->
    <div class="glass-card">
        <h3>Existing Sessions</h3>

        <!-- FILTERS (DAY + WEEK ONLY) -->
        <div style="display:flex;gap:12px;margin-bottom:16px;flex-wrap:wrap">
            <select id="dayFilter" class="form-control" style="max-width:200px">
                <option value="">All Days</option>
                @foreach (var d in distinctDays)
                {
                    <option value="@d">@d</option>
                }
            </select>

            <select id="weekFilter" class="form-control" style="max-width:200px">
                <option value="">All Weeks</option>
                @foreach (var w in semesterWeeks)
                {
                    <option value="@w">Week @w</option>
                }
            </select>

            <button id="clearFilters" class="btn-back">Clear</button>
        </div>

        <table class="session-table">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Time</th>
                    <th>Semester Week</th>
                    <th>Status</th>
                    <th></th>
                </tr>
            </thead>
            <tbody id="sessionsBody">
                @foreach (var x in sessionsWithWeek.OrderBy(x => x.Session.SessionDate))
                {
                    var s = x.Session;
                    <tr data-day="@s.SessionDate.DayOfWeek"
                        data-week="@x.SemesterWeek">
                        <td>@s.SessionDate.ToString("ddd dd/MM/yyyy")</td>
                        <td>@s.StartTime.ToString(@"hh\:mm") - @s.EndTime.ToString(@"hh\:mm")</td>
                        <td>Week @x.SemesterWeek</td>
                        <td><span class="status-pill">Active</span></td>
                        <td>
                            <form asp-action="DeleteSession" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="sessionId" value="@s.SessionID" />
                                <input type="hidden" name="courseId" value="@Model.CourseID" />
                                <button type="submit" class="btn-danger">Delete</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

</div>

<script>
    // AUTO END TIME = START + 1h15
    document.getElementById("startTime").addEventListener("change", function () {
        if (!this.value) return;

        const [h, m] = this.value.split(":").map(Number);
        const totalMinutes = h * 60 + m + 75;

        const endH = Math.floor(totalMinutes / 60) % 24;
        const endM = totalMinutes % 60;

        document.getElementById("endTime").value =
            String(endH).padStart(2, "0") + ":" + String(endM).padStart(2, "0");
    });

    // FILTERS
    const dayFilter = document.getElementById("dayFilter");
    const weekFilter = document.getElementById("weekFilter");
    const clearBtn = document.getElementById("clearFilters");
    const rows = document.querySelectorAll("#sessionsBody tr");

    function applyFilters() {
        rows.forEach(r => {
            const matchDay = !dayFilter.value || r.dataset.day === dayFilter.value;
            const matchWeek = !weekFilter.value || r.dataset.week === weekFilter.value;
            r.style.display = (matchDay && matchWeek) ? "" : "none";
        });
    }

    dayFilter.onchange = applyFilters;
    weekFilter.onchange = applyFilters;

    clearBtn.onclick = e => {
        e.preventDefault();
        dayFilter.value = "";
        weekFilter.value = "";
        applyFilters();
    };
</script>
