@model IEnumerable<StudentTracker.Models.CourseScheduleView>

@{
    ViewData["Title"] = "Course Schedule";
}

<style>
    body {
        background: #f2f4fb;
        font-family: 'Segoe UI', sans-serif;
        color: #0b2540;
        margin: 0;
        padding: 0;
    }

    .schedule-shell {
        max-width: 1000px;
        margin: 80px auto;
        padding: 0 20px 40px 20px;
    }

    .schedule-header {
        display: flex;
        flex-direction: column;
        gap: 6px;
        margin-bottom: 20px;
    }

        .schedule-header h2 {
            font-size: 1.9rem;
            font-weight: 700;
            margin: 0;
            color: #0b2540;
            text-align: left;
        }

    .schedule-subtitle {
        font-size: 0.95rem;
        color: #64748b;
    }

    .schedule-actions {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        margin-bottom: 16px;
        flex-wrap: wrap;
    }

    .btn {
        border-radius: 999px;
        font-weight: 600;
        padding: 9px 22px;
        cursor: pointer;
        transition: 0.2s ease;
        border: 1px solid transparent;
        font-size: 0.9rem;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }

    .btn-add {
        background: linear-gradient(135deg, #0f6ae6, #1d4ed8);
        color: #ffffff;
        box-shadow: 0 10px 25px rgba(37, 99, 235, 0.35);
    }

        .btn-add:hover {
            background: linear-gradient(135deg, #2563eb, #1d4ed8);
        }

    .btn-secondary {
        background: #e2e8f0;
        color: #0f172a;
        border-color: #cbd5e1;
    }

        .btn-secondary:hover {
            background: #cbd5e1;
        }

    .schedule-card {
        background: #ffffff;
        border-radius: 20px;
        padding: 22px 20px 16px 20px;
        box-shadow: 0 16px 40px rgba(15, 23, 42, 0.15);
        border: 1px solid rgba(148, 163, 184, 0.32);
    }

    table {
        width: 100%;
        border-collapse: collapse;
        border-radius: 14px;
        overflow: hidden;
        background: #ffffff;
    }

    th, td {
        padding: 12px 14px;
        text-align: center;
        font-size: 0.9rem;
        border-bottom: 1px solid #e2e8f0;
    }

    th {
        background: #0d4b84;
        color: #e5f0ff;
        font-weight: 600;
    }

    tbody tr:nth-child(even) {
        background: #f8fafc;
    }

    tbody tr:hover {
        background: #eef4ff;
    }

    .actions a,
    .actions button {
        margin: 0 4px;
        padding: 7px 14px;
        border-radius: 999px;
        text-decoration: none;
        font-weight: 600;
        border: none;
        cursor: pointer;
        font-size: 0.85rem;
        transition: 0.2s;
    }

    .btn-edit {
        background: #e0ecff;
        color: #1d4ed8;
        border: 1px solid #bfdbfe;
    }

        .btn-edit:hover {
            background: #bfdbfe;
        }

    .btn-delete {
        background: #fef2f2;
        color: #b91c1c;
        border: 1px solid #fecaca;
    }

        .btn-delete:hover {
            background: #fee2e2;
        }
</style>

<div class="schedule-shell">

    <div class="schedule-header">
        <h2>Course Schedule</h2>
        <div class="schedule-subtitle">
            @if (ViewBag.CourseName != null)
            {
                <span><strong>Course:</strong> @ViewBag.CourseName</span>
            }
            @if (ViewBag.TeacherName != null)
            {
                <span> | <strong>Teacher:</strong> @ViewBag.TeacherName</span>
            }
        </div>
    </div>

    <div class="schedule-actions">
        <a asp-action="AddSchedule" asp-route-courseId="@ViewBag.CourseID" class="btn btn-add">
            Add Schedule
        </a>
        <a asp-action="Index" class="btn btn-secondary">
            Back to Courses
        </a>
    </div>

    <div class="schedule-card">
        <table>
            <thead>
                <tr>
                    <th>Schedule ID</th>
                    <th>Day Of Week</th>
                    <th>Start Time</th>
                    <th>End Time</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var s in Model)
                {
                    <tr>
                        <td>@s.ScheduleID</td>
                        <td>@s.DayOfWeek</td>
                        <td>@s.StartTime.ToString(@"hh\:mm")</td>
                        <td>@s.EndTime.ToString(@"hh\:mm")</td>
                        <td class="actions">
                            <a asp-action="EditSchedule"
                               asp-route-id="@s.ScheduleID"
                               class="btn-edit">
                                Edit
                            </a>

                            <form asp-action="DeleteSchedule"
                                  asp-route-id="@s.ScheduleID"
                                  asp-route-courseId="@s.CourseID"
                                  method="post"
                                  style="display:inline;">
                                <button class="btn-delete" type="submit">
                                    Delete
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

</div>
