@model StudentTracker.Models.CourseView

@{
    ViewData["Title"] = "Deactivate Course";
}

<style>
    body {
        background: #f5f7fb;
        font-family: 'Segoe UI', sans-serif;
        color: #0b2540;
        margin: 0;
        padding: 0;
    }

    .page-wrapper {
        max-width: 750px;
        margin: 100px auto;
        padding: 0 20px 40px 20px;
    }

    .confirm-card {
        background: #ffffff;
        border-radius: 22px;
        padding: 40px;
        box-shadow: 0 16px 40px rgba(15, 23, 42, 0.12);
        border: 1px solid #e6a8a8;
        text-align: center;
    }

    h2 {
        font-size: 2rem;
        font-weight: 800;
        margin-bottom: 10px;
        color: #b91c1c;
    }

    .subtitle {
        color: #64748b;
        font-size: 1rem;
        margin-bottom: 28px;
    }

    .info-box {
        background: #fff8f8;
        border: 1px solid #f5d2d2;
        border-radius: 16px;
        padding: 20px;
        margin-bottom: 30px;
        text-align: left;
    }

        .info-box p {
            margin: 8px 0;
            font-size: 1rem;
            color: #7f1d1d;
        }

    .label {
        font-weight: 700;
        color: #991b1b;
    }

    .actions {
        display: flex;
        justify-content: center;
        gap: 16px;
        margin-top: 10px;
    }

    .btn {
        padding: 12px 26px;
        border-radius: 999px;
        font-weight: 600;
        text-decoration: none;
        cursor: pointer;
        border: none;
        font-size: 0.95rem;
    }

    .btn-secondary {
        background: #f3f4f6;
        color: #374151;
        border: 1px solid #d1d5db;
    }

    .btn-danger {
        background: #dc2626;
        color: white;
        border: 1px solid #b91c1c;
    }

    .action-buttons {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 18px;
        margin-top: 28px;
    }

        .action-buttons form {
            margin: 0;
        }

    .btn-cancel {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        height: 44px;
        padding: 0 26px;
        border-radius: 999px;
        background: #f1f5f9;
        color: #0f172a;
        font-weight: 600;
        text-decoration: none;
        border: 1px solid #cbd5e1;
        transition: all 0.2s ease;
    }

        .btn-cancel:hover {
            background: #e2e8f0;
            transform: translateY(-1px);
        }

    .btn-confirm {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        height: 50px;
        padding: 0 30px;
        border-radius: 999px;
        background: linear-gradient(135deg, #dc2626, #b91c1c);
        color: #fff;
        font-weight: 600
        border: none;
        cursor: pointer;
        box-shadow: 0 10px 22px rgba(220,38,38,.35);
        transition: all 0.2s ease;
    }

        .btn-confirm:hover {
            transform: translateY(-1px);
            box-shadow: 0 14px 28px rgba(220,38,38,.45);
        }


</style>

<div class="page-wrapper">
    <div class="confirm-card">

        <h2>Deactivate Course?</h2>
        <p class="subtitle">Are you sure you want to deactivate this course?</p>

        <div class="info-box">
            <p><span class="label">Course Name:</span> @Model.CourseName</p>
            <p><span class="label">Code:</span> @Model.CourseCode</p>
            <p><span class="label">Credit Hours:</span> @Model.CreditHours</p>
            <p><span class="label">Department:</span> @Model.DepartmentName</p>
            <p><span class="label">Teacher:</span> @Model.TeacherName</p>
            <p><span class="label">Status:</span> @(Model.IsActive ? "Active" : "Inactive")</p>
        </div>

        <div class="actions">
            <div class="action-buttons">
                <a asp-action="Index"
                   asp-controller="Courses"
                   class="btn-cancel">
                    Cancel
                </a>

                <form asp-action="DeactivateCourse" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="courseId" value="@Model.CourseID" />
                    <button type="submit" class="btn-confirm">
                      Deactivate
                    </button>
                </form>
            </div>

        </div>

    </div>
</div>
