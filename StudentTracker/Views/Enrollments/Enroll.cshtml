@model StudentTracker.Models.EnrollmentViewModel

@{
    ViewData["Title"] = "Enroll Student";
}

<style>
    body {
        background: linear-gradient(135deg, #001a33, #003c8f);
        font-family: 'Segoe UI', sans-serif;
        color: #fff;
    }

    .enroll-wrapper {
        width: 85%;
        max-width: 1200px;
        margin: 80px auto;
        background: rgba(0, 45, 90, 0.75);
        border-radius: 22px;
        padding: 50px;
        backdrop-filter: blur(30px);
    }

    .list-group-item {
        background: transparent;
        border: 1px solid rgba(255,255,255,0.15);
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .badge-active {
        background: rgba(0,255,100,0.25);
        color: #00ff8c;
        padding: 5px 12px;
        border-radius: 8px;
        font-weight: 600;
        margin-left: 10px;
    }

    .btn-unenroll {
        padding: 6px 10px;
        border-radius: 8px;
        background: rgba(255,80,80,0.3);
        color: #ff6b6b;
        border: none;
        font-weight: 600;
    }

        .btn-unenroll:hover {
            background: rgba(255,80,80,0.6);
        }
</style>

<div class="enroll-wrapper">

    <h2 class="text-center">Enroll Student</h2>
    <h4 class="text-center mb-4">@Model.StudentName (@Model.StudentID)</h4>

    <!-- ONE single form for Enroll + Unenroll -->
    <form asp-action="Enroll" asp-controller="Enrollments" method="post">
        @Html.AntiForgeryToken()

        <!-- For model binding in Enroll (POST) -->
        <input type="hidden" asp-for="StudentID" />
        <input type="hidden" asp-for="ReturnRole" />
        <input type="hidden" asp-for="ReturnStatus" />

        <!-- For parameters in Unenroll (POST) -->
        <input type="hidden" name="studentId" value="@Model.StudentID" />
        <input type="hidden" name="role" value="@Model.ReturnRole" />
        <input type="hidden" name="status" value="@Model.ReturnStatus" />

        <div class="accordion" id="depsAccordion">
            @for (int i = 0; i < Model.Departments.Count; i++)
            {
                var dep = Model.Departments[i];
                var collapseId = $"collapse{i}";

                <div class="accordion-item bg-transparent mb-3">
                    <h2 class="accordion-header" id="heading@i">
                        <button class="accordion-button collapsed"
                                type="button"
                                data-bs-toggle="collapse"
                                data-bs-target="#@collapseId">
                            @dep.DepartmentName
                        </button>
                    </h2>

                    <div id="@collapseId" class="accordion-collapse collapse">
                        <div class="accordion-body">
                            <ul class="list-group">
                                @foreach (var course in dep.Courses)
                                {
                                    bool isActive = Model.EnrolledCourseIds.Contains(course.CourseID);

                                    <li class="list-group-item">
                                        <div>
                                            <label>@course.CourseName</label>
                                            @if (isActive)
                                            {
                                                <span class="badge-active">Enrolled ✓</span>
                                            }
                                        </div>

                                        <div class="d-flex align-items-center">

                                            @* Checkbox only if NOT yet enrolled *@
                                            @if (!isActive)
                                            {
                                                <input type="checkbox"
                                                       name="SelectedCourses"
                                                       value="@course.CourseID"
                                                       class="form-check-input me-2" />
                                            }

                                            @* Unenroll button uses SAME form, but different action *@
                                            @if (isActive)
                                            {
                                                <button type="submit"
                                                        class="btn-unenroll"
                                                        formaction="@Url.Action("Unenroll", "Enrollments")"
                                                        formmethod="post"
                                                        name="courseId"
                                                        value="@course.CourseID"
                                                        onclick="event.stopPropagation()">
                                                    Unenroll
                                                </button>
                                            }

                                        </div>
                                    </li>
                                }
                            </ul>
                        </div>
                    </div>
                </div>
            }
        </div>

        <div class="text-center mt-4">
            <button type="submit" class="btn btn-primary px-5 py-2 me-3">
                Enroll Selected
            </button>

            <a asp-controller="Users" asp-action="Index"
               asp-route-role="@Model.ReturnRole"
               asp-route-status="@Model.ReturnStatus"
               class="btn btn-secondary px-5 py-2">
                Cancel
            </a>
        </div>

    </form>
</div>
