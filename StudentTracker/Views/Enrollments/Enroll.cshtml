@model StudentTracker.Models.EnrollmentViewModel

@{
    ViewData["Title"] = "Enroll Student";
}

<style>
    body {
        background: #f3f6fb;
        font-family: 'Segoe UI', sans-serif;
        color: #0b2540;
        margin: 0;
        padding: 0;
    }

    .enroll-wrapper {
        width: 90%;
        max-width: 1250px;
        margin: 70px auto;
        padding: 36px 40px;
        border-radius: 22px;
        background: #ffffff;
        border-top: 4px solid #003c8f;
        border-inline: 1px solid rgba(148, 163, 184, 0.35);
        border-bottom: 1px solid rgba(148, 163, 184, 0.35);
        box-shadow: 0 18px 40px rgba(15, 23, 42, 0.16);
    }

    .enroll-title {
        font-size: 1.6rem;
        font-weight: 700;
        color: #003c8f;
        text-align: left;
        margin-bottom: 4px;
    }

    .enroll-subtitle {
        font-size: 0.95rem;
        color: #64748b;
        margin-bottom: 26px;
    }

    .accordion-button {
        background: #f1f5f9 !important;
        color: #0f172a !important;
        border-radius: 14px !important;
        font-weight: 600;
        padding: 16px 18px;
        border: 1px solid #e2e8f0;
        font-size: 0.98rem;
    }

        .accordion-button:not(.collapsed) {
            background: #e0ecff !important;
            color: #1d4ed8 !important;
            box-shadow: none !important;
            border-color: #bfdbfe;
        }

    .accordion-item {
        background: transparent !important;
        border: none;
        margin-bottom: 8px;
    }

    .accordion-body {
        background: #f8fafc;
        padding: 18px 20px;
        border-radius: 16px;
        border: 1px solid #e2e8f0;
        margin-top: 10px;
    }

    .list-group {
        margin-bottom: 0;
    }

    .list-group-item {
        background: #ffffff !important;
        border: 1px solid #e2e8f0;
        border-radius: 14px;
        padding: 12px 16px;
        margin-bottom: 10px;
        color: #0f172a;
        font-weight: 500;
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-size: 0.95rem;
    }

        .list-group-item label {
            font-size: 0.98rem;
        }

    .form-check-input {
        width: 18px;
        height: 18px;
        cursor: pointer;
        border-radius: 6px;
        border: 1px solid #94a3b8;
        background: transparent;
    }

        .form-check-input:checked {
            background-color: #2563eb;
            border-color: #2563eb;
            box-shadow: 0 0 0 2px rgba(37, 99, 235, 0.25);
        }

    .badge-active {
        background: #ecfdf5;
        color: #15803d;
        padding: 4px 10px;
        border-radius: 999px;
        font-weight: 600;
        font-size: 0.8rem;
        margin-left: 10px;
        border: 1px solid #bbf7d0;
    }

    .btn-unenroll {
        padding: 7px 14px;
        border-radius: 999px;
        background: #fee2e2;
        color: #b91c1c;
        border: 1px solid #fecaca;
        font-weight: 600;
        font-size: 0.85rem;
        cursor: pointer;
    }

        .btn-unenroll:hover {
            background: #fecaca;
        }

    .enroll-actions {
        text-align: center;
        margin-top: 28px;
    }

    .enroll-button {
        background: #2563eb;
        border: 1px solid #1d4ed8;
        border-radius: 999px;
        padding: 10px 38px;
        font-size: 1rem;
        font-weight: 600;
        color: white;
        box-shadow: 0 12px 25px rgba(37, 99, 235, 0.45);
        margin-right: 10px;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        transition: 0.2s ease;
        text-decoration: none;
    }

        .enroll-button:hover {
            background: #1d4ed8;
        }

    .cancel-button {
        background: #e2e8f0;
        border: 1px solid #cbd5e1;
        color: #0f172a;
        border-radius: 999px;
        padding: 10px 30px;
        font-size: 1rem;
        font-weight: 600;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        transition: 0.2s ease;
    }

        .cancel-button:hover {
            background: #cbd5e1;
        }

    @@media (max-width: 992px) {
        .enroll-wrapper

    {
        padding: 26px 20px;
        margin: 60px auto;
    }

    .enroll-actions {
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    .enroll-button,
    .cancel-button {
        width: 100%;
        justify-content: center;
        margin-right: 0;
    }

    }
</style>

<div class="enroll-wrapper">
    <h2 class="enroll-title">Enroll Student</h2>
    <p class="enroll-subtitle">
        Select the courses this student should attend. You can enroll in new courses or unenroll from existing ones.
    </p>

    <h4 class="mb-4" style="color:#0f172a;">
        @Model.StudentName (@Model.StudentID)
    </h4>

    <form asp-action="Enroll" asp-controller="Enrollments" method="post">
        @Html.AntiForgeryToken()

        <input type="hidden" asp-for="StudentID" />
        <input type="hidden" asp-for="ReturnRole" />
        <input type="hidden" asp-for="ReturnStatus" />
        <input type="hidden" name="studentId" value="@Model.StudentID" />
        <input type="hidden" name="role" value="@Model.ReturnRole" />
        <input type="hidden" name="status" value="@Model.ReturnStatus" />

        <div class="accordion" id="depsAccordion">
            @for (int i = 0; i < Model.Departments.Count; i++)
            {
                var dep = Model.Departments[i];
                var collapseId = $"collapse{i}";

                <div class="accordion-item">
                    <h2 class="accordion-header" id="heading@i">
                        <button class="accordion-button collapsed"
                                type="button"
                                data-bs-toggle="collapse"
                                data-bs-target="#@collapseId">
                            @dep.DepartmentName
                        </button>
                    </h2>

                    <div id="@collapseId" class="accordion-collapse collapse">
                        <div class="accordion-body">
                            <ul class="list-group">
                                @foreach (var course in dep.Courses)
                                {
                                    bool isActive = Model.EnrolledCourseIds.Contains(course.CourseID);

                                    <li class="list-group-item">
                                        <div>
                                            <label>@course.CourseName</label>
                                            @if (isActive)
                                            {
                                                <span class="badge-active">Enrolled</span>
                                            }
                                        </div>

                                        <div class="d-flex align-items-center">
                                            @if (!isActive)
                                            {
                                                <input type="checkbox"
                                                       name="SelectedCourses"
                                                       value="@course.CourseID"
                                                       class="form-check-input me-2" />
                                            }

                                            @if (isActive)
                                            {
                                                <button type="submit"
                                                        class="btn-unenroll"
                                                        formaction="@Url.Action("Unenroll", "Enrollments")"
                                                        formmethod="post"
                                                        name="courseId"
                                                        value="@course.CourseID">
                                                    Unenroll
                                                </button>
                                            }
                                        </div>
                                    </li>
                                }
                            </ul>
                        </div>
                    </div>
                </div>
            }
        </div>

        <div class="enroll-actions">
            <button type="submit" class="enroll-button">Enroll Selected</button>

            <a asp-controller="Users"
               asp-action="Index"
               asp-route-role="@Model.ReturnRole"
               asp-route-status="@Model.ReturnStatus"
               class="cancel-button">
                Cancel
            </a>
        </div>
    </form>
</div>
