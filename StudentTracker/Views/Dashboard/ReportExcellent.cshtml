@model List<StudentTracker.Models.AdminExcellentStudentView>

@{
    ViewData["Title"] = "High Achievers";
}

<div class="container mt-5">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1">High Achievers</h2>
            <p class="text-muted mb-0">Students with grades 95 / 100 and above</p>
        </div>

        <a asp-controller="Admin"
           asp-action="Reports"
           class="btn btn-outline-secondary">
            ← Back to Reports
        </a>
    </div>

    <table class="table table-bordered table-striped align-middle">
        <thead class="table-dark">
            <tr>
                <th>Full Name</th>
                <th>Course</th>
                <th>Test</th>
                <th class="text-center">Grade</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Count > 0)
            {
                foreach (var item in Model)
                {
                    <tr>
                        <td>@item.FullName</td>
                        <td>@item.CourseName</td>
                        <td>@item.TestName</td>
                        <td class="text-center fw-bold">@item.FinalGrade</td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="4" class="text-center text-muted">
                        No high achievers found.
                    </td>
                </tr>
            }
        </tbody>
    </table>

</div>
