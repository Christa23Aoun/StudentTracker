@model StudentTracker.Models.AdminDashboardViewModel
@{
    ViewData["Title"] = "Admin Dashboard";
}

<style>
    body {
        background: linear-gradient(135deg, #001a33, #003c8f);
        font-family: 'Segoe UI', sans-serif;
        color: #fff;
        margin: 0;
        padding: 0;
    }

    .dashboard-container {
        width: 85%;
        max-width: 1300px;
        margin: 80px auto;
        text-align: center;
    }

    h1 {
        font-weight: 700;
        margin-bottom: 10px;
    }

    .dashboard-cards {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 40px;
        margin-top: 60px;
    }

    .card {
        background: rgba(0, 45, 90, 0.75);
        border-radius: 22px;
        padding: 40px 30px;
        backdrop-filter: blur(25px);
        -webkit-backdrop-filter: blur(25px);
        transition: all 0.3s ease;
        cursor: pointer;
        box-shadow: 0 8px 25px rgba(0, 0, 0, 0.5);
        text-decoration: none;
        color: #fff;
    }

    .card:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.7);
    }

    .card h2 {
        font-size: 2rem;
        margin: 10px 0;
    }

    .card p {
        font-size: 0.95rem;
        color: #d0e0ff;
    }

    /* 🔹 Unique glow borders */
    .students { border-top: 5px solid #00C853; } /* Green */
    .teachers { border-top: 5px solid #2979FF; } /* Blue */
    .courses { border-top: 5px solid #FFD600; }  /* Yellow */
    .departments { border-top: 5px solid #AA00FF; } /* Violet */
    .grades { border-top: 5px solid #FF6D00; }   /* Orange */
    .attendance { border-top: 5px solid #00BFA5; } /* Teal */
</style>

<div class="dashboard-container">
    <h1>👨‍💼 Admin Dashboard</h1>
    <p>Overview of the university’s academic structure and performance.</p>

    <div class="dashboard-cards">
        <!-- Students -->
        <a asp-controller="Users" asp-action="Index" asp-route-role="Student" class="card students">
            <h2>👨‍🎓 @Model.Summary.TotalStudents</h2>
            <p>Total registered students</p>
        </a>

        <!-- Teachers -->
        <a asp-controller="Users" asp-action="Index" asp-route-role="Teacher" class="card teachers">
            <h2>👩‍🏫 @Model.Summary.TotalTeachers</h2>
            <p>Total active teachers</p>
        </a>

        <!-- Courses -->
        <a asp-controller="Courses" asp-action="Index" class="card courses">
            <h2>📚 @Model.Summary.ActiveCourses</h2>
            <p>Active courses this semester</p>
        </a>

        <!-- Departments -->
        <a asp-controller="Departments" asp-action="Index" class="card departments">
            <h2>🏛 @Model.Summary.Departments</h2>
            <p>Total academic departments</p>
        </a>

        <!-- Pending Grades -->
        <a asp-controller="Grades" asp-action="Index" class="card grades">
            <h2>🧾 @Model.PendingGrades.Count</h2>
            <p>Pending grade validations</p>
        </a>

        
    </div>

    <p style="margin-top: 60px; font-size: 0.95rem; color: #cce;">
        Academic Year: <strong>@Model.Summary.CurrentAcademicYear</strong> |
        Semester: <strong>@Model.Summary.CurrentSemester</strong>
    </p>
</div>
