@model StudentTrackerCOMMON.DTOs.AdminDashboard.AdminFullDashboardDto

@{
    ViewData["Title"] = "Admin Dashboard";
}

<style>
    
    body {
        background: linear-gradient(135deg, #001f3f, #003c8f);
        font-family: 'Segoe UI', sans-serif;
        color: #fff;
        margin: 0;
        padding: 0;
    }

   
    .dashboard-wrapper {
        padding: 80px 0;
        text-align: center;
    }

    .dashboard-header {
        margin-bottom: 40px;
    }

        .dashboard-header h2 {
            font-weight: 700;
            font-size: 2.3rem;
            color: #fff;
        }

        .dashboard-header p {
            color: #cfd8dc;
            font-size: 1.1rem;
            margin-top: 10px;
        }

    
    .card-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 25px;
        width: 85%;
        max-width: 1100px;
        margin: 0 auto;
    }

   
    .card-link {
        text-decoration: none;
        color: inherit;
    }

    
    .card {
        background: rgba(255, 255, 255, 0.12);
        backdrop-filter: blur(14px);
        -webkit-backdrop-filter: blur(14px);
        border-radius: 20px;
        padding: 40px 20px;
        border: 1px solid rgba(255, 255, 255, 0.25);
        transition: all 0.3s ease;
        color: #fff;
        
        box-shadow: 0 8px 25px rgba(0, 0, 0, 0.4), 0 0 15px rgba(0, 191, 255, 0.2), inset 0 0 8px rgba(255, 255, 255, 0.1);
    }

        .card:hover {
            transform: translateY(-8px);
            box-shadow: 0 12px 35px rgba(0, 0, 0, 0.6), 0 0 25px rgba(0, 191, 255, 0.45), inset 0 0 10px rgba(255, 255, 255, 0.15);
        }

        .card h5 {
            font-weight: 600;
            font-size: 1.05rem;
            text-transform: uppercase;
            margin-bottom: 10px;
            letter-spacing: 0.5px;
            opacity: 0.9;
        }

        .card h3 {
            font-size: 2.6rem;
            font-weight: 800;
            color: #fff;
            text-shadow: 0 0 6px rgba(255, 255, 255, 0.3);
        }

    /
    .students {
        border-top: 4px solid #00e676;
    }

    .teachers {
        border-top: 4px solid #2196f3;
    }

    .courses {
        border-top: 4px solid #ffb300;
    }

    .departments {
        border-top: 4px solid #ba68c8;
    }

  
    .footer-summary {
        margin-top: 60px;
        color: #cfd8dc;
        font-size: 1rem;
    }

        .footer-summary strong {
            color: #fff;
        }
</style>

<div class="dashboard-wrapper">
    <div class="dashboard-header">
        <h2>🧑‍💼 Admin Dashboard</h2>
        <p>Overview of the university’s academic structure and performance</p>
    </div>

    <div class="card-grid">
        <a href="/Users?role=Student" class="card-link">
            <div class="card students">
                <h5>👩‍🎓 Total Students</h5>
                <h3>@Model.Summary.TotalStudents</h3>
            </div>
        </a>

        <a href="/Users?role=Teacher" class="card-link">
            <div class="card teachers">
                <h5>👨‍🏫 Total Teachers</h5>
                <h3>@Model.Summary.TotalTeachers</h3>
            </div>
        </a>

        <a href="/Courses" class="card-link">
            <div class="card courses">
                <h5>📚 Active Courses</h5>
                <h3>@Model.Summary.ActiveCourses</h3>
            </div>
        </a>

        <a href="/Departments" class="card-link">
            <div class="card departments">
                <h5>🏛️ Departments</h5>
                <h3>@Model.Summary.Departments</h3>
            </div>
        </a>
    </div>

    <div class="footer-summary">
        Academic Year: <strong>@Model.Summary.CurrentAcademicYear</strong> |
        Semester: <strong>@Model.Summary.CurrentSemester</strong>
    </div>
</div>
