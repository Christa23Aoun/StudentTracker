@model StudentTracker.Models.AdminDashboardViewModel
@{
    ViewData["Title"] = "Admin Dashboard";
}

<style>
    body {
        background: #f5f7fa;
        font-family: 'Inter', sans-serif;
        color: #1a2b4c;
    }

    .dashboard-container {
        width: 92%;
        max-width: 1300px;
        margin: 70px auto;
    }

    .dashboard-header {
        border-left: 5px solid #003c8f;
        padding-left: 18px;
        margin-bottom: 40px;
    }

        .dashboard-header h1 {
            font-size: 36px;
            font-weight: 800;
            color: #003c8f;
            margin: 0;
        }

        .dashboard-header p {
            color: #5b6e80;
            margin-top: 6px;
        }

    .dashboard-cards {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
        gap: 30px;
    }

    .card {
        background: white;
        border: 1px solid #d9e1ec;
        border-radius: 6px;
        padding: 28px;
        text-decoration: none;
        color: inherit;
        box-shadow: 0px 4px 10px rgba(0,0,0,0.06);
        transition: .25s;
    }

        .card::before {
            content: "";
            display: block;
            height: 4px;
            background: #003c8f;
            margin-bottom: 18px;
        }

    .card-title {
        font-size: 14px;
        text-transform: uppercase;
        font-weight: 600;
        color: #5e6a78;
    }

    .card-value {
        font-size: 32px;
        font-weight: 800;
        color: #003c8f;
    }

    .bulk-actions {
        margin-top: 40px;
        display: flex;
        gap: 15px;
    }

    .btn-primary {
        background: #003c8f;
        color: white;
        padding: 10px 24px;
        border-radius: 6px;
        border: none;
        font-weight: 600;
    }

    .btn-danger {
        background: #c62828;
        color: white;
        padding: 10px 24px;
        border-radius: 6px;
        border: none;
        font-weight: 600;
    }

    .academic-info {
        margin-top: 50px;
        padding-top: 15px;
        border-top: 1px solid #d9e1ec;
        color: #5b6e80;
        font-size: 14px;
    }
</style>

<div class="dashboard-container">

    <div class="dashboard-header">
        <h1>Admin Dashboard</h1>
        <p>Overview of academic operations and university performance indicators.</p>
    </div>

    @if (TempData["GradeMessage"] != null)
    {
        <div style="margin-bottom:20px; padding:12px 18px; background:#e3f2fd; border-left:4px solid #003c8f;">
            @TempData["GradeMessage"]
        </div>
    }

    <div class="dashboard-cards">
        <a asp-controller="Users" asp-action="Index" asp-route-role="Student" class="card">
            <div class="card-title">Total Registered Students</div>
            <div class="card-value">@Model.Summary.TotalStudents</div>
        </a>

        <a asp-controller="Users" asp-action="Index" asp-route-role="Teacher" class="card">
            <div class="card-title">Total Active Teachers</div>
            <div class="card-value">@Model.Summary.TotalTeachers</div>
        </a>

        <a asp-controller="Courses" asp-action="Index" class="card">
            <div class="card-title">Active Courses This Semester</div>
            <div class="card-value">@Model.Summary.ActiveCourses</div>
        </a>

        <a asp-controller="Departments" asp-action="Index" class="card">
            <div class="card-title">Academic Departments</div>
            <div class="card-value">@Model.Summary.Departments</div>
        </a>

        <a asp-controller="Grades" asp-action="Index" class="card">
            <div class="card-title">Pending Grade Reviews</div>
            <div class="card-value">@Model.PendingGrades.Count</div>
        </a>
    </div>

   

    <div class="academic-info">
        Academic Year: <strong>@Model.Summary.CurrentAcademicYear</strong> |
        Semester: <strong>@Model.Summary.CurrentSemester</strong>
    </div>

</div>
